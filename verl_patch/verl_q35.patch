diff --git a/verl/verl/erropd/hooks.py b/verl/verl/erropd/hooks.py
new file mode 100644
index 0000000..b2971db
--- /dev/null
+++ b/verl/verl/erropd/hooks.py
@@ -0,0 +1,607 @@
+"""Driver-side ERROPD hooks for OPD on K=8 listwise JSON ranking.
+
+All decisions are made on the driver (RayPPOTrainer.fit), after the batch has
+old/ref/base log-probs and before update_actor. The actor only consumes two
+optional per-token tensors:
+
+  erropd_token_lambda  float [bs, L]  lambda applied at each response token
+  erropd_loss_mask     float [bs, L]  1 = keep, 0 = zero this token's pg loss
+
+They are added to the batch ONLY when a training intervention is enabled.
+With every flag off, the batch that reaches update_actor is untouched (same
+keys, same tensors), so the actor runs the production code path. Logging
+(rollout validity, failure types, per-class advantage) is always on and only
+reads the batch.
+
+Config (all under a top-level `erropd` group, passed as `+erropd.<key>=...`):
+
+  token_class_lambda: off | only_score | only_id | only_term | all_but_term | only_scaffold |
+      all_but_scaffold | id_score.  lambda_t on the selected classes, 1.0 elsewhere (B3).
+      Classes (listwise_contract): id, score, term (the '}' closing each list element, the ','
+      between elements, the list-closing ']', EOS), scaffold (everything else).
+  lambda_max: float, default = actor_rollout_ref.actor.policy_loss.lambda_vals
+  mask: off | invalid_rollout | from_violation | after_violation
+      invalid_rollout (B4 a): zero the loss of rollouts failing the strict parser.
+      from_violation (B4 b): zero the loss of the token containing the first contract
+      violation and of every later token.
+      after_violation (B4 b'): zero the loss of tokens strictly after that token (the
+      violating token keeps its loss).
+  gate_tau: float or null. If set (C2): lambda_t = lambda_max if the strict-parse
+      pass fraction of step t-1's rollouts >= gate_tau, else 1.0; step 1 uses 1.0.
+  gate_estimator: eligible | raw  (default eligible: only prompts whose K input ids
+      are unique enter the fraction; the parser rejects every output on the others).
+  lambda_schedule: [[start_step, lambda], ...]  piecewise constant, 1-indexed steps,
+      e.g. [[1,1.0],[21,1.25]] = steps 1..20 at 1.0, steps 21.. at 1.25 (C1).
+  lambda_warmup_steps / lambda_warmup_value: bracket-free shorthand for the two-piece
+      schedule [[1, value], [steps+1, lambda_max]] (safe inside unquoted shell variables).
+  stop_after_kept_rollouts: int or null. End training after the step at which the
+      cumulative number of rollouts with nonzero loss mass reaches this value.
+  save_steps: [int, ...] or "20x48x62"  extra checkpoint steps (in addition to save_freq / last).
+  dump_rollouts: bool (default false)  append per-rollout records to
+      <log_dir>/erropd_rollouts.jsonl.
+  log_dir: default trainer.default_local_dir. Per-step metrics are appended to
+      <log_dir>/erropd_step_metrics.jsonl.
+  log_update_norm: bool (default true)  actor logs ||theta_{t+1}-theta_t|| and ||theta||
+      (read-only; used to compare effective update size across arms).
+  reopd: bool (default false)  REOPD token-wise coefficient (Sun et al., arXiv 2608.11698):
+      lambda_t = 1 + gamma_b * q_t,  q_t = exp(-(e^x - x - 1)/tau),  x = log piT - log piS
+      at the sampled token, gamma_b from their Eq. 8-12 controller, one controller call
+      per synchronized actor micro-batch (statistics over all DP ranks' rows of that
+      micro-batch). Parameters: reopd_tau (0.007), reopd_gamma_max (default lambda_max-1),
+      reopd_kappa (0.5), reopd_beta (0.95), reopd_beta_gamma (0.9), reopd_k0 (10),
+      reopd_warmup_calls (0), reopd_warmup_gamma (0.25).
+      Unspecified in the paper and fixed here: gamma_0 = 0; EMAs start at the first
+      observation; B0 = kappa * running mean of RMS(a) over calls 1..k0, then frozen;
+      eps = 1e-8.
+
+Masking zeroes advantages (hence the per-token loss) but leaves response_mask,
+and therefore the token-mean normalizer, unchanged: the update equals the
+vanilla update minus the masked tokens' terms.
+
+Loss mode (env PAPER_LOSS_MODE, required, always explicit; ported from G-OPD-erropd
+snapshot 302dfd90ef):
+  opd          the production OPD estimator (unchanged).
+  fkl_sampled  on-policy forward KL: the teacher pass also draws one token per response
+      position from its own distribution (pre_ref / post_ref), the actor's loss is the
+      student's masked token-mean CE on those tokens in place of the OPD pg term. Not
+      combinable with the interventions above; kl_loss_coef must be 0.
+The mode is stamped on every batch (meta paper_loss_mode); the actor refuses a
+missing mode or a meta/env disagreement, and check_ack refuses an actor that did
+not run the requested loss.
+"""
+
+import json
+import os
+import time
+
+import numpy as np
+import torch
+
+from verl.erropd import listwise_contract as lc
+
+_CLASS_MODES = {
+    "off": None,
+    "only_score": {lc.SCORE},
+    "only_id": {lc.ID},
+    "only_term": {lc.TERM},
+    "all_but_term": {lc.SCAFFOLD, lc.ID, lc.SCORE},
+    "only_scaffold": {lc.SCAFFOLD},
+    "all_but_scaffold": {lc.ID, lc.SCORE, lc.TERM},
+    "id_score": {lc.ID, lc.SCORE},
+}
+_MASK_MODES = ("off", "invalid_rollout", "from_violation", "after_violation")
+
+
+def _cfg_get(cfg, key, default=None):
+    if cfg is None:
+        return default
+    try:
+        v = cfg.get(key, default)
+    except Exception:
+        v = getattr(cfg, key, default)
+    return default if v is None and default is not None else v
+
+
+class TokenSpanDecoder:
+    """Decode response token ids to text plus per-token character spans.
+
+    text == tokenizer.decode(ids, skip_special_tokens=True) (the string the eval
+    parses, modulo vLLM's own detokenizer). Fast path: byte-level pieces when the
+    output is pure ASCII; otherwise incremental prefix decoding.
+    """
+
+    def __init__(self, tokenizer):
+        self.tok = tokenizer
+        self.special_ids = set(int(i) for i in (tokenizer.all_special_ids or []))
+        try:
+            for tid, at in tokenizer.added_tokens_decoder.items():
+                if getattr(at, "special", False):
+                    self.special_ids.add(int(tid))
+        except Exception:
+            pass
+        try:
+            try:
+                from transformers.models.gpt2.tokenization_gpt2 import bytes_to_unicode
+            except ImportError:  # [q35 port] transformers>=5 moved it; same GPT-2 byte<->unicode table
+                from transformers.convert_slow_tokenizer import bytes_to_unicode
+
+            self.byte_decoder = {v: k for k, v in bytes_to_unicode().items()}
+        except Exception:
+            self.byte_decoder = None
+        self.added_ids = set()
+        try:
+            self.added_ids = set(int(i) for i in tokenizer.added_tokens_decoder.keys())
+        except Exception:
+            pass
+        self.n_fallback = 0
+
+    def _piece_bytes(self, tid, piece):
+        if tid in self.special_ids:
+            return b""
+        if tid in self.added_ids:
+            return piece.encode("utf-8")
+        return bytes(self.byte_decoder[c] for c in piece)
+
+    def decode(self, ids):
+        ids = [int(i) for i in ids]
+        text = self.tok.decode(ids, skip_special_tokens=True)
+        if self.byte_decoder is not None:
+            try:
+                pieces = self.tok.convert_ids_to_tokens(ids)
+                bs = [self._piece_bytes(t, p) for t, p in zip(ids, pieces)]
+                joined = b"".join(bs)
+                if all(b < 0x80 for b in joined) and joined.decode("ascii") == text:
+                    spans, pos = [], 0
+                    for b in bs:
+                        spans.append((pos, pos + len(b)))
+                        pos += len(b)
+                    return text, spans
+            except Exception:
+                pass
+        # fallback: incremental prefix decoding (monotone clamp)
+        self.n_fallback += 1
+        spans, prev = [], 0
+        for i in range(len(ids)):
+            cur = len(self.tok.decode(ids[: i + 1], skip_special_tokens=True))
+            cur = max(cur, prev)
+            spans.append((prev, cur))
+            prev = cur
+        return text, spans
+
+
+def char_to_token(ci, spans):
+    for t, (a, b) in enumerate(spans):
+        if a <= ci < b:
+            return t
+    return None
+
+
+class ErropdHooks:
+    def __init__(self, config, tokenizer):
+        ncfg = config.get("erropd", None) if hasattr(config, "get") else None
+        actor_lambda = float(config.actor_rollout_ref.actor.policy_loss.get("lambda_vals", 1.0))
+        self.class_mode = str(_cfg_get(ncfg, "token_class_lambda", "off"))
+        if self.class_mode not in _CLASS_MODES:
+            raise ValueError(f"erropd.token_class_lambda={self.class_mode} not in {list(_CLASS_MODES)}")
+        lm = _cfg_get(ncfg, "lambda_max", None)
+        self.lambda_max = float(lm) if lm is not None else actor_lambda
+        self.mask_mode = str(_cfg_get(ncfg, "mask", "off"))
+        if self.mask_mode not in _MASK_MODES:
+            raise ValueError(f"erropd.mask={self.mask_mode} not in {_MASK_MODES}")
+        tau = _cfg_get(ncfg, "gate_tau", None)
+        self.gate_tau = float(tau) if tau is not None else None
+        self.gate_estimator = str(_cfg_get(ncfg, "gate_estimator", "eligible"))
+        if self.gate_estimator not in ("eligible", "raw"):
+            raise ValueError("erropd.gate_estimator must be eligible|raw")
+        sched = _cfg_get(ncfg, "lambda_schedule", None)
+        wu_steps = _cfg_get(ncfg, "lambda_warmup_steps", None)
+        if wu_steps is not None:
+            if sched is not None:
+                raise ValueError("give erropd.lambda_schedule or erropd.lambda_warmup_steps, not both")
+            wu_val = float(_cfg_get(ncfg, "lambda_warmup_value", 1.0))
+            sched = [[1, wu_val], [int(wu_steps) + 1, self.lambda_max]]
+        self.schedule = None
+        if sched is not None:
+            self.schedule = sorted((int(s), float(l)) for s, l in list(sched))
+            if not self.schedule or self.schedule[0][0] != 1:
+                raise ValueError("erropd.lambda_schedule must start at step 1, e.g. [[1,1.0],[21,1.25]]")
+        if self.schedule is not None and self.gate_tau is not None:
+            raise ValueError("erropd.lambda_schedule and erropd.gate_tau are mutually exclusive")
+        sak = _cfg_get(ncfg, "stop_after_kept_rollouts", None)
+        self.stop_after_kept = int(sak) if sak is not None else None
+        ss = _cfg_get(ncfg, "save_steps", []) or []
+        if isinstance(ss, str):
+            ss = [x for x in ss.replace(",", "x").split("x") if x.strip()]
+        elif isinstance(ss, (int, float)):
+            ss = [ss]
+        self.save_steps = set(int(x) for x in ss)
+        self.dump_rollouts = bool(_cfg_get(ncfg, "dump_rollouts", False))
+        self.log_dir = _cfg_get(ncfg, "log_dir", None) or config.trainer.default_local_dir
+        self.log_update_norm = bool(_cfg_get(ncfg, "log_update_norm", True))
+
+        # REOPD
+        self.reopd = bool(_cfg_get(ncfg, "reopd", False))
+        if self.reopd:
+            if self.class_mode != "off" or self.schedule is not None or self.gate_tau is not None:
+                raise ValueError("erropd.reopd is exclusive with token_class_lambda / lambda_schedule / gate_tau")
+            gm = _cfg_get(ncfg, "reopd_gamma_max", None)
+            self.r_gamma_max = float(gm) if gm is not None else self.lambda_max - 1.0
+            self.r_tau = float(_cfg_get(ncfg, "reopd_tau", 0.007))
+            self.r_kappa = float(_cfg_get(ncfg, "reopd_kappa", 0.5))
+            self.r_beta = float(_cfg_get(ncfg, "reopd_beta", 0.95))
+            self.r_beta_g = float(_cfg_get(ncfg, "reopd_beta_gamma", 0.9))
+            self.r_k0 = int(_cfg_get(ncfg, "reopd_k0", 10))
+            self.r_warm_calls = int(_cfg_get(ncfg, "reopd_warmup_calls", 0))
+            self.r_warm_gamma = float(_cfg_get(ncfg, "reopd_warmup_gamma", 0.25))
+            self.r_state = {"calls": 0, "b0_sum": 0.0, "B0": None, "rho_bar": None, "s_bar": None,
+                            "gamma": 0.0}
+        # actor micro-batch layout (for REOPD controller calls)
+        a = config.actor_rollout_ref.actor
+        self.layout = {
+            "world": int(config.trainer.n_gpus_per_node) * int(config.trainer.nnodes),
+            "micro": a.get("ppo_micro_batch_size_per_gpu", None),
+            "dynamic": bool(a.get("use_dynamic_bsz", False)),
+        }
+
+        # training interventions that require per-token tensors in the actor
+        self.needs_lambda_tensor = (
+            self.class_mode != "off" or self.schedule is not None or self.gate_tau is not None
+            or self.reopd
+        )
+        self.needs_mask_tensor = self.mask_mode != "off"
+        self.active = self.needs_lambda_tensor or self.needs_mask_tensor
+
+        # PAPER_LOSS_MODE: always explicit (no default)
+        plm = os.environ.get("PAPER_LOSS_MODE", None)
+        if plm not in ("opd", "fkl_sampled"):
+            raise ValueError(f"PAPER_LOSS_MODE must be set explicitly to opd or fkl_sampled (got {plm!r})")
+        self.loss_mode = plm
+        self.fkl = plm == "fkl_sampled"
+        if self.fkl:
+            if self.active or self.schedule is not None or self.gate_tau is not None or self.reopd:
+                raise ValueError("PAPER_LOSS_MODE=fkl_sampled cannot be combined with ERROPD interventions")
+            a_ = config.actor_rollout_ref.actor
+            if a_.get("use_kl_loss", False) and float(a_.get("kl_loss_coef", 0.0)) != 0.0:
+                raise ValueError("PAPER_LOSS_MODE=fkl_sampled with a nonzero kl_loss_coef is not defined")
+            if str(config.trainer.get("use_legacy_worker_impl", "auto")) == "disable":
+                raise ValueError("PAPER_LOSS_MODE=fkl_sampled is implemented in the legacy FSDP workers only")
+
+        if self.active:
+            pl = config.actor_rollout_ref.actor.policy_loss
+            if not pl.get("only_reverse_kl_advantages", False):
+                raise ValueError("erropd interventions require policy_loss.only_reverse_kl_advantages=True")
+            if pl.get("multi_teacher_distill", False):
+                raise ValueError("erropd interventions are not defined for multi_teacher_distill")
+            if int(config.actor_rollout_ref.actor.get("ppo_epochs", 1)) != 1:
+                raise ValueError("erropd interventions assume ppo_epochs=1 (on-policy, ratio 1)")
+
+        self.decoder = TokenSpanDecoder(tokenizer)
+        self.n_tokenizer = len(tokenizer)
+        self.prev_frac = {"raw": None, "eligible": None}
+        self.kept_cum = 0
+        self.stop_now = False
+        self.gate_open_steps = 0
+        self.n_steps = 0
+        self._last = {}
+        os.makedirs(self.log_dir, exist_ok=True)
+        print(
+            f"[erropd] hooks: class_mode={self.class_mode} lambda_max={self.lambda_max} mask={self.mask_mode} "
+            f"gate_tau={self.gate_tau} ({self.gate_estimator}) schedule={self.schedule} "
+            f"stop_after_kept={self.stop_after_kept} save_steps={sorted(self.save_steps)} reopd={self.reopd} "
+            f"active={self.active} loss_mode={self.loss_mode} log_dir={self.log_dir}",
+            flush=True,
+        )
+
+    # ------------------------------------------------------------------
+    def pre_ref(self, batch):
+        """Before the teacher (ref) log-prob pass: request one teacher-sampled token per response position
+        (PAPER_LOSS_MODE=fkl_sampled)."""
+        if self.fkl:
+            batch.meta_info["paper_need_ref_sample"] = True
+
+    def post_ref(self, batch):
+        batch.meta_info.pop("paper_need_ref_sample", None)
+        if self.fkl and "ref_sampled_token" not in batch.batch.keys():
+            raise RuntimeError("[paper] fkl_sampled needs ref_sampled_token from the teacher pass; the worker did not "
+                               "return it (wrong verl tree on the workers?)")
+
+    # ------------------------------------------------------------------
+    def lambda_for_step(self, step):
+        """Returns (lambda_step, gate_open or None)."""
+        if self.schedule is not None:
+            lam = self.schedule[0][1]
+            for s, l in self.schedule:
+                if step >= s:
+                    lam = l
+            return lam, None
+        if self.gate_tau is not None:
+            est = self.prev_frac[self.gate_estimator]
+            if est is None:  # step 1: no t-1 estimate
+                return 1.0, False
+            is_open = est >= self.gate_tau
+            return (self.lambda_max if is_open else 1.0), is_open
+        return self.lambda_max, None
+
+    # ------------------------------------------------------------------
+    def micro_groups(self, bs):
+        """Row indices of each synchronized actor micro-batch (rank r gets the contiguous
+        chunk r of the batch; each rank splits its chunk into micro-batches in order)."""
+        w, mic = self.layout["world"], self.layout["micro"]
+        if self.layout["dynamic"] or not mic or bs % w or (bs // w) % int(mic):
+            return [list(range(bs))]
+        per, mic = bs // w, int(mic)
+        return [[r * per + j * mic + k for r in range(w) for k in range(mic)] for j in range(per // mic)]
+
+    def reopd_token_lambda(self, old, ref, base, resp_mask):
+        """REOPD Eq. 4-12 on the driver. Inputs [bs, L] float; returns (tl float32, stats)."""
+        eps = 1e-8
+        st = self.r_state
+        bs, L = old.shape
+        tl = torch.ones(bs, L, dtype=torch.float64)
+        gammas, qs = [], []
+        for rows in self.micro_groups(bs):
+            idx = torch.tensor(rows, dtype=torch.long)
+            m = resp_mask[idx].double()
+            if m.sum() <= 0:
+                continue
+            x = (ref[idx] - old[idx]).double()          # log piT - log pi_theta (sampled token)
+            a = -x                                      # alignment cost  log pi_theta - log piT
+            r = (ref[idx] - base[idx]).double()         # residual        log piT - log pi_ref
+            delta = torch.exp(x) - x - 1.0
+            q = torch.exp(-delta / self.r_tau)
+            q = torch.where(torch.isfinite(q), q, torch.zeros_like(q))
+            st["calls"] += 1
+            if st["calls"] <= self.r_k0:
+                rms_a = float(torch.sqrt((m * a * a).sum() / m.sum()))
+                st["b0_sum"] += rms_a
+                st["B0"] = self.r_kappa * st["b0_sum"] / st["calls"]
+            rho = float((m * r.abs() * q).sum() / ((m * r.abs()).sum() + eps))
+            s_ = float(torch.sqrt((m * (q * r) ** 2).sum() / (m.sum() + eps)))
+            st["rho_bar"] = rho if st["rho_bar"] is None else self.r_beta * st["rho_bar"] + (1 - self.r_beta) * rho
+            st["s_bar"] = s_ if st["s_bar"] is None else self.r_beta * st["s_bar"] + (1 - self.r_beta) * s_
+            g_tilde = min(max(st["B0"] * st["rho_bar"] / (st["s_bar"] + eps), 0.0), self.r_gamma_max)
+            st["gamma"] = self.r_beta_g * st["gamma"] + (1 - self.r_beta_g) * g_tilde
+            gamma = self.r_warm_gamma if st["calls"] <= self.r_warm_calls else st["gamma"]
+            tl[idx] = torch.where(m > 0, 1.0 + gamma * q, torch.ones_like(q))
+            gammas.append(gamma)
+            qs.append(float((m * q).sum() / m.sum()))
+        stats = {
+            "erropd/reopd_gamma_mean": float(np.mean(gammas)) if gammas else 0.0,
+            "erropd/reopd_gamma_last": gammas[-1] if gammas else 0.0,
+            "erropd/reopd_q_mean": float(np.mean(qs)) if qs else 0.0,
+            "erropd/reopd_B0": float(st["B0"] or 0.0),
+            "erropd/reopd_rho_bar": float(st["rho_bar"] or 0.0),
+            "erropd/reopd_s_bar": float(st["s_bar"] or 0.0),
+            "erropd/reopd_calls_cum": st["calls"],
+        }
+        return tl.float(), stats
+
+
+    # ------------------------------------------------------------------
+    def analyze(self, batch):
+        """Per-rollout analysis. Pure function of the batch (no mutation)."""
+        responses = batch.batch["responses"].cpu()
+        resp_mask = batch.batch["response_mask"].cpu()
+        extra = batch.non_tensor_batch["extra_info"]
+        bs, L = responses.shape
+        lengths = resp_mask.sum(-1).long().tolist()
+        cls = torch.zeros(bs, L, dtype=torch.long)
+        recs = []
+        n_straddle = 0
+        n_tok_total = 0
+        for i in range(bs):
+            n = int(lengths[i])
+            ids = responses[i, :n].tolist()
+            text, spans = self.decoder.decode(ids)
+            ei = extra[i]
+            K = int(ei["K"])
+            rids = [str(r) for r in list(ei["review_ids"])]
+            valid = lc.strict_valid(text, K, rids)
+            eligible = lc.prompt_eligible(K, rids)
+            status, ci, vtype = lc.locate_first_violation(text, K, rids)
+            tcls, ns = lc.token_classes_from_spans(text, spans)
+            n_straddle += ns
+            n_tok_total += n
+            if n:
+                cls[i, :n] = torch.tensor(tcls, dtype=torch.long)
+            vtok = char_to_token(ci, spans) if ci is not None else None
+            recs.append({
+                "index": int(ei.get("index", -1)) if hasattr(ei, "get") else -1,
+                "K": K, "review_ids": rids, "valid": bool(valid), "eligible": bool(eligible), "status": status,
+                "vtype": vtype, "viol_char": ci, "viol_tok": vtok, "n_tok": n, "text": text,
+            })
+        return cls, recs, lengths, n_straddle, n_tok_total
+
+    # ------------------------------------------------------------------
+    def on_batch(self, batch, step, metrics):
+        """Called after compute_advantage, before update_actor. Returns the batch
+        (unchanged object when no intervention is active)."""
+        t0 = time.time()
+        self.n_steps += 1
+        if self.fkl and "ref_sampled_token" not in batch.batch.keys():
+            raise RuntimeError("[paper] PAPER_LOSS_MODE=fkl_sampled but the batch has no ref_sampled_token (no teacher "
+                               "pass with pre_ref/post_ref?)")
+        extra = batch.non_tensor_batch.get("extra_info", None)
+        listwise = (extra is not None and len(extra) > 0 and hasattr(extra[0], "get")
+                    and "review_ids" in extra[0] and "K" in extra[0])
+        if listwise:
+            cls, recs, lengths, n_straddle, n_tok_total = self.analyze(batch)
+        else:
+            if self.class_mode != "off" or self.mask_mode != "off" or self.gate_tau is not None:
+                raise ValueError("[erropd] token classes / masking / validity gate need listwise "
+                                 "extra_info (K, review_ids) in the batch")
+            bs0, L0 = batch.batch["responses"].shape
+            cls, recs, n_straddle, n_tok_total = torch.zeros(bs0, L0, dtype=torch.long), [], 0, 0
+        bs, L = cls.shape
+        resp_mask = batch.batch["response_mask"].cpu().float()
+
+        lam_step, gate_open = self.lambda_for_step(step)
+        if gate_open:
+            self.gate_open_steps += 1
+
+        # per-token lambda actually applied
+        sel = _CLASS_MODES[self.class_mode]
+        if sel is None:
+            tl = torch.full((bs, L), float(lam_step), dtype=torch.float32)
+        else:
+            tl = torch.ones(bs, L, dtype=torch.float32)
+            selmask = torch.zeros(bs, L, dtype=torch.bool)
+            for c in sel:
+                selmask |= cls == c
+            tl[selmask] = float(lam_step)
+        tl = torch.where(resp_mask > 0, tl, torch.ones_like(tl))
+        reopd_stats = {}
+        if self.reopd:
+            bk0 = batch.batch
+            tl, reopd_stats = self.reopd_token_lambda(
+                bk0["old_log_probs"].cpu().float(), bk0["ref_log_prob"].cpu().float(),
+                bk0["base_log_prob"].cpu().float(), resp_mask)
+            lam_step = float((tl * resp_mask).sum() / resp_mask.sum().clamp(min=1))  # mean applied lambda
+
+        # loss mask
+        lm = torch.ones(bs, L, dtype=torch.float32)
+        if self.mask_mode == "invalid_rollout":
+            for i, r in enumerate(recs):
+                if not r["valid"]:
+                    lm[i, :] = 0.0
+        elif self.mask_mode in ("from_violation", "after_violation"):
+            off = 0 if self.mask_mode == "from_violation" else 1
+            for i, r in enumerate(recs):
+                if r["status"] == lc.VIOLATION and r["viol_tok"] is not None:
+                    lm[i, r["viol_tok"] + off:] = 0.0
+        kept = int(((lm * resp_mask).sum(-1) > 0).sum().item())
+        self.kept_cum += kept
+        if self.stop_after_kept is not None and self.kept_cum >= self.stop_after_kept:
+            self.stop_now = True
+
+        # ---------------- metrics (always) ----------------
+        m = {"erropd/listwise": float(listwise)}
+        n = len(recs)
+        n_valid = sum(r["valid"] for r in recs)
+        elig = [r for r in recs if r["eligible"]]
+        n_elig = len(elig)
+        frac_raw = n_valid / n if n else 0.0
+        frac_elig = (sum(r["valid"] for r in elig) / n_elig) if n_elig else 0.0
+        m["erropd/rollout_valid_frac_sampled"] = frac_raw
+        m["erropd/rollout_valid_frac_sampled_eligible"] = frac_elig
+        m["erropd/n_rollouts"] = n
+        m["erropd/n_eligible"] = n_elig
+        for st in (lc.VALID, lc.VIOLATION, lc.INCOMPLETE, lc.INELIGIBLE):
+            m[f"erropd/status_frac/{st}"] = sum(r["status"] == st for r in recs) / max(n, 1)
+        vtypes = {}
+        for r in recs:
+            if r["status"] in (lc.VIOLATION, lc.INCOMPLETE) and r["vtype"]:
+                vtypes[r["vtype"]] = vtypes.get(r["vtype"], 0) + 1
+        for k, v in vtypes.items():
+            m[f"erropd/vtype_frac/{k}"] = v / max(n, 1)
+        m["erropd/lambda_step"] = float(lam_step)
+        if gate_open is not None:
+            m["erropd/gate_open"] = float(gate_open)
+            est = self.prev_frac[self.gate_estimator]
+            m["erropd/gate_estimate_prev"] = -1.0 if est is None else float(est)
+        m["erropd/kept_rollouts"] = kept
+        m["erropd/kept_rollouts_cum"] = self.kept_cum
+        m["erropd/masked_token_frac"] = float(((1 - lm) * resp_mask).sum() / resp_mask.sum().clamp(min=1))
+        m["erropd/straddle_token_frac"] = n_straddle / max(n_tok_total, 1)
+        m["erropd/decode_fallbacks_cum"] = self.decoder.n_fallback
+
+        # per-class advantage as the actor will compute it (up to recompute numerics)
+        bk = batch.batch
+        if "old_log_probs" in bk.keys() and "ref_log_prob" in bk.keys():
+            old = bk["old_log_probs"].cpu().float()
+            ref = bk["ref_log_prob"].cpu().float()
+            if "base_log_prob" in bk.keys():
+                base = bk["base_log_prob"].cpu().float()
+                adv = torch.where(tl == 1.0, ref - old, (ref - base) * tl - (old - base))
+                tb = ref - base
+                sb = old - base
+            else:
+                adv, tb, sb = ref - old, None, None
+            for c, name in lc.CLASS_NAMES.items():
+                w = ((cls == c).float() * resp_mask)
+                cnt = w.sum().clamp(min=1)
+                m[f"erropd/adv_mean/{name}"] = float((adv * w).sum() / cnt)
+                m[f"erropd/tok_frac/{name}"] = float(w.sum() / resp_mask.sum().clamp(min=1))
+                if tb is not None:
+                    m[f"erropd/teacher_minus_base_mean/{name}"] = float((tb * w).sum() / cnt)
+                    m[f"erropd/student_minus_base_mean/{name}"] = float((sb * w).sum() / cnt)
+            m["erropd/adv_mean/all"] = float((adv * resp_mask).sum() / resp_mask.sum().clamp(min=1))
+            vt = [(i, r["viol_tok"]) for i, r in enumerate(recs) if r["viol_tok"] is not None]
+            if vt:
+                m["erropd/adv_at_violation_tok"] = float(np.mean([adv[i, t].item() for i, t in vt]))
+                if tb is not None:
+                    m["erropd/teacher_minus_base_at_violation_tok"] = float(
+                        np.mean([tb[i, t].item() for i, t in vt]))
+        m.update(reopd_stats)
+        if "ref_sampled_token" in batch.batch.keys():
+            # PAPER fkl_sampled: share of response positions where the teacher sample equals the student's token
+            _eq = (batch.batch["ref_sampled_token"].cpu() == batch.batch["responses"].cpu()).float() * resp_mask
+            m["paper/fkl_teacher_eq_student"] = float(_eq.sum() / resp_mask.sum().clamp(min=1))
+            _tm = (cls == lc.TERM).float() * resp_mask
+            if float(_tm.sum()) > 0:
+                m["paper/fkl_teacher_eq_student_term"] = float((_eq * _tm).sum() / _tm.sum())
+            # samples outside the tokenizer (the model's padded vocabulary rows): diagnostic only
+            _oov = (batch.batch["ref_sampled_token"].cpu() >= self.n_tokenizer).float() * resp_mask
+            m["paper/fkl_sample_oov_frac"] = float(_oov.sum() / resp_mask.sum().clamp(min=1))
+        m["erropd/hook_sec"] = time.time() - t0
+
+        # update gate estimate for step t+1
+        self.prev_frac = {"raw": frac_raw, "eligible": frac_elig}
+        metrics.update(m)
+        self._last = {"step": step, **m}
+
+        if self.dump_rollouts:
+            with open(os.path.join(self.log_dir, "erropd_rollouts.jsonl"), "a") as fh:
+                for r in recs:
+                    fh.write(json.dumps({"step": step, "lambda_step": lam_step, **r}, ensure_ascii=False) + "\n")
+
+        if self.log_update_norm:
+            batch.meta_info["erropd_log_update_norm"] = True
+        batch.meta_info["paper_loss_mode"] = self.loss_mode  # read by the actor (always explicit)
+        if not self.active:
+            return batch
+        if self.needs_lambda_tensor:
+            batch.batch["erropd_token_lambda"] = tl
+        if self.needs_mask_tensor:
+            batch.batch["erropd_loss_mask"] = lm
+        batch.meta_info["erropd_expect_ack"] = True
+        return batch
+
+    # ------------------------------------------------------------------
+    def check_ack(self, batch, actor_metrics):
+        if self.fkl and "paper/fkl_ce" not in actor_metrics:
+            raise RuntimeError("[paper] PAPER_LOSS_MODE=fkl_sampled but the actor did not run the fkl loss (wrong verl "
+                               "tree on the workers?). Refusing to continue.")
+        if not self.fkl and "paper/fkl_ce" in actor_metrics:
+            raise RuntimeError("[paper] PAPER_LOSS_MODE=opd but the actor ran the fkl loss. Refusing to continue.")
+        batch.meta_info.pop("paper_loss_mode", None)
+        if not self.active:
+            return
+        if "erropd/actor_ack" not in actor_metrics:
+            raise RuntimeError(
+                "[erropd] actor did not acknowledge erropd tensors: the Ray workers imported a verl "
+                "without the erropd actor patch (wrong tree on sys.path?). Refusing to continue."
+            )
+        # the tensors are consumed; drop them so later logging/dumps see the vanilla key set
+        for k in ("erropd_token_lambda", "erropd_loss_mask"):
+            if k in batch.batch.keys():
+                batch.batch.pop(k)
+        batch.meta_info.pop("erropd_expect_ack", None)
+
+    def is_save_step(self, step):
+        return step in self.save_steps
+
+    def write_step(self, step, metrics):
+        rec = {"step": step}
+        for k, v in metrics.items():
+            if k.startswith(("erropd/", "paper/")) or k in ("actor/pg_loss", "actor/grad_norm", "response_length/mean",
+                                                          "actor/entropy", "actor/kl_loss", "training/epoch"):
+                try:
+                    rec[k] = float(v)
+                except Exception:
+                    pass
+        with open(os.path.join(self.log_dir, "erropd_step_metrics.jsonl"), "a") as fh:
+            fh.write(json.dumps(rec) + "\n")
+
+    def summary(self):
+        return {"gate_open_steps": self.gate_open_steps, "n_steps": self.n_steps, "kept_cum": self.kept_cum}
