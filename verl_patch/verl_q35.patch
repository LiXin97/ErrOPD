+# limitations under the License.
+"""[G-OPD port] Teacher (ref) prompt re-tokenization.
+
+The production G-OPD tree loads the teacher's tokenizer whenever `actor_rollout_ref.ref.model.path` is set and,
+before the teacher forward, re-renders every prompt with the TEACHER tokenizer's chat template
+(`apply_chat_template(raw_prompt, add_generation_prompt=True, tokenize=False, **data.apply_chat_template_kwargs)`,
+then `tokenizer(..., add_special_tokens=False)`), left-pads, concatenates the student's response tokens, and runs
+the teacher on those `ref_input_ids` (same for the ref-side base copy).
+
+In every listwise configuration the teacher and the student share one tokenizer and one chat template, so the
+re-rendered prompt is token-identical to the actor's prompt and the teacher forward is value-identical to a forward
+on the actor's own `input_ids` (only the amount of left padding can differ, and padding is removed before the
+forward with use_remove_padding=True). This port therefore performs the same re-rendering on every batch and
+ASSERTS token identity with the actor's prompt instead of materialising `ref_input_ids`; any mismatch raises. This
+also keeps Qwen3.5's 4-row (text + mrope) position ids on one code path.
+"""
+
+import numpy as np
+import torch
+
+from verl import DataProto
+
+
+def verify_ref_prompt_identity(batch: DataProto, ref_tokenizer, apply_chat_template_kwargs=None) -> dict:
+    """Re-render each raw prompt with the teacher tokenizer (production recipe) and check it equals the actor prompt.
+
+    Returns metrics; raises RuntimeError on any mismatch.
+    """
+    if apply_chat_template_kwargs is None:
+        apply_chat_template_kwargs = {}
+    if "raw_prompt" not in batch.non_tensor_batch:
+        raise ValueError(
+            "raw_prompt not found in batch.non_tensor_batch. Set data.return_raw_chat=True (as production does)."
+        )
+    raw_prompts = batch.non_tensor_batch["raw_prompt"]
+    prompts = batch.batch["prompts"]  # (bs, prompt_len), left-padded
+    prompt_len = prompts.shape[1]
+    prompt_mask = batch.batch["attention_mask"][:, :prompt_len].bool()
+    n_mismatch = 0
+    first_bad = None
+    for i in range(len(batch)):
+        messages = raw_prompts[i]
+        if not isinstance(messages, (list, np.ndarray)):
+            raise TypeError(f"raw_prompt must be a list or numpy array, got {type(messages)}")
+        messages = list(messages)
+        ref_prompt_str = ref_tokenizer.apply_chat_template(
+            messages, add_generation_prompt=True, tokenize=False, **apply_chat_template_kwargs
+        )
+        ref_ids = ref_tokenizer(ref_prompt_str, return_tensors="pt", add_special_tokens=False)["input_ids"][0]
+        actor_ids = prompts[i][prompt_mask[i]].to(ref_ids.dtype)
+        if ref_ids.shape != actor_ids.shape or not torch.equal(ref_ids, actor_ids):
+            n_mismatch += 1
+            if first_bad is None:
+                first_bad = (i, ref_ids[-12:].tolist(), actor_ids[-12:].tolist(), len(ref_ids), len(actor_ids))
+    if n_mismatch:
+        raise RuntimeError(
+            f"[G-OPD port] teacher re-tokenized prompt differs from the actor prompt on {n_mismatch}/{len(batch)} rows; "
+            f"first (row, ref tail, actor tail, ref len, actor len) = {first_bad}. The port assumes token identity."
+        )
+    return {"gopd/ref_retok_identical_frac": 1.0}
