@@ -0,0 +1,565 @@
+"""Output contract for the K=8 listwise JSON ranking task (ERROPD 2027 round).
+
+Three pieces, all pure Python (no torch), used by the driver-side hooks:
+
+1. ``parse_score_list``: a VERBATIM copy of the strict parser in
+   erropd/scripts/eval_listwise_offline.py, which produced every
+   parse/USEFUL number in the paper. ``tests/erropd/test_contract.py`` asserts the
+   source text is identical, so training-time validity and eval-time validity
+   are the same predicate. ``strict_valid`` applies it exactly as the eval does
+   (eval strips the vLLM text, then the parser strips again).
+
+2. ``locate_first_violation``: the first character at which a response can no
+   longer be completed into a parser-passing output ("viable prefix" rule),
+   for b2 masking. It is an incremental JSON scanner that encodes the parser's
+   quirks: the parsed span runs from the first '[' to the LAST ']' (so text
+   before the first '[' is free, and any ']' after the array closes breaks the
+   parse); extra keys with arbitrary JSON values are allowed; score passes if
+   ``float()`` accepts it (numbers, numeric strings, true/false, NaN/Infinity);
+   review_id passes if ``str(value)`` is an unused input id. One simplification
+   is not modelled: json.loads keeps the LAST value of a duplicated key; the
+   locator treats a second "review_id" key in one object as a violation.
+   Agreement with the parser is measured on every prediction file on disk
+   (see ).
+
+3. ``token_classes_from_spans``: per-token class over the decoded response,
+   SCAFFOLD / ID / SCORE / TERM. ID = characters of the review_id string value,
+   SCORE = numeric characters of the score value (regexes anchored on the keys;
+   an unterminated value at the end of the text still counts), TERM = the
+   list-termination decision (the '}' closing each list element, the ',' between
+   elements, the list-closing ']', and EOS). Everything else is SCAFFOLD.
+"""
+
+import json
+import re
+
+# ----------------------------------------------------------------------------
+# 1. Strict parser -- VERBATIM from erropd/scripts/eval_listwise_offline.py
+#    Do not edit; tests/erropd/test_contract.py compares the source text.
+# ----------------------------------------------------------------------------
+
+
+def parse_score_list(text: str, expected_K: int, review_ids: list[str]):
+    """Return K scores aligned to review_ids, or None if parse fails.
+
+    A valid prediction must be a JSON list of exactly K objects, each with a
+    unique input review_id and a numeric score. Scores are returned in the
+    input-review order so NDCG/Kendall are computed against the right item.
+    """
+    text = text.strip()
+    try:
+        m = re.search(r"\[.*\]", text, re.S)
+        if not m:
+            return None
+        arr = json.loads(m.group(0))
+        if not isinstance(arr, list) or len(arr) != expected_K:
+            return None
+
+        expected_ids = [str(rid) for rid in review_ids]
+        if len(expected_ids) != expected_K or len(set(expected_ids)) != expected_K:
+            return None
+
+        id_to_score = {}
+        for item in arr:
+            if not isinstance(item, dict) or "review_id" not in item or "score" not in item:
+                return None
+            rid = str(item["review_id"])
+            if rid not in expected_ids or rid in id_to_score:
+                return None
+            id_to_score[rid] = float(item["score"])
+
+        if set(id_to_score) != set(expected_ids):
+            return None
+        return [id_to_score[rid] for rid in expected_ids]
+    except Exception:
+        pass
+    return None
+
+
+# ----------------------------------------------------------------------------
+# End of verbatim block.
+# ----------------------------------------------------------------------------
+
+
+def strict_valid(text: str, K: int, review_ids) -> bool:
+    """Validity exactly as the eval computes it: parser(vllm_text.strip())."""
+    return parse_score_list(text.strip(), expected_K=K, review_ids=list(review_ids)) is not None
+
+
+def prompt_eligible(K: int, review_ids) -> bool:
+    """False when the parser rejects every output for this prompt (duplicate or
+    wrong-count input ids; 73/1795 train and 10/212 val prompts)."""
+    ids = [str(r) for r in review_ids]
+    return len(ids) == K and len(set(ids)) == K
+
+
+# ----------------------------------------------------------------------------
+# 2. First-violation locator
+# ----------------------------------------------------------------------------
+
+VALID = "valid"            # parser passes (eligible prompt, contract satisfied, array closed)
+VIOLATION = "violation"    # a character at which no completion can pass the parser
+INCOMPLETE = "incomplete"  # text ended before the array closed, no violation yet
+INELIGIBLE = "ineligible"  # prompt has duplicate/wrong-count input ids; contract checked
+                           # with multiset ids and no violation found
+
+# violation types (for logging / failure anatomy)
+V_NO_ARRAY = "no_array"              # text ended with no '[' at all (reported with INCOMPLETE)
+V_MALFORMED = "malformed_json"       # JSON syntax error
+V_NOT_OBJECT = "element_not_object"
+V_EXTRA_ITEM = "extra_item"          # a (K+1)-th element is started
+V_PREMATURE_CLOSE = "premature_close"  # ']' with fewer than K elements (K-1 truncation etc.)
+V_HALLUCINATED_ID = "hallucinated_id"  # id prefix matches no input id
+V_DUPLICATE_ID = "duplicate_id"        # id prefix matches only already-used input ids
+V_BAD_ID_VALUE = "bad_id_value"        # non-string id whose str() is not an unused input id
+V_DUP_ID_KEY = "duplicate_review_id_key"
+V_BAD_SCORE = "bad_score"              # float(score) would raise
+V_MISSING_KEY = "missing_key"          # object closed without review_id and score
+V_TRAILING_BRACKET = "trailing_bracket"  # ']' after the array closed (parser span grows)
+
+_WS = " \t\n\r"
+_NUM_START = "-0123456789"
+_LITERALS = ("true", "false", "null", "NaN", "Infinity", "-Infinity")
+
+
+def _float_ok(v) -> bool:
+    try:
+        float(v)
+        return True
+    except Exception:
+        return False
+
+
+# JSON number DFA (viable-prefix semantics): -?(0|[1-9]\d*)(\.\d+)?([eE][+-]?\d+)?
+_NUM_COMPLETE = {"ZERO", "INT", "FRAC", "EXP"}
+
+
+def _num_step(st, ch):
+    d = ch in "0123456789"
+    if st == "S0":
+        return "MINUS" if ch == "-" else "ZERO" if ch == "0" else "INT" if d else None
+    if st == "MINUS":
+        return "ZERO" if ch == "0" else "INT" if d else None
+    if st == "ZERO":
+        return "DOT" if ch == "." else "E" if ch in "eE" else None
+    if st == "INT":
+        return "INT" if d else "DOT" if ch == "." else "E" if ch in "eE" else None
+    if st == "DOT":
+        return "FRAC" if d else None
+    if st == "FRAC":
+        return "FRAC" if d else "E" if ch in "eE" else None
+    if st == "E":
+        return "ESIGN" if ch in "+-" else "EXP" if d else None
+    if st == "ESIGN":
+        return "EXP" if d else None
+    if st == "EXP":
+        return "EXP" if d else None
+    return None
+
+
+
+class _Scanner:
+    """Incremental JSON scanner for the parsed span, with contract hooks.
+
+    Frames on ``self.stack`` are dicts:
+      {"t": "arr", "depth": d, "state": "first"|"next", "count": n}
+      {"t": "obj", "depth": d, "state": "first"|"key"|"colon"|"next",
+       "key": str|None, "has_id": bool, "has_score": bool}
+    depth 1 = the top-level array, depth 2 = its elements, >=3 = nested values.
+    """
+
+    def __init__(self, K, review_ids, eligible):
+        self.K = K
+        self.eligible = eligible
+        # multiset of remaining ids (multiset semantics only matter for ineligible prompts)
+        self.remaining = {}
+        for r in review_ids:
+            r = str(r)
+            self.remaining[r] = self.remaining.get(r, 0) + 1
+        self.used = set()
+        self.stack = []
+        self.done = False           # top-level array closed
+        self.expect_value = False   # a value must start at the next non-ws char
+        self.value_ctx = None       # ("elem",) | ("member", key) | ("nested",)
+        # in-progress scalar tokens
+        self.tok = None             # {"kind": "str"|"num"|"lit", ...}
+
+    # -- helpers --------------------------------------------------------------
+    def _ids_with_prefix(self, prefix, pool):
+        return [r for r in pool if r.startswith(prefix)]
+
+    def _unused_ids(self):
+        return [r for r, c in self.remaining.items() if c > 0]
+
+    def _consume_id(self, rid):
+        self.remaining[rid] -= 1
+        self.used.add(rid)
+
+    # -- value start ----------------------------------------------------------
+    def _start_value(self, ch, pos):
+        """Returns violation type or None."""
+        ctx = self.value_ctx
+        self.expect_value = False
+        top = self.stack[-1] if self.stack else None
+        if ctx == ("elem",):
+            if ch != "{":
+                return V_NOT_OBJECT if (ch in '"[' or ch in _NUM_START or ch in "tfnNI") else V_MALFORMED
+        is_id = ctx is not None and ctx[0] == "member" and top["depth"] == 2 and ctx[1] == "review_id"
+        is_score = ctx is not None and ctx[0] == "member" and top["depth"] == 2 and ctx[1] == "score"
+        if ch == "{":
+            if is_id:
+                return V_BAD_ID_VALUE
+            if is_score:
+                return V_BAD_SCORE
+            depth = (top["depth"] + 1) if top else 1
+            self.stack.append({"t": "obj", "depth": depth, "state": "first", "key": None,
+                               "has_id": False, "has_score": False})
+            return None
+        if ch == "[":
+            if is_id:
+                return V_BAD_ID_VALUE
+            if is_score:
+                return V_BAD_SCORE
+            depth = (top["depth"] + 1) if top else 1
+            self.stack.append({"t": "arr", "depth": depth, "state": "first", "count": 0})
+            return None
+        if ch == '"':
+            self.tok = {"kind": "str", "raw": "", "esc": False, "u": 0, "role": "value",
+                        "is_id": is_id, "is_score": is_score, "has_escape": False}
+            return None
+        if ch in _NUM_START:
+            st = _num_step("S0", ch)
+            self.tok = {"kind": "num", "raw": ch, "st": st, "is_id": is_id, "is_score": is_score}
+            return None
+        if ch in "tfnNI":
+            # literals: id can never be str(True/False/None/nan/inf) (ids are hex strings);
+            # float(None) raises, float(True/False/NaN/Infinity) does not.
+            if is_id:
+                return V_BAD_ID_VALUE
+            if is_score and ch == "n":
+                return V_BAD_SCORE
+            self.tok = {"kind": "lit", "raw": ch, "is_id": is_id, "is_score": is_score}
+            return None
+        return V_MALFORMED
+
+    # -- value end (scalar completed, or container closed) ---------------------
+    def _end_value(self, py_value, is_id, is_score, container=False):
+        """Called when a value in the current frame completes. Returns violation or None."""
+        if is_id:
+            rid = str(py_value)
+            if self.remaining.get(rid, 0) <= 0:
+                return V_DUPLICATE_ID if rid in self.used else V_BAD_ID_VALUE
+            self._consume_id(rid)
+        if is_score and not container:
+            if not _float_ok(py_value):
+                return V_BAD_SCORE
+        self._after_value()
+        return None
+
+    def _after_value(self):
+        top = self.stack[-1] if self.stack else None
+        if top is None:
+            return
+        if top["t"] == "arr":
+            top["state"] = "next"
+            top["count"] += 1
+        else:
+            top["state"] = "next"
+
+    # -- main step --------------------------------------------------------------
+    def feed(self, ch, pos):
+        """Process one character of the span. Returns violation type or None."""
+        if self.done:
+            return V_TRAILING_BRACKET if ch == "]" else None
+
+        tok = self.tok
+        if tok is not None:
+            if tok["kind"] == "str":
+                return self._feed_str(ch, pos)
+            if tok["kind"] == "num":
+                if tok["raw"] == "-" and ch == "I":
+                    # "-Infinity" literal
+                    if tok["is_id"]:
+                        return V_BAD_ID_VALUE
+                    self.tok = {"kind": "lit", "raw": "-I", "is_id": tok["is_id"], "is_score": tok["is_score"]}
+                    return None
+                nxt = _num_step(tok["st"], ch)
+                if nxt is not None:
+                    tok["raw"] += ch
+                    tok["st"] = nxt
+                    return None
+                # the number ended before this char
+                if tok["st"] not in _NUM_COMPLETE:
+                    return V_MALFORMED
+                self.tok = None
+                v = self._end_value(json.loads(tok["raw"]), tok["is_id"], tok["is_score"])
+                if v is not None:
+                    return v
+                return self.feed(ch, pos)
+            if tok["kind"] == "lit":
+                cand = tok["raw"] + ch
+                matches = [l for l in _LITERALS if l.startswith(cand)]
+                if not matches:
+                    return V_MALFORMED
+                tok["raw"] = cand
+                if cand in _LITERALS:
+                    self.tok = None
+                    val = {"true": True, "false": False, "null": None, "NaN": float("nan"),
+                           "Infinity": float("inf"), "-Infinity": float("-inf")}[cand]
+                    return self._end_value(val, tok["is_id"], tok["is_score"])
+                return None
+
+        if ch in _WS:
+            return None
+
+        if self.expect_value:
+            return self._start_value(ch, pos)
+
+        top = self.stack[-1]
+        if top["t"] == "arr":
+            if top["state"] == "first":
+                if ch == "]":
+                    return self._close_array(top)
+                if top["depth"] == 1:
+                    if self.K == 0:
+                        return V_EXTRA_ITEM
+                    self.value_ctx = ("elem",)
+                else:
+                    self.value_ctx = ("nested",)
+                return self._start_value(ch, pos)
+            # state == "next"
+            if ch == ",":
+                if top["depth"] == 1 and top["count"] >= self.K:
+                    return V_EXTRA_ITEM
+                self.expect_value = True
+                self.value_ctx = ("elem",) if top["depth"] == 1 else ("nested",)
+                return None
+            if ch == "]":
+                return self._close_array(top)
+            return V_MALFORMED
+
+        # object frame
+        st = top["state"]
+        if st in ("first", "key"):
+            if ch == "}" and st == "first":
+                return self._close_object(top)
+            if ch == '"':
+                self.tok = {"kind": "str", "raw": "", "esc": False, "u": 0, "role": "key",
+                            "is_id": False, "is_score": False, "has_escape": False}
+                return None
+            return V_MALFORMED
+        if st == "colon":
+            if ch == ":":
+                self.expect_value = True
+                self.value_ctx = ("member", top["key"])
+                if top["depth"] == 2 and top["key"] == "review_id":
+                    if top["has_id"]:
+                        return V_DUP_ID_KEY
+                    top["has_id"] = True
+                if top["depth"] == 2 and top["key"] == "score":
+                    top["has_score"] = True
+                return None
+            return V_MALFORMED
+        # st == "next"
+        if ch == ",":
+            top["state"] = "key"
+            return None
+        if ch == "}":
+            return self._close_object(top)
+        return V_MALFORMED
+
+    def _feed_str(self, ch, pos):
+        tok = self.tok
+        if tok["esc"]:
+            if tok["u"] > 0:
+                if ch not in "0123456789abcdefABCDEF":
+                    return V_MALFORMED
+                tok["raw"] += ch
+                tok["u"] -= 1
+                if tok["u"] == 0:
+                    tok["esc"] = False
+                return self._str_prefix_check()
+            if ch == "u":
+                tok["raw"] += ch
+                tok["u"] = 4
+                tok["has_escape"] = True
+                return None
+            if ch in '"\\/bfnrt':
+                tok["raw"] += ch
+                tok["esc"] = False
+                tok["has_escape"] = True
+                return self._str_prefix_check()
+            return V_MALFORMED
+        if ch == "\\":
+            tok["raw"] += ch
+            tok["esc"] = True
+            return None
+        if ch == '"':
+            self.tok = None
+            try:
+                val = json.loads('"' + tok["raw"] + '"')
+            except Exception:
+                return V_MALFORMED
+            if tok["role"] == "key":
+                top = self.stack[-1]
+                top["key"] = val
+                top["state"] = "colon"
+                return None
+            if tok["is_id"]:
+                # the closing quote completes the id; the prefix check already
+                # guaranteed val is a prefix of an unused id; now require equality
+                if self.remaining.get(val, 0) <= 0:
+                    return V_DUPLICATE_ID if val in self.used else V_HALLUCINATED_ID
+                self._consume_id(val)
+                self._after_value()
+                return None
+            return self._end_value(val, False, tok["is_score"])
+        if ord(ch) < 0x20:
+            return V_MALFORMED  # json.loads(strict=True) rejects raw control chars in strings
+        tok["raw"] += ch
+        return self._str_prefix_check()
+
+    def _str_prefix_check(self):
+        tok = self.tok
+        if not tok["is_id"] or tok["esc"]:
+            return None
+        try:
+            decoded = json.loads('"' + tok["raw"] + '"')
+        except Exception:
+            return None
+        if self._ids_with_prefix(decoded, self._unused_ids()):
+            return None
+        if self._ids_with_prefix(decoded, list(self.used)):
+            return V_DUPLICATE_ID
+        return V_HALLUCINATED_ID
+
+    def _close_array(self, top):
+        if top["depth"] == 1 and top["count"] != self.K:
+            return V_PREMATURE_CLOSE if top["count"] < self.K else V_EXTRA_ITEM
+        self.stack.pop()
+        if not self.stack:
+            self.done = True
+            return None
+        return self._after_nested_container()
+
+    def _close_object(self, top):
+        if top["depth"] == 2 and not (top["has_id"] and top["has_score"]):
+            return V_MISSING_KEY
+        self.stack.pop()
+        return self._after_nested_container()
+
+    def _after_nested_container(self):
+        self._after_value()
+        return None
+
+
+def locate_first_violation(text: str, K: int, review_ids):
+    """Locate the first contract violation in a decoded response.
+
+    Returns (status, char_index, vtype):
+      status in {VALID, VIOLATION, INCOMPLETE, INELIGIBLE};
+      char_index indexes into ``text`` exactly as given (unstripped), None unless VIOLATION;
+      vtype is a V_* string for VIOLATION / INCOMPLETE (``"unterminated"`` or V_NO_ARRAY), else None.
+    """
+    eligible = prompt_eligible(K, review_ids)
+    start = text.find("[")
+    if start < 0:
+        return (INCOMPLETE if eligible else INELIGIBLE), None, V_NO_ARRAY
+    sc = _Scanner(K, review_ids, eligible)
+    sc.stack.append({"t": "arr", "depth": 1, "state": "first", "count": 0})
+    for pos in range(start + 1, len(text)):
+        v = sc.feed(text[pos], pos)
+        if v is not None:
+            return VIOLATION, pos, v
+    # end of text: a pending number/literal may be complete
+    if sc.tok is not None and not sc.done:
+        return (INCOMPLETE if eligible else INELIGIBLE), None, "unterminated"
+    if not sc.done:
+        return (INCOMPLETE if eligible else INELIGIBLE), None, "unterminated"
+    return (VALID if eligible else INELIGIBLE), None, None
+
+
+# ----------------------------------------------------------------------------
+# 3. Token classes
+# ----------------------------------------------------------------------------
+
+SCAFFOLD, ID, SCORE, TERM = 0, 1, 2, 3
+CLASS_NAMES = {SCAFFOLD: "scaffold", ID: "id", SCORE: "score", TERM: "term"}
+# a token spanning several classes takes the highest-priority one
+_PRIORITY = {SCAFFOLD: 0, TERM: 1, ID: 2, SCORE: 3}
+
+# id value characters: after `"review_id" : "` up to the closing quote (or end of text)
+_ID_RE = re.compile(r'"review_id"\s*:\s*"([^"\\]*)')
+# score value characters: optional opening quote, then numeric characters
+_SCORE_RE = re.compile(r'"score"\s*:\s*"?([-+0-9.eE]+)')
+
+
+def _term_positions(text: str):
+    """List-termination characters (class TERM): the '}' that closes a top-level element
+    object, the ',' that separates top-level elements, and the ']' that closes the list
+    opened by the first '['. String-aware; on malformed JSON the depth count simply
+    continues. Nothing after the list close is TERM (trailing text is scaffold)."""
+    out = []
+    start = text.find("[")
+    if start < 0:
+        return out
+    depth, in_str, esc = 1, False, False
+    for i in range(start + 1, len(text)):
+        ch = text[i]
+        if in_str:
+            if esc:
+                esc = False
+            elif ch == "\\":
+                esc = True
+            elif ch == '"':
+                in_str = False
+            continue
+        if ch == '"':
+            in_str = True
+        elif ch in "{[":
+            depth += 1
+        elif ch in "}]":
+            if depth == 2 and ch == "}":
+                out.append(i)
+            if depth == 1 and ch == "]":
+                out.append(i)
+                break
+            depth -= 1
+        elif ch == "," and depth == 1:
+            out.append(i)
+    return out
+
+
+def char_classes(text: str):
+    """List[int] of length len(text): SCAFFOLD / ID / SCORE / TERM per character."""
+    cls = [SCAFFOLD] * len(text)
+    for i in _term_positions(text):
+        cls[i] = TERM
+    for m in _ID_RE.finditer(text):
+        for i in range(m.start(1), m.end(1)):
+            cls[i] = ID
+    for m in _SCORE_RE.finditer(text):
+        for i in range(m.start(1), m.end(1)):
+            cls[i] = SCORE
+    return cls
+
+
+def token_classes_from_spans(text: str, spans):
+    """Token class = highest-priority class among its characters (SCORE > ID > TERM > SCAFFOLD).
+
+    ``spans`` is a list of (char_start, char_end) per token. Zero-length spans are special
+    tokens (EOS) and are TERM: ending the sequence is part of the list-termination decision.
+    Returns (classes, n_straddle), n_straddle = tokens whose characters span >1 class.
+    """
+    cc = char_classes(text)
+    out = []
+    n_straddle = 0
+    for a, b in spans:
+        if b <= a:
+            out.append(TERM)
+            continue
+        seg = set(cc[a:b])
+        if len(seg) > 1:
+            n_straddle += 1
+        out.append(max(seg, key=_PRIORITY.__getitem__))
+    return out, n_straddle
