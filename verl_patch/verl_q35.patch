--- /dev/null
+++ b/verl/tests/q35/tiny_qwen35_padded_cpu.py
@@ -0,0 +1,117 @@
+"""CPU check (qwen35, D6): verl DataParallelPPOActor.compute_log_prob on a tiny random Qwen3.5
+(Qwen3_5ForConditionalGeneration: 3 GatedDeltaNet layers + 1 full-attention layer, small vision tower), padded
+batches (use_remove_padding=False), inputs built like the agent loop (4-row text+mrope position ids from the
+processor-bound get_rope_index), vs a plain HF forward of each sequence alone without padding.
+
+Checks: (1) the padded path equals the unpadded per-sequence forward (the linear-attention recurrence must not see
+left/right padding), (2) the 3 mrope rows equal the text row for text-only input.
+Usage: PYTHONPATH=<port tree> python tiny_qwen35_padded_cpu.py <dir with Qwen3.5 tokenizer+processor files>
+"""
+import os
+import sys
+import tempfile
+from types import SimpleNamespace
+
+import numpy as np
+import torch
+import torch.nn.functional as F
+
+tok_dir = sys.argv[1]
+torch.manual_seed(0)
+from transformers import AutoProcessor, AutoTokenizer  # noqa: E402
+from transformers.models.qwen3_5.configuration_qwen3_5 import Qwen3_5Config  # noqa: E402
+from transformers.models.qwen3_5.modeling_qwen3_5 import Qwen3_5ForConditionalGeneration  # noqa: E402
+
+import verl  # noqa: E402
+from hydra import compose, initialize_config_dir  # noqa: E402
+from omegaconf import open_dict  # noqa: E402
+
+from verl import DataProto  # noqa: E402
+from verl.experimental.agent_loop.agent_loop import AgentLoopWorker  # noqa: E402
+from verl.models.transformers.monkey_patch import apply_monkey_patch  # noqa: E402
+from verl.utils import hf_processor  # noqa: E402
+from verl.workers.actor.dp_actor import DataParallelPPOActor  # noqa: E402
+
+tok = AutoTokenizer.from_pretrained(tok_dir)
+V = 248320
+text_cfg = dict(vocab_size=V, hidden_size=64, intermediate_size=128, num_hidden_layers=4, num_attention_heads=4,
+                num_key_value_heads=2, head_dim=16, linear_num_key_heads=2, linear_num_value_heads=4,
+                linear_key_head_dim=16, linear_value_head_dim=16, linear_conv_kernel_dim=4,
+                layer_types=["linear_attention", "linear_attention", "linear_attention", "full_attention"],
+                full_attention_interval=4, max_position_embeddings=4096, tie_word_embeddings=True,
+                rope_parameters={"rope_type": "default", "rope_theta": 10000000, "partial_rotary_factor": 0.25,
+                                 "mrope_section": [1, 1, 0], "mrope_interleaved": True}, mtp_num_hidden_layers=0)
+vis_cfg = dict(depth=1, hidden_size=32, intermediate_size=64, num_heads=2, out_hidden_size=64, patch_size=16,
+               spatial_merge_size=2, temporal_patch_size=2, in_channels=3, num_position_embeddings=64,
+               deepstack_visual_indexes=[])
+cfg = Qwen3_5Config(text_config=text_cfg, vision_config=vis_cfg, image_token_id=248056, video_token_id=248057,
+                    vision_start_token_id=248053, vision_end_token_id=248054, tie_word_embeddings=True)
+cfg._attn_implementation = "eager"
+cfg.text_config._attn_implementation = "eager"
+cfg.vision_config._attn_implementation = "eager"
+model = Qwen3_5ForConditionalGeneration(cfg).float().eval()
+
+msgs = [[{"role": "system", "content": "judge"}, {"role": "user", "content": "rank these " * k}] for k in (3, 11, 6)]
+resps = [[91, 5, 17, 248046], [91, 7, 7, 7, 11, 13, 248046], [91, 248046]]
+prompts = [tok.apply_chat_template(m, add_generation_prompt=True, tokenize=True) for m in msgs]
+prompts = [p["input_ids"] if hasattr(p, "keys") else p for p in prompts]
+
+
+def ref_logp(p, r):
+    ids = torch.tensor([p + r])
+    with torch.no_grad():
+        lg = model(input_ids=ids, use_cache=False).logits[0].float()
+    lp = F.log_softmax(lg, -1)
+    return lp[len(p) - 1: len(p) + len(r) - 1].gather(-1, torch.tensor(r)[:, None])[:, 0]
+
+
+refs = [ref_logp(p, r) for p, r in zip(prompts, resps)]
+
+tmpf = tempfile.NamedTemporaryFile(delete=False)
+torch.distributed.init_process_group("gloo", rank=0, world_size=1, init_method=f"file://{tmpf.name}")
+cfg_dir = os.path.join(os.path.dirname(verl.__file__), "trainer", "config")
+with initialize_config_dir(config_dir=cfg_dir, version_base=None):
+    full = compose(config_name="ppo_trainer")
+rcfg = full.actor_rollout_ref.ref
+with open_dict(rcfg):
+    rcfg.use_remove_padding = False
+    rcfg.use_fused_kernels = False
+    rcfg.use_torch_compile = False
+    rcfg.fsdp_config.dtype = "float32"  # autocast in fp32 so the comparison isolates padding, not bf16 rounding
+apply_monkey_patch(model=model, use_remove_padding=False, ulysses_sp_size=1, use_fused_kernels=False)
+import verl.utils.torch_functional as vtf  # noqa: E402
+
+vtf.FLAH_ATTN_CROSS_ENTROPY_LOSS_AVAILABLE = False
+actor = DataParallelPPOActor(config=rcfg, actor_module=model)
+proc = hf_processor(tok_dir)
+PL, RL = max(map(len, prompts)), max(map(len, resps))
+bs = len(prompts)
+input_ids = torch.full((bs, PL + RL), tok.pad_token_id, dtype=torch.long)
+attn = torch.zeros((bs, PL + RL), dtype=torch.long)
+for i, (p, r) in enumerate(zip(prompts, resps)):
+    input_ids[i, PL - len(p):PL] = torch.tensor(p)
+    attn[i, PL - len(p):PL] = 1
+    input_ids[i, PL:PL + len(r)] = torch.tensor(r)
+    attn[i, PL:PL + len(r)] = 1
+stub = SimpleNamespace(processor=proc, tokenizer=tok)
+pos, mmis = [], []
+for i in range(bs):
+    mmi = AgentLoopWorker._compute_multi_modal_inputs(stub, SimpleNamespace(multi_modal_data={}), input_ids[i:i + 1])
+    pos.append(AgentLoopWorker._compute_position_ids(stub, input_ids[i:i + 1], attn[i:i + 1], mmi))
+    mmis.append(mmi)
+position_ids = torch.cat(pos, 0)
+vm = attn.bool()
+mrope_ok = all(torch.equal(position_ids[:, r][vm], position_ids[:, 0][vm]) for r in (1, 2, 3))
+dp = DataProto.from_single_dict({"input_ids": input_ids, "attention_mask": attn, "position_ids": position_ids,
+                                 "responses": input_ids[:, PL:].clone()})
+dp.non_tensor_batch["multi_modal_inputs"] = np.array(mmis, dtype=object)
+dp.meta_info.update({"micro_batch_size": 3, "temperature": 1.0, "use_dynamic_bsz": False, "max_token_len": 16384,
+                     "pad_token_id": tok.pad_token_id})
+with torch.no_grad():
+    lp = actor.compute_log_prob(data=dp, calculate_entropy=False)["log_probs"].float()
+worst = max((lp[i, :len(r)] - refs[i]).abs().max().item() for i, r in enumerate(resps))
+print(f"position_ids {tuple(position_ids.shape)}; mrope rows == text row on valid positions: {mrope_ok}")
+print(f"verl padded (use_remove_padding=False) vs HF per-sequence unpadded: max |dlogp| = {worst:.3e} (fp32, CPU)")
+ok = mrope_ok and worst < 1e-4
+print("PASS" if ok else "FAIL")
+sys.exit(0 if ok else 1)
