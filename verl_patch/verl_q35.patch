+"""Driver-side ERROPD hook tests on real tokenized model outputs (CPU).
+
+  PYTHONPATH=<G-OPD-erropd>/verl ERROPD_TOKENIZER=<student SFT dir> \
+  ERROPD_EVAL_SCRIPT=<erropd>/scripts/eval_listwise_offline.py python test_hooks.py
+
+hook_cases.json holds synthetic cases with made-up item ids and scores (valid, duplicate_id, premature_close,
+hallucinated_id, malformed_json, extra_item, and a prompt with duplicate input ids).
+"""
+
+import ast
+import inspect
+import json
+import math
+import os
+import sys
+import tempfile
+
+import numpy as np
+import torch
+from omegaconf import OmegaConf
+
+from verl import DataProto
+from verl.erropd import listwise_contract as lc
+from verl.erropd.hooks import ErropdHooks
+
+HERE = os.path.dirname(os.path.abspath(__file__))
+RESULTS = []
+# PAPER_LOSS_MODE is required (always explicit); every test below runs in opd mode unless it says otherwise (T17)
+os.environ["PAPER_LOSS_MODE"] = "opd"
+
+
+def check(name, cond, detail=""):
+    RESULTS.append((bool(cond), name, detail))
+    print(f"{'PASS' if cond else 'FAIL'}  {name} {detail}", flush=True)
+
+
+from transformers import AutoTokenizer  # noqa: E402
+
+TOK = AutoTokenizer.from_pretrained(os.environ["ERROPD_TOKENIZER"])
+CASES = json.load(open(os.path.join(HERE, "hook_cases.json")))
+EOS = TOK.eos_token_id
+PAD = TOK.pad_token_id if TOK.pad_token_id is not None else EOS
+
+
+def make_batch(cases, seed=0, L=None):
+    ids = [TOK(c["text"], add_special_tokens=False)["input_ids"] + [EOS] for c in cases]
+    L = L or max(len(x) for x in ids) + 3
+    bs = len(cases)
+    resp = torch.full((bs, L), PAD, dtype=torch.long)
+    mask = torch.zeros(bs, L)
+    for i, x in enumerate(ids):
+        resp[i, :len(x)] = torch.tensor(x)
+        mask[i, :len(x)] = 1
+    g = torch.Generator().manual_seed(seed)
+    d = {
+        "responses": resp, "response_mask": mask,
+        "old_log_probs": -2.0 * torch.rand(bs, L, generator=g),
+        "ref_log_prob": -2.0 * torch.rand(bs, L, generator=g),
+        "base_log_prob": -2.0 * torch.rand(bs, L, generator=g),
+        "advantages": torch.zeros(bs, L),
+    }
+    # make some tokens teacher~student close so REOPD q is non-trivial
+    d["ref_log_prob"][:, ::3] = d["old_log_probs"][:, ::3] + 0.01
+    extra = np.array([{"K": c["K"], "review_ids": list(c["review_ids"]), "index": i} for i, c in enumerate(cases)],
+                     dtype=object)
+    dp = DataProto.from_single_dict({**d, "extra_info": extra})
+    return dp, ids
+
+
+def make_cfg(erropd, lam=1.4, world=2, micro=2):
+    return OmegaConf.create({
+        "actor_rollout_ref": {"actor": {
+            "policy_loss": {"lambda_vals": lam, "only_reverse_kl_advantages": True, "multi_teacher_distill": False},
+            "ppo_epochs": 1, "ppo_micro_batch_size_per_gpu": micro, "use_dynamic_bsz": False}},
+        "trainer": {"default_local_dir": tempfile.mkdtemp(), "n_gpus_per_node": world, "nnodes": 1},
+        "erropd": erropd,
+    })
+
+
+def snapshot(dp):
+    return ({k: v.clone() for k, v in dp.batch.items()},
+            {k: v.copy() for k, v in dp.non_tensor_batch.items()}, dict(dp.meta_info))
+
+
+# ---------------------------------------------------------------- T0 verbatim parser
+src_eval = open(os.environ["ERROPD_EVAL_SCRIPT"]).read()
+fn = [n for n in ast.parse(src_eval).body if isinstance(n, ast.FunctionDef) and n.name == "parse_score_list"][0]
+eval_src = ast.get_source_segment(src_eval, fn)
+check("T0 parse_score_list source is byte-identical to the eval script's", inspect.getsource(lc.parse_score_list).rstrip() == eval_src.rstrip())
+
+# ---------------------------------------------------------------- T1 flags off
+dp, ids = make_batch(CASES)
+before = snapshot(dp)
+hooks = ErropdHooks(make_cfg({}), TOK)
+metrics = {}
+out = hooks.on_batch(dp, 1, metrics)
+check("T1 flags-off returns the same batch object", out is dp)
+check("T1 flags-off: tensor key set unchanged", set(dp.batch.keys()) == set(before[0].keys()))
+check("T1 flags-off: every tensor bitwise unchanged", all(torch.equal(dp.batch[k], before[0][k]) for k in before[0]))
+check("T1 flags-off: non-tensor batch unchanged", dp.non_tensor_batch.keys() == before[1].keys())
+check("T1 flags-off: meta_info adds only erropd_log_update_norm and the loss-mode stamp paper_loss_mode=opd",
+      set(dp.meta_info) - set(before[2]) == {"erropd_log_update_norm", "paper_loss_mode"}
+      and dp.meta_info["paper_loss_mode"] == "opd")
+n_valid = sum(lc.strict_valid(c["text"], c["K"], c["review_ids"]) for c in CASES)
+check("T1 rollout validity = verbatim parser on the cases", math.isclose(metrics["erropd/rollout_valid_frac_sampled"], n_valid / len(CASES)),
+      f"({metrics['erropd/rollout_valid_frac_sampled']} vs {n_valid}/{len(CASES)})")
+n_elig = sum(lc.prompt_eligible(c["K"], c["review_ids"]) for c in CASES)
+check("T1 eligible count", metrics["erropd/n_eligible"] == n_elig, f"({n_elig})")
+check("T1 decoder used the byte-level fast path (no fallback)", metrics["erropd/decode_fallbacks_cum"] == 0)
+_dpv, _ = make_batch([c for c in CASES if c["expect"] == "valid"])
+_mv = {}
+ErropdHooks(make_cfg({}), TOK).on_batch(_dpv, 1, _mv)
+check("T1 no straddling tokens on parser-valid outputs", _mv["erropd/straddle_token_frac"] == 0.0,
+      f"(valid: {_mv['erropd/straddle_token_frac']}; all cases incl. malformed: {metrics['erropd/straddle_token_frac']:.4f})")
+# advantage metric recomputation (lambda=1.4 everywhere)
+bk = dp.batch
+adv = torch.where(torch.full_like(bk["ref_log_prob"], 1.4) == 1.0, bk["ref_log_prob"] - bk["old_log_probs"],
+                  (bk["ref_log_prob"] - bk["base_log_prob"]) * 1.4 - (bk["old_log_probs"] - bk["base_log_prob"]))
+m = bk["response_mask"]
+check("T1 erropd/adv_mean/all matches manual lambda=1.4 advantage",
+      math.isclose(metrics["erropd/adv_mean/all"], float((adv * m).sum() / m.sum()), rel_tol=1e-6))
+
+# ---------------------------------------------------------------- T2 per-rollout analysis
+cls, recs, lengths, _, _ = hooks.analyze(dp)
+for c, r, x in zip(CASES, recs, ids):
+    key = "valid" if r["status"] == lc.VALID else "ineligible" if r["status"] == lc.INELIGIBLE else r["vtype"]
+    check(f"T2 [{c['expect']}] status/vtype", key == c["expect"], f"(got {key})")
+    check(f"T2 [{c['expect']}] decoded text == eval text", r["text"] == c["text"])
+    if r["viol_tok"] is not None:
+        _, spans = hooks.decoder.decode(x)
+        a, b = spans[r["viol_tok"]]
+        check(f"T2 [{c['expect']}] violation token span contains the violation char", a <= r["viol_char"] < b,
+              f"(tok {r['viol_tok']} span {a}:{b} char {r['viol_char']} {c['text'][r['viol_char']]!r})")
+# class content check on a valid case: score-class tokens spell the scores, id-class tokens spell the ids
+i0 = [i for i, c in enumerate(CASES) if c["expect"] == "valid"][0]
+text0, spans0 = hooks.decoder.decode(ids[i0])
+score_chars = "".join(text0[a:b] for (a, b), k in zip(spans0, cls[i0].tolist()) if k == lc.SCORE)
+id_chars = "".join(text0[a:b] for (a, b), k in zip(spans0, cls[i0].tolist()) if k == lc.ID)
+arr = json.loads(text0[text0.index("["):text0.rindex("]") + 1])
+check("T2 id-class tokens spell exactly the review_id values", id_chars == "".join(o["review_id"] for o in arr))
+exp_scores = "".join(m.group(1) for m in lc._SCORE_RE.finditer(text0))
+check("T2 score-class tokens spell exactly the score values", score_chars == exp_scores, f"({score_chars[:30]}...)")
+check("T2 EOS token is term", cls[i0, len(ids[i0]) - 1].item() == lc.TERM)
+term_chars = "".join(text0[a:b] for (a, b), k in zip(spans0, cls[i0].tolist()) if k == lc.TERM)
+check("T2 term-class tokens are exactly the 7 item terminators '},' + the list close '}]' (+ zero-width EOS)",
+      term_chars.replace(" ", "") == "}," * 7 + "}]", f"({term_chars!r})")
+ipc = [i for i, c in enumerate(CASES) if c["expect"] == "premature_close"][0]
+textp, spansp = hooks.decoder.decode(ids[ipc])
+vt = recs[ipc]["viol_tok"]
+check("T2 premature_close: the violating token is a term token", cls[ipc, vt].item() == lc.TERM,
+      f"({textp[spansp[vt][0]:spansp[vt][1]]!r})")
+
+# ---------------------------------------------------------------- T3 class-selective lambda
+for mode, sel in (("only_score", {lc.SCORE}), ("only_id", {lc.ID}), ("only_term", {lc.TERM}),
+                  ("all_but_term", {lc.SCAFFOLD, lc.ID, lc.SCORE}), ("only_scaffold", {lc.SCAFFOLD}),
+                  ("all_but_scaffold", {lc.ID, lc.SCORE, lc.TERM}), ("id_score", {lc.ID, lc.SCORE})):
+    dp, _ = make_batch(CASES)
+    h = ErropdHooks(make_cfg({"token_class_lambda": mode}), TOK)
+    h.on_batch(dp, 1, {})
+    tl = dp.batch["erropd_token_lambda"]
+    rm = dp.batch["response_mask"] > 0
+    selm = torch.zeros_like(rm)
+    for c_ in sel:
+        selm |= cls == c_
+    exp = torch.where(selm & rm, torch.full_like(tl, 1.4), torch.ones_like(tl))
+    check(f"T3 {mode}: tl = 1.4 exactly on selected classes, 1.0 elsewhere (incl. padding)", torch.equal(tl, exp))
+    check(f"T3 {mode}: no loss mask tensor", "erropd_loss_mask" not in dp.batch.keys())
+    check(f"T3 {mode}: expect-ack set", dp.meta_info.get("erropd_expect_ack") is True)
+
+# ---------------------------------------------------------------- T4/T5 masks
+dp, _ = make_batch(CASES)
+h = ErropdHooks(make_cfg({"mask": "invalid_rollout"}), TOK)
+mt = {}
+h.on_batch(dp, 1, mt)
+lm = dp.batch["erropd_loss_mask"]
+check("T4 b1: rows zeroed exactly for rollouts failing the parser",
+      all((lm[i] == 0).all().item() == (not r["valid"]) and (lm[i] == 1).all().item() == r["valid"] for i, r in enumerate(recs)))
+check("T4 b1: no token-lambda tensor (scalar lambda path)", "erropd_token_lambda" not in dp.batch.keys())
+check("T4 b1: kept_rollouts = #valid", mt["erropd/kept_rollouts"] == n_valid)
+dp, _ = make_batch(CASES)
+h = ErropdHooks(make_cfg({"mask": "after_violation"}), TOK)
+h.on_batch(dp, 1, {})
+lm = dp.batch["erropd_loss_mask"]
+ok = True
+for i, r in enumerate(recs):
+    if r["status"] == lc.VIOLATION:
+        v = r["viol_tok"]
+        ok &= bool((lm[i, :v + 1] == 1).all()) and bool((lm[i, v + 1:] == 0).all())
+    else:
+        ok &= bool((lm[i] == 1).all())
+check("T5 b2: tokens <= violation token kept, tokens after it zeroed; no-violation rows untouched", ok)
+ip = [i for i, c in enumerate(CASES) if c["expect"] == "premature_close"][0]
+n_masked_pc = int(((lm[ip] == 0) & (dp.batch["response_mask"][ip] > 0)).sum())
+check("T5 b' (after_violation) on premature_close masks only what follows ']' (the EOS)", n_masked_pc == 1,
+      f"(masked real tokens: {n_masked_pc})")
+dp, _ = make_batch(CASES)
+h = ErropdHooks(make_cfg({"mask": "from_violation"}), TOK)
+h.on_batch(dp, 1, {})
+lm = dp.batch["erropd_loss_mask"]
+ok = True
+for i, r in enumerate(recs):
+    if r["status"] == lc.VIOLATION:
+        v = r["viol_tok"]
+        ok &= bool((lm[i, :v] == 1).all()) and bool((lm[i, v:] == 0).all())
+    else:
+        ok &= bool((lm[i] == 1).all())
+check("T5 b (from_violation): tokens < violation token kept, violation token and later zeroed", ok)
+n_masked_pc = int(((lm[ip] == 0) & (dp.batch["response_mask"][ip] > 0)).sum())
+check("T5 b on premature_close masks the '}]' token and the EOS", n_masked_pc == 2, f"(masked real tokens: {n_masked_pc})")
+
+# ---------------------------------------------------------------- T6 schedule
+h = ErropdHooks(make_cfg({"lambda_schedule": [[1, 1.0], [3, 1.25]]}), TOK)
+check("T6 schedule lambda(1,2,3,10) = 1.0,1.0,1.25,1.25",
+      [h.lambda_for_step(s)[0] for s in (1, 2, 3, 10)] == [1.0, 1.0, 1.25, 1.25])
+dp, _ = make_batch(CASES)
+h.on_batch(dp, 2, {})
+check("T6 step 2: tl all ones", torch.equal(dp.batch["erropd_token_lambda"], torch.ones_like(dp.batch["erropd_token_lambda"])))
+dp, _ = make_batch(CASES)
+h.on_batch(dp, 3, {})
+rm = dp.batch["response_mask"] > 0
+tl = dp.batch["erropd_token_lambda"]
+check("T6 step 3: tl = 1.25 on all response tokens, 1.0 on padding",
+      torch.equal(tl, torch.where(rm, torch.full_like(tl, 1.25), torch.ones_like(tl))))
+
+# ---------------------------------------------------------------- T7 gate
+valid_cases = [c for c in CASES if c["expect"] == "valid"] * 4
+h = ErropdHooks(make_cfg({"gate_tau": 0.5}), TOK)
+seq = []
+for step, cs in ((1, CASES), (2, valid_cases), (3, CASES), (4, CASES)):
+    dp, _ = make_batch(cs)
+    mm = {}
+    h.on_batch(dp, step, mm)
+    seq.append((mm["erropd/lambda_step"], mm["erropd/gate_open"], round(mm["erropd/gate_estimate_prev"], 4)))
+# step1: no prev -> 1.0 closed; step2: prev = 2/7 < .5 -> 1.0; step3: prev = 1.0 -> 1.4; step4: prev = 2/7 -> 1.0
+check("T7 gate sequence (lambda, open, prev estimate)",
+      [s[:2] for s in seq] == [(1.0, 0.0), (1.0, 0.0), (1.4, 1.0), (1.0, 0.0)], f"{seq}")
+
+# ---------------------------------------------------------------- T8 REOPD
+dp, _ = make_batch(CASES)
+h = ErropdHooks(make_cfg({"reopd": True}, lam=1.4, world=2, micro=2), TOK)
+check("T8 REOPD groups follow actor layout (world=2, micro=2, bs=8)", h.micro_groups(8) == [[0, 1, 4, 5], [2, 3, 6, 7]])
+bk = {k: v.clone() for k, v in dp.batch.items()}
+mm = {}
+h.on_batch(dp, 1, mm)
+tl = dp.batch["erropd_token_lambda"].double()
+
+
+def reopd_ref(old, ref, base, mask, groups, tau=0.007, gmax=0.4, kappa=0.5, beta=0.95, bg=0.9, k0=10):
+    st = dict(calls=0, b0=0.0, B0=None, rho=None, s=None, g=0.0)
+    out = torch.ones_like(old, dtype=torch.float64)
+    for rows in groups:
+        mm_ = mask[rows].double()
+        x = (ref[rows] - old[rows]).double()
+        r = (ref[rows] - base[rows]).double()
+        q = torch.exp(-(torch.exp(x) - x - 1) / tau)
+        st["calls"] += 1
+        if st["calls"] <= k0:
+            st["b0"] += math.sqrt(float((mm_ * x * x).sum() / mm_.sum()))
+            st["B0"] = kappa * st["b0"] / st["calls"]
+        rho = float((mm_ * r.abs() * q).sum() / ((mm_ * r.abs()).sum() + 1e-8))
+        s = math.sqrt(float((mm_ * (q * r) ** 2).sum() / (mm_.sum() + 1e-8)))
+        st["rho"] = rho if st["rho"] is None else beta * st["rho"] + (1 - beta) * rho
+        st["s"] = s if st["s"] is None else beta * st["s"] + (1 - beta) * s
+        gt = min(max(st["B0"] * st["rho"] / (st["s"] + 1e-8), 0.0), gmax)
+        st["g"] = bg * st["g"] + (1 - bg) * gt
+        out[rows] = torch.where(mm_ > 0, 1 + st["g"] * q, torch.ones_like(q))
+    return out
+
+
+exp = reopd_ref(bk["old_log_probs"], bk["ref_log_prob"], bk["base_log_prob"], bk["response_mask"], [[0, 1, 4, 5], [2, 3, 6, 7]])
+check("T8 REOPD tl matches independent Eq.4-12 recomputation (fp32 cast)", torch.equal(tl.float(), exp.float()),
+      f"(max diff {float((tl - exp).abs().max()):.2e}; gamma={mm['erropd/reopd_gamma_last']:.4f} q_mean={mm['erropd/reopd_q_mean']:.3f})")
+rm = dp.batch["response_mask"] > 0
+check("T8 REOPD 1 <= tl <= 1 + gamma_max(=lambda_max-1=0.4)", bool((tl >= 1).all()) and bool((tl <= 1.4 + 1e-6).all()))
+check("T8 REOPD controller calls = 2 per step", mm["erropd/reopd_calls_cum"] == 2)
+
+# ---------------------------------------------------------------- T9 budget stop
+h = ErropdHooks(make_cfg({"mask": "invalid_rollout", "stop_after_kept_rollouts": 10}), TOK)
+stops = []
+for step in range(1, 7):
+    dp, _ = make_batch(CASES)
+    h.on_batch(dp, step, {})
+    stops.append(h.stop_now)
+check("T9 budget: 2 kept/step, target 10 -> stop flagged at step 5", stops == [False] * 4 + [True, True], f"{stops}")
+
+# ---------------------------------------------------------------- T10 ack
+dp, _ = make_batch(CASES)
+h = ErropdHooks(make_cfg({"token_class_lambda": "only_score"}), TOK)
+h.on_batch(dp, 1, {})
+try:
+    h.check_ack(dp, {"actor/pg_loss": 0.0})
+    raised = False
+except RuntimeError:
+    raised = True
+check("T10 missing actor ack raises (wrong verl tree guard)", raised)
+h.check_ack(dp, {"erropd/actor_ack": 1.0})
+check("T10 ack present: erropd tensors dropped after update", "erropd_token_lambda" not in dp.batch.keys())
+
+# ---------------------------------------------------------------- T11 Hydra overrides on the real trainer config
+import verl  # noqa: E402
+from hydra import compose, initialize_config_dir  # noqa: E402
+
+cfg_dir = os.path.join(os.path.dirname(verl.__file__), "trainer", "config")
+with initialize_config_dir(config_dir=cfg_dir, version_base=None):
+    full = compose(config_name="ppo_trainer", overrides=[
+        "actor_rollout_ref.actor.policy_loss.only_reverse_kl_advantages=True",
+        "actor_rollout_ref.actor.policy_loss.lambda_vals=1.25",
+        "actor_rollout_ref.actor.ppo_micro_batch_size_per_gpu=2",
+        f"trainer.default_local_dir={tempfile.mkdtemp()}",
+        "trainer.total_training_steps=62",
+        "+erropd.lambda_schedule=[[1,1.0],[21,1.25]]",
+        "+erropd.save_steps=[48,62]",
+        "+erropd.dump_rollouts=true",
+    ])
+h = ErropdHooks(full, TOK)
+check("T11 Hydra: schedule parsed", h.schedule == [(1, 1.0), (21, 1.25)], f"{h.schedule}")
+check("T11 Hydra: save_steps parsed", h.save_steps == {48, 62})
+check("T11 Hydra: C1 lambda at steps 20/21/62", [h.lambda_for_step(s)[0] for s in (20, 21, 62)] == [1.0, 1.25, 1.25])
+check("T11 Hydra: total_training_steps is a live key", full.trainer.total_training_steps == 62)
+with initialize_config_dir(config_dir=cfg_dir, version_base=None):
+    full2 = compose(config_name="ppo_trainer", overrides=[
+        "actor_rollout_ref.actor.policy_loss.only_reverse_kl_advantages=True",
+        "actor_rollout_ref.actor.policy_loss.lambda_vals=1.40",
+        f"trainer.default_local_dir={tempfile.mkdtemp()}",
+        "+erropd.lambda_warmup_steps=20", "+erropd.lambda_warmup_value=1.0", "+erropd.save_steps=20x48x62",
+    ])
+h = ErropdHooks(full2, TOK)
+check("T11 Hydra: bracket-free warm-up shorthand -> [(1,1.0),(21,1.40)]", h.schedule == [(1, 1.0), (21, 1.4)], f"{h.schedule}")
+check("T11 Hydra: bracket-free save_steps '20x48x62'", h.save_steps == {20, 48, 62}, f"{h.save_steps}")
+
+# ---------------------------------------------------------------- T17 PAPER_LOSS_MODE driver handshake
+def _raises(fn, exc):
+    try:
+        fn()
+        return False
+    except exc:
+        return True
+
+
+for _v in (None, "", "OPD", "fkl"):
+    if _v is None:
+        os.environ.pop("PAPER_LOSS_MODE", None)
+    else:
+        os.environ["PAPER_LOSS_MODE"] = _v
+    check(f"T17 hooks refuse PAPER_LOSS_MODE={_v!r} (always explicit: opd | fkl_sampled)",
+          _raises(lambda: ErropdHooks(make_cfg({}), TOK), ValueError))
+os.environ["PAPER_LOSS_MODE"] = "opd"
+dpo, _ = make_batch(CASES)
+ho = ErropdHooks(make_cfg({}), TOK)
+ho.pre_ref(dpo)
+check("T17 opd: pre_ref requests nothing", "paper_need_ref_sample" not in dpo.meta_info)
+ho.post_ref(dpo)
+keys0 = set(dpo.batch.keys())
+mo = {}
+outo = ho.on_batch(dpo, 1, mo)
+check("T17 opd: on_batch stamps meta paper_loss_mode=opd, batch tensors unchanged, no paper/ metric",
+      outo is dpo and dpo.meta_info.get("paper_loss_mode") == "opd" and set(dpo.batch.keys()) == keys0
+      and not any(k.startswith("paper/") for k in mo))
+check("T17 opd: check_ack refuses an actor that ran the fkl loss",
+      _raises(lambda: ho.check_ack(dpo, {"paper/fkl_ce": 1.0}), RuntimeError))
+ho.check_ack(dpo, {"actor/pg_loss": 0.0})
+check("T17 opd: check_ack clears the mode stamp", "paper_loss_mode" not in dpo.meta_info)
+os.environ["PAPER_LOSS_MODE"] = "fkl_sampled"
+try:
+    dpf, _ = make_batch(CASES)
+    hf = ErropdHooks(make_cfg({}), TOK)
+    check("T17 fkl: hooks construct in fkl_sampled mode, inactive (no ERROPD tensors)", hf.fkl and not hf.active)
+    hf.pre_ref(dpf)
+    check("T17 fkl: pre_ref requests teacher samples", dpf.meta_info.get("paper_need_ref_sample") is True)
+    check("T17 fkl: post_ref refuses a teacher pass without ref_sampled_token",
+          _raises(lambda: hf.post_ref(dpf), RuntimeError))
+    check("T17 fkl: post_ref clears the request flag", "paper_need_ref_sample" not in dpf.meta_info)
+    check("T17 fkl: on_batch refuses a batch without ref_sampled_token",
+          _raises(lambda: hf.on_batch(dpf, 1, {}), RuntimeError))
+    dpf.batch["ref_sampled_token"] = dpf.batch["responses"].clone()
+    hf.post_ref(dpf)
+    mf = {}
+    hf.on_batch(dpf, 1, mf)
+    check("T17 fkl: on_batch stamps meta paper_loss_mode=fkl_sampled",
+          dpf.meta_info.get("paper_loss_mode") == "fkl_sampled")
+    check("T17 fkl: teacher-sample agreement logged (1.0 when the samples equal the student's tokens)",
+          mf.get("paper/fkl_teacher_eq_student") == 1.0 and mf.get("paper/fkl_teacher_eq_student_term") == 1.0)
+    check("T17 fkl: out-of-tokenizer sample share logged (0.0 on the student's own tokens)",
+          mf.get("paper/fkl_sample_oov_frac") == 0.0)
+    _rs = dpf.batch["responses"]
+    _alt = torch.where(torch.arange(_rs.shape[1])[None, :] % 2 == 0, _rs, (_rs + 1) % len(TOK))
+    dpf.batch["ref_sampled_token"] = _alt
+    mf2 = {}
+    hf.on_batch(dpf, 2, mf2)
+    _rm = dpf.batch["response_mask"]
+    _exp = float(((_alt == _rs).float() * _rm).sum() / _rm.sum())
+    check("T17 fkl: agreement == independent count on a half-disagreeing sample",
+          abs(mf2.get("paper/fkl_teacher_eq_student", -1) - _exp) < 1e-12, f"({mf2.get('paper/fkl_teacher_eq_student')} vs {_exp})")
+    _o = _rs.clone()
+    _o[:, 0] = len(TOK) + 5
+    dpf.batch["ref_sampled_token"] = _o
+    mf3 = {}
+    hf.on_batch(dpf, 3, mf3)
+    _e3 = float((_rm[:, 0]).sum() / _rm.sum())
+    check("T17 fkl: out-of-tokenizer share == independent count (first position of every row out of range)",
+          abs(mf3.get("paper/fkl_sample_oov_frac", -1) - _e3) < 1e-12, f"({mf3.get('paper/fkl_sample_oov_frac')} vs {_e3})")
+    check("T17 fkl: missing actor fkl metric raises (no silent fallback to OPD)",
+          _raises(lambda: hf.check_ack(dpf, {"actor/pg_loss": 0.0}), RuntimeError))
+    hf.check_ack(dpf, {"paper/fkl_ce": 1.0})
+    for _ov in ({"token_class_lambda": "only_term"}, {"mask": "invalid_rollout"}, {"gate_tau": 0.9},
+                {"lambda_warmup_steps": 20}, {"reopd": True}):
+        check(f"T17 fkl: combining with ERROPD intervention {_ov} is refused",
+              _raises(lambda: ErropdHooks(make_cfg(_ov), TOK), ValueError))
+    _c = make_cfg({})
+    _c.actor_rollout_ref.actor.use_kl_loss = True
+    _c.actor_rollout_ref.actor.kl_loss_coef = 0.001
+    check("T17 fkl: a nonzero kl_loss_coef is refused", _raises(lambda: ErropdHooks(_c, TOK), ValueError))
+    _c = make_cfg({})
+    _c.trainer.use_legacy_worker_impl = "disable"
+    check("T17 fkl: the non-legacy worker path is refused", _raises(lambda: ErropdHooks(_c, TOK), ValueError))
+    _c = make_cfg({})
+    _c.actor_rollout_ref.actor.use_kl_loss = True
+    _c.actor_rollout_ref.actor.kl_loss_coef = 0.0
+    _c.trainer.use_legacy_worker_impl = "enable"
+    ErropdHooks(_c, TOK)
+    check("T17 fkl: the production config (use_kl_loss with coef 0, legacy workers) is accepted", True)
+finally:
+    os.environ["PAPER_LOSS_MODE"] = "opd"
+
+# write_step keeps paper/ metrics and actor/kl_loss
+_h = ErropdHooks(make_cfg({}), TOK)
+_h.write_step(3, {"paper/fkl_ce": 0.5, "actor/kl_loss": 0.0, "erropd/x": 1.0, "other/y": 2.0})
+_rec = [json.loads(x) for x in open(os.path.join(_h.log_dir, "erropd_step_metrics.jsonl"))][-1]
+check("T17 write_step records paper/ metrics and actor/kl_loss (and still drops unrelated keys)",
+      _rec.get("paper/fkl_ce") == 0.5 and _rec.get("actor/kl_loss") == 0.0 and "other/y" not in _rec)
+
+n_fail = sum(not ok for ok, _, _ in RESULTS)
+print(f"\n{len(RESULTS) - n_fail} passed, {n_fail} failed")
+sys.exit(1 if n_fail else 0)
