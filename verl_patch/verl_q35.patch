@@ -0,0 +1,258 @@
+"""CPU check (PAPER_LOSS_MODE=fkl_sampled on the Qwen3.5 path): a tiny random Qwen3.5
+(Qwen3_5ForConditionalGeneration: 3 GatedDeltaNet layers + 1 full-attention layer, small vision tower), padded batches
+(use_remove_padding=False, the path every Qwen3.5 run uses), inputs built like the agent loop (4-row mrope position ids,
+processor multi_modal_inputs), fp32 (so the checks isolate the code path, not bf16 rounding).
+
+Teacher pass (DataParallelPPOActor.compute_log_prob, ref config):
+  T1  requesting teacher samples leaves the log-probs bitwise unchanged
+  T2  at temperature 1e-6 the sample is the argmax of the logits of a plain HF forward on the same padded inputs at
+      every valid response position (exact), and of the per-sequence unpadded forward up to 1e-4 in logit
+  T3  samples at T=1: int64, in vocabulary, response-shaped
+Actor pass (label override, _forward_micro_batch):
+  A1  log p(label | prompt, student prefix) == plain HF padded forward with verl's log-prob primitive (<= 1e-6)
+      and per-sequence unpadded forward, log-softmax gather (<= 1e-4)
+Update (update_policy, PAPER_LOSS_MODE=fkl_sampled, SGD, micro-batch 1, grad accumulation 3, clip 1.0):
+  U1  with the student's own tokens as teacher samples: per-micro-batch loss and updated parameters == an independent
+      plain-SFT step (plain HF forward on the same padded inputs, masked token-mean CE; no verl actor code)
+  U2  with random tokens: == independent CE step on them
+Usage: PYTHONPATH=<tree> python tiny_qwen35_fkl_cpu.py <dir with Qwen3.5 tokenizer+processor files>
+"""
+import copy
+import os
+import sys
+import tempfile
+from types import SimpleNamespace
+
+import numpy as np
+import torch
+import torch.nn.functional as F
+
+tok_dir = sys.argv[1]
+from transformers import AutoTokenizer  # noqa: E402
+from transformers.models.qwen3_5.configuration_qwen3_5 import Qwen3_5Config  # noqa: E402
+from transformers.models.qwen3_5.modeling_qwen3_5 import Qwen3_5ForConditionalGeneration  # noqa: E402
+
+import verl  # noqa: E402
+from hydra import compose, initialize_config_dir  # noqa: E402
+from omegaconf import open_dict  # noqa: E402
+
+from verl import DataProto  # noqa: E402
+from verl.experimental.agent_loop.agent_loop import AgentLoopWorker  # noqa: E402
+from verl.models.transformers.monkey_patch import apply_monkey_patch  # noqa: E402
+from verl.utils import hf_processor  # noqa: E402
+from verl.utils.config import omega_conf_to_dataclass  # noqa: E402
+from verl.workers.actor.dp_actor import DataParallelPPOActor  # noqa: E402
+import verl.utils.torch_functional as vtf  # noqa: E402
+
+vtf.FLAH_ATTN_CROSS_ENTROPY_LOSS_AVAILABLE = False
+RES = []
+
+
+def check(name, cond, detail=""):
+    RES.append(bool(cond))
+    print(f"{'PASS' if cond else 'FAIL'}  {name} {detail}", flush=True)
+
+
+tok = AutoTokenizer.from_pretrained(tok_dir)
+V = 248320
+text_cfg = dict(vocab_size=V, hidden_size=64, intermediate_size=128, num_hidden_layers=4, num_attention_heads=4,
+                num_key_value_heads=2, head_dim=16, linear_num_key_heads=2, linear_num_value_heads=4,
+                linear_key_head_dim=16, linear_value_head_dim=16, linear_conv_kernel_dim=4,
+                layer_types=["linear_attention", "linear_attention", "linear_attention", "full_attention"],
+                full_attention_interval=4, max_position_embeddings=4096, tie_word_embeddings=True,
+                rope_parameters={"rope_type": "default", "rope_theta": 10000000, "partial_rotary_factor": 0.25,
+                                 "mrope_section": [1, 1, 0], "mrope_interleaved": True}, mtp_num_hidden_layers=0)
+vis_cfg = dict(depth=1, hidden_size=32, intermediate_size=64, num_heads=2, out_hidden_size=64, patch_size=16,
+               spatial_merge_size=2, temporal_patch_size=2, in_channels=3, num_position_embeddings=64,
+               deepstack_visual_indexes=[])
+cfg = Qwen3_5Config(text_config=text_cfg, vision_config=vis_cfg, image_token_id=248056, video_token_id=248057,
+                    vision_start_token_id=248053, vision_end_token_id=248054, tie_word_embeddings=True)
+cfg._attn_implementation = "eager"
+cfg.text_config._attn_implementation = "eager"
+cfg.vision_config._attn_implementation = "eager"
+
+
+def new_model():
+    torch.manual_seed(0)
+    m = Qwen3_5ForConditionalGeneration(cfg).float()
+    apply_monkey_patch(model=m, use_remove_padding=False, ulysses_sp_size=1, use_fused_kernels=False)
+    return m
+
+
+model = new_model().eval()
+msgs = [[{"role": "system", "content": "judge"}, {"role": "user", "content": "rank these " * k}] for k in (3, 11, 6)]
+resps = [[91, 5, 17, 248046], [91, 7, 7, 7, 11, 13, 248046], [91, 248046]]
+prompts = [tok.apply_chat_template(m, add_generation_prompt=True, tokenize=True) for m in msgs]
+prompts = [p["input_ids"] if hasattr(p, "keys") else p for p in prompts]
+
+tmpf = tempfile.NamedTemporaryFile(delete=False)
+torch.distributed.init_process_group("gloo", rank=0, world_size=1, init_method=f"file://{tmpf.name}")
+cfg_dir = os.path.join(os.path.dirname(verl.__file__), "trainer", "config")
+with initialize_config_dir(config_dir=cfg_dir, version_base=None):
+    full = compose(config_name="ppo_trainer")
+rcfg = full.actor_rollout_ref.ref
+with open_dict(rcfg):
+    rcfg.use_remove_padding = False
+    rcfg.use_fused_kernels = False
+    rcfg.use_torch_compile = False
+    rcfg.fsdp_config.dtype = "float32"
+proc = hf_processor(tok_dir)
+PL, RL = max(map(len, prompts)), max(map(len, resps))
+bs = len(prompts)
+input_ids = torch.full((bs, PL + RL), tok.pad_token_id, dtype=torch.long)
+attn = torch.zeros((bs, PL + RL), dtype=torch.long)
+for i, (p, r) in enumerate(zip(prompts, resps)):
+    input_ids[i, PL - len(p):PL] = torch.tensor(p)
+    attn[i, PL - len(p):PL] = 1
+    input_ids[i, PL:PL + len(r)] = torch.tensor(r)
+    attn[i, PL:PL + len(r)] = 1
+stub = SimpleNamespace(processor=proc, tokenizer=tok)
+pos, mmis = [], []
+for i in range(bs):
+    mmi = AgentLoopWorker._compute_multi_modal_inputs(stub, SimpleNamespace(multi_modal_data={}), input_ids[i:i + 1])
+    pos.append(AgentLoopWorker._compute_position_ids(stub, input_ids[i:i + 1], attn[i:i + 1], mmi))
+    mmis.append(mmi)
+position_ids = torch.cat(pos, 0)
+resp_mask = attn[:, PL:].clone().float()
+responses = input_ids[:, PL:].clone()
+
+
+def proto(temp, extra=None):
+    d = {"input_ids": input_ids, "attention_mask": attn, "position_ids": position_ids, "responses": responses}
+    d.update(extra or {})
+    dp = DataProto.from_single_dict(d)
+    dp.non_tensor_batch["multi_modal_inputs"] = np.array(mmis, dtype=object)
+    dp.meta_info.update({"micro_batch_size": 3, "temperature": temp, "use_dynamic_bsz": False, "max_token_len": 16384,
+                         "pad_token_id": tok.pad_token_id})
+    return dp
+
+
+def hf_padded_logits(m, rows):
+    """Plain HF forward on the padded inputs exactly as verl's padded path feeds them (mrope position ids
+    transposed to (4, bs, seq), processor multi_modal_inputs); response-position logits (bs, RL, V)."""
+    mm = {}
+    for i in rows:
+        for k, v in mmis[i].items():
+            mm.setdefault(k, []).append(v)
+    mm = {k: torch.cat(v, 0) for k, v in mm.items()}
+    out = m(input_ids=input_ids[rows], attention_mask=attn[rows], position_ids=position_ids[rows].transpose(0, 1),
+            **mm, use_cache=False)
+    return out.logits[:, -RL - 1:-1, :]
+
+
+def per_seq_logits(m, i):
+    ids = torch.tensor([prompts[i] + resps[i]])
+    lg = m(input_ids=ids, use_cache=False).logits[0].float()
+    return lg[len(prompts[i]) - 1: len(prompts[i]) + len(resps[i]) - 1]  # (len(r), V)
+
+
+# ---------------- teacher pass
+ref_actor = DataParallelPPOActor(config=rcfg, actor_module=model)
+with torch.no_grad():
+    lp0 = ref_actor.compute_log_prob(data=proto(1.0), calculate_entropy=False)["log_probs"]
+    o1 = ref_actor.compute_log_prob(data=proto(1.0), calculate_entropy=False, paper_teacher_sample=True)
+    oc = ref_actor.compute_log_prob(data=proto(1e-6), calculate_entropy=False, paper_teacher_sample=True)
+    hfp = hf_padded_logits(model, list(range(bs))).float()
+    seq = [per_seq_logits(model, i) for i in range(bs)]
+check("T1 requesting teacher samples leaves the log-probs bitwise unchanged", torch.equal(lp0, o1["log_probs"]))
+smp = oc["paper_teacher_sample"]
+vm = resp_mask.bool()
+got = hfp.gather(-1, smp.unsqueeze(-1)).squeeze(-1)
+check("T2 temperature 1e-6 sample == argmax of the plain HF padded forward at every valid response position (exact)",
+      torch.equal(got[vm], hfp.max(-1).values[vm]), f"({int(vm.sum())} positions)")
+gap = max((seq[i].max(-1).values - seq[i].gather(-1, smp[i, :len(r)].unsqueeze(-1)).squeeze(-1)).max().item()
+          for i, r in enumerate(resps))
+check("T2 ... and of the per-sequence unpadded forward (logit at the sample >= max - 1e-4)", gap <= 1e-4,
+      f"(max shortfall {gap:.2e})")
+s1 = o1["paper_teacher_sample"]
+check("T3 T=1 samples: int64, response-shaped, in vocabulary, not all argmax",
+      s1.dtype == torch.int64 and s1.shape == responses.shape and int(s1.min()) >= 0 and int(s1.max()) < V
+      and not torch.equal(hfp.gather(-1, s1.unsqueeze(-1)).squeeze(-1)[vm], hfp.max(-1).values[vm]))
+
+# ---------------- label override
+lab = torch.randint(0, V, responses.shape, generator=torch.Generator().manual_seed(7))
+mb = {"input_ids": input_ids, "attention_mask": attn, "position_ids": position_ids, "responses": responses,
+      "multi_modal_inputs": np.array(mmis, dtype=object), "pad_token_id": tok.pad_token_id}
+with torch.no_grad():
+    lpo = ref_actor._forward_micro_batch(mb, temperature=1.0, label_override=lab)["log_probs"]
+# same log-prob primitive as the actor (verl's logprobs_from_logits; the CPU torch path computes x_y - logsumexp(x),
+# which differs from log_softmax + gather by ~1 ulp at |log p| ~ 12)
+d_pad = (lpo - vtf.logprobs_from_logits(hfp, lab))[vm].abs().max().item()
+d_seq = max((lpo[i, :len(r)] - F.log_softmax(seq[i], -1).gather(-1, lab[i, :len(r)].unsqueeze(-1)).squeeze(-1))
+            .abs().max().item() for i, r in enumerate(resps))
+check("A1 label override == plain HF padded forward, verl log-prob primitive (<= 1e-6)", d_pad <= 1e-6, f"(max diff {d_pad:.2e})")
+check("A1 label override == per-sequence unpadded forward gather (<= 1e-4)", d_seq <= 1e-4, f"(max diff {d_seq:.2e})")
+
+
+# ---------------- fkl update vs independent SFT step
+acfg = copy.deepcopy(full.actor_rollout_ref.actor)
+with open_dict(acfg):
+    acfg.strategy = "fsdp"
+    acfg.ppo_mini_batch_size = bs
+    acfg.ppo_micro_batch_size_per_gpu = 1
+    acfg.ppo_micro_batch_size = None
+    acfg.use_dynamic_bsz = False
+    acfg.ppo_epochs = 1
+    acfg.use_kl_loss = True
+    acfg.kl_loss_coef = 0.0
+    acfg.kl_loss_type = "low_var_kl"
+    acfg.entropy_coeff = 0.0
+    acfg.loss_agg_mode = "token-mean"
+    acfg.use_torch_compile = False
+    acfg.use_remove_padding = False
+    acfg.use_fused_kernels = False
+    acfg.grad_clip = 1.0
+    acfg.policy_loss.only_reverse_kl_advantages = True
+    acfg.policy_loss.lambda_vals = 1.0
+    acfg.fsdp_config.dtype = "float32"
+    acfg.rollout_n = 1
+acfg = omega_conf_to_dataclass(acfg)
+
+
+def fkl_update(tokens):
+    m = new_model()
+    p0 = {k: v.detach().clone() for k, v in m.state_dict().items()}
+    actor = DataParallelPPOActor(config=acfg, actor_module=m, actor_optimizer=torch.optim.SGD(m.parameters(), lr=1e-2))
+    g = torch.Generator().manual_seed(3)
+    dp = proto(1.0, {"response_mask": resp_mask, "old_log_probs": -torch.rand(bs, RL, generator=g),
+                     "advantages": torch.zeros(bs, RL), "ref_log_prob": -torch.rand(bs, RL, generator=g),
+                     "rollout_is_weights": torch.rand(bs, RL, generator=g) * resp_mask, "ref_sampled_token": tokens})
+    dp.meta_info["paper_loss_mode"] = "fkl_sampled"
+    os.environ["PAPER_LOSS_MODE"] = "fkl_sampled"
+    try:
+        met = actor.update_policy(dp)
+    finally:
+        os.environ.pop("PAPER_LOSS_MODE", None)
+    return met, p0, {k: v.detach().clone() for k, v in m.state_dict().items()}
+
+
+def sft_reference(tokens):
+    m = new_model()
+    opt = torch.optim.SGD(m.parameters(), lr=1e-2)
+    opt.zero_grad()
+    ces = []
+    for i in range(bs):
+        lg = hf_padded_logits(m, [i])
+        lp = vtf.logprobs_from_logits(lg, tokens[i:i + 1])
+        ce = vtf.masked_mean(-lp, resp_mask[i:i + 1])
+        (ce / bs).backward()
+        ces.append(ce.item())
+    torch.nn.utils.clip_grad_norm_(m.parameters(), max_norm=1.0)
+    opt.step()
+    return ces, {k: v.detach().clone() for k, v in m.state_dict().items()}
+
+
+for tag, toks in (("U1 own tokens (plain SFT)", responses.clone()), ("U2 random tokens", lab.clone())):
+    met, p0, p1 = fkl_update(toks)
+    ces, pr = sft_reference(toks)
+    ce = met.get("paper/fkl_ce", [])
+    dce = max(abs(a - b) for a, b in zip(ce, ces)) if len(ce) == len(ces) == bs else 1e9
+    dpar = max((p1[k] - pr[k]).abs().max().item() for k in pr)
+    dlt = max((p1[k] - p0[k]).abs().max().item() for k in pr)
+    check(f"{tag}: fkl loss per micro-batch == independent CE (max diff {dce:.2e} <= 1e-5)", dce <= 1e-5)
+    check(f"{tag}: fkl SGD update == independent SFT step (max param diff {dpar:.2e}, update size {dlt:.2e}; "
+          f"diff <= 1e-6)", dpar <= 1e-6 and dlt > 1e-4)
+    check(f"{tag}: actor/kl_loss == 0", met.get("actor/kl_loss", None) == 0.0)
+
+print(f"\n{sum(RES)} passed, {len(RES) - sum(RES)} failed")
+sys.exit(0 if all(RES) else 1)
