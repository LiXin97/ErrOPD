diff --git a/verl/tests/q35/equiv_compare.py b/verl/tests/q35/equiv_compare.py
new file mode 100644
index 0000000..379050c
--- /dev/null
+++ b/verl/tests/q35/equiv_compare.py
@@ -0,0 +1,71 @@
+"""Compare equiv_harness outputs of the original tree and the ERROPD tree. Exit 1 on any failure."""
+import sys
+
+import torch
+
+orig = torch.load(sys.argv[1], weights_only=False)
+nacl = torch.load(sys.argv[2], weights_only=False)
+fails = []
+lines = []
+
+
+def eq_lists(a, b):
+    return len(a) == len(b) and all(torch.equal(x, y) for x, y in zip(a, b))
+
+
+def eq_params(a, b):
+    return a.keys() == b.keys() and all(torch.equal(a[k], b[k]) for k in a)
+
+
+def check(name, cond):
+    lines.append(f"{'PASS' if cond else 'FAIL'}  {name}")
+    if not cond:
+        fails.append(name)
+
+
+lines.append(f"original tree: {orig['verl_file']}")
+lines.append(f"erropd tree:    {nacl['verl_file']}")
+# 1. flags-off equivalence: original vs erropd, same scenario
+for sc in ("lam1.0", "lam1.25", "lam1.4"):
+    o, n = orig[sc], nacl[sc]
+    check(f"[flags-off {sc}] advantages bitwise equal (all micro-batches)", eq_lists(o["adv"], n["adv"]))
+    check(f"[flags-off {sc}] pg_loss bitwise equal", eq_lists(o["pg"], n["pg"]))
+    check(f"[flags-off {sc}] updated parameters bitwise equal", eq_params(o["params"], n["params"]))
+    check(f"[flags-off {sc}] no erropd metrics emitted", not any(k.startswith("erropd/") for k in n["metrics"]))
+# 2. update-norm logging is read-only
+o, n = orig["lam1.4"], nacl["lam1.4_updnorm"]
+check("[update-norm on, lam1.4] advantages/pg/params bitwise equal to original", eq_lists(o["adv"], n["adv"])
+      and eq_lists(o["pg"], n["pg"]) and eq_params(o["params"], n["params"]))
+un = n["metrics"].get("erropd/update_norm", [None])[0]
+p0, p1 = n["params0"], n["params"]
+true_un = torch.sqrt(sum(((p1[k].double() - p0[k].double()) ** 2).sum() for k in p1)).item()
+check(f"[update-norm] logged {un} == ||theta1-theta0|| {true_un} (rel 1e-9)",
+      un is not None and abs(un - true_un) <= 1e-9 * max(true_un, 1e-12))
+# 3. per-token lambda invariances
+for sc, ref in (("tl_ones_cfg1.4", "lam1.0"), ("tl_const1.4_cfg1.0", "lam1.4"), ("tl_const1.25_cfg1.25", "lam1.25")):
+    o, n = orig[ref], nacl[sc]
+    check(f"[{sc}] == original {ref}: advantages/pg/params bitwise", eq_lists(o["adv"], n["adv"])
+          and eq_lists(o["pg"], n["pg"]) and eq_params(o["params"], n["params"]))
+    check(f"[{sc}] actor ack emitted", n["metrics"].get("erropd/actor_ack", [0])[0] == 1.0)
+# mixed: elementwise selection between lambda=1.0 and lambda=1.4 advantages
+n = nacl["tl_mixed1.4"]
+tl = n["token_lambda"]
+ok = True
+for j, adv in enumerate(n["adv"]):
+    rows = slice(2 * j, 2 * j + 2)
+    sel = tl[rows] == 1.0
+    ok &= torch.equal(adv, torch.where(sel, orig["lam1.0"]["adv"][j], orig["lam1.4"]["adv"][j]))
+check("[tl_mixed1.4] advantages = elementwise select(lambda=1.0 adv, lambda=1.4 adv), bitwise", ok)
+# 4. loss mask
+n = nacl["mask_lam1.4"]
+lm = n["loss_mask"]
+ok = all(torch.equal(adv, orig["lam1.4"]["adv"][j] * lm[2 * j:2 * j + 2]) for j, adv in enumerate(n["adv"]))
+check("[mask_lam1.4] advantages = original lambda=1.4 advantages * mask, bitwise", ok)
+unmasked_mb = [j for j in range(4) if bool((lm[2 * j:2 * j + 2] == 1).all())]
+check("[mask_lam1.4] pg_loss unchanged on micro-batches without masked tokens",
+      all(torch.equal(n["pg"][j], orig["lam1.4"]["pg"][j]) for j in unmasked_mb))
+check("[mask_lam1.4] parameters differ from unmasked run (mask has an effect)",
+      not eq_params(n["params"], orig["lam1.4"]["params"]))
+print("\n".join(lines))
+print(f"\n{len(lines) - 2 - len(fails)} passed, {len(fails)} failed")
+sys.exit(1 if fails else 0)
diff --git a/verl/tests/q35/equiv_harness.py b/verl/tests/q35/equiv_harness.py
new file mode 100644
index 0000000..c29677d
--- /dev/null
+++ b/verl/tests/q35/equiv_harness.py
@@ -0,0 +1,409 @@
+"""Run DataParallelPPOActor.update_policy of whichever verl tree is on PYTHONPATH on a
+fixed batch (tiny random Qwen3, CPU, single-process gloo group) and save
+per-micro-batch advantages, pg losses, metrics and the updated parameters.
+
+Usage (one process per tree, because both trees are the package `verl`):
+  PYTHONPATH=<tree>/verl python equiv_harness.py --out OUT.pt --scenarios s1,s2,... [--batch-pt BATCH.pt]
+
+The batch mirrors the production OPD configuration: only_reverse_kl_advantages,
+base-relative advantage, rollout IS weights (c-capped TIS), single mini-batch,
+ppo_epochs=1 (on-policy: old_log_prob = log_prob.detach()), micro-batch 2,
+use_kl_loss with coef 0, token-mean aggregation.
+
+--batch-pt: a stored batch shared by every tree and interpreter (written on first use from the
+generator below, then loaded), so all runs see the same tensors byte for byte.
+
+PAPER_LOSS_MODE (trees that have it; others ignore the env): every OPD scenario sets
+PAPER_LOSS_MODE=opd explicitly; lossmode_opd_lam1.4 also stamps meta paper_loss_mode=opd (the driver
+path); metaonly_opd_lam1.4 stamps the meta with the env unset. fkl_self / fkl_rand run
+PAPER_LOSS_MODE=fkl_sampled with SGD (parameter delta = -lr x clipped gradient) and the student's own
+tokens / random tokens as the teacher samples, and an independent plain-SFT step on the same tokens
+(no verl actor code) is saved next to them. The teacher-pass section (compute_log_prob with and without
+the teacher-sample request, both padding modes, static and dynamic micro-batching) and the refusal
+section run on every tree; their PAPER parts only where the tree has the feature.
+"""
+
+import argparse
+import os
+import tempfile
+
+import torch
+
+BS, P, R, VOCAB = 8, 6, 10, 128
+BATCH_PT = None
+
+
+def build_actor_cfg(lam, rmpad=False, dynamic=False, kl_coef=0.0):
+    import verl
+    from hydra import compose, initialize_config_dir
+    from omegaconf import open_dict
+
+    from verl.utils.config import omega_conf_to_dataclass
+
+    cfg_dir = os.path.join(os.path.dirname(verl.__file__), "trainer", "config")
+    with initialize_config_dir(config_dir=cfg_dir, version_base=None):
+        cfg = compose(config_name="ppo_trainer")
+    actor = cfg.actor_rollout_ref.actor
+    with open_dict(actor):
+        actor.strategy = "fsdp"
+        actor.ppo_mini_batch_size = BS
+        actor.ppo_micro_batch_size_per_gpu = 2
+        actor.ppo_micro_batch_size = None
+        actor.use_dynamic_bsz = bool(dynamic)
+        actor.ppo_max_token_len_per_gpu = 40
+        actor.ppo_epochs = 1
+        actor.use_kl_loss = True
+        actor.kl_loss_coef = float(kl_coef)
+        actor.kl_loss_type = "low_var_kl"
+        actor.entropy_coeff = 0.0
+        actor.loss_agg_mode = "token-mean"
+        actor.use_torch_compile = False
+        actor.use_remove_padding = bool(rmpad)
+        actor.grad_clip = 1.0
+        actor.policy_loss.only_reverse_kl_advantages = True
+        actor.policy_loss.lambda_vals = float(lam)
+        actor.fsdp_config.dtype = "bfloat16"
+        actor.rollout_n = 1
+    return omega_conf_to_dataclass(actor)
+
+
+def _generate_batch():
+    g = torch.Generator().manual_seed(1234)
+    input_ids = torch.randint(0, VOCAB, (BS, P + R), generator=g)
+    attn = torch.ones(BS, P + R, dtype=torch.long)
+    resp_len = torch.tensor([10, 7, 10, 3, 9, 10, 5, 8])
+    for i in range(BS):
+        attn[i, P + int(resp_len[i]):] = 0
+    attn[1, :2] = 0  # left-padded prompt
+    pos = torch.clamp(torch.cumsum(attn, dim=-1) - 1, min=0)
+    responses = input_ids[:, P:].clone()
+    resp_mask = attn[:, P:].clone().float()
+    ref = -3.0 * torch.rand(BS, R, generator=g)
+    base = -3.0 * torch.rand(BS, R, generator=g)
+    base_ref = -3.0 * torch.rand(BS, R, generator=g)
+    old = -3.0 * torch.rand(BS, R, generator=g)
+    isw = (2.5 * torch.rand(BS, R, generator=g)).clamp(max=5.0) * resp_mask
+    return {
+        "input_ids": input_ids, "attention_mask": attn, "position_ids": pos,
+        "responses": responses, "response_mask": resp_mask, "old_log_probs": old,
+        "advantages": torch.zeros(BS, R), "ref_log_prob": ref, "base_log_prob": base,
+        "base_ref_log_prob": base_ref, "rollout_is_weights": isw,
+    }
+
+
+def build_batch():
+    from verl import DataProto
+
+    if BATCH_PT:
+        if not os.path.exists(BATCH_PT):
+            torch.save(_generate_batch(), BATCH_PT)
+        d = torch.load(BATCH_PT)
+    else:
+        d = _generate_batch()
+    dp = DataProto.from_single_dict({k: v.clone() for k, v in d.items()})
+    dp.meta_info["temperature"] = 1.0
+    dp.meta_info["global_token_num"] = d["attention_mask"].sum(-1).tolist()
+    return dp
+
+
+def token_lambda_tensor(spec, resp_mask):
+    kind, _, val = spec.partition(":")
+    if kind == "ones":
+        return torch.ones(BS, R)
+    if kind == "const":
+        return torch.full((BS, R), float(val))
+    if kind == "mixed":  # checkerboard of 1.0 / val
+        t = torch.ones(BS, R)
+        idx = (torch.arange(BS)[:, None] + torch.arange(R)[None, :]) % 2 == 0
+        t[idx] = float(val)
+        return t
+    raise ValueError(spec)
+
+
+def loss_mask_tensor():
+    m = torch.ones(BS, R)
+    m[2, :] = 0.0          # b1-style: whole rollout
+    m[5, 4:] = 0.0         # b2-style: after a violation token at index 3
+    return m
+
+
+SCENARIOS = {
+    # name: (lambda_vals, token_lambda spec or None, loss_mask?, update-norm meta?, expect-ack meta?)
+    "lam1.0": (1.0, None, False, False, False),
+    "lam1.25": (1.25, None, False, False, False),
+    "lam1.4": (1.4, None, False, False, False),
+    # erropd-only scenarios
+    "lam1.4_updnorm": (1.4, None, False, True, False),
+    "tl_ones_cfg1.4": (1.4, "ones", False, False, True),
+    "tl_const1.4_cfg1.0": (1.0, "const:1.4", False, False, True),
+    "tl_const1.25_cfg1.25": (1.25, "const:1.25", False, False, True),
+    "tl_mixed1.4": (1.4, "mixed:1.4", False, False, True),
+    "mask_lam1.4": (1.4, None, True, False, True),
+    # PAPER_LOSS_MODE
+    "lossmode_opd_lam1.4": (1.4, None, False, False, False),
+    "metaonly_opd_lam1.4": (1.4, None, False, False, False),
+    "fkl_self": (1.0, None, False, False, False),
+    "fkl_rand": (1.0, None, False, False, False),
+}
+# name -> (env PAPER_LOSS_MODE or None = unset, meta paper_loss_mode or None = absent)
+MODE = {k: ("opd", None) for k in SCENARIOS}
+MODE["lossmode_opd_lam1.4"] = ("opd", "opd")
+MODE["metaonly_opd_lam1.4"] = (None, "opd")
+MODE["fkl_self"] = ("fkl_sampled", "fkl_sampled")
+MODE["fkl_rand"] = ("fkl_sampled", "fkl_sampled")
+FKL_TOKENS = {"fkl_self": "self", "fkl_rand": "rand"}
+
+
+def tiny_model():
+    from transformers import Qwen3Config, Qwen3ForCausalLM
+
+    torch.manual_seed(0)
+    mcfg = Qwen3Config(vocab_size=VOCAB, hidden_size=32, intermediate_size=64, num_hidden_layers=2,
+                       num_attention_heads=4, num_key_value_heads=2, head_dim=8,
+                       max_position_embeddings=64, tie_word_embeddings=False)
+    mcfg._attn_implementation = "eager"
+    return Qwen3ForCausalLM(mcfg).float()
+
+
+class _Env:
+    """Set / unset PAPER_LOSS_MODE for one call and restore it afterwards."""
+
+    def __init__(self, value):
+        self.value = value
+
+    def __enter__(self):
+        self.saved = os.environ.get("PAPER_LOSS_MODE")
+        if self.value is None:
+            os.environ.pop("PAPER_LOSS_MODE", None)
+        else:
+            os.environ["PAPER_LOSS_MODE"] = self.value
+
+    def __exit__(self, *a):
+        if self.saved is None:
+            os.environ.pop("PAPER_LOSS_MODE", None)
+        else:
+            os.environ["PAPER_LOSS_MODE"] = self.saved
+
+
+def fkl_tokens(kind, data):
+    if kind == "self":
+        return data.batch["responses"].clone()
+    return torch.randint(0, VOCAB, data.batch["responses"].shape, generator=torch.Generator().manual_seed(99))
+
+
+def run(name):
+    import verl.workers.actor.dp_actor as dpa
+
+    lam, tl_spec, use_mask, updnorm, ack = SCENARIOS[name]
+    cfg = build_actor_cfg(lam)
+    model = tiny_model()
+    params0 = {k: v.detach().clone() for k, v in model.state_dict().items()}
+    if name in FKL_TOKENS:
+        opt = torch.optim.SGD(model.parameters(), lr=1e-2)
+    else:
+        opt = torch.optim.AdamW(model.parameters(), lr=1e-2)
+    actor = dpa.DataParallelPPOActor(config=cfg, actor_module=model, actor_optimizer=opt)
+
+    rec = {"adv": [], "pg": [], "logp": []}
+    orig_get = dpa.get_policy_loss_fn
+
+    def get_fn(mode):
+        fn = orig_get(mode)
+
+        def wrapped(**kw):
+            rec["adv"].append(kw["advantages"].detach().clone())
+            rec["logp"].append(kw["log_prob"].detach().clone())
+            out = fn(**kw)
+            rec["pg"].append(out[0].detach().clone())
+            return out
+        return wrapped
+
+    dpa.get_policy_loss_fn = get_fn
+    data = build_batch()
+    if tl_spec is not None:
+        data.batch["erropd_token_lambda"] = token_lambda_tensor(tl_spec, data.batch["response_mask"])
+    if use_mask:
+        data.batch["erropd_loss_mask"] = loss_mask_tensor()
+    if updnorm:
+        data.meta_info["erropd_log_update_norm"] = True
+    if ack:
+        data.meta_info["erropd_expect_ack"] = True
+    if name in FKL_TOKENS:
+        data.batch["ref_sampled_token"] = fkl_tokens(FKL_TOKENS[name], data)
+    env_mode, meta_mode = MODE[name]
+    if meta_mode is not None:
+        data.meta_info["paper_loss_mode"] = meta_mode
+    try:
+        with _Env(env_mode):
+            metrics = actor.update_policy(data)
+    finally:
+        dpa.get_policy_loss_fn = orig_get
+    params = {k: v.detach().clone() for k, v in model.state_dict().items()}
+    ref = sft_reference(data.batch["ref_sampled_token"]) if name in FKL_TOKENS else None
+    return {"adv": rec["adv"], "pg": rec["pg"], "logp": rec["logp"], "metrics": dict(metrics), "params": params,
+            "params0": params0, "token_lambda": data.batch.get("erropd_token_lambda", None),
+            "loss_mask": data.batch.get("erropd_loss_mask", None), "fkl_ref": ref,
+            "response_mask": data.batch["response_mask"].clone()}
+
+
+def sft_reference(tokens):
+    """Independent plain-SFT step on `tokens` at the response positions of the stored batch (no verl actor code):
+    same tiny model init, micro-batches of 2 in row order, token-mean CE per micro-batch / grad accumulation,
+    grad-norm clip 1.0, SGD lr 1e-2. Returns per-micro-batch CE and the updated parameters."""
+    import verl.utils.torch_functional as vtf2
+
+    model = tiny_model()
+    opt = torch.optim.SGD(model.parameters(), lr=1e-2)
+    d = build_batch()
+    ga = BS // 2
+    ces = []
+    opt.zero_grad()
+    for j in range(0, BS, 2):
+        ids, am, pos = (d.batch[k][j:j + 2] for k in ("input_ids", "attention_mask", "position_ids"))
+        rm = d.batch["response_mask"][j:j + 2]
+        with torch.autocast(device_type="cpu", dtype=torch.bfloat16):
+            logits = model(input_ids=ids, attention_mask=am, position_ids=pos, use_cache=False).logits
+        # verl's primitives (same numerics as the actor: bf16 logits, the torch log-prob path, masked token-mean),
+        # none of the actor's control flow
+        lp = vtf2.logprobs_from_logits(logits[:, -R - 1:-1, :], tokens[j:j + 2])
+        ce = vtf2.masked_mean(-lp, rm)
+        (ce / ga).backward()
+        ces.append(ce.detach())
+    torch.nn.utils.clip_grad_norm_(model.parameters(), max_norm=1.0)
+    opt.step()
+    return {"ce": ces, "params": {k: v.detach().clone() for k, v in model.state_dict().items()}}
+
+
+def run_teacher(has_paper):
+    """Teacher-style compute_log_prob (micro-batch 1 and dynamic micro-batching, unpadded sequences, so the
+    remove-padding forward equals the padded one): flags-off log-probs (compared across trees), and on trees with
+    PAPER_LOSS_MODE the teacher-sample request (log-probs unchanged; temperature 1e-4 sample == argmax) and the
+    label override (== direct log-softmax gather)."""
+    import verl.workers.actor.dp_actor as dpa
+    from verl import DataProto
+
+    model = tiny_model().eval()
+    g = torch.Generator().manual_seed(4321)
+    ids = torch.randint(0, VOCAB, (4, P + R), generator=g)
+    attn = torch.ones(4, P + R, dtype=torch.long)
+    pos = torch.arange(P + R)[None, :].repeat(4, 1)
+    out = {}
+
+    def batch(temp, dynamic):
+        d = DataProto.from_single_dict({"input_ids": ids, "attention_mask": attn, "position_ids": pos,
+                                        "responses": ids[:, P:]})
+        d.meta_info.update({"micro_batch_size": 1, "temperature": temp, "use_dynamic_bsz": dynamic,
+                            "max_token_len": 40})
+        return d
+
+    # remove-padding packs a micro-batch into one stream; the CPU eager model has no varlen attention, so the
+    # remove-padding path is run with micro-batch 1 only (dynamic micro-batches hold 2 rows here)
+    for rmpad in (False, True):
+        for dyn in ((False, True) if not rmpad else (False,)):
+            tag = f"rmpad{int(rmpad)}_dyn{int(dyn)}"
+            actor = dpa.DataParallelPPOActor(config=build_actor_cfg(1.0, rmpad=rmpad), actor_module=model,
+                                             actor_optimizer=None)
+            out[f"logp_{tag}"] = actor.compute_log_prob(batch(1.0, dyn), calculate_entropy=False)["log_probs"]
+            if not has_paper:
+                continue
+            o1 = actor.compute_log_prob(batch(1.0, dyn), calculate_entropy=False, paper_teacher_sample=True)
+            out[f"logp_req_{tag}"] = o1["log_probs"]
+            out[f"sample_t1_{tag}"] = o1["paper_teacher_sample"]
+            oc = actor.compute_log_prob(batch(1e-4, dyn), calculate_entropy=False, paper_teacher_sample=True)
+            out[f"sample_cold_{tag}"] = oc["paper_teacher_sample"]
+        if has_paper:
+            g2 = torch.Generator().manual_seed(7)
+            lab = torch.randint(0, VOCAB, (4, R), generator=g2)
+            lps = []
+            for i in range(4):
+                mb = {"input_ids": ids[i:i + 1], "attention_mask": attn[i:i + 1], "position_ids": pos[i:i + 1],
+                      "responses": ids[i:i + 1, P:]}
+                with torch.no_grad():
+                    lps.append(actor._forward_micro_batch(mb, temperature=1.0, label_override=lab[i:i + 1])["log_probs"])
+            out[f"logp_override_rmpad{int(rmpad)}"] = torch.cat(lps, 0)
+            out["override_labels"] = lab
+    if has_paper:
+        import verl.utils.torch_functional as vtf3
+
+        with torch.no_grad():
+            with torch.autocast(device_type="cpu", dtype=torch.bfloat16):
+                lg = model(input_ids=ids, attention_mask=attn, position_ids=pos).logits
+            out["direct_logits"] = lg[:, -R - 1:-1, :].float()
+            out["direct_override_logp"] = vtf3.logprobs_from_logits(lg[:, -R - 1:-1, :], out["override_labels"])
+    return out
+
+
+def run_refusals():
+    """PAPER_LOSS_MODE refusals (trees that have it). Each case must raise before any parameter changes."""
+    import verl.workers.actor.dp_actor as dpa
+
+    cases = {
+        "unset": (None, None, {}, 0.0),
+        "unknown_env": ("bogus", None, {}, 0.0),
+        "meta_env_disagree": ("fkl_sampled", "opd", {}, 0.0),
+        "fkl_without_samples": ("fkl_sampled", "fkl_sampled", {"drop_samples": True}, 0.0),
+        "fkl_with_token_lambda": ("fkl_sampled", "fkl_sampled", {"token_lambda": True}, 0.0),
+        "fkl_with_kl_coef": ("fkl_sampled", "fkl_sampled", {}, 0.1),
+    }
+    res = {}
+    for name, (env_mode, meta_mode, extra, kl_coef) in cases.items():
+        cfg = build_actor_cfg(1.0, kl_coef=kl_coef)
+        model = tiny_model()
+        p0 = {k: v.detach().clone() for k, v in model.state_dict().items()}
+        actor = dpa.DataParallelPPOActor(config=cfg, actor_module=model,
+                                         actor_optimizer=torch.optim.SGD(model.parameters(), lr=1e-2))
+        data = build_batch()
+        if not extra.get("drop_samples"):
+            data.batch["ref_sampled_token"] = data.batch["responses"].clone()
+        if extra.get("token_lambda"):
+            data.batch["erropd_token_lambda"] = torch.ones(BS, R)
+        if meta_mode is not None:
+            data.meta_info["paper_loss_mode"] = meta_mode
+        err = None
+        try:
+            with _Env(env_mode):
+                actor.update_policy(data)
+        except (RuntimeError, ValueError) as e:
+            err = f"{type(e).__name__}: {e}"
+        unchanged = all(torch.equal(p0[k], v) for k, v in model.state_dict().items())
+        res[name] = {"error": err, "params_unchanged": unchanged}
+    return res
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--out", required=True)
+    ap.add_argument("--scenarios", required=True)
+    ap.add_argument("--batch-pt", default="")
+    args = ap.parse_args()
+    global BATCH_PT
+    BATCH_PT = args.batch_pt or None
+    import verl
+    import verl.utils.torch_functional as vtf
+    from verl.workers.actor.dp_actor import DataParallelPPOActor
+
+    # CPU run: flash-attn's Triton cross-entropy needs CUDA; use the torch path in BOTH trees.
+    vtf.FLAH_ATTN_CROSS_ENTROPY_LOSS_AVAILABLE = False
+
+    tmp = tempfile.NamedTemporaryFile(delete=False)
+    torch.distributed.init_process_group("gloo", rank=0, world_size=1, init_method=f"file://{tmp.name}")
+    torch.use_deterministic_algorithms(True)
+    has_paper = hasattr(DataParallelPPOActor, "_paper_gumbel_sample")
+    res = {"verl_file": verl.__file__, "has_paper": has_paper, "torch": torch.__version__}
+    import transformers
+
+    res["transformers"] = transformers.__version__
+    res["teacher"] = run_teacher(has_paper)
+    if has_paper:
+        res["refusals"] = run_refusals()
+    for name in args.scenarios.split(","):
+        if (name in FKL_TOKENS or name.startswith(("lossmode_", "metaonly_"))) and not has_paper:
+            continue
+        res[name] = run(name)
+        print(f"{name}: pg={[round(float(x), 6) for x in res[name]['pg']]}", flush=True)
+    torch.save(res, args.out)
+    print("saved", args.out, "verl from", verl.__file__, "has_paper", has_paper)
+
+
+if __name__ == "__main__":
+    main()
diff --git a/verl/tests/q35/fkl_compare.py b/verl/tests/q35/fkl_compare.py
new file mode 100644
index 0000000..c23e897
--- /dev/null
+++ b/verl/tests/q35/fkl_compare.py
@@ -0,0 +1,117 @@
+"""Compare equiv_harness outputs of a reference q35 tree without PAPER_LOSS_MODE (e.g. snapshot d80a0a3855) and the
+q35 tree with it, run in the same interpreter on the same stored batch. Exit 1 on any failure.
+
+Usage: python fkl_compare.py OLD.pt NEW.pt
+
+1. opd mode is bitwise the old tree: every scenario both trees ran (production lambda 1.0/1.25/1.4 and the ERROPD
+   scenarios), and PAPER_LOSS_MODE=opd via env+meta and via meta only against the old tree's lambda 1.4: advantages,
+   current log-probs, pg losses, initial and updated parameters, logged grad norm and pg loss; no paper/ metric.
+2. fkl_sampled with the student's own tokens as teacher samples == an independently coded plain-SFT step (loss per
+   micro-batch and SGD update); with random tokens == CE on them; no OPD policy-gradient path; kl loss 0.
+3. Teacher pass: flags-off log-probs bitwise the old tree; requesting samples leaves log-probs bitwise unchanged;
+   temperature 1e-4 sample == argmax of the teacher logits at every response position (padded, remove-padding,
+   dynamic micro-batching); label-override log-probs == direct log-softmax gather.
+4. Refusals: unset mode, unknown mode, meta/env disagreement, fkl without samples, fkl with ERROPD tensors, fkl with a
+   nonzero kl coefficient; each raises before any parameter changes.
+"""
+import sys
+
+import torch
+
+old = torch.load(sys.argv[1], weights_only=False)
+new = torch.load(sys.argv[2], weights_only=False)
+lines, fails = [], []
+
+
+def check(name, cond):
+    lines.append(f"{'PASS' if cond else 'FAIL'}  {name}")
+    if not cond:
+        fails.append(name)
+
+
+def eq_lists(a, b):
+    return len(a) == len(b) and all(torch.equal(x, y) for x, y in zip(a, b))
+
+
+def eq_params(a, b):
+    return a.keys() == b.keys() and all(torch.equal(a[k], b[k]) for k in a)
+
+
+def metric_list(m, k):
+    v = m.get(k)
+    return v if isinstance(v, list) else ([] if v is None else [v])
+
+
+lines.append(f"reference tree: {old['verl_file']} (has PAPER_LOSS_MODE: {old['has_paper']})")
+lines.append(f"tested tree:    {new['verl_file']} (has PAPER_LOSS_MODE: {new['has_paper']})")
+lines.append(f"interpreter: torch {new['torch']}, transformers {new['transformers']}")
+check("interpreters identical for both runs", (old["torch"], old["transformers"]) == (new["torch"], new["transformers"]))
+check("reference tree lacks PAPER_LOSS_MODE, tested tree has it", (not old["has_paper"]) and new["has_paper"])
+
+# 1. opd mode == old tree, bitwise
+shared = [k for k in old if isinstance(old[k], dict) and "params" in old[k] and k in new]
+pairs = [(k, k) for k in shared] + [("lam1.4", "lossmode_opd_lam1.4"), ("lam1.4", "metaonly_opd_lam1.4")]
+for ko, kn in pairs:
+    o, n = old[ko], new[kn]
+    tag = ko if ko == kn else f"{kn} vs reference {ko}"
+    ok = (eq_lists(o["adv"], n["adv"]) and eq_lists(o["logp"], n["logp"]) and eq_lists(o["pg"], n["pg"])
+          and eq_params(o["params0"], n["params0"]) and eq_params(o["params"], n["params"]))
+    gm = metric_list(o["metrics"], "actor/grad_norm") == metric_list(n["metrics"], "actor/grad_norm")
+    pl = metric_list(o["metrics"], "actor/pg_loss") == metric_list(n["metrics"], "actor/pg_loss")
+    nm = not any(k.startswith("paper/") for k in n["metrics"])
+    same_keys = set(o["metrics"]) == set(n["metrics"])
+    check(f"[opd {tag}] advantages, log-probs, pg losses ({len(n['pg'])} micro-batches), initial and updated "
+          f"parameters bitwise; grad norm and pg loss metrics equal; same metric keys; no paper/ metric",
+          ok and gm and pl and nm and same_keys and len(n["adv"]) == 4)
+
+# 2. fkl
+for sc, what in (("fkl_self", "student's own tokens = plain SFT"), ("fkl_rand", "random teacher tokens = CE on them")):
+    n = new[sc]
+    ref = n["fkl_ref"]
+    ce = metric_list(n["metrics"], "paper/fkl_ce")
+    dce = max(abs(a - float(b)) for a, b in zip(ce, ref["ce"])) if len(ce) == len(ref["ce"]) == 4 else 1e9
+    dpar = max((n["params"][k] - ref["params"][k]).abs().max().item() for k in ref["params"])
+    dlt = max((n["params"][k] - n["params0"][k]).abs().max().item() for k in ref["params"])
+    check(f"[{sc}] fkl loss per micro-batch == independent CE ({what}); max diff {dce:.2e} <= 1e-5", dce <= 1e-5)
+    check(f"[{sc}] fkl SGD update == independent SFT step on the same tokens (max param diff {dpar:.2e}, update size "
+          f"{dlt:.2e}; diff <= 1e-6)", dpar <= 1e-6 and dlt > 1e-4)
+    pls = sum(metric_list(n["metrics"], "actor/pg_loss"))
+    exp = sum(float(c) for c in ce) / 4
+    check(f"[{sc}] logged actor/pg_loss == sum of micro-batch CE x 1/4 ({pls:.6f} vs {exp:.6f}); actor/kl_loss == 0",
+          abs(pls - exp) <= 1e-6 and sum(metric_list(n["metrics"], "actor/kl_loss")) == 0.0)
+    check(f"[{sc}] no OPD policy-gradient path taken (policy-loss function never called)", len(n["adv"]) == 0)
+check("[fkl_rand] differs from fkl_self (the teacher tokens matter)",
+      not eq_params(new["fkl_rand"]["params"], new["fkl_self"]["params"]))
+
+# 3. teacher pass
+to, tn = old["teacher"], new["teacher"]
+tags = [k[len("logp_"):] for k in to if k.startswith("logp_") and not k.startswith(("logp_req", "logp_override"))]
+check(f"[teacher] flags-off log-probs bitwise equal to the reference tree ({', '.join(tags)})",
+      len(tags) == 3 and all(torch.equal(to[f"logp_{t}"], tn[f"logp_{t}"]) for t in tags))
+lg = tn["direct_logits"]
+top = lg.max(-1).values
+for t in tags:
+    check(f"[teacher {t}] requesting samples leaves the log-probs bitwise unchanged",
+          torch.equal(tn[f"logp_{t}"], tn[f"logp_req_{t}"]))
+    got = lg.gather(-1, tn[f"sample_cold_{t}"].unsqueeze(-1)).squeeze(-1)
+    check(f"[teacher {t}] at temperature 1e-4 the sampled token is the argmax of the teacher logits at every "
+          f"response position", torch.equal(got, top))
+    s1 = tn[f"sample_t1_{t}"]
+    check(f"[teacher {t}] T=1 samples: shape {tuple(s1.shape)}, int64, in vocabulary, not all argmax",
+          s1.dtype == torch.int64 and tuple(s1.shape) == tuple(top.shape) and int(s1.min()) >= 0
+          and int(s1.max()) < lg.shape[-1] and not torch.equal(lg.gather(-1, s1.unsqueeze(-1)).squeeze(-1), top))
+for r in (0, 1):
+    dd = (tn[f"logp_override_rmpad{r}"] - tn["direct_override_logp"]).abs().max().item()
+    check(f"[label override rmpad={r}] log p(label | student prefix) == direct log-softmax gather (max diff "
+          f"{dd:.2e} <= 1e-6)", dd <= 1e-6)
+dd = (tn["logp_override_rmpad0"] - tn["logp_override_rmpad1"]).abs().max().item()
+check(f"[label override] padded and remove-padding paths agree (max diff {dd:.2e} <= 1e-6)", dd <= 1e-6)
+
+# 4. refusals
+for name, r in new["refusals"].items():
+    check(f"[refusal {name}] raises ({r['error'][:90] if r['error'] else None}) and leaves parameters unchanged",
+          r["error"] is not None and r["params_unchanged"])
+
+print("\n".join(lines))
+print(f"\n{sum(1 for x in lines if x.startswith('PASS'))} passed, {len(fails)} failed")
+sys.exit(1 if fails else 0)
