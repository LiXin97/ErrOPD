+    mm = {}
+    out = ErropdHooks(make_cfg({}), TOK).on_batch(dpm, 1, mm)
+finally:
+    for k in ("PAPER_ADV_MODE", "PAPER_ADV_GAMMA", "PAPER_ADV_BASELINE"):
+        os.environ.pop(k, None)
+rmk = bkm["response_mask"].double()
+advk = ((bkm["ref_log_prob"] - bkm["base_log_prob"]) * 1.4 - (bkm["old_log_probs"] - bkm["base_log_prob"])).double() * rmk
+r2g = torch.zeros_like(advk)
+run = torch.zeros(advk.shape[0], dtype=torch.float64)
+for t in range(advk.shape[1] - 1, -1, -1):
+    run = advk[:, t] + 0.9 * run
+    r2g[:, t] = run
+exp_b = float((r2g * rmk).sum() / rmk.sum())
+check("T16 non-listwise (math) batch: hooks run flags-off, batch unchanged except meta",
+      out is dpm and set(dpm.batch.keys()) == set(bkm.keys()) and mm["erropd/listwise"] == 0.0)
+check("T16 R2G per-batch baseline (gamma 0.9) in meta == independent computation",
