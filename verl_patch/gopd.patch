@@ -0,0 +1,90 @@
+"""PAPER_LOSS_MODE=rkl_full: the full-vocabulary reverse-KL loss vs the sampled-token OPD estimator (CPU).
+
+  PYTHONPATH=<tree>/verl python test_rkl.py
+
+The implemented loss (DataParallelPPOActor._paper_rkl_full on log_softmax, aggregated with agg_loss token-mean as in
+the actor) is L(theta) = sum_y p(y) [log p(y) - log q(y)], p = softmax(theta).
+(1) Its gradient on the logits equals the closed form p * (log p - log q - L).
+(2) It equals the expectation of the sampled-token OPD gradient at lambda 1 (y ~ p, A = log q(y) - log p(y),
+    loss -A * ratio, ratio = exp(lp - lp.detach()), token-mean): checked by Monte Carlo (400k draws, 5 SE) on
+    two-token decisions and on a 6-token state.
+(3) On a two-token decision the rate on the rare token's logit is p(1-p)(A(1) - A(0)) for both (exactly for the
+    loss; in expectation for the sampled estimator), i.e. the full-vocabulary loss removes the sampling noise and keeps
+    the p(1-p) factor.
+"""
+import math
+import sys
+
+import torch
+
+import verl.utils.torch_functional as vtf
+from verl.trainer.ppo.core_algos import agg_loss
+from verl.workers.actor.dp_actor import DataParallelPPOActor
+
+vtf.FLAH_ATTN_CROSS_ENTROPY_LOSS_AVAILABLE = False
+RES = []
+
+
+def check(name, cond, detail=""):
+    RES.append(bool(cond))
+    print(f"{'PASS' if cond else 'FAIL'}  {name} {detail}", flush=True)
+
+
+def rkl_grad(theta0, q):
+    theta = theta0.clone().requires_grad_(True)
+    lp = torch.log_softmax(theta, -1)
+    mat = DataParallelPPOActor._paper_rkl_full(lp.view(1, 1, -1), torch.log(q).view(1, 1, -1))
+    loss = agg_loss(loss_mat=mat, loss_mask=torch.ones(1, 1), loss_agg_mode="token-mean")
+    (g,) = torch.autograd.grad(loss, theta)
+    return float(loss.detach()), g
+
+
+def opd_mc_grad(theta0, q, M, seed):
+    theta = theta0.clone().requires_grad_(True)
+    p = torch.softmax(theta0, -1)
+    y = torch.multinomial(p, M, replacement=True, generator=torch.Generator().manual_seed(seed))
+    V = theta0.numel()
+    lp = vtf.logprobs_from_logits(theta.expand(1, M, V), y.view(1, M))
+    A = (torch.log(q)[y] - torch.log(p)[y]).view(1, M)
+    loss = agg_loss(loss_mat=-A * torch.exp(lp - lp.detach()), loss_mask=torch.ones(1, M), loss_agg_mode="token-mean")
+    (g,) = torch.autograd.grad(loss, theta)
+    # per-sample gradient covariance bound: |A| * |e_y - p| <= |A| * sqrt(2)
+    se = math.sqrt(float((p * (torch.log(q) - torch.log(p)) ** 2).sum()) * 2 / M)
+    return g, se
+
+
+M = 400000
+for p1, q1 in ((0.01, 0.2), (0.3, 0.6), (0.5, 0.5), (0.001, 0.3)):
+    theta0 = torch.tensor([0.0, math.log(p1 / (1 - p1))], dtype=torch.float64)
+    q = torch.tensor([1 - q1, q1], dtype=torch.float64)
+    p = torch.softmax(theta0, -1)
+    L, g = rkl_grad(theta0, q)
+    closed = p * (torch.log(p) - torch.log(q) - L)
+    check(f"[p={p1}, q={q1}] implemented RKL gradient == closed form p(log p - log q - L)",
+          (g - closed).abs().max().item() < 1e-12, f"(grad {g.tolist()})")
+    go, se = opd_mc_grad(theta0, q, M, seed=1)
+    check(f"[p={p1}, q={q1}] E[sampled OPD gradient] (Monte Carlo) == implemented RKL gradient",
+          (go - g).abs().max().item() < 5 * se + 1e-9, f"(MC {go.tolist()}, RKL {g.tolist()}, 5 SE {5 * se:.2e})")
+    A = torch.log(q) - torch.log(p)
+    rate = float(p[1] * (1 - p[1]) * (A[1] - A[0]))
+    check(f"[p={p1}, q={q1}] rate on the rare token's logit -dL/dtheta_1 = p(1-p)(A(1)-A(0)) = {rate:.6f}",
+          abs(-float(g[1]) - rate) < 1e-12)
+
+# 6-token state, random student and teacher
+gen = torch.Generator().manual_seed(3)
+theta0 = (2.0 * torch.randn(6, generator=gen)).double()
+q = torch.softmax((2.0 * torch.randn(6, generator=gen)).double(), -1)
+L, g = rkl_grad(theta0, q)
+p = torch.softmax(theta0, -1)
+check("[6 tokens] implemented RKL == sum_y p(y)(log p(y) - log q(y))",
+      abs(L - float((p * (torch.log(p) - torch.log(q))).sum())) < 1e-12, f"(L {L:.6f})")
+go, se = opd_mc_grad(theta0, q, M, seed=2)
+check("[6 tokens] E[sampled OPD gradient] (Monte Carlo) == implemented RKL gradient",
+      (go - g).abs().max().item() < 5 * se, f"(max |diff| {(go - g).abs().max().item():.2e}, 5 SE {5 * se:.2e})")
+# fp32 log-probs as in the actor (bf16 logits -> float -> log_softmax)
+lp32 = torch.log_softmax(theta0.float().to(torch.bfloat16).float(), -1)
+v32 = float(DataParallelPPOActor._paper_rkl_full(lp32, torch.log(q).float()))
+check("[6 tokens] fp32 evaluation from bf16 logits agrees with float64 to bf16 rounding", abs(v32 - L) < 5e-2,
+      f"({v32:.5f} vs {L:.5f})")
+print(f"\n{sum(RES)} passed, {len(RES) - sum(RES)} failed")
+sys.exit(0 if all(RES) else 1)
