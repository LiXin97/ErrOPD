+"""ESCI K=8 strict parser: VERBATIM copy of parse_score_list in erropd/scripts/eval_esci_listwise_offline.py
+(product_id lists). tests/erropd/test_hooks.py asserts the source text is identical. Do not edit."""
+
+import json
+import re
+
+
+def parse_score_list(text: str, expected_K: int, product_ids: list[str]):
+    """Return K scores aligned to product_ids, or None if parse fails.
+
+    A valid prediction must be a JSON list of exactly K objects, each with a
+    unique input product_id and a numeric score. Scores are returned in the
+    input-product order so NDCG/Kendall are computed against the right item.
+    """
+    text = text.strip()
+    try:
+        m = re.search(r"\[.*\]", text, re.S)
+        if not m:
+            return None
+        arr = json.loads(m.group(0))
+        if not isinstance(arr, list) or len(arr) != expected_K:
+            return None
+
+        expected_ids = [str(pid) for pid in product_ids]
+        if len(expected_ids) != expected_K or len(set(expected_ids)) != expected_K:
+            return None
+
+        id_to_score = {}
+        for item in arr:
+            if not isinstance(item, dict) or "product_id" not in item or "score" not in item:
+                return None
+            pid = str(item["product_id"])
+            if pid not in expected_ids or pid in id_to_score:
+                return None
+            id_to_score[pid] = float(item["score"])
+
+        if set(id_to_score) != set(expected_ids):
+            return None
+        return [id_to_score[pid] for pid in expected_ids]
+    except Exception:
+        pass
+    return None
