+    h = ErropdHooks(make_cfg(cfg), TOK)
+    h.pre_ref(dp)
+    h.on_batch(dp, 1, {})
+    rt = cloudpickle.loads(cloudpickle.dumps(dp))
+    same = set(rt.batch.keys()) == set(dp.batch.keys()) and all(torch.equal(rt.batch[k], dp.batch[k]) for k in dp.batch.keys()) \
+        and rt.meta_info == dp.meta_info
+    chunks = rt.chunk(2)
+    same &= all(c.meta_info == dp.meta_info for c in chunks)
+    ok_all &= same
+    detail.append(f"{list(cfg) or ['flags-off']}:{'ok' if same else 'MISMATCH'}")
+check("T15 DataProto with ERROPD tensors/meta survives cloudpickle round-trip and chunking, every arm", ok_all, " ".join(detail))
+
+# ---------------------------------------------------------------- T16 R2G baseline on a non-listwise (math) batch
+dpm, _ = make_batch(CASES)
