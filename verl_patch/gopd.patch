@@ -0,0 +1,771 @@
+"""Driver-side ERROPD hooks for OPD on K=8 listwise JSON ranking.
+
+All decisions are made on the driver (RayPPOTrainer.fit), after the batch has
+old/ref/base log-probs and before update_actor. The actor only consumes two
+optional per-token tensors:
+
+  erropd_token_lambda  float [bs, L]  lambda applied at each response token
+  erropd_loss_mask     float [bs, L]  1 = keep, 0 = zero this token's pg loss
+
+They are added to the batch ONLY when a training intervention is enabled.
+With every flag off, the batch that reaches update_actor is untouched (same
+keys, same tensors), so the actor runs the production code path. Logging
+(rollout validity, failure types, per-class advantage) is always on and only
+reads the batch.
+
+Config (all under a top-level `erropd` group, passed as `+erropd.<key>=...`):
+
+  token_class_lambda: off | only_score | only_id | only_term | all_but_term | only_scaffold |
+      all_but_scaffold | id_score.  lambda_t on the selected classes, 1.0 elsewhere (B3).
+      Classes (listwise_contract): id, score, term (the '}' closing each list element, the ','
+      between elements, the list-closing ']', EOS), scaffold (everything else).
+  lambda_max: float, default = actor_rollout_ref.actor.policy_loss.lambda_vals
+  mask: off | invalid_rollout | from_violation | after_violation
+      invalid_rollout (B4 a): zero the loss of rollouts failing the strict parser.
+      from_violation (B4 b): zero the loss of the token containing the first contract
+      violation and of every later token.
+      after_violation (B4 b'): zero the loss of tokens strictly after that token (the
+      violating token keeps its loss).
+  gate_tau: float or null. If set (C2): lambda_t = lambda_max if the strict-parse
+      pass fraction of step t-1's rollouts >= gate_tau, else 1.0; step 1 uses 1.0.
+  gate_estimator: eligible | raw  (default eligible: only prompts whose K input ids
+      are unique enter the fraction; the parser rejects every output on the others).
+  lambda_schedule: [[start_step, lambda], ...]  piecewise constant, 1-indexed steps,
+      e.g. [[1,1.0],[21,1.25]] = steps 1..20 at 1.0, steps 21.. at 1.25 (C1).
+  lambda_warmup_steps / lambda_warmup_value: bracket-free shorthand for the two-piece
+      schedule [[1, value], [steps+1, lambda_max]] (safe inside unquoted shell variables).
+  stop_after_kept_rollouts: int or null. End training after the step at which the
+      cumulative number of rollouts with nonzero loss mass reaches this value.
+  save_steps: [int, ...] or "20x48x62"  extra checkpoint steps (in addition to save_freq / last).
+  dump_rollouts: bool (default false)  append per-rollout records to
+      <log_dir>/erropd_rollouts.jsonl.
+  log_dir: default trainer.default_local_dir. Per-step metrics are appended to
+      <log_dir>/erropd_step_metrics.jsonl.
+  plaus_alpha: float or null (B3p). lambda_t = lambda_max on sampled tokens whose teacher probability is at
+      least alpha x the teacher's max probability at that state (contrastive-decoding plausibility), 1.0 elsewhere.
+      Needs the teacher's per-position max log-prob, requested from the teacher pass only when this is set.
+  sg_gate: bool (B6, SG-OPD sign-consistency gate, Xu et al. arXiv 2606.09304, gate-only variant).
+      lambda_t = lambda_max where the verifier signal a1 and the teacher's push on the sampled token agree in sign,
+      a1 = sign(valid_i - mean valid over the step's eligible rollouts) (verifier = the strict parser; one rollout
+      per prompt, so the baseline is the batch mean), teacher push = sign(log pT - log pS); 1.0 elsewhere
+      (their beta = 1: conflict tokens get the plain OPD advantage). Ineligible prompts: a1 = 0.
+  format_bonus_beta: float or null (B7). Adds beta * (valid_i - mean valid over eligible rollouts) to the advantage
+      of every response token of rollout i (0 for prompts with repeated input ids).
+  log_update_norm: bool (default true)  actor logs ||theta_{t+1}-theta_t|| and ||theta||
+      (read-only; used to compare effective update size across arms).
+  reopd: bool (default false)  REOPD token-wise coefficient (Sun et al., arXiv 2608.11698):
+      lambda_t = 1 + gamma_b * q_t,  q_t = exp(-(e^x - x - 1)/tau),  x = log piT - log piS
+      at the sampled token, gamma_b from their Eq. 8-12 controller, one controller call
+      per synchronized actor micro-batch (statistics over all DP ranks' rows of that
+      micro-batch). Parameters: reopd_tau (0.007), reopd_gamma_max (default lambda_max-1),
+      reopd_kappa (0.5), reopd_beta (0.95), reopd_beta_gamma (0.9), reopd_k0 (10),
+      reopd_warmup_calls (0), reopd_warmup_gamma (0.25).
+      Unspecified in the paper and fixed here: gamma_0 = 0; EMAs start at the first
+      observation; B0 = kappa * running mean of RMS(a) over calls 1..k0, then frozen;
+      eps = 1e-8.
+
+Masking zeroes advantages (hence the per-token loss) but leaves response_mask,
+and therefore the token-mean normalizer, unchanged: the update equals the
+vanilla update minus the masked tokens' terms.
+"""
+
+import json
+import os
+import time
+
+import numpy as np
+import torch
+
+from verl.erropd import listwise_contract as lc
+
+_CLASS_MODES = {
+    "off": None,
+    "only_score": {lc.SCORE},
+    "only_id": {lc.ID},
+    "only_term": {lc.TERM},
+    "all_but_term": {lc.SCAFFOLD, lc.ID, lc.SCORE},
+    "only_scaffold": {lc.SCAFFOLD},
+    "all_but_scaffold": {lc.ID, lc.SCORE, lc.TERM},
+    "id_score": {lc.ID, lc.SCORE},
+}
+_MASK_MODES = ("off", "invalid_rollout", "from_violation", "after_violation")
+
+
+def _cfg_get(cfg, key, default=None):
+    if cfg is None:
+        return default
+    try:
+        v = cfg.get(key, default)
+    except Exception:
+        v = getattr(cfg, key, default)
+    return default if v is None and default is not None else v
+
+
+class TokenSpanDecoder:
+    """Decode response token ids to text plus per-token character spans.
+
+    text == tokenizer.decode(ids, skip_special_tokens=True) (the string the eval
+    parses, modulo vLLM's own detokenizer). Fast path: byte-level pieces when the
+    output is pure ASCII; otherwise incremental prefix decoding.
+    """
+
+    def __init__(self, tokenizer):
+        self.tok = tokenizer
+        self.special_ids = set(int(i) for i in (tokenizer.all_special_ids or []))
+        try:
+            for tid, at in tokenizer.added_tokens_decoder.items():
+                if getattr(at, "special", False):
+                    self.special_ids.add(int(tid))
+        except Exception:
+            pass
+        try:
+            from transformers.models.gpt2.tokenization_gpt2 import bytes_to_unicode
+
+            self.byte_decoder = {v: k for k, v in bytes_to_unicode().items()}
+        except Exception:
+            self.byte_decoder = None
+        self.added_ids = set()
+        try:
+            self.added_ids = set(int(i) for i in tokenizer.added_tokens_decoder.keys())
+        except Exception:
+            pass
+        self.n_fallback = 0
+
+    def _piece_bytes(self, tid, piece):
+        if tid in self.special_ids:
+            return b""
+        if tid in self.added_ids:
+            return piece.encode("utf-8")
+        return bytes(self.byte_decoder[c] for c in piece)
+
+    def decode(self, ids):
+        ids = [int(i) for i in ids]
+        text = self.tok.decode(ids, skip_special_tokens=True)
+        if self.byte_decoder is not None:
+            try:
+                pieces = self.tok.convert_ids_to_tokens(ids)
+                bs = [self._piece_bytes(t, p) for t, p in zip(ids, pieces)]
+                joined = b"".join(bs)
+                if all(b < 0x80 for b in joined) and joined.decode("ascii") == text:
+                    spans, pos = [], 0
+                    for b in bs:
+                        spans.append((pos, pos + len(b)))
+                        pos += len(b)
+                    return text, spans
+            except Exception:
+                pass
+        # fallback: incremental prefix decoding (monotone clamp)
+        self.n_fallback += 1
+        spans, prev = [], 0
+        for i in range(len(ids)):
+            cur = len(self.tok.decode(ids[: i + 1], skip_special_tokens=True))
+            cur = max(cur, prev)
+            spans.append((prev, cur))
+            prev = cur
+        return text, spans
+
+
+def char_to_token(ci, spans):
+    for t, (a, b) in enumerate(spans):
+        if a <= ci < b:
+            return t
+    return None
+
+
+class ErropdHooks:
+    def __init__(self, config, tokenizer):
+        ncfg = config.get("erropd", None) if hasattr(config, "get") else None
