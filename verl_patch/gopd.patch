index 0000000..6652a5f
--- /dev/null
+++ b/verl/tests/erropd/fi_cost.py
@@ -0,0 +1,113 @@
+"""CPU cost of the FI field at the real vocabulary (151,936), against the rkl_full loss it replaces and the alpha gate.
+
+  PYTHONPATH=<tree>/verl python fi_cost.py [--rows 256] [--reps 3]
+
+Each variant runs in its own subprocess on the same (1, rows, 151936) fp32 log-probs (a peaked student, a teacher
+that differs in the tail), and reports wall time per call and the process's peak-RSS increase over the inputs:
+  rkl_loss   the existing arm's loss and backward to the logits: s = log_softmax(z), sum_v e^s (s - t), autograd
+  alpha1     _paper_alpha_omega(alpha=1) (the alpha gate's diagnostics on the untouched rkl_full step)
+  fi_fp64    _paper_fi_omega(fir), float64 build (the shipped default), chunk = rows
+  fi_fp32    _paper_fi_omega(fir), fp32 arithmetic (test-only), chunk = rows
+  fi_surr    fi_fp64 plus the surrogate's forward and backward to the logits
+  fkl_fp64   _paper_fi_omega(fklfull), float64 build
+  fkd_fp64   _paper_fi_omega(fkldec), float64 build, every 100th row a decision state (E1)
+CPU timings are not GPU timings; the ratios are what transfers (both are memory-bound elementwise passes).
+"""
+import argparse
+import json
+import os
+import resource
+import subprocess
+import sys
+import time
+
+V = 151936
+
+
+def inputs(rows):
+    import torch
+
+    g = torch.Generator().manual_seed(0)
+    zs = 2.0 * torch.randn(1, rows, V, generator=g)
+    zs[..., 100] = 28.0
+    zt = zs + 0.3 * torch.randn(1, rows, V, generator=g)
+    zt[..., 101] = 27.0
+    return zs.bfloat16().float(), torch.log_softmax(zt.bfloat16().float(), -1)
+
+
+def run_variant(name, rows, reps):
+    import torch
+
+    from verl.workers.actor.dp_actor import DataParallelPPOActor as A
+
+    torch.set_num_threads(int(os.environ.get("FI_COST_THREADS", "16")))
+    zs, t = inputs(rows)
+    s = torch.log_softmax(zs, -1)
+    base = resource.getrusage(resource.RUSAGE_SELF).ru_maxrss
+    cfg = {"mode": "fir", "dir": "g1", "tgt": "d", "fp64": name != "fi_fp32", "identity": False, "floor": 0.0,
+           "chunk": rows}
+    times = []
+    for _ in range(reps):
+        t0 = time.perf_counter()
+        if name == "rkl_loss":
+            z = zs.clone().requires_grad_(True)
+            ss = torch.log_softmax(z, -1)
+            loss = (ss.exp() * (ss - t)).sum(-1).mean()
+            (g,) = torch.autograd.grad(loss, z)
+            del g, ss, z
+        elif name == "alpha1":
+            om, st = A._paper_alpha_omega(s, t, 1.0, True, chunk=rows, err_token=25439)
+            del om, st
+        elif name in ("fi_fp64", "fi_fp32"):
+            om, st = A._paper_fi_omega(s, t, cfg, err_token=25439)
+            del om, st
+        elif name in ("fkl_fp64", "fkd_fp64"):
+            dec = name == "fkd_fp64"
+            c2 = {**cfg, "mode": "fkldec" if dec else "fklfull", "tgt": "g1" if dec else "d", "dir": "d",
+                  "where": "dec" if dec else "all"}
+            rr = None
+            if dec:
+                rr = torch.zeros(1, rows, dtype=torch.bool)
+                rr[0, ::100] = True
+            om, st = A._paper_fi_omega(s, t, c2, err_token=25439, rescale_rows=rr)
+            del om, st
+        elif name == "fi_surr":
+            z = zs.clone().requires_grad_(True)
+            ss = torch.log_softmax(z, -1)
+            om, st = A._paper_fi_omega(ss, t, cfg, err_token=25439)
+            loss = (om * ss).sum(-1).mean()
+            (g,) = torch.autograd.grad(loss, z)
+            del g, ss, z, om, st
+        times.append(time.perf_counter() - t0)
+    peak = resource.getrusage(resource.RUSAGE_SELF).ru_maxrss
+    print(json.dumps({"variant": name, "rows": rows, "s_per_call_min": min(times), "s_per_call_all": times,
+                      "peak_rss_increase_GB": (peak - base) / 1e6}))
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--rows", type=int, default=256)
+    ap.add_argument("--reps", type=int, default=3)
+    ap.add_argument("--variant", default=None)
+    a = ap.parse_args()
+    if a.variant:
+        run_variant(a.variant, a.rows, a.reps)
+        return
+    out = {}
+    for v in ("rkl_loss", "alpha1", "fi_fp32", "fi_fp64", "fi_surr", "fkl_fp64", "fkd_fp64"):
+        r = subprocess.run([sys.executable, __file__, "--variant", v, "--rows", str(a.rows), "--reps", str(a.reps)],
+                           capture_output=True, text=True)
+        line = [x for x in r.stdout.splitlines() if x.startswith("{")]
+        out[v] = json.loads(line[-1]) if line else {"error": r.stderr[-500:]}
+        print(json.dumps(out[v]), flush=True)
+    b = out["rkl_loss"].get("s_per_call_min")
+    if b:
+        for v in out:
+            if "s_per_call_min" in out[v]:
+                print(f"{v:9s} {out[v]['s_per_call_min']:.3f} s per {a.rows}-row chunk "
+                      f"({out[v]['s_per_call_min'] / b:.2f}x the rkl_full loss+backward), "
+                      f"peak RSS +{out[v]['peak_rss_increase_GB']:.2f} GB")
+
+
+if __name__ == "__main__":
+    main()
