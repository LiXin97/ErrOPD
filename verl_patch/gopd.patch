index 0000000..9f70f3d
--- /dev/null
+++ b/verl/verl/erropd/r2g.py
@@ -0,0 +1,36 @@
+"""Reward-to-go of a per-token advantage (R2G study, PAPER_ADV_MODE).
+
+reward_to_go(a, mask, gamma)[i, t] = sum_{t' >= t} gamma^(t'-t) a[i, t'] mask[i, t'], times mask[i, t].
+Computed in float64. gamma = 1: reverse cumsum. gamma < 1: blocked recursion (vectorized inside blocks of positions
+via the gamma^k scaling trick, a short loop across blocks), so long responses cost a few dozen kernel calls instead of
+one per token. The block length keeps gamma^block >= 1e-250, so the scaling never underflows in float64.
+"""
+import math
+
+import torch
+
+
+def reward_to_go(a, mask, gamma):
+    x = (a * mask).double()
+    if gamma == 1.0:
+        r = torch.flip(torch.cumsum(torch.flip(x, dims=[1]), dim=1), dims=[1])
+        return r * mask.double()
+    if not (0.0 <= gamma < 1.0):
+        raise ValueError(f"gamma must be in [0, 1], got {gamma}")
+    if gamma == 0.0:
+        return x * mask.double()
+    block = max(1, min(256, int(250.0 / -math.log10(gamma))))
+    N, L = x.shape
+    out = torch.empty_like(x)
+    carry = torch.zeros(N, dtype=x.dtype, device=x.device)
+    for end in range(L, 0, -block):
+        start = max(0, end - block)
+        n = end - start
+        k = torch.arange(n, dtype=x.dtype, device=x.device)
+        w = gamma ** k                                                       # gamma^k, k = 0..n-1
+        seg = x[:, start:end] * w
+        rc = torch.flip(torch.cumsum(torch.flip(seg, dims=[1]), dim=1), dims=[1])  # sum_{k'>=k} gamma^k' x_k'
+        r = rc / w + carry[:, None] * gamma ** (n - k)                         # + gamma^(n-k) * carry
+        out[:, start:end] = r
+        carry = r[:, 0]
+    return out * mask.double()
