+        if err_token is not None and not (0 <= int(err_token) < V):
+            raise ValueError(f"[paper] PAPER_ALPHA_ERR_TOKEN={err_token} is outside the vocabulary (size {V})")
+        s_all = lp_s.detach().reshape(-1, V)
+        t_all = lp_t.reshape(-1, V)
+        n_rows = s_all.shape[0]
+        om = torch.empty_like(s_all)
+        keys = ("n_a1", "n_pre", "n_post", "scale", "cos", "l1", "zsum", "om_err", "p_err", "r_err")
+        st = {k: torch.zeros(n_rows, dtype=torch.float32, device=s_all.device) for k in keys}
+        for i in range(0, n_rows, max(1, int(chunk))):
+            j = min(i + max(1, int(chunk)), n_rows)
+            ls, lt = s_all[i:j], t_all[i:j]
+            p = ls.exp()
+            r = ls - lt
+            r = r - (p * r).sum(-1, keepdim=True)  # r = lp_s - lp_t - L
+            g1 = p * r
+            if alpha == 1.0:
+                w = g1  # sum_v g1 = 0 identically; centering would only add float noise
+            else:
+                w = r.clone() if alpha == 0.0 else p.pow(alpha) * r
+                w -= w.sum(-1, keepdim=True) * p  # analytic centering
+                w -= w.sum(-1, keepdim=True) * p  # float cleanup of the same identity
+            n_a1 = g1.norm(dim=-1)
+            n_pre = w.norm(dim=-1)
+            if renorm:
+                sc = n_a1 / n_pre.clamp_min(eps)  # a floor, not an additive smoother: sc == 1.0 exactly at alpha == 1
+                w = w * sc.unsqueeze(-1)
+            else:
+                sc = torch.ones_like(n_a1)
+            om[i:j] = w
+            st["n_a1"][i:j] = n_a1
+            st["n_pre"][i:j] = n_pre
+            st["n_post"][i:j] = w.norm(dim=-1)
+            st["scale"][i:j] = sc
+            st["cos"][i:j] = (w * g1).sum(-1) / (st["n_post"][i:j] * n_a1).clamp_min(eps)
+            st["l1"][i:j] = w.abs().sum(-1)
+            st["zsum"][i:j] = w.sum(-1).abs()
+            if err_token is not None:
+                st["om_err"][i:j] = w[:, err_token]
+                st["p_err"][i:j] = p[:, err_token]
+                st["r_err"][i:j] = r[:, err_token]
+            del p, r, g1, w
+        return om.view(B, T, V), {k: v.view(B, T) for k, v in st.items()}
+
+    @staticmethod
+    def _paper_alpha_metrics(cfg, st, masks, om):
+        """PAPER alpha gate: the per-micro-batch diagnostics the record reports. `om` is the masked weight tensor.
+        Gradient-mass shares are L1 shares of the applied per-logit weight, which is what the step is spread over.
+        """
+        m = {"paper/alpha": float(cfg["alpha"]), "paper/alpha_renorm": 1.0 if cfg["renorm"] else 0.0,
+             "paper/alpha_applied": 1.0 if cfg["apply"] else 0.0}
+        a = masks["all"]
+        n = a.sum().clamp(min=1)
+
+        def mean(x, k=a):
+            kk = k.to(x.dtype)
+            return float((x * kk).sum() / kk.sum().clamp(min=1))
+
+        m["paper/alpha_gnorm_a1"] = mean(st["n_a1"])
+        m["paper/alpha_gnorm_pre"] = mean(st["n_pre"])
+        m["paper/alpha_gnorm_post"] = mean(st["n_post"])
+        _sc = st["scale"][a]
+        m["paper/alpha_scale_mean"] = float(_sc.mean()) if _sc.numel() else 0.0
+        m["paper/alpha_scale_min"] = float(_sc.min()) if _sc.numel() else 0.0
+        m["paper/alpha_scale_max"] = float(_sc.max()) if _sc.numel() else 0.0
+        m["paper/alpha_cos_to_a1"] = mean(st["cos"])
+        _z = (st["zsum"] / st["l1"].clamp_min(1e-30))[a]
+        m["paper/alpha_zerosum_rel_max"] = float(_z.max()) if _z.numel() else 0.0
+        # the error decision: p_theta, the residual, the weight carried, and the share of the L1 gradient mass
+        _l1_tot = float((st["l1"] * a.to(st["l1"].dtype)).sum())
+        for tag, k in masks.items():
+            kk = k.to(om.dtype)
+            m[f"paper/alpha_n_{tag}"] = float(k.sum())
+            if float(k.sum()) == 0:
+                continue
+            m[f"paper/alpha_p_err_{tag}"] = mean(st["p_err"], k)
+            m[f"paper/alpha_r_err_{tag}"] = mean(st["r_err"], k)
+            m[f"paper/alpha_om_err_{tag}"] = mean(st["om_err"], k)
+            # per-prefix share of that prefix's own L1 mass, averaged over the positions of the set
+            m[f"paper/alpha_err_share_{tag}"] = mean(st["om_err"].abs() / st["l1"].clamp_min(1e-30), k)
+            # and the share of the whole micro-batch's L1 mass that this set's error logits carry
+            m[f"paper/alpha_err_mass_frac_{tag}"] = (
+                float((st["om_err"].abs() * kk).sum()) / _l1_tot if _l1_tot > 0 else 0.0)
+        del n
+        return m
+
+    @staticmethod
+    def _paper_alpha_masks(responses, response_mask, boundary_token, err_slot):
+        """PAPER alpha gate diagnostics: the three position sets the record reports on.
+        all      every masked response position;
+        bnd      positions whose sampled token is boundary_token (the single-token item separator "}," on ESCI):
+                 the item-boundary decisions, i.e. the states at which closing the list early is the injected error;
+        slot     the err_slot-th such position in the row (slot 7 of a K=8 list = the item-7 decision).
+        """
+        m_all = response_mask.bool()
+        if boundary_token is None:
+            return {"all": m_all}
+        is_b = (responses == int(boundary_token)) & m_all
+        out = {"all": m_all, "bnd": is_b}
+        if err_slot is not None:
+            out["slot"] = is_b & (is_b.cumsum(-1) == int(err_slot))
+        return out
+
+    @staticmethod
+    def _paper_fi_dec_mask(responses, response_mask, item_end_tokens, k):
+        """PAPER FI: the item-k decision states, defined by the STATE and not by the outcome: the position of the k-th
+        response token, counted per row over masked positions, that is any item-end token ("}," continuing or "}]"
+        closing). The token sampled at that position is the decision taken there, so a row that closes at item k (the
+        injected error) is in the mask exactly as a row that continues is. A row with fewer than k items has none."""
+        m = response_mask.bool()
+        is_e = torch.zeros_like(m)
+        for tok in item_end_tokens:
+            is_e |= responses == int(tok)
+        is_e &= m
+        return is_e & (is_e.cumsum(-1) == int(k))
+
+    @staticmethod
+    def _paper_fi_omega(lp_s, lp_t, cfg, err_token=None, rescale_rows=None):
+        """PAPER factor isolation (detached): the per-logit weight omega of the FI step at every prefix row.
+
+        With l = lp_s, m = lp_t (re-normalised in float64 when cfg["fp64"]), p = e^l, q = e^m, r = l - m - L,
+        L = sum_v p_v (l_v - m_v):
+            g1 = p (.) r     the full-vocabulary reverse KL's logit gradient (rkl_full's)
+            d  = p - q       the full-vocabulary forward KL's, sum_v q_v (m_v - l_v)
+        omega = dir * scale with (dir, target) from PAPER_FI_MODES and scale = ||target|| / ||dir||, except: scale is 1
+        for fklfull and ctl, under the identity switch, at rows outside `rescale_rows` (a (B, T) bool mask; FI-S,
+        fkldec and rkldose pass their decision states), at rows whose ||dir|| is below cfg["floor"], and at rows whose
+        ||dir|| is exactly 0
+        (omega = 0 there; counted). Both g1 and d sum to zero over the vocabulary, so the surrogate sum_v omega_v lp_s,v
+        (omega detached) has logit gradient omega - p sum_v omega_v = omega up to the fp32 cast, as in the alpha gate.
+        The scale is positive wherever dir != 0, and r = 0 <=> d = 0 <=> pi_S = pi_T, so every mode keeps rkl_full's
+        stationary point. rkldose (target "kg1"): the scale is k = cfg["dose"] itself (no division) on the rescaled
+        rows; omega is the fp32 cast of g1 times fp32(k) on those rows (k applied AFTER the cast) and the fp32 cast of
+        g1 elsewhere; the float64 w = g1 * k stands for it in the row statistics. Precision: cfg["fp64"] re-normalises the fp32 log-probs in float64 and builds r, g1, d and both
+        norms there, then casts omega to fp32 (). Row-chunked (cfg["chunk"]).
+
+        Returns (omega: fp32, shaped like lp_s; stats: dict of (B, T) fp32 tensors):
+            n_g1, n_d    ||g1||_2, ||d||_2            ratio  ||d|| / ||g1|| (the FI-R factor; 0 where ||g1|| = 0)
+            n_want       the target norm the mode means to apply at the row (the direction's own norm under the
+                         identity switch, off FI-S's / fkldec's / rkldose's rows, and for fklfull / ctl; k ||g1|| on
+                         rkldose's rows), before the floor and zero fallbacks
+            scale        the factor applied to the direction      floor, zero   1.0 where the floor / ||dir|| = 0 hit
+            n_app        ||a||_2 of the logit gradient the surrogate applies, a = omega32 - p sum_v omega32_v
+            cos_g1       cos(a, g1)                   cos_rf   cos(g1, d)          cos_d   cos(a, d)
+            l1, zsum     ||omega32||_1, |sum_v omega32_v| (float64 accumulation)
+            rkl, fkl     sum_v p (l - m) and sum_v q (m - l) per prefix
+            p_err, q_err, g1_err, d_err, om_err      at err_token
+        """
+        B, T, V = lp_s.shape
+        if err_token is not None and not (0 <= int(err_token) < V):
+            raise ValueError(f"[paper] PAPER_ALPHA_ERR_TOKEN={err_token} is outside the vocabulary (size {V})")
+        fp64, ident, floor, chunk = bool(cfg["fp64"]), bool(cfg["identity"]), float(cfg["floor"]), int(cfg["chunk"])
+        if cfg.get("where") == "dec" and rescale_rows is None:
+            # without its mask a 'dec' mode would rescale every row (fkldec would be the retired all-prefix FI-F)
+            raise ValueError(f"[paper] PAPER_FI_MODE={cfg.get('mode')} needs its decision-state mask (rescale_rows)")
+        same = cfg["dir"] == cfg["tgt"]  # fklfull and ctl: the direction at its own norm, no division
+        dose = cfg.get("tgt") == "kg1"   # rkldose: the direction times a fixed k on the rescaled rows, no division
+        kd = 1.0 if (not dose or ident) else float(cfg["dose"])
+        tiny = 1e-300 if fp64 else 1e-30
+        s_all = lp_s.detach().reshape(-1, V)
+        t_all = lp_t.detach().reshape(-1, V)
+        n_rows = s_all.shape[0]
+        rr_all = None if rescale_rows is None else rescale_rows.reshape(-1).bool()
+        om = torch.empty(s_all.shape, dtype=torch.float32, device=s_all.device)
+        keys = ("n_g1", "n_d", "ratio", "n_want", "scale", "floor", "zero", "n_app", "cos_g1", "cos_rf", "cos_d", "l1",
+                "zsum", "rkl", "fkl", "p_err", "q_err", "g1_err", "d_err", "om_err")
+        st = {k: torch.zeros(n_rows, dtype=torch.float32, device=s_all.device) for k in keys}
+        step = max(1, chunk)
+        for i in range(0, n_rows, step):
+            j = min(i + step, n_rows)
+            ls, lt = s_all[i:j], t_all[i:j]
+            if fp64:
+                ls = torch.log_softmax(ls.double(), -1)
+                lt = torch.log_softmax(lt.double(), -1)
+            r = ls - lt
+            p = ls.exp()
+            del ls
+            q = lt.exp()
+            del lt
+            fkl = -(q * r).sum(-1)                   # sum_v q_v (m_v - l_v)
+            L = (p * r).sum(-1, keepdim=True)        # sum_v p_v (l_v - m_v)
+            r = r - L                                # r = l - m - L (the alpha gate's expression, same order)
+            g1 = p * r
+            del r
+            d = p - q
+            if err_token is not None:
+                st["p_err"][i:j] = p[:, err_token]
+                st["q_err"][i:j] = q[:, err_token]
+            del q
+            n1 = g1.norm(dim=-1)
+            nd = d.norm(dim=-1)
+            vd, nv = (g1, n1) if cfg["dir"] == "g1" else (d, nd)
+            want = nv if (same or ident) else (nv * kd if dose else (nd if cfg["tgt"] == "d" else n1))
+            if rr_all is not None:
+                want = torch.where(rr_all[i:j], want, nv)  # outside the rescaled rows the direction keeps its norm
+            zero = nv == 0
+            hit = (nv < floor) & ~zero if not same else torch.zeros_like(zero)
+            if same:
+                sc = torch.ones_like(nv)             # exactly 1: the direction is applied as it is
+                w = vd
+            elif dose:
+                # exactly k on the rescaled rows, exactly 1 elsewhere (and at floor / zero-norm rows)
+                sc = torch.ones_like(nv) if rr_all is None else torch.where(rr_all[i:j], torch.full_like(nv, kd),
+                                                                            torch.ones_like(nv))
+                sc = torch.where(hit | zero, torch.ones_like(sc), sc)
+                w = vd * sc.unsqueeze(-1)
+            else:
+                nt = nv if ident else want
+                sc = nt / nv.clamp_min(tiny)         # exactly 1.0 where nt is nv (x / x)
+                sc = torch.where(hit | zero, torch.ones_like(sc), sc)
+                w = vd * sc.unsqueeze(-1)
+            if dose:
+                om[i:j] = vd                         # the unscaled field, cast to fp32 ...
+                om[i:j].mul_(sc.to(torch.float32).unsqueeze(-1))  # ... times fp32(k) on the rescaled rows (x 1 else)
+            else:
+                om[i:j] = w
+            o = om[i:j]
+            # the logit gradient the surrogate actually applies, a = o - p sum_v o_v (log-softmax Jacobian), measured
+            # through row dot products so that no extra (chunk, V) buffer is needed; w stands for o in the dots (they
+            # differ by the fp32 cast only), the cast's zero-sum residual s_o enters exactly
+            s_o = o.sum(-1, dtype=torch.float64)
+            pg, pw, pp = (p * g1).sum(-1), (p * w).sum(-1), (p * p).sum(-1)
+            wg, ww = (w * g1).sum(-1), (w * w).sum(-1)
+            pd_, wd_ = (p * d).sum(-1), (w * d).sum(-1)  # cos(a, d): the direction check of the d-direction modes
+            n_app = (ww - 2 * s_o * pw + s_o * s_o * pp).clamp_min(0).sqrt()
+            st["n_g1"][i:j] = n1
+            st["n_d"][i:j] = nd
+            st["ratio"][i:j] = torch.where(n1 > 0, nd / n1.clamp_min(tiny), torch.zeros_like(nd))
+            st["n_want"][i:j] = want
+            st["scale"][i:j] = sc
+            st["floor"][i:j] = hit.to(torch.float32)
+            st["zero"][i:j] = zero.to(torch.float32)
+            st["n_app"][i:j] = n_app
+            st["cos_g1"][i:j] = (wg - s_o * pg) / (n_app * n1).clamp_min(tiny)
+            st["cos_rf"][i:j] = (g1 * d).sum(-1) / (n1 * nd).clamp_min(tiny)
+            st["cos_d"][i:j] = (wd_ - s_o * pd_) / (n_app * nd).clamp_min(tiny)
+            st["l1"][i:j] = o.abs().sum(-1, dtype=torch.float64)
+            st["zsum"][i:j] = s_o.abs()
+            st["rkl"][i:j] = L.squeeze(-1)
+            st["fkl"][i:j] = fkl
+            if err_token is not None:
+                st["g1_err"][i:j] = g1[:, err_token]
+                st["d_err"][i:j] = d[:, err_token]
+                st["om_err"][i:j] = o[:, err_token]
+            del p, g1, d, w, vd, o
+        return om.view(B, T, V), {k: v.view(B, T) for k, v in st.items()}
+
+    @staticmethod
+    def _paper_fi_metrics(cfg, st, masks, responses=None):
+        """PAPER factor isolation: the per-micro-batch diagnostics (rank-local; see fi.md sec. 7). `masks`
+        holds the position sets (all, bnd, slot from _paper_alpha_masks, and the state-defined dec). Mass is the L2 norm
+        of a prefix's logit gradient. Shares are emitted two ways: per micro-batch (`*_share_<set>`, only when the set
+        is non-empty), and as sums that are always emitted (`*_sum_<set>`), so that the ratio of their step means,
+        sum_<set> / sum_all, is the step-level (rank-local) share."""
+        m = {"paper/fi_mode": cfg["code"], "paper/fi_identity": 1.0 if cfg["identity"] else 0.0,
+             "paper/fi_fp64": 1.0 if cfg["fp64"] else 0.0, "paper/fi_floor": float(cfg["floor"]),
+             "paper/fi_applied": 1.0 if cfg["apply"] else 0.0}
+        if cfg.get("dose") is not None:
+            m["paper/fi_dose"] = float(cfg["dose"])   # rkldose only (no other mode emits it)
+        if cfg.get("force_surrogate"):
+            m["paper/fi_force_surrogate"] = 1.0       # the DOSE k = 1 surrogate control only
+        a = masks["all"]
+
+        def mean(x, k=a):
+            kk = k.to(x.dtype)
+            return float((x * kk).sum() / kk.sum().clamp(min=1))
+
+        def total(x, k):
+            return float((x.double() * k.to(torch.float64)).sum())
+
+        nz = a & (st["zero"] == 0)
+        m["paper/fi_g1_norm"] = mean(st["n_g1"])
+        m["paper/fi_d_norm"] = mean(st["n_d"])
+        m["paper/fi_app_norm"] = mean(st["n_app"])
+        m["paper/fi_want_norm"] = mean(st["n_want"])
+        m["paper/fi_fkl_full"] = mean(st["fkl"])
+        m["paper/fi_rkl_check"] = mean(st["rkl"])
+        _r, _s = st["ratio"][nz], st["scale"][a]
+        if _r.numel():
+            m["paper/fi_ratio_mean"] = float(_r.mean())
+            m["paper/fi_ratio_med"] = float(_r.median())
+            m["paper/fi_ratio_min"] = float(_r.min())
+            m["paper/fi_ratio_max"] = float(_r.max())
+            m["paper/fi_ratio_log10_mean"] = float(_r.clamp_min(1e-30).log10().mean())
+        if _s.numel():
+            m["paper/fi_scale_mean"] = float(_s.mean())
+            m["paper/fi_scale_min"] = float(_s.min())
+            m["paper/fi_scale_max"] = float(_s.max())
+        # the lock's N1: realised per-prefix norm against the nominal target, applied direction against g1, zero-norm
+        # prefixes, the ||d||-weighted angle between the two directions (P_col), the floor
+        _dev = ((st["n_app"].double() / st["n_want"].double().clamp_min(1e-300)) - 1.0).abs()[nz & (st["floor"] == 0)]
+        m["paper/fi_normdev_mean"] = float(_dev.mean()) if _dev.numel() else 0.0
+        m["paper/fi_normdev_max"] = float(_dev.max()) if _dev.numel() else 0.0
+        _c = st["cos_g1"][nz]
+        m["paper/fi_cos_to_g1_mean"] = float(_c.mean()) if _c.numel() else 1.0
+        m["paper/fi_cos_to_g1_min"] = float(_c.min()) if _c.numel() else 1.0
+        # the direction check of the modes that apply d (fklfull, fkldec): applied gradient against d = p - q. For the
+        # g1 modes it is the RKL/FKL angle; for the d modes cos_to_g1 is.
+        _cd = st["cos_d"][nz]
+        m["paper/fi_cos_to_d_mean"] = float(_cd.mean()) if _cd.numel() else 1.0
+        m["paper/fi_cos_to_d_min"] = float(_cd.min()) if _cd.numel() else 1.0
+        m["paper/fi_zero_n"] = float((a & (st["zero"] > 0)).sum())
+        m["paper/fi_zero_share"] = mean(st["zero"])
+        _wt = total(st["n_want"], a)
+        m["paper/fi_zero_want_share"] = total(st["n_want"], a & (st["zero"] > 0)) / _wt if _wt > 0 else 0.0
+        m["paper/fi_floor_share"] = mean(st["floor"])
+        m["paper/fi_cos_rkl_fkl"] = mean(st["cos_rf"])
+        _dsum = total(st["n_d"], a)
+        m["paper/fi_dcos_sum_all"] = total(st["n_d"] * st["cos_rf"], a)
+        m["paper/fi_pcol"] = m["paper/fi_dcos_sum_all"] / _dsum if _dsum > 0 else 1.0
+        _z = (st["zsum"] / st["l1"].clamp_min(1e-30))[a]
+        m["paper/fi_zerosum_rel_max"] = float(_z.max()) if _z.numel() else 0.0
+        tot_app, tot_want, tot_l1 = total(st["n_app"], a), _wt, total(st["l1"], a)
+        for tag, k in masks.items():
+            m[f"paper/fi_n_{tag}"] = float(k.sum())
+            # sums, always emitted (zero for an empty set): step-level shares are ratios of their step means
+            m[f"paper/fi_app_sum_{tag}"] = total(st["n_app"], k)
+            m[f"paper/fi_want_sum_{tag}"] = total(st["n_want"], k)
+            m[f"paper/fi_g1_sum_{tag}"] = total(st["n_g1"], k)
+            m[f"paper/fi_d_sum_{tag}"] = total(st["n_d"], k)
+            m[f"paper/fi_l1_sum_{tag}"] = total(st["l1"], k)
+            m[f"paper/fi_errabs_sum_{tag}"] = total(st["om_err"].abs(), k)
+            if responses is not None and cfg.get("err_token") is not None:
+                m[f"paper/fi_n_close_{tag}"] = float((k & (responses == int(cfg["err_token"]))).sum())
+            if float(k.sum()) == 0:
+                continue
+            m[f"paper/fi_p_err_{tag}"] = mean(st["p_err"], k)
+            m[f"paper/fi_q_err_{tag}"] = mean(st["q_err"], k)
+            m[f"paper/fi_g1_err_{tag}"] = mean(st["g1_err"], k)
+            m[f"paper/fi_d_err_{tag}"] = mean(st["d_err"], k)
+            m[f"paper/fi_om_err_{tag}"] = mean(st["om_err"], k)
+            m[f"paper/fi_ratio_{tag}"] = mean(st["ratio"], k)
+            m[f"paper/fi_ratio_log10_{tag}"] = mean(st["ratio"].clamp_min(1e-30).log10(), k)
+            m[f"paper/fi_scale_{tag}"] = mean(st["scale"], k)
+            m[f"paper/fi_mass_share_{tag}"] = total(st["n_app"], k) / tot_app if tot_app > 0 else 0.0
+            m[f"paper/fi_want_share_{tag}"] = total(st["n_want"], k) / tot_want if tot_want > 0 else 0.0
+            m[f"paper/fi_l1_share_{tag}"] = total(st["l1"], k) / tot_l1 if tot_l1 > 0 else 0.0
+            m[f"paper/fi_err_mass_frac_{tag}"] = total(st["om_err"].abs(), k) / tot_l1 if tot_l1 > 0 else 0.0
+        return m
