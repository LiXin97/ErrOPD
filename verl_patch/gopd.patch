+      f"(abs_adv_mean {mm.get('erropd/abs_adv_mean', float('nan')):.3f})")
+try:
+    ErropdHooks(make_cfg({"sg_gate": True, "reopd": True}), TOK)
+    raised = False
+except ValueError:
+    raised = True
+check("T14 two per-token lambda rules at once are refused", raised)
+
+# ---------------------------------------------------------------- T15 serialization to Ray workers
+# Everything the ERROPD code sends to workers is inside the DataProto passed to update_actor / compute_ref_log_prob:
+# per-token float tensors and bool meta flags. Ray serializes it with cloudpickle, then the dispatcher chunks it.
+import cloudpickle  # noqa: E402
+
+ok_all, detail = True, []
+for cfg in ({"format_bonus_beta": 1.0}, {"plaus_alpha": 0.1}, {"sg_gate": True}, {"mask": "from_violation"},
+            {"token_class_lambda": "only_term"}, {"reopd": True}, {}):
+    dp, _ = make_batch(CASES)
