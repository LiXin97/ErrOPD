+"""Driver-side ERROPD hook tests on real tokenized model outputs (CPU).
+
+  PYTHONPATH=<G-OPD-erropd>/verl ERROPD_TOKENIZER=<student SFT dir> \
+  ERROPD_EVAL_SCRIPT=<erropd>/scripts/eval_listwise_offline.py python test_hooks.py
+
+hook_cases.json holds synthetic cases with made-up item ids and scores (valid, duplicate_id, premature_close,
+hallucinated_id, malformed_json, extra_item, and a prompt with duplicate input ids).
+"""
+
+import ast
+import inspect
+import json
+import math
+import os
+import sys
+import tempfile
+
+import numpy as np
+import torch
+from omegaconf import OmegaConf
+
+from verl import DataProto
+from verl.erropd import listwise_contract as lc
+from verl.erropd.hooks import ErropdHooks
+
+HERE = os.path.dirname(os.path.abspath(__file__))
+RESULTS = []
+
+
+def check(name, cond, detail=""):
+    RESULTS.append((bool(cond), name, detail))
+    print(f"{'PASS' if cond else 'FAIL'}  {name} {detail}", flush=True)
+
+
+from transformers import AutoTokenizer  # noqa: E402
+
+TOK = AutoTokenizer.from_pretrained(os.environ["ERROPD_TOKENIZER"])
+CASES = json.load(open(os.path.join(HERE, "hook_cases.json")))
+EOS = TOK.eos_token_id
+PAD = TOK.pad_token_id if TOK.pad_token_id is not None else EOS
