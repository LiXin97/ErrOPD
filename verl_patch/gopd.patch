+"""Metrics gathered across data-parallel ranks with a key emitted only in some micro-batches (,
+). Exit 1 on any failure.
+
+Usage: PYTHONPATH=<tree under test> python test_metrics_ragged.py [REF_TREE]
+REF_TREE (default: snapshot 1701cf637e's verl/) is the tree whose reduce_metrics and DataProto.concat crashed FI_K and
+FI_R; its two functions are loaded from file beside the tested ones.
+
+1. THE CRASH, REPRODUCED WITH THE TRAINER'S OWN CODE.  Two ranks, 32 micro-batches of 2 rows each (the FI runs' layout:
+   mini-batch 64 per rank, micro-batch 2), metrics built by _paper_fi_metrics -> append_to_dict as update_policy does.
+   Rank 0 has one micro-batch whose two rows both close at item 7 (no 7th "},", so the `slot` set is empty and every
+   per-set slot key is skipped there): the reference tree's concat + reduce_metrics raises exactly the FI_K/FI_R
+   ValueError ("inhomogeneous shape after 1 dimensions. The detected shape was (2,) + inhomogeneous part."); the tested
+   tree reduces, and each ragged key equals the reduction over all 63 emitted entries.
+2. THE POST-STEP PATH.  A post-step key present on rank 1 and missing on rank 0 (rank 0's first micro-batch has an
+   empty set): the reference concat raises AssertionError; the tested one merges with rank 0's keys first.
+3. REGULAR INPUT IS UNCHANGED, BITWISE.  On equal-length per-rank lists, lists of scalars, max/min keys, mixed
+   float/np.float32/np.float64/int values, single-rank input, and the same 2 x 32 FI layout without an empty set,
+   the tested reduce_metrics(concat(...)) equals the reference's in keys, key order, value type and bits; the tested
+   reduction of a regular value is the original call on the same object.
+4. NON-METRIC MERGES STILL FAIL ON A KEY MISMATCH (list_of_dict_to_dict_of_list itself is untouched).
+"""
+import copy
+import importlib.util
+import os
+import sys
+
+import numpy as np
+import torch
+
+RES = []
+
+
+def check(name, cond, detail=""):
+    RES.append(bool(cond))
+    print(f"{'PASS' if cond else 'FAIL'}  {name} {detail}", flush=True)
+
+
+REF = sys.argv[1] if len(sys.argv) > 1 else "/path/to/verl_trees/gopd-1701cf637e/verl"
+REF = os.path.abspath(REF)
+
+
+def load(name, path):
+    spec = importlib.util.spec_from_file_location(name, path)
+    mod = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(mod)
+    return mod
+
+
+# the tested tree (PYTHONPATH) and the reference tree's two files, loaded beside it
+from verl.protocol import DataProto, list_of_dict_to_dict_of_list  # noqa: E402
+from verl.utils.metric import reduce_metrics  # noqa: E402
+from verl.utils.py_functional import append_to_dict  # noqa: E402
+
+ref_utils = load("ref_metric_utils", os.path.join(REF, "verl/utils/metric/utils.py"))
+ref_proto = load("ref_protocol", os.path.join(REF, "verl/protocol.py"))
+print(f"tested tree: {os.path.dirname(os.path.dirname(os.path.abspath(sys.modules['verl'].__file__)))}")
+print(f"reference:   {REF}")
+
+
+def gather(reduce_fn, proto_mod, per_rank):
+    out = proto_mod.DataProto.concat([proto_mod.DataProto(meta_info={"metrics": copy.deepcopy(m)}) for m in per_rank])
+    return reduce_fn(out.meta_info["metrics"])
+
+
+def same(a, b):
+    """keys, key order, value type and bits"""
+    if list(a) != list(b):
+        return False
+    for k in a:
+        x, y = a[k], b[k]
+        if type(x) is not type(y):
+            return False
+        if np.asarray(x).tobytes() != np.asarray(y).tobytes():
+            return False
+    return True
+
+
+# ---- the FI layout: _paper_fi_metrics per micro-batch, as update_policy builds it -------------------------------
+os.environ["PAPER_FI_MODE"] = "fklfull"
+from verl.workers.actor.dp_actor import DataParallelPPOActor as A, paper_fi_cfg  # noqa: E402
+
+cfg = paper_fi_cfg()
+B_, E_, V, T = cfg["boundary_token"], cfg["err_token"], 25600, 32
+G = torch.Generator().manual_seed(0)
+
+
+def row(n_items):
+    ids = []
+    for i in range(n_items):
+        ids += [100 + i, (E_ if i == n_items - 1 else B_)]
+    return ids
+
+
+FULL, EARLY = row(8), row(7)  # 8 items: a 7th "}," (slot non-empty); closing at item 7: none
+
+
+def mb_metrics(rows):
+    resp = torch.zeros(len(rows), T, dtype=torch.long)
+    m = torch.zeros(len(rows), T, dtype=torch.bool)
+    for i, r in enumerate(rows):
+        resp[i, : len(r)] = torch.tensor(r)
+        m[i, : len(r)] = True
+    ls = torch.log_softmax(torch.randn(len(rows), T, V, generator=G), -1)
+    lt = torch.log_softmax(torch.randn(len(rows), T, V, generator=G), -1)
+    masks = A._paper_alpha_masks(resp, m, cfg["boundary_token"], cfg["err_slot"])
+    masks["dec"] = A._paper_fi_dec_mask(resp, m, (cfg["boundary_token"], cfg["err_token"]), cfg["err_slot"])
+    _, st = A._paper_fi_omega(ls, lt, cfg, err_token=cfg["err_token"])
+    return A._paper_fi_metrics(cfg, st, masks, resp)
+
+
+# 32 distinct micro-batch metric dicts per rank; the regular ones are reused for both layouts
+mbs = [[mb_metrics([FULL, FULL if j % 3 else EARLY]) for j in range(32)] for _ in range(2)]
+empty_slot = mb_metrics([EARLY, EARLY])
+check("an all-early micro-batch has no slot keys, a regular one has them",
+      "paper/fi_p_err_slot" not in empty_slot and "paper/fi_p_err_slot" in mbs[0][0]
+      and empty_slot["paper/fi_n_slot"] == 0.0)
+
+
+def rank_dict(mb_list, post):
+    d = {}
+    for x in mb_list:
+        append_to_dict(d, x)
+    append_to_dict(d, post)  # the mini-batch block (grad_norm, post-step) once per rank
+    return d
+
+
+POST = {"actor/grad_norm": 0.5, "paper/fi_dlogp_err_slot_mean": 1e-3, "paper/fi_dlogp_err_slot_n": 2.0}
+regular = [rank_dict(mbs[0], POST), rank_dict(mbs[1], dict(POST, **{"actor/grad_norm": 0.5}))]
+ragged = [rank_dict([empty_slot] + mbs[0][1:], POST), rank_dict(mbs[1], POST)]
+
+# 1. the crash
+check("ragged layout: rank 0 has 31 entries of paper/fi_p_err_slot, rank 1 has 32",
+      len(ragged[0]["paper/fi_p_err_slot"]) == 31 and len(ragged[1]["paper/fi_p_err_slot"]) == 32)
+try:
+    gather(ref_utils.reduce_metrics, ref_proto, ragged)
+    check("reference tree raises the FI_K/FI_R ValueError", False, "(no exception)")
+except ValueError as e:
+    check("reference tree raises the FI_K/FI_R ValueError",
+          "inhomogeneous shape after 1 dimensions. The detected shape was (2,) + inhomogeneous part." in str(e),
+          f"({e})")
+try:
+    red = gather(reduce_metrics, sys.modules["verl.protocol"], ragged)
+    ok = True
+except Exception as e:  # noqa: BLE001
+    red, ok = None, False
+    print(f"      tested tree raised {type(e).__name__}: {e}")
+check("tested tree reduces the ragged layout", ok)
+if ok:
+    rag_keys = [k for k in ragged[0] if len(ragged[0][k]) != len(ragged[1][k])]
+    check("the ragged keys are exactly the per-set slot keys", rag_keys and all(k.endswith("_slot") for k in rag_keys)
+          and "paper/fi_n_slot" not in rag_keys, f"({len(rag_keys)} keys)")
+    good = True
+    for k in rag_keys:
+        flat = ragged[0][k] + ragged[1][k]
+        want = np.max(flat) if "max" in k else (np.min(flat) if "min" in k else np.mean(flat))
+        good &= len(flat) == 63 and red[k] == want
+    check("each ragged key = its reduction over the 63 emitted entries (rank order kept)", good)
+    reg_keys = [k for k in ragged[0] if k not in rag_keys]
+    flat_eq = all(np.asarray(red[k]).tobytes() == np.asarray(
+        gather(ref_utils.reduce_metrics, ref_proto, [{k: ragged[0][k]}, {k: ragged[1][k]}])[k]).tobytes()
+        for k in reg_keys)
+    check("every non-ragged key of the ragged layout equals the reference's reduction, bitwise", flat_eq)
+
+# 2. the post-step path: rank 0's first micro-batch had an empty set, rank 1's did not
+post0 = {"actor/grad_norm": 0.5}
+r0, r1 = rank_dict(mbs[0], post0), rank_dict(mbs[1], POST)
+try:
+    gather(ref_utils.reduce_metrics, ref_proto, [r0, r1])
+    check("reference concat raises AssertionError on a key only rank 1 has", False)
+except AssertionError:
+    check("reference concat raises AssertionError on a key only rank 1 has", True)
+red = gather(reduce_metrics, sys.modules["verl.protocol"], [r0, r1])
+check("tested concat merges it: rank 0's keys first, then rank 1's new ones, values from the ranks that have them",
+      list(red)[: len(r0)] == list(r0) and red["paper/fi_dlogp_err_slot_mean"] == 1e-3
+      and red["paper/fi_dlogp_err_slot_n"] == 2.0 and red["actor/grad_norm"] == 0.5)
+
+# 3. regular input: bitwise the reference
+bank = {
+    "fi_2x32_regular": regular,
+    "scalars_per_rank": [{"actor/lr": 1e-6, "perf/max_memory_allocated_gb": 61.25, "perf/mfu/actor": 0.123},
+                         {"actor/lr": 1e-6, "perf/max_memory_allocated_gb": 62.5, "perf/mfu/actor": 0.121}],
+    "mixed_types": [{"a/x": [np.float32(0.1), 0.2, np.float64(0.3)], "a/x_max": [1, 2, 3], "a/x_min": [0.5, -1.0, 2]},
+                    {"a/x": [0.4, np.float32(0.5), 0.6], "a/x_max": [4, 5, 6], "a/x_min": [0.1, 0.2, 0.3]}],
+    "single_rank": [rank_dict(mbs[0], POST)],
+    "four_ranks": [rank_dict(mbs[i % 2], POST) for i in range(4)],
+    "single_entry_lists": [{"k": [1.0], "k_max": [3.0]}, {"k": [2.0], "k_max": [-1.0]}],
+    "key_order_differs": [{"a": [1.0], "b": [2.0]}, {"b": [3.0], "a": [4.0]}],
+}
+for name, per_rank in bank.items():
+    a = gather(reduce_metrics, sys.modules["verl.protocol"], per_rank)
+    b = gather(ref_utils.reduce_metrics, ref_proto, per_rank)
+    check(f"regular input bitwise the reference: {name}", same(a, b), f"({len(a)} keys)")
+# direct: the tested reduction on regular values is the original call on the same object
+from verl.utils.metric.utils import _flatten_if_ragged  # noqa: E402
+
+objs = [[[1.0, 2.0], [3.0, 4.0]], [1.0, 2.0], [[1.0]], 5.0, [], [[1.0, 2.0]], np.ones((2, 3)).tolist()]
+check("_flatten_if_ragged returns regular values as the same object", all(_flatten_if_ragged(o) is o for o in objs))
+check("reduce_metrics source differs from the reference only by the ragged guard",
+      open(sys.modules["verl.utils.metric.utils"].__file__).read().startswith(
+          open(os.path.join(REF, "verl/utils/metric/utils.py")).read().split("    for key, val in metrics.items():")[0]))
+
+# 4. non-metric merges are unchanged
+try:
+    list_of_dict_to_dict_of_list([{"a": 1}, {"a": 2, "b": 3}])
+    check("list_of_dict_to_dict_of_list still asserts on a key mismatch", False)
+except AssertionError:
+    check("list_of_dict_to_dict_of_list still asserts on a key mismatch", True)
+
+print(f"\n{sum(RES)} passed, {len(RES) - sum(RES)} failed")
+sys.exit(0 if all(RES) else 1)
