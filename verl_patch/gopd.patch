@@ -0,0 +1,304 @@
+"""Compare equiv_harness outputs of the parent snapshot without FI (207f17ee48, the alpha-gate snapshot) and the tree
+with it, run in the same interpreter on the same stored batch. Exit 1 on any failure.
+
+Usage: python fi_compare.py OLD.pt NEW.pt
+
+The reference tree does not read PAPER_FI_MODE, so it runs the plain rkl_full step for every FI scenario.
+
+1. DEFAULT OFF.  Every scenario both trees ran that is not an FI scenario -- production lambda, ERROPD interventions,
+   R2G, opd / fkl_sampled / rkl_full, and all 8 alpha-gate scenarios -- is bitwise unchanged: advantages, log-probs,
+   pg losses, initial and updated parameters, every metric, the references. The alpha scenarios are in this set on
+   purpose: the post-step measurement they use was generalised for FI, and this shows its keys and values did not move.
+2. ctl IS rkl_full, BITWISE.  PAPER_FI_MODE=ctl takes the untouched rkl_full path: losses and parameters bitwise equal
+   to the reference tree's run of the same scenario and to the tested tree's own rkl_full; every metric the reference
+   logs is bitwise equal and the only new keys are paper/fi_*.
+3. THE MEASURED LOSS IS THE SAME IN EVERY ARM.  paper/rkl_full (at the step's starting parameters) is bitwise equal
+   across rkl_full and every FI scenario.
+4. THE IDENTITY SWITCH.  fir at its own norm with fp32 arithmetic is bitwise the alpha gate's surrogate at alpha = 1
+   (the route the alpha suite validated against rkl_full); its update and the float64 build's equal rkl_full's to a
+   reported max parameter difference (bar 1e-8, one fp32 ulp at |w| ~ 0.1; the surrogate and autograd routes can
+   differ by a CPU reduction order). fis at its own norm is fir's, bitwise.
+5. EACH MODE IS THE INTENDED, INDEPENDENTLY DERIVED STEP.  fir, fis, fklfull (and the identity and chunk-1 variants):
+   surrogate loss and SGD update equal an independent implementation whose g1 and d are float64 AUTOGRAD gradients of
+   the two objectives (sum p (l - m) and sum q (m - l)) rather than the closed form; for fklfull this is the check of
+   its gradient against autograd of the full-vocabulary forward-KL loss at the actor level. The update is real and
+   differs from rkl_full's.
+6. THE NORMS ARE WHAT THE MODE SAYS (the lock's N1 diagnostics): the realised per-prefix norm of the applied logit
+   gradient equals the mode's target (||d|| for fir and fklfull and at fis's decision states, ||g1|| elsewhere for fis
+   and for ctl), max relative deviation <= 1e-5; the applied direction's cosine to g1 >= 0.9999 for fir, fis, ctl; no
+   zero-norm prefix; and the logged ||g1|| and ||d|| equal the independent reference's. fis's decision states are the
+   reference's, recomputed from the token ids.
+7. DIAGNOSTICS POPULATED, for every FI scenario and the three position sets (all / boundary / slot), including the
+   post-step change in the error decision's log-probability and the clip indicator.
+8. CHUNKING IS NOT A DEGREE OF FREEDOM: chunk 1 and chunk 256 give bitwise identical parameters and FI metrics.
+10. E1 (fkldec, the mirror of fis): with no decision state in the batch its step is fklfull's, bitwise (parameters,
+   and every metric but paper/fi_mode against fklfull run at the same item index); with decision states the update
+   is real and differs from fklfull's, the decision states' target is ||g1|| (want_sum_dec == g1_sum_dec bitwise),
+   the realised norm there equals it, and the per-micro-batch ||g1|| and ||d|| sums equal fklfull's bitwise (the
+   forward pass is the same). Its applied direction is checked against d (paper/fi_cos_to_d_min >= 0.9999), as is
+   fklfull's.
+9. REFUSALS: FI with opd, with fkl_sampled, with the alpha gate; an unknown mode; FI-F (dropped); a negative floor; a
+   non-0/1 switch; ctl with the identity switch; an error token outside the vocabulary. Each raises, parameters
+   unchanged.
+"""
+import math
+import sys
+
+import torch
+
+old = torch.load(sys.argv[1], weights_only=False)
+new = torch.load(sys.argv[2], weights_only=False)
+lines, fails = [], []
+FI_SCEN = sorted(k for k in new if isinstance(new[k], dict) and k.startswith("rkl_fi_"))
+
+
+def check(name, cond):
+    lines.append(f"{'PASS' if cond else 'FAIL'}  {name}")
+    if not cond:
+        fails.append(name)
+
+
+def eq(a, b):
+    if isinstance(a, torch.Tensor) or isinstance(b, torch.Tensor):
+        return isinstance(a, torch.Tensor) and isinstance(b, torch.Tensor) and a.shape == b.shape and torch.equal(a, b)
+    if isinstance(a, dict) and isinstance(b, dict):
+        return a.keys() == b.keys() and all(eq(a[k], b[k]) for k in a)
+    if isinstance(a, (list, tuple)) and isinstance(b, (list, tuple)):
+        return len(a) == len(b) and all(eq(x, y) for x, y in zip(a, b))
+    if isinstance(a, float) and isinstance(b, float) and math.isnan(a) and math.isnan(b):
+        return True
+    return a == b
+
+
+def dparam(x, y):
+    return max((x["params"][k] - y["params"][k]).abs().max().item() for k in x["params"])
+
+
+def upd(x):
+    return max((x["params"][k] - x["params0"][k]).abs().max().item() for k in x["params"])
+
+
+def mean(v):
+    return sum(v) / len(v)
+
+
+lines.append(f"reference tree: {old['verl_file']} (FI: {old.get('has_fi', False)}, alpha: {old.get('has_alpha')})")
+lines.append(f"tested tree:    {new['verl_file']} (FI: {new.get('has_fi', False)}, alpha: {new.get('has_alpha')})")
+check("reference tree lacks FI and has the alpha gate (the parent snapshot); tested tree has both",
+      (not old.get("has_fi", False)) and old.get("has_alpha", False) and new.get("has_fi", False)
+      and new.get("has_alpha", False))
+check(f"all 13 FI scenarios ran, the 4 E1 ones among them ({FI_SCEN})", len(FI_SCEN) == 13
+      and sum("fkldec" in k or k.endswith("_nodec") for k in FI_SCEN) == 4)
+
+# 1. default off
+shared = [k for k in old if isinstance(old[k], dict) and "params" in old[k] and k in new
+          and not k.startswith("rkl_fi_")]
+for sc in shared:
+    o, n = old[sc], new[sc]
+    ok = all(eq(o[k], n[k]) for k in ("adv", "pg", "logp", "params0", "params", "metrics", "fkl_ref"))
+    check(f"[{sc}] with PAPER_FI_MODE unset: advantages, log-probs, pg losses, parameters, metrics "
+          f"({len(n['metrics'])} keys), references bitwise equal to the parent snapshot", ok)
+n_alpha = sum(sc.startswith("rkl_alpha") for sc in shared)
+check(f"all {len(shared)} non-FI scenarios compared, the 8 alpha-gate scenarios among them ({n_alpha}); expected 29",
+      len(shared) == 29 and n_alpha == 8)
+check("teacher-pass section (log-probs, B3p max, fkl teacher samples, label override) bitwise equal",
+      eq(old["maxlp"], new["maxlp"]))
+check("full-vocabulary log-prob section bitwise equal", eq(old.get("fullp"), new.get("fullp")))
+
+# 2. ctl is rkl_full, bitwise
+o, n = old["rkl_fi_ctl"], new["rkl_fi_ctl"]
+check(f"[rkl_fi_ctl] losses and parameters bitwise equal to the parent's plain rkl_full step (update size {upd(n):.3e})",
+      all(eq(o[k], n[k]) for k in ("adv", "pg", "logp", "params0", "params")))
+check(f"[rkl_fi_ctl] ... and to the tested tree's own rkl_full (max param diff {dparam(n, new['rkl_full']):.1e})",
+      eq(n["params"], new["rkl_full"]["params"]))
+extra = sorted(set(n["metrics"]) - set(o["metrics"]))
+check(f"[rkl_fi_ctl] every metric the parent logs is bitwise equal; the only new keys are paper/fi_* ({len(extra)})",
+      all(eq(o["metrics"][k], n["metrics"][k]) for k in o["metrics"]) and all(k.startswith("paper/fi_") for k in extra)
+      and len(extra) > 30)
+check("[rkl_fi_ctl] flagged as not applied (paper/fi_applied == 0) and no surrogate loss logged",
+      all(x == 0.0 for x in n["metrics"]["paper/fi_applied"]) and "paper/fi_surr_loss" not in n["metrics"])
+
+# 3. the measured loss is the same in every arm
+base = new["rkl_full"]["metrics"]["paper/rkl_full"]
+check(f"[all FI arms] paper/rkl_full bitwise equal across rkl_full and all {len(FI_SCEN)} FI scenarios "
+      f"({[round(x, 5) for x in base]})", all(eq(base, new[sc]["metrics"]["paper/rkl_full"]) for sc in FI_SCEN))
+
+# 4. the identity switch. rkl_full's applied gradient is fp32 autograd of its loss; FI applies an explicit field through
+# a surrogate. The alpha suite validated that surrogate route at alpha = 1 (rkl_alpha1_surr); fir at its own norm in
+# fp32 arithmetic is the same field through the same surrogate, so it must equal that scenario BITWISE. Against
+# rkl_full itself the surrogate route and the autograd route can differ by the reduction order of a CPU sum, i.e. by
+# an ulp of a parameter, depending on the thread count; that is reported against a bar of 1e-8 (one fp32 ulp at |w| ~
+# 0.1), and the float64 build is held to the same bar.
+n32, na1 = new["rkl_fi_fir_id32"], new["rkl_alpha1_surr"]
+check(f"[rkl_fi_fir_id32] fir at its own norm, fp32 arithmetic, is bitwise the alpha gate's validated surrogate at "
+      f"alpha = 1 (parameters and surrogate losses)",
+      eq(n32["params"], na1["params"]) and eq(n32["metrics"]["paper/fi_surr_loss"], na1["metrics"]["paper/alpha_surr_loss"]))
+d32 = dparam(n32, new["rkl_full"])
+check(f"[rkl_fi_fir_id32] ... and its update equals rkl_full's to {d32:.2e} max parameter difference (<= 1e-8; "
+      f"rkl_alpha1_surr's in this run: {dparam(na1, new['rkl_full']):.2e}; update size {upd(n32):.2e})", d32 <= 1e-8)
+d64 = dparam(new["rkl_fi_fir_id"], new["rkl_full"])
+check(f"[rkl_fi_fir_id] fir at its own norm, float64 build (the shipped arithmetic): max param diff from rkl_full "
+      f"{d64:.2e} <= 1e-8, and from the fp32-arithmetic identity {dparam(new['rkl_fi_fir_id'], n32):.2e}", d64 <= 1e-8)
+check(f"[rkl_fi_fis_id] fis at its own norm is fir's, bitwise (max param diff "
+      f"{dparam(new['rkl_fi_fis_id'], new['rkl_fi_fir_id']):.1e})",
+      eq(new["rkl_fi_fis_id"]["params"], new["rkl_fi_fir_id"]["params"]))
+check("[identity] scale exactly 1.0 throughout", all(
+    x == 1.0 for sc in ("rkl_fi_fir_id", "rkl_fi_fir_id32", "rkl_fi_fis_id")
+    for k in ("paper/fi_scale_min", "paper/fi_scale_max") for x in new[sc]["metrics"][k]))
+
+# 5. each mode is the independently derived step
+for sc in sorted(k for k in FI_SCEN if k != "rkl_fi_ctl"):
+    n = new[sc]
+    ref = n["fkl_ref"]
+    dl = max(abs(a - float(b)) for a, b in zip(n["metrics"]["paper/fi_surr_loss"], ref["ce"]))
+    scale = max(abs(float(b)) for b in ref["ce"]) + 1e-12
+    dp = max((n["params"][k] - ref["params"][k]).abs().max().item() for k in ref["params"])
+    # the fp32-arithmetic scenario's field carries rkl_full's own zero-sum residual (~1e-6 of ||omega||_1), which the
+    # surrogate's cancellation amplifies in this scalar; its bar is 1e-4, the float64 scenarios' 1e-5
+    rel = 1e-4 if n["metrics"]["paper/fi_fp64"][0] == 0.0 else 1e-5
+    check(f"[{sc}] surrogate loss per micro-batch == the independent (float64 autograd) implementation "
+          f"(max diff {dl:.2e} <= {rel:g} x {scale:.3g}; losses "
+          f"{[round(float(x), 6) for x in n['metrics']['paper/fi_surr_loss']]})", dl <= rel * scale)
+    check(f"[{sc}] SGD update == the independent step (max param diff {dp:.2e} <= 1e-8; update size {upd(n):.2e})",
+          dp <= 1e-8)
+    if not sc.endswith(("_id", "_id32")):
+        dd = dparam(n, new["rkl_full"])
+        check(f"[{sc}] the update is real and differs from rkl_full's (max param diff from rkl_full {dd:.2e})",
+              upd(n) > 1e-8 and dd > 1e-8)
+    check(f"[{sc}] no policy-gradient path was taken and no ERROPD ack was emitted",
+          len(n["adv"]) == 0 and "erropd/actor_ack" not in n["metrics"])
+
+# 6. norms and the lock's N1 diagnostics
+for sc in FI_SCEN:
+    m = new[sc]["metrics"]
+    mode = {1.0: "fir", 3.0: "fklfull", 4.0: "ctl", 5.0: "fis", 6.0: "fkldec"}[m["paper/fi_mode"][0]]
+    app, want = mean(m["paper/fi_app_norm"]), mean(m["paper/fi_want_norm"])
+    dev = max(m["paper/fi_normdev_max"])
+    check(f"[{sc}] realised per-prefix norm of the applied logit gradient == the mode's target: mean {app:.6g} vs "
+          f"{want:.6g}, max relative deviation {dev:.1e} <= 1e-5 (mean ||g1|| {mean(m['paper/fi_g1_norm']):.4g}, "
+          f"||d|| {mean(m['paper/fi_d_norm']):.4g}, ratio {mean(m['paper/fi_ratio_mean']):.4g}, P_col "
+          f"{mean(m['paper/fi_pcol']):.4f})", abs(app - want) <= 1e-5 * max(want, 1e-30) and dev <= 1e-5)
+    cmin = min(m["paper/fi_cos_to_g1_min"])
+    if mode in ("fir", "fis", "ctl"):
+        check(f"[{sc}] applied direction against g1: min cosine {cmin:.9f} >= 0.9999", cmin >= 0.9999)
+    else:
+        check(f"[{sc}] {mode}'s applied direction is d: its cosine to g1 is the RKL/FKL angle (mean "
+              f"{mean(m['paper/fi_cos_to_g1_mean']):.4f} == mean cos(g1, d) {mean(m['paper/fi_cos_rkl_fkl']):.4f})",
+              abs(mean(m["paper/fi_cos_to_g1_mean"]) - mean(m["paper/fi_cos_rkl_fkl"])) < 1e-5)
+        cdmin = min(m["paper/fi_cos_to_d_min"])
+        check(f"[{sc}] applied direction against d: min cosine {cdmin:.9f} >= 0.9999 (the d arms' N1)", cdmin >= 0.9999)
+    check(f"[{sc}] no zero-norm prefix on this batch (zero share {max(m['paper/fi_zero_share'])}, count "
+          f"{max(m['paper/fi_zero_n'])})", max(m["paper/fi_zero_share"]) == 0.0 and max(m["paper/fi_zero_n"]) == 0.0)
+    ref = new[sc]["fkl_ref"]
+    if ref is not None and "n_g1" in ref:
+        rm = new[sc]["response_mask"]
+        per_mb = []
+        for j in range(0, rm.shape[0], 2):
+            k = rm[j:j + 2]
+            per_mb.append((float(ref["n_g1"][j:j + 2].sum() / k.sum()), float(ref["n_d"][j:j + 2].sum() / k.sum())))
+        e1 = max(abs(a - b[0]) / b[0] for a, b in zip(m["paper/fi_g1_norm"], per_mb))
+        e2 = max(abs(a - b[1]) / b[1] for a, b in zip(m["paper/fi_d_norm"], per_mb))
+        check(f"[{sc}] logged per-micro-batch mean ||g1|| and ||d|| == the independent reference's "
+              f"(max rel diff {e1:.1e}, {e2:.1e})", e1 < 1e-5 and e2 < 1e-5)
+        if ref.get("dec") is not None:
+            nref = [float(ref["dec"][j:j + 2].sum()) for j in range(0, rm.shape[0], 2)]
+            check(f"[{sc}] the decision states are the reference's, recomputed from the token ids (per micro-batch "
+                  f"{m['paper/fi_n_dec']} vs {nref}; FI-S rescaled {sum(nref):g} prefixes)",
+                  m["paper/fi_n_dec"] == nref and sum(nref) > 0)
+    zs = max(m["paper/fi_zerosum_rel_max"])
+    bar = 1e-4 if m["paper/fi_fp64"][0] == 0.0 else 1e-6
+    check(f"[{sc}] the zero-sum identity holds (max |sum_v omega| / ||omega||_1 = {zs:.2e} <= {bar:g})", zs <= bar)
+
+# 7. diagnostics populated
+WANT = ["paper/fi_mode", "paper/fi_identity", "paper/fi_fp64", "paper/fi_floor", "paper/fi_applied",
+        "paper/fi_g1_norm", "paper/fi_d_norm", "paper/fi_app_norm", "paper/fi_want_norm", "paper/fi_fkl_full",
+        "paper/fi_rkl_check", "paper/fi_ratio_mean", "paper/fi_ratio_med", "paper/fi_ratio_min", "paper/fi_ratio_max",
+        "paper/fi_ratio_log10_mean", "paper/fi_scale_mean", "paper/fi_scale_min", "paper/fi_scale_max",
+        "paper/fi_normdev_mean", "paper/fi_normdev_max", "paper/fi_cos_to_g1_mean", "paper/fi_cos_to_g1_min",
+        "paper/fi_cos_to_d_mean", "paper/fi_cos_to_d_min",
+        "paper/fi_zero_n", "paper/fi_zero_share", "paper/fi_zero_want_share", "paper/fi_floor_share",
+        "paper/fi_cos_rkl_fkl", "paper/fi_dcos_sum_all", "paper/fi_pcol", "paper/fi_zerosum_rel_max",
+        "paper/fi_clip_bound", "paper/fi_clip_coef", "actor/grad_norm"]
+TAGS = ("all", "bnd", "slot", "dec")
+for sc in FI_SCEN:
+    m = new[sc]["metrics"]
+    miss = [k for k in WANT if k not in m]
+    check(f"[{sc}] the configuration, norm, ratio, scale, floor, angle, zero-sum and clip diagnostics are all logged "
+          f"({len(WANT)} keys; missing {miss})", not miss)
+    gn, cb = m["actor/grad_norm"], m["paper/fi_clip_bound"]
+    check(f"[{sc}] the clip indicator agrees with actor/grad_norm against the clip of 1.0 (grad_norm {gn}, bound {cb})",
+          all((g > 1.0 - 1e-6) == (b == 1.0) for g, b in zip(gn, cb)))
+    check(f"[{sc}] the logged reverse KL in the FI builder equals paper/rkl_full (max diff "
+          f"{max(abs(a - b) for a, b in zip(m['paper/fi_rkl_check'], m['paper/rkl_full'])):.1e} <= 1e-5)",
+          max(abs(a - b) for a, b in zip(m["paper/fi_rkl_check"], m["paper/rkl_full"])) <= 1e-5)
+    for tag in TAGS:
+        sums = [f"paper/fi_n_{tag}", f"paper/fi_app_sum_{tag}", f"paper/fi_want_sum_{tag}", f"paper/fi_g1_sum_{tag}",
+                f"paper/fi_d_sum_{tag}", f"paper/fi_l1_sum_{tag}", f"paper/fi_errabs_sum_{tag}",
+                f"paper/fi_n_close_{tag}"]
+        need = [f"paper/fi_p_err_{tag}", f"paper/fi_q_err_{tag}", f"paper/fi_g1_err_{tag}", f"paper/fi_d_err_{tag}",
+                f"paper/fi_om_err_{tag}", f"paper/fi_ratio_{tag}", f"paper/fi_ratio_log10_{tag}",
+                f"paper/fi_scale_{tag}", f"paper/fi_mass_share_{tag}", f"paper/fi_want_share_{tag}",
+                f"paper/fi_l1_share_{tag}", f"paper/fi_err_mass_frac_{tag}",
+                f"paper/fi_dlogp_err_{tag}_mean", f"paper/fi_dlogp_err_{tag}_absmax", f"paper/fi_logp_err_{tag}_pre",
+                f"paper/fi_dlogp_err_{tag}_n"]
+        miss_s = [k for k in sums if k not in m or len(m[k]) != 4]
+        check(f"[{sc}] the '{tag}' sums are emitted in every micro-batch (step-level shares are ratios of them)",
+              not miss_s)
+        n_set = max(m.get(f"paper/fi_n_{tag}", [0]))
+        if n_set == 0:
+            check(f"[{sc}] the '{tag}' set is empty on this batch: only its sums are logged",
+                  not any(k in m for k in need[:12]))
+            continue
+        # the post-step keys exist only if the set is non-empty in the first micro-batch (PAPER_ALPHA_POSTSTEP=first)
+        need_here = need[:12] + (need[12:] if m[f"paper/fi_n_{tag}"][0] > 0 else [])
+        miss = [k for k in need_here if k not in m]
+        check(f"[{sc}] the error-decision diagnostics are logged for the '{tag}' set ({n_set:g} positions): weight "
+              f"{m.get(f'paper/fi_om_err_{tag}', [float('nan')])[0]:+.3e}, mass share "
+              f"{m.get(f'paper/fi_mass_share_{tag}', [float('nan')])[0]:.3g}, dlogp "
+              f"{m.get(f'paper/fi_dlogp_err_{tag}_mean', [float('nan')])[0]:+.3e} (missing {miss})", not miss)
+
+# 8. chunking
+for a_, b_ in (("rkl_fi_fir", "rkl_fi_fir_chunk1"), ("rkl_fi_fis", "rkl_fi_fis_chunk1"),
+               ("rkl_fi_fkldec", "rkl_fi_fkldec_chunk1")):
+    ma, mb = new[a_]["metrics"], new[b_]["metrics"]
+    keys = [k for k in ma if k.startswith("paper/fi_")]
+    check(f"[{b_}] chunk 1 and chunk 256 give bitwise identical parameters and all {len(keys)} FI metrics",
+          eq(new[a_]["params"], new[b_]["params"]) and all(eq(ma[k], mb.get(k)) for k in keys)
+          and set(keys) == {k for k in mb if k.startswith("paper/fi_")})
+
+# 10. E1 (fkldec)
+kd, kk = new["rkl_fi_fkldec"], new["rkl_fi_fklfull"]
+nd_, nk_ = new["rkl_fi_fkldec_nodec"], new["rkl_fi_fklfull_nodec"]
+check(f"[rkl_fi_fkldec_nodec] no decision state in the batch (n_dec {nd_['metrics']['paper/fi_n_dec']}): parameters "
+      f"bitwise fklfull's (at item 2 and at item 99)", max(nd_["metrics"]["paper/fi_n_dec"]) == 0.0
+      and eq(nd_["params"], kk["params"]) and eq(nd_["params"], nk_["params"]))
+dm = nd_["metrics"]
+diff = [k for k in nk_["metrics"] if k != "paper/fi_mode" and not eq(nk_["metrics"][k], dm.get(k))]
+check(f"[rkl_fi_fkldec_nodec] ... and every one of its {len(dm)} metrics but paper/fi_mode (6 vs 3) is fklfull's at the "
+      f"same item index, bitwise (differ: {diff})", not diff and set(dm) == set(nk_["metrics"])
+      and dm["paper/fi_mode"][0] == 6.0 and nk_["metrics"]["paper/fi_mode"][0] == 3.0)
+md, mk_ = kd["metrics"], kk["metrics"]
+check(f"[rkl_fi_fkldec] decision states present ({md['paper/fi_n_dec']} per micro-batch) and the update differs from "
+      f"fklfull's (max param diff {dparam(kd, kk):.2e})", sum(md["paper/fi_n_dec"]) > 0 and dparam(kd, kk) > 1e-8)
+check("[rkl_fi_fkldec] the decision states' target is ||g1||: fi_want_sum_dec == fi_g1_sum_dec bitwise per micro-batch",
+      eq(md["paper/fi_want_sum_dec"], md["paper/fi_g1_sum_dec"]))
+_r = max(abs(a - b) / b for a, b in zip(md["paper/fi_app_sum_dec"], md["paper/fi_g1_sum_dec"]) if b > 0)
+check(f"[rkl_fi_fkldec] ... and the realised norm there equals it (summed, max rel dev {_r:.1e} <= 1e-5)", _r <= 1e-5)
+same_fwd = [f"paper/fi_{x}_sum_{t}" for x in ("g1", "d") for t in ("all", "bnd", "slot", "dec")] + ["paper/rkl_full"]
+check("[rkl_fi_fkldec] same forward pass as fklfull: per-micro-batch ||g1|| and ||d|| sums of every set and "
+      "paper/rkl_full bitwise fklfull's", all(eq(md[k], mk_[k]) for k in same_fwd))
+_off = [(a - b, c - e) for a, b, c, e in zip(md["paper/fi_want_sum_all"], md["paper/fi_want_sum_dec"],
+                                             mk_["paper/fi_want_sum_all"], mk_["paper/fi_want_sum_dec"])]
+check(f"[rkl_fi_fkldec] off the decision states the target mass is fklfull's (rel 1e-12: {_off})",
+      all(abs(x - y) <= 1e-12 * max(abs(y), 1e-30) for x, y in _off))
+
+# 9. refusals
+ref_ = new.get("fi_refusals", {})
+check(f"all 9 refusal cases ran ({sorted(ref_)})", len(ref_) == 9)
+for k, r in sorted(ref_.items()):
+    check(f"[refusal {k}] raises ({(r['error'] or 'none')[:100]}) and leaves parameters unchanged",
+          r["error"] is not None and r["params_unchanged"])
+
+print("\n".join(lines))
+print(f"\n{sum(1 for x in lines if x.startswith('PASS'))} passed, {len(fails)} failed")
+sys.exit(1 if fails else 0)
