+def add_ref_inputs(data, extra_pad=3, corrupt=False):
+    """G-OPD ref re-tokenization layout: each prompt's non-padding tokens left-padded to (prompt width + extra_pad),
+    then the responses; position ids from the mask."""
+    ids, am = data.batch["input_ids"], data.batch["attention_mask"]
+    W = P + extra_pad
+    ri = torch.zeros(BS, W + R, dtype=ids.dtype)
+    rm = torch.zeros(BS, W + R, dtype=am.dtype)
+    for i in range(BS):
+        pt = ids[i, :P][am[i, :P].bool()]
+        ri[i, W - len(pt):W] = pt
+        rm[i, W - len(pt):W] = 1
+    ri[:, W:] = ids[:, P:]
+    rm[:, W:] = am[:, P:]
+    if corrupt:
+        ri[3, W - 1] = (ri[3, W - 1] + 1) % VOCAB
+    data.batch["ref_input_ids"] = ri
+    data.batch["ref_attention_mask"] = rm
+    data.batch["ref_position_ids"] = torch.clamp(torch.cumsum(rm, dim=-1) - 1, min=0)
