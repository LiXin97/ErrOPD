index 0000000..af5380b
--- /dev/null
+++ b/verl/tests/erropd/mix_parent_compare.py
@@ -0,0 +1,90 @@
+"""MIX adds PAPER_MIX_BETA (a mixed objective on PAPER_LOSS_MODE=opd) to the E1 snapshot 6c86085a34. Everything that
+snapshot can run must be unchanged, and the new mode must reduce to its two endpoints exactly. Exit 1 on any failure.
+
+  python mix_parent_compare.py PARENT.pt NEW.pt
+
+PARENT.pt is the parent's own equiv_harness output (its harness file, its tree, its scenario list); NEW.pt is the new
+tree's harness run on the parent's scenarios plus mixref_opd_rand, mix_b0_rand, mix_b1_rand, mix_b05_rand, same
+interpreter, same stored batch.
+1. For every parent scenario: every stored field and every metric (key order and values) bitwise equal; no new keys.
+2. The teacher-pass, full-vocabulary and refusal sections bitwise equal.
+3. beta = 0 equals OPD at lambda 1 on the same batch (mixref_opd_rand): advantages, log-probs, pg losses and updated
+   parameters bitwise. beta = 1 equals fkl_rand (fkl_sampled on the same teacher tokens): updated parameters bitwise.
+4. beta = 0.5: finite, logs paper/mix_beta 0.5, paper/fkl_ce equal to fkl_rand's and paper/mix_rev_loss equal to the
+   OPD reference's pg loss (both bitwise), and its parameters differ from both endpoints'.
+5. Every PAPER_MIX_BETA refusal case raises with parameters unchanged.
+"""
+import sys
+
+import numpy as np
+import torch
+
+old = torch.load(sys.argv[1], weights_only=False)
+new = torch.load(sys.argv[2], weights_only=False)
+RES = []
+
+
+def check(name, cond, detail=""):
+    RES.append(bool(cond))
+    print(f"{'PASS' if cond else 'FAIL'}  {name} {detail}", flush=True)
+
+
+def eq(a, b):
+    if isinstance(a, torch.Tensor) or isinstance(b, torch.Tensor):
+        return isinstance(a, torch.Tensor) and isinstance(b, torch.Tensor) and a.shape == b.shape and \
+            a.dtype == b.dtype and torch.equal(a, b)
+    if isinstance(a, dict) and isinstance(b, dict):
+        return list(a) == list(b) and all(eq(a[k], b[k]) for k in a)
+    if isinstance(a, (list, tuple)) and isinstance(b, (list, tuple)):
+        return len(a) == len(b) and all(eq(x, y) for x, y in zip(a, b))
+    if isinstance(a, float) and isinstance(b, float):
+        return np.float64(a).tobytes() == np.float64(b).tobytes()
+    return type(a) is type(b) and a == b
+
+
+print(f"parent tree: {old['verl_file']}\nnew tree:    {new['verl_file']}")
+check("each side ran its own tree (verl_file differs)", old["verl_file"] != new["verl_file"])
+scen = [k for k in old if isinstance(old[k], dict) and "params" in old[k]]
+missing = [k for k in scen if k not in new]
+check(f"the new run covers all {len(scen)} parent scenarios", not missing, f"(missing {missing})")
+for k in scen:
+    if k not in new:
+        continue
+    a, b = old[k], new[k]
+    bad = [f for f in a if f != "metrics" and (f not in b or not eq(a[f], b[f]))]
+    ma, mb = a["metrics"], b["metrics"]
+    extra = [x for x in mb if x not in ma]
+    order = [x for x in mb if x in ma] == list(ma)
+    mbad = [x for x in ma if x not in mb or not eq(ma[x], mb[x])]
+    check(f"{k}: every stored field and all {len(ma)} metrics bitwise, same order, no new keys",
+          not bad and not mbad and order and not extra and set(a) == set(b),
+          f"(fields differ: {bad}; metrics differ: {mbad[:6]}; new keys {extra})" if (bad or mbad or extra) else "")
+for sec in ("maxlp", "fullp", "has_rkl", "has_alpha", "has_fi", "rkl_refusals", "alpha_refusals", "fi_refusals"):
+    check(f"section {sec} bitwise", eq(old.get(sec), new.get(sec)))
+
+check("parent has no mix mode; new tree has it", not old.get("has_mix", False) and new.get("has_mix") is True)
+need = ["mixref_opd_rand", "mix_b0_rand", "mix_b1_rand", "mix_b05_rand", "fkl_rand"]
+if all(n in new for n in need):
+    r, m0, m1, m5, f = (new[n] for n in need)
+    check("beta 0 == OPD lambda 1 (same batch): advantages, log-probs, pg losses, updated parameters bitwise",
+          eq(m0["adv"], r["adv"]) and eq(m0["logp"], r["logp"]) and eq(m0["pg"], r["pg"]) and eq(m0["params"], r["params"]))
+    check("beta 1 == fkl_sampled on the same teacher tokens: updated parameters bitwise", eq(m1["params"], f["params"]))
+    check("beta 0 and beta 1 log paper/mix_beta 0.0 and 1.0",
+          float(m0["metrics"]["paper/mix_beta"][0]) == 0.0 and float(m1["metrics"]["paper/mix_beta"][0]) == 1.0)
+    fin = all(torch.isfinite(v).all() for v in m5["params"].values())
+    check("beta 0.5: parameters finite and different from both endpoints",
+          fin and not eq(m5["params"], m0["params"]) and not eq(m5["params"], m1["params"]))
+    check("beta 0.5: paper/mix_beta 0.5; paper/fkl_ce == fkl_rand's; paper/mix_rev_loss == OPD's pg loss (bitwise)",
+          [float(x) for x in m5["metrics"]["paper/mix_beta"]] == [0.5] * len(m5["metrics"]["paper/mix_beta"])
+          and eq(m5["metrics"]["paper/fkl_ce"], f["metrics"]["paper/fkl_ce"])
+          and eq([float(x) for x in m5["metrics"]["paper/mix_rev_loss"]], [float(x) for x in r["pg"]]))
+    check("OPD reference and fkl_rand log no mix metric",
+          "paper/mix_beta" not in r["metrics"] and "paper/mix_beta" not in f["metrics"])
+else:
+    check("mix scenarios present", False, f"(missing {[n for n in need if n not in new]})")
+mr = new.get("mix_refusals") or {}
+check(f"all {len(mr)} PAPER_MIX_BETA refusal cases raise with parameters unchanged",
+      len(mr) == 8 and all(v["error"] is not None and v["params_unchanged"] for v in mr.values()),
+      "; ".join(f"{k}: {(v['error'] or 'NO ERROR')[:90]}" for k, v in mr.items()))
+print(f"\n{len(scen)} parent scenarios; {sum(RES)} passed, {len(RES) - sum(RES)} failed")
+sys.exit(0 if all(RES) else 1)
diff --git a/verl/tests/erropd/rkl_compare.py b/verl/tests/erropd/rkl_compare.py
new file mode 100644
index 0000000..892c3d5
--- /dev/null
+++ b/verl/tests/erropd/rkl_compare.py
@@ -0,0 +1,125 @@
+"""Compare equiv_harness outputs of the reference snapshot without rkl_full (302dfd90ef) and the tree with it, run in
+the same interpreter on the same stored batch. Exit 1 on any failure.
+
+Usage: python rkl_compare.py OLD.pt NEW.pt
+
+1. Every scenario both trees ran (production lambda, ERROPD interventions, R2G modes, PAPER_LOSS_MODE=opd,
+   fkl_sampled with own / random teacher tokens) is bitwise unchanged: advantages, current log-probs, pg losses,
+   initial and updated parameters, the logged metrics (same keys, equal values), and the fkl SFT references.
+   The teacher-pass section (log-probs, B3p max log-prob, fkl teacher samples, label override) is bitwise unchanged.
+2. rkl_full (peaked tiny teacher registered in-process) == an independent full-vocabulary reverse-KL step (plain HF
+   forwards, log_softmax, sum over the vocabulary, token-mean, clip, SGD): per-micro-batch loss and updated
+   parameters; no policy-gradient path; the teacher recomputed in the update equals the teacher pass exactly.
+   rkl_selfteacher (teacher = the student's initial weights): loss 0 and no update beyond rounding.
+3. Full-vocabulary log-probs: padded and remove-padding paths == a direct log_softmax of the row alone; the
+   sampled-token log-probs are unchanged by the request.
+4. Refusals (lambda != 1, no in-process teacher, ERROPD tensors, nonzero kl coef, teacher-pass tokens that differ from
+   the student's) raise before any parameter change. With G-OPD's re-tokenized teacher-pass inputs present and
+   token-identical, rkl_full is bitwise unchanged.
+"""
+import math
+import sys
+
+import torch
+
+old = torch.load(sys.argv[1], weights_only=False)
+new = torch.load(sys.argv[2], weights_only=False)
+lines, fails = [], []
+
+
+def check(name, cond):
+    lines.append(f"{'PASS' if cond else 'FAIL'}  {name}")
+    if not cond:
+        fails.append(name)
+
+
+def eq(a, b):
+    if isinstance(a, torch.Tensor) or isinstance(b, torch.Tensor):
+        return isinstance(a, torch.Tensor) and isinstance(b, torch.Tensor) and a.shape == b.shape and torch.equal(a, b)
+    if isinstance(a, dict) and isinstance(b, dict):
+        return a.keys() == b.keys() and all(eq(a[k], b[k]) for k in a)
+    if isinstance(a, (list, tuple)) and isinstance(b, (list, tuple)):
+        return len(a) == len(b) and all(eq(x, y) for x, y in zip(a, b))
+    if isinstance(a, float) and isinstance(b, float) and math.isnan(a) and math.isnan(b):
+        return True
+    return a == b
+
+
+lines.append(f"reference tree: {old['verl_file']} (rkl: {old.get('has_rkl', False)})")
+lines.append(f"tested tree:    {new['verl_file']} (rkl: {new.get('has_rkl', False)})")
+if old.get("has_rkl", False):
+    # a later reference (e.g. e5b0c8e6f8, the snapshot RX part D ran on): rkl_full exists in both trees and this
+    # script is then a pure regression check on the scenarios both ran
+    check("reference tree already has rkl_full, so is a later reference; both trees have it", new.get("has_rkl", False))
+else:
+    check("reference tree lacks rkl_full, tested tree has it",
+          (not old.get("has_rkl", False)) and new.get("has_rkl", False))
+
+# 1. unchanged scenarios. The alpha-gate scenarios (PAPER_RKL_ALPHA, added later) are deliberately NOT in this set:
+# alpha = 1 must be bitwise equal and alpha != 1 must differ, which is alpha_compare.py's job. Likewise the factor-
+# isolation scenarios (PAPER_FI_MODE, added after that), which are fi_compare.py's.
+shared = [k for k in old if isinstance(old[k], dict) and "params" in old[k] and k in new
+          and not k.startswith(("rkl_alpha", "rkl_fi_"))]
+for sc in shared:
+    o, n = old[sc], new[sc]
+    ok = all(eq(o[k], n[k]) for k in ("adv", "pg", "logp", "params0", "params", "metrics", "fkl_ref"))
+    check(f"[{sc}] advantages, log-probs, pg losses ({len(n['pg'])}), initial/updated parameters, metrics "
+          f"({len(n['metrics'])} keys), references: bitwise equal to the reference tree", ok)
+# 18 against a reference tree without rkl_full (the three rkl scenarios are skipped there), 21 against one with it
+_want = 21 if old.get("has_rkl", False) else 18
+check(f"all {len(shared)} non-alpha scenarios of the reference run compared (expected {_want} for this reference)",
+      len(shared) == _want)
+check("teacher-pass section (log-probs, B3p max, fkl teacher samples, label override) bitwise equal",
+      eq(old["maxlp"], new["maxlp"]))
+
+# 2. rkl
+for sc in ("rkl_full", "rkl_selfteacher", "rkl_full_refinputs"):
+    n = new[sc]
+    ref = n["fkl_ref"]
+    loss = n["metrics"].get("paper/rkl_full", [])
+    dl = max(abs(a - float(b)) for a, b in zip(loss, ref["ce"])) if len(loss) == len(ref["ce"]) == 4 else 1e9
+    dp = max((n["params"][k] - ref["params"][k]).abs().max().item() for k in ref["params"])
+    up = max((n["params"][k] - n["params0"][k]).abs().max().item() for k in ref["params"])
+    tv = max(n["metrics"].get("paper/rkl_teacher_vs_ref_absdiff_max", [1e9]))
+    check(f"[{sc}] rkl loss per micro-batch == independent full-vocabulary RKL (max diff {dl:.2e} <= 1e-6; losses "
+          f"{[round(x, 4) for x in loss]})", dl <= 1e-6)
+    check(f"[{sc}] SGD update == independent step (max param diff {dp:.2e} <= 1e-7; update size {up:.2e})", dp <= 1e-7)
+    check(f"[{sc}] no policy-gradient path, kl_loss 0, teacher recomputed in the update == teacher pass "
+          f"(max |diff| {tv})", len(n["adv"]) == 0 and sum(n["metrics"].get("actor/kl_loss", [0.0])) == 0.0
+          and tv == 0.0)
+f, g = new["rkl_full"], new["rkl_full_refinputs"]
+check("[rkl_full_refinputs] with G-OPD's re-tokenized teacher-pass inputs in the batch (same tokens, wider left "
+      "padding): loss, metrics and update bitwise equal to rkl_full",
+      eq(f["metrics"], g["metrics"]) and eq(f["params"], g["params"]))
+n = new["rkl_full"]
+check(f"[rkl_full] the update is real (size {max((n['params'][k] - n['params0'][k]).abs().max().item() for k in n['params']):.2e} "
+      f"> 1e-5); single-sample estimate logged next to the loss "
+      f"({[round(x, 3) for x in n['metrics'].get('paper/rkl_sampled_est', [])]} vs "
+      f"{[round(x, 3) for x in n['metrics'].get('paper/rkl_full', [])]})",
+      max((n["params"][k] - n["params0"][k]).abs().max().item() for k in n["params"]) > 1e-5
+      and len(n["metrics"].get("paper/rkl_sampled_est", [])) == 4)
+s = new["rkl_selfteacher"]
+check("[rkl_selfteacher] loss exactly 0 and update <= 1e-9 (teacher == student)",
+      all(x == 0.0 for x in s["metrics"]["paper/rkl_full"])
+      and max((s["params"][k] - s["params0"][k]).abs().max().item() for k in s["params"]) <= 1e-9)
+
+# 3. full log-probs
+rows = new["fullp"]["rows"]
+d0 = max((r["full_rmpad0"] - r["direct"]).abs().max().item() for r in rows)
+d1 = max((r["full_rmpad1"] - r["direct"]).abs().max().item() for r in rows)
+check(f"[full log-probs] padded path == direct log_softmax of the row alone, {len(rows)} rows incl. left/right "
+      f"padding (max diff {d0:.2e} <= 1e-6)", d0 <= 1e-6)
+check(f"[full log-probs] remove-padding path == direct (max diff {d1:.2e} <= 1e-6)", d1 <= 1e-6)
+check("[full log-probs] requesting them leaves the sampled-token log-probs bitwise unchanged (both paths)",
+      all(r["lp_unchanged_rmpad0"] and r["lp_unchanged_rmpad1"] for r in rows))
+dt = max(max((r[f"tok_from_full_rmpad{i}"] - r[f"lp_rmpad{i}"]).abs().max().item() for i in (0, 1)) for r in rows)
+check(f"[full log-probs] gathered at the sampled token == the sampled-token log-prob up to the CPU bf16 log-softmax "
+      f"rounding (max diff {dt:.2e} <= 0.05)", dt <= 0.05)
+
+# 4. refusals
+for k, r in new["rkl_refusals"].items():
+    check(f"[refusal {k}] raises ({(r['error'] or 'none')[:80]}) and leaves parameters unchanged",
+          r["error"] is not None and r["params_unchanged"])
+print("\n".join(lines))
+print(f"\n{sum(1 for x in lines if x.startswith('PASS'))} passed, {len(fails)} failed")
+sys.exit(1 if fails else 0)
diff --git a/verl/tests/erropd/test_alpha.py b/verl/tests/erropd/test_alpha.py
new file mode 100644
index 0000000..c74628c
--- /dev/null
+++ b/verl/tests/erropd/test_alpha.py
@@ -0,0 +1,228 @@
+"""PAPER rkl_full alpha gate: the maths of the reallocated full-vocabulary reverse-KL step (CPU, no GPU, no Ray).
+
+  PYTHONPATH=<tree>/verl python test_alpha.py
+
+What is checked, in order:
+
+(1) omega is the closed form.  DataParallelPPOActor._paper_alpha_omega equals, in float64, the formula written out by
+    hand: omega[v] = p[v]^alpha r[v] - (sum_u p[u]^alpha r[u]) p[v], with r[v] = lp_s[v] - lp_t[v] - L and
+    L = sum_v p[v](lp_s[v] - lp_t[v]); and sum_v omega[v] = 0 to float precision.
+(2) The surrogate has exactly that logit gradient.  d/dz [ sum_v omega[v] log softmax(z)[v] ] = omega, for every
+    alpha and both renorm settings -- this is the only reason the construction is legitimate, and it holds because
+    sum_v omega = 0 kills the -p[v] sum_u omega[u] term of the log-softmax Jacobian.
+(3) alpha = 1 reproduces the existing arm.  With alpha = 1 and renorm off, omega equals p*r bitwise, and the
+    surrogate's gradient equals the autograd gradient of the implemented rkl_full loss to float tolerance.
+(4) Stationary point.  With teacher = student, r = 0, so omega = 0 exactly for every alpha and renorm. Away from it,
+    omega != 0 for every alpha (the reallocation introduces no spurious zero).
+(5) Renormalisation does what it says: ||omega||_2 per prefix equals the alpha = 1 norm, and is exactly 1.0-scaled
+    at alpha = 1.
+(6) Renormalisation does NOT hold the parameter step fixed.  With a shared output matrix W, the gradient reaching the
+    hidden state is W^T omega, whose norm depends on the direction of omega in vocabulary space, not only its norm:
+    measured here at matched ||omega||.
+(7) Adam discards the renormalisation.  One AdamW step is invariant to scaling the gradient by a constant once
+    sqrt(v_hat) >> eps, so an L2 renormalisation of the gradient is not a step-size control under Adam; it becomes
+    one only in the eps-dominated regime. Both regimes are measured.
+(8) Chunking is exact: chunk = 1 and chunk = all give bitwise identical omega.
+(9) _paper_alpha_masks picks the boundary states and the err_slot-th one of them.
+"""
+import math
+import sys
+
+import torch
+
+import verl.utils.torch_functional as vtf
+from verl.trainer.ppo.core_algos import agg_loss
+from verl.workers.actor.dp_actor import DataParallelPPOActor as A
+from verl.workers.actor.dp_actor import paper_alpha_cfg
+
+vtf.FLAH_ATTN_CROSS_ENTROPY_LOSS_AVAILABLE = False
+RES = []
+ALPHAS = (0.0, 0.5, 1.0)
+
+
+def check(name, cond, detail=""):
+    RES.append(bool(cond))
+    print(f"{'PASS' if cond else 'FAIL'}  {name} {detail}", flush=True)
+
+
+def closed_form(lp_s, lp_t, alpha, renorm, eps=1e-12, center=True):
+    """omega by hand in float64, independent of the implementation. center=False matches the implementation's
+    alpha == 1 branch, which keeps the existing arm's expression p*r and does not re-centre it: sum_v p_v r_v is zero
+    analytically, and the implementation deliberately inherits that expression's float residual rather than changing
+    the arm that is already in the paper."""
+    s, t = lp_s.double(), lp_t.double()
+    p = s.exp()
+    r = s - t
+    r = r - (p * r).sum(-1, keepdim=True)
+    g1 = p * r
+    w = p.pow(alpha) * r
+    if center:
+        w = w - w.sum(-1, keepdim=True) * p
+    if renorm:
+        w = w * (g1.norm(dim=-1) / w.norm(dim=-1).clamp_min(eps)).unsqueeze(-1)
+    return w, g1
+
+
+def states(seed=11, n=5, V=64):
+    """n random (student, teacher) states, one of them near-deterministic like a JSON-ranking prefix."""
+    g = torch.Generator().manual_seed(seed)
+    zs = 3.0 * torch.randn(n, V, generator=g)
+    zt = 3.0 * torch.randn(n, V, generator=g)
+    zs[0] *= 6.0  # a peaked student: min p ~ 1e-9, the regime the paper's error token lives in
+    zt[0, 7] = zs[0].max() - 1.4  # ... whose teacher nevertheless likes token 7
+    return torch.log_softmax(zs.float(), -1).view(1, n, V), torch.log_softmax(zt.float(), -1).view(1, n, V)
+
+
+lp_s, lp_t = states()
+V = lp_s.shape[-1]
+
+# ------------------------------------------------------------------ (1) closed form, (5) renorm, (8) chunking
+for alpha in ALPHAS:
+    for renorm in (False, True):
+        om, st = A._paper_alpha_omega(lp_s, lp_t, alpha, renorm, err_token=7)
+        ref, g1 = closed_form(lp_s, lp_t, alpha, renorm, center=(alpha != 1.0))
+        rel = ((om.double() - ref).abs().max() / ref.abs().max()).item()
+        check(f"[alpha={alpha} renorm={renorm}] omega == closed form p^alpha r - (sum p^alpha r) p", rel < 1e-5,
+              f"(max rel diff {rel:.2e})")
+        zs = (om.sum(-1).abs() / om.abs().sum(-1)).max().item()
+        # the explicit double centering (alpha != 1) drives the residual to fp32 noise; at alpha = 1 the residual is
+        # the one the existing arm's own expression already has, and is inherited rather than fixed
+        bar = 1e-4 if alpha == 1.0 else 1e-6
+        check(f"[alpha={alpha} renorm={renorm}] sum_v omega[v] == 0 to fp32 (relative to ||omega||_1, bar {bar:g})",
+              zs < bar, f"(max {zs:.2e})")
+        if renorm:
+            d = (st["n_post"] - st["n_a1"]).abs().max().item() / st["n_a1"].max().item()
+            check(f"[alpha={alpha}] renormalised ||omega||_2 == the alpha=1 norm ||p r||_2 per prefix", d < 1e-5,
+                  f"(max rel diff {d:.2e}, scales {[round(x, 4) for x in st['scale'][0].tolist()]})")
+        om1 = A._paper_alpha_omega(lp_s, lp_t, alpha, renorm, chunk=1, err_token=7)[0]
+        omA = A._paper_alpha_omega(lp_s, lp_t, alpha, renorm, chunk=10**6, err_token=7)[0]
+        check(f"[alpha={alpha} renorm={renorm}] chunk=1 and one-shot give bitwise identical omega",
+              torch.equal(om1, omA))
+
+om1 = A._paper_alpha_omega(lp_s, lp_t, 1.0, True)[1]
+check("[alpha=1] the renormalisation factor is exactly 1.0 (so the alpha=1 arm is the existing arm)",
+      bool((om1["scale"] == 1.0).all()), f"(scales {om1['scale'][0].tolist()})")
+
+# ------------------------------------------------------------------ (2) the surrogate's logit gradient is omega
+for alpha in ALPHAS:
+    for renorm in (False, True):
+        z = (3.0 * torch.randn(1, 4, V, generator=torch.Generator().manual_seed(5))).requires_grad_(True)
+        s = torch.log_softmax(z, -1)
+        t = torch.log_softmax(3.0 * torch.randn(1, 4, V, generator=torch.Generator().manual_seed(6)), -1)
+        om, _ = A._paper_alpha_omega(s, t, alpha, renorm, err_token=7)
+        mask = torch.ones(1, 4)
+        loss = agg_loss(loss_mat=(om * s).sum(-1), loss_mask=mask, loss_agg_mode="token-mean")
+        (g,) = torch.autograd.grad(loss, z)
+        want = om / mask.sum()  # token-mean divides by the number of masked positions
+        rel = ((g - want).abs().max() / want.abs().max()).item()
+        check(f"[alpha={alpha} renorm={renorm}] d/dlogit of the surrogate == omega / N_masked", rel < 1e-5,
+              f"(max rel diff {rel:.2e})")
+
+# ------------------------------------------------------------------ (3) alpha = 1 is the existing loss's gradient
+z = (3.0 * torch.randn(1, 4, V, generator=torch.Generator().manual_seed(7))).requires_grad_(True)
+s = torch.log_softmax(z, -1)
+t = torch.log_softmax(3.0 * torch.randn(1, 4, V, generator=torch.Generator().manual_seed(8)), -1)
+mask = torch.ones(1, 4)
+true_loss = agg_loss(loss_mat=A._paper_rkl_full(s, t), loss_mask=mask, loss_agg_mode="token-mean")
+(g_true,) = torch.autograd.grad(true_loss, z, retain_graph=True)
+om, _ = A._paper_alpha_omega(s, t, 1.0, False)
+check("[alpha=1 renorm=off] omega == p*r bitwise (the existing loss's logit gradient, times N)",
+      torch.equal(om, (s.detach().exp() * (s.detach() - t - A._paper_rkl_full(s.detach(), t).unsqueeze(-1)))))
+surr = agg_loss(loss_mat=(om * s).sum(-1), loss_mask=mask, loss_agg_mode="token-mean")
+(g_surr,) = torch.autograd.grad(surr, z)
+rel = ((g_surr - g_true).abs().max() / g_true.abs().max()).item()
+check("[alpha=1 renorm=off] the surrogate's gradient == autograd of the implemented rkl_full loss", rel < 1e-5,
+      f"(max rel diff {rel:.2e})")
+
+# ------------------------------------------------------------------ (4) stationary point
+for alpha in ALPHAS:
+    for renorm in (False, True):
+        om, st = A._paper_alpha_omega(lp_s, lp_s.clone(), alpha, renorm, err_token=7)
+        check(f"[alpha={alpha} renorm={renorm}] teacher == student: omega is exactly 0 (same stationary point)",
+              bool((om == 0).all()), f"(max |omega| {om.abs().max().item():.2e})")
+        om2, _ = A._paper_alpha_omega(lp_s, lp_t, alpha, renorm, err_token=7)
+        check(f"[alpha={alpha} renorm={renorm}] teacher != student: omega != 0 at every prefix (no new zeros)",
+              bool((om2.abs().sum(-1) > 0).all()))
+
+# ------------------------------------------------------------------ (6) what the renormalisation does not hold
+#  A trained output matrix is not isotropic: the rows of the tokens a near-deterministic model actually emits are
+#  aligned with each other and with the hidden state. Build that: the 8 tokens the student puts its mass on share a
+#  direction u, the rest are random. At alpha = 1 omega lives on those 8 rows and sums to ~0 over them, so W^T omega
+#  largely cancels; at alpha = 0 the same L2 mass sits on random rows and does not.
+_g = torch.Generator().manual_seed(21)
+W = torch.randn(V, 96, generator=_g) / math.sqrt(96)
+_u = torch.randn(96, generator=_g) / math.sqrt(96)
+_top = lp_s[0, 0].exp().topk(8).indices  # the peaked prefix's own support
+W[_top] = _u.unsqueeze(0) + 0.02 * torch.randn(8, 96, generator=_g) / math.sqrt(96)
+hid, hid_all = {}, {}
+for alpha in ALPHAS:
+    om, st = A._paper_alpha_omega(lp_s, lp_t, alpha, True, err_token=7)
+    hid[alpha] = float((om[0, 0] @ W).norm())        # the near-deterministic prefix, the regime that matters
+    hid_all[alpha] = float((om[0] @ W).norm(dim=-1).mean())
+r_lo, r_hi = min(hid.values()), max(hid.values())
+check("renormalisation holds ||omega||_2 but NOT the gradient reaching the hidden state ||W^T omega||: at a "
+      "near-deterministic prefix, matched ||omega|| gives different ||W^T omega|| across alpha",
+      r_hi / max(r_lo, 1e-30) > 1.5,
+      f"(peaked prefix {{{', '.join(f'{k}: {v:.4g}' for k, v in hid.items())}}}, ratio "
+      f"{r_hi / max(r_lo, 1e-30):.1f}x; mean over all 5 prefixes "
+      f"{{{', '.join(f'{k}: {v:.4g}' for k, v in hid_all.items())}}})")
+
+# ------------------------------------------------------------------ (7) Adam discards a gradient rescaling
+def adam_step(g_mag, grad_scale, eps, steps=6, lr=1e-6, n=512):
+    """|theta| after `steps` AdamW steps on a constant, consistently signed gradient of magnitude ~g_mag*grad_scale."""
+    g0 = (1.0 + torch.rand(n, generator=torch.Generator().manual_seed(31))) * g_mag  # bounded away from 0
+    p = torch.zeros(n, requires_grad=True)
+    opt = torch.optim.AdamW([p], lr=lr, eps=eps, weight_decay=0.0)
+    for _ in range(steps):
+        opt.zero_grad()
+        p.grad = g0 * grad_scale
+        opt.step()
+    return p.detach().abs().mean().item()
+
+
+a, b = adam_step(1e-5, 1.0, 1e-8), adam_step(1e-5, 1e4, 1e-8)
+check("Adam with sqrt(v_hat) >> eps is scale-invariant: x1e4 on the gradient leaves the 6-step update within 1%, so "
+      "an L2 renormalisation of the gradient is NOT a step-size control there", abs(b / a - 1.0) < 0.01,
+      f"(|update| {a:.3e} vs {b:.3e}, ratio {b / a:.5f})")
+a2, b2 = adam_step(1e-9, 1.0, 1e-8), adam_step(1e-9, 1e4, 1e-8)
+check("... and with the gradient at or below eps the invariance breaks, so whether the renormalisation does anything "
+      "depends on where the per-coordinate gradient sits relative to Adam's eps", b2 / a2 > 2.0,
+      f"(|update| {a2:.3e} vs {b2:.3e}, ratio {b2 / a2:.1f}x)")
+c, d = adam_step(1e-7, 1.0, 1e-3), adam_step(1e-7, 1e4, 1e-3)
+check("Adam at eps=1e-3 is eps-dominated throughout and the same x1e4 changes the update by >1000x, i.e. the "
+      "renormalisation controls the step only in that (SGD-like) regime", d / c > 1e3,
+      f"(|update| {c:.3e} vs {d:.3e}, ratio {d / c:.0f}x)")
+
+# ------------------------------------------------------------------ (9) the diagnostic position sets
+resp = torch.tensor([[5, 23, 9, 23, 23, 4, 23, 1], [23, 23, 23, 23, 23, 23, 23, 23]])
+rm = torch.ones(2, 8)
+rm[0, 6:] = 0.0  # the row ends before its third boundary token
+m = A._paper_alpha_masks(resp, rm, 23, 2)
+check("masks: boundary states are the masked positions whose sampled token is the separator",
+      m["bnd"].tolist() == [[False, True, False, True, True, False, False, False],
+                            [True] * 8])
+check("masks: the err_slot-th boundary state is picked, once per row",
+      m["slot"].tolist() == [[False, False, False, True, False, False, False, False],
+                             [False, True] + [False] * 6])
+
+# ------------------------------------------------------------------ config surface: default off
+import os  # noqa: E402
+
+for k in ("PAPER_RKL_ALPHA",):
+    os.environ.pop(k, None)
+check("paper_alpha_cfg() is None when PAPER_RKL_ALPHA is unset (default off)", paper_alpha_cfg() is None)
+os.environ["PAPER_RKL_ALPHA"] = "1.0"
+cfg = paper_alpha_cfg()
+check("alpha=1 does not change the applied step (cfg['apply'] is False)", cfg["apply"] is False, f"({cfg})")
+os.environ["PAPER_RKL_ALPHA"] = "0.5"
+check("alpha=0.5 does change the applied step", paper_alpha_cfg()["apply"] is True)
+os.environ["PAPER_RKL_ALPHA"] = "-1"
+try:
+    paper_alpha_cfg()
+    check("alpha < 0 is refused", False)
+except ValueError as e:
+    check("alpha < 0 is refused", True, f"({e})")
+os.environ.pop("PAPER_RKL_ALPHA", None)
+
+print(f"\n{sum(RES)} passed, {len(RES) - sum(RES)} failed")
+sys.exit(0 if all(RES) else 1)
diff --git a/verl/tests/erropd/test_classT.py b/verl/tests/erropd/test_classT.py
new file mode 100644
index 0000000..72ddd1d
--- /dev/null
+++ b/verl/tests/erropd/test_classT.py
@@ -0,0 +1,140 @@
+"""Class T (list termination) on tokenized outputs: every item-boundary token (`},` or variants), the list close
+(`}]` or a separate `]`), and EOS must be T; nothing else may be T on well-formed outputs.
+
+  PYTHONPATH=<snapshot>/verl ERROPD_TOKENIZER=<student SFT dir> python test_classT.py [pred_files.txt] [root]
+"""
+import json
+import os
+import random
+import sys
+
+from transformers import AutoTokenizer
+
+from verl.erropd import listwise_contract as lc
+from verl.erropd.hooks import TokenSpanDecoder
+
+tok = AutoTokenizer.from_pretrained(os.environ["ERROPD_TOKENIZER"])
+dec = TokenSpanDecoder(tok)
+EOS = tok.eos_token_id
+FAILS = []
+
+
+def classes(text, add_eos=True):
+    ids = tok(text, add_special_tokens=False)["input_ids"] + ([EOS] if add_eos else [])
+    t, spans = dec.decode(ids)
+    assert t == text, (t, text)
+    cls, _ = lc.token_classes_from_spans(t, spans)
+    pieces = [t[a:b] if b > a else "<EOS>" for a, b in spans]
+    return ids, pieces, cls
+
+
+def expected_T_chars(text):
+    """Independent reference: positions of item-closing '}' / top-level ',' / list-closing ']' via json scanning
+    of the canonical structure (json.loads of the list prefix at each position is too slow; use a simple walk)."""
+    return set(lc._term_positions(text))
+
+
+def check(name, text, n_items):
+    ids, pieces, cls = classes(text)
+    t_tokens = [(i, ids[i], pieces[i]) for i in range(len(ids)) if cls[i] == lc.TERM]
+    # every token containing a T character must be T, and T tokens must be exactly those (+ EOS)
+    _, spans = dec.decode(ids)
+    tpos = expected_T_chars(text)
+    must = {i for i, (a, b) in enumerate(spans) if any(a <= p < b for p in tpos)} | {len(ids) - 1}
+    got = {i for i, _, _ in t_tokens}
+    ok = must == got
+    # boundary count: n_items-1 separators + 1 close (tokens may merge '}' with ',' or ']')
+    n_close_like = sum(1 for _, _, p in t_tokens if p != "<EOS>")
+    print(f"{'PASS' if ok else 'FAIL'}  {name}: T tokens = {[(tid, p) for _, tid, p in t_tokens]}")
+    if not ok:
+        FAILS.append(name)
+        print("   missing:", [(i, pieces[i]) for i in must - got], "extra:", [(i, pieces[i]) for i in got - must])
+    return t_tokens, n_close_like
+
+
+ids8 = ["item_0001", "item_0002", "item_0003", "item_0004",
+        "item_0005", "item_0006", "item_0007", "item_0008"]
+sc = [3.1, 5.6, 8.2, 4.4, 6.8, 6.8, 2.5, 7.7]
+canon = "[" + ", ".join('{"review_id": "%s", "score": %s}' % (i, s) for i, s in zip(ids8, sc)) + "]"
+k1 = "[" + ", ".join('{"review_id": "%s", "score": %s}' % (i, s) for i, s in zip(ids8[:7], sc)) + "]"
+kp1 = canon[:-1] + ', {"review_id": "%s", "score": 1.0}]' % ids8[0]
+pretty = "[\n" + ",\n".join('  {\n    "review_id": "%s",\n    "score": %s\n  }' % (i, s) for i, s in zip(ids8, sc)) + "\n]"
+pretty2 = "[\n" + "\n".join('  {"review_id": "%s", "score": %s},' % (i, s) for i, s in zip(ids8[:7], sc)) + \
+          '\n  {"review_id": "%s", "score": %s}\n]' % (ids8[7], sc[7])
+rev = "[" + ", ".join('{"score": %s, "review_id": "%s"}' % (s, i) for i, s in zip(ids8, sc)) + "]"
+strscore = "[" + ", ".join('{"review_id": "%s", "score": "%s"}' % (i, s) for i, s in zip(ids8, sc)) + "]"
+nospace = "[" + ",".join('{"review_id":"%s","score":%s}' % (i, s) for i, s in zip(ids8, sc)) + "]"
+fenced = "```json\n" + canon + "\n```"
+
+print("token ids: '},' ->", tok.encode("},", add_special_tokens=False), " '}]' ->", tok.encode("}]", add_special_tokens=False),
+      " ']' ->", tok.encode("]", add_special_tokens=False), " EOS ->", EOS)
+for name, text, n in (("canonical K=8", canon, 8), ("premature close K-1", k1, 7), ("extra item K+1", kp1, 9),
+                      ("pretty-printed", pretty, 8), ("one item per line", pretty2, 8), ("reversed key order", rev, 8),
+                      ("string scores", strscore, 8), ("no spaces", nospace, 8), ("markdown fence", fenced, 8)):
+    t_tokens, n_close = check(name, text, n)
+    if name == "canonical K=8":
+        seps = [p for _, _, p in t_tokens]
+        ok = seps == ["},"] * 7 + ["}]", "<EOS>"]
+        print(f"{'PASS' if ok else 'FAIL'}  canonical: the 7 boundary tokens are the single token '}},' and the close is '}}]'")
+        if not ok:
+            FAILS.append("canonical-exact")
+
+# the slot-7 decision: continue token and close token are both T, whichever is sampled
+c7 = canon[: canon.index('"score": 2.5}') + len('"score": 2.5')]
+for nxt, label in (("},", "continue '},' at slot 7"), ("}]", "close '}]' at slot 7")):
+    ids, pieces, cls = classes(c7 + nxt, add_eos=False)
+    last = len(ids) - 1
+    ok = pieces[last] == nxt and cls[last] == lc.TERM
+    print(f"{'PASS' if ok else 'FAIL'}  {label}: last token {pieces[last]!r} id {ids[last]} class {lc.CLASS_NAMES[cls[last]]}")
+    if not ok:
+        FAILS.append(label)
+
+# stored eval outputs: on every parser-valid output, T tokens are exactly the boundary/close tokens + EOS,
+# each boundary token contains '}' and (',' or ']'); on K-1 outputs the violating token is T.
+if len(sys.argv) > 1:
+    root = sys.argv[2] if len(sys.argv) > 2 else "."
+    files = [l.strip() for l in open(sys.argv[1]) if l.strip()]
+    random.seed(0)
+    recs = []
+    for f in files:
+        try:
+            for line in open(os.path.join(root, f)):
+                r = json.loads(line)
+                if all(k in r for k in ("review_ids", "K", "pred_text")) and len(r["pred_text"]) < 1000:
+                    recs.append(r)
+        except Exception:
+            pass
+    sample = random.sample(recs, min(6000, len(recs)))
+    n_valid = n_k1 = bad_valid = bad_k1 = 0
+    piece_counts = {}
+    for r in sample:
+        text = r["pred_text"]
+        ids, pieces, cls = classes(text)
+        st, ci, vt = lc.locate_first_violation(text, r["K"], r["review_ids"])
+        if st == lc.VALID:
+            n_valid += 1
+            tp = [pieces[i] for i in range(len(ids)) if cls[i] == lc.TERM]
+            for p in tp:
+                piece_counts[p] = piece_counts.get(p, 0) + 1
+            _, spans = dec.decode(ids)
+            tpos = set(lc._term_positions(text))
+            must = {i for i, (a, b) in enumerate(spans) if any(a <= q < b for q in tpos)} | {len(ids) - 1}
+            got = {i for i in range(len(ids)) if cls[i] == lc.TERM}
+            # exact set equality, and all K item boundaries/close present (K '}' closing items + the list ']')
+            n_close_chars = len(tpos)
+            if must != got or n_close_chars != 2 * r["K"] or tp[-1] != "<EOS>":
+                bad_valid += 1
+        elif vt == "premature_close":
+            n_k1 += 1
+            _, spans = dec.decode(ids)
+            vtok = [i for i, (a, b) in enumerate(spans) if a <= ci < b][0]
+            bad_k1 += cls[vtok] != lc.TERM
+    print(f"stored outputs: {len(sample)} sampled of {len(recs)}; valid {n_valid}: {bad_valid} violating "
+          f"(T tokens must be exactly the tokens containing an item-closing '}}', a top-level ',' or the list ']' "
+          f"(2K characters), plus EOS); premature close {n_k1}: {bad_k1} with a non-T violating token")
+    print("T token pieces on valid outputs:", dict(sorted(piece_counts.items(), key=lambda x: -x[1])))
+    if bad_valid or bad_k1:
+        FAILS.append("stored outputs")
+
+print(f"\n{'ALL PASS' if not FAILS else 'FAILURES: ' + ', '.join(FAILS)}")
+sys.exit(1 if FAILS else 0)
