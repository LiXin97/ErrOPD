+    _fi_env(PAPER_FI_MODE="rkldose", PAPER_FI_DOSE="1")
+    hk0 = ErropdHooks(make_cfg({}, lam=1.0), TOK)
+    check("T19 FI rkldose k=1 unforced: an actor that reports the force flag is refused",
