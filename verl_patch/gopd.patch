+def _merge_metric_dicts(list_of_dict: list[dict]):
+    """ERROPD: the metrics branch of DataProto.concat. When every worker reports the same key set (the regular case)
+    this is list_of_dict_to_dict_of_list, called unchanged. A key a worker emits only conditionally (e.g. a post-step
+    diagnostic on a position set that is empty in that rank's micro-batch) can be missing from some workers; then the
+    keys are the union (the first worker's order, then new keys in order of appearance) and each key's list holds the
+    values of the workers that reported it, instead of the assertion list_of_dict_to_dict_of_list raises.
+    list_of_dict_to_dict_of_list itself is unchanged: it also merges non_tensor_batch, where a mismatch must still fail.
+    """
+    if all(d.keys() == list_of_dict[0].keys() for d in list_of_dict):
+        return list_of_dict_to_dict_of_list(list_of_dict)
+    output = {}
+    for data in list_of_dict:
+        for key, item in data.items():
+            output.setdefault(key, []).append(item)
+    return output
+
+
