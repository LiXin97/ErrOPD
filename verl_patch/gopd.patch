+"""DOSE adds PAPER_FI_MODE=rkldose (k = PAPER_FI_DOSE: g1 x k at the item-k decision states, g1 elsewhere) to the MIX
+snapshot bcfda2a463. Everything that snapshot can run must be unchanged, and the new mode must be what it says.
+Exit 1 on any failure.
+
+  python dose_parent_compare.py PARENT.pt NEW.pt
+
+PARENT.pt is the parent's own equiv_harness output (its harness file, its tree, its scenario list); NEW.pt is the new
+tree's harness on the parent's scenarios plus rkl_dose_{k1, k3, k3_chunk1, k30, k3_nodec, k3_id}, same interpreter,
+same stored batch.
+1. For every parent scenario: every stored field and every metric (key order and values) bitwise equal; no new keys.
+2. The teacher-pass, full-vocabulary and refusal sections (rkl, alpha, MIX) bitwise equal; the FI refusals likewise
+   except the valid-mode list in the unknown-mode message, which now ends with rkldose.
+3. k = 1 IS rkl_full: advantages, log-probs, pg losses and updated parameters bitwise equal to rkl_full (the parent's
+   and the new tree's) and to the FI control; every metric of the FI control bitwise except paper/fi_mode (4 vs 7),
+   plus paper/fi_dose = 1; not applied, no surrogate loss.
+4. With no decision state (item 99) and under the identity switch, k = 3 applies g1 everywhere through the surrogate:
+   parameters bitwise rkl_fi_fis_id's (FI-S at its own norm). Against rkl_full's autograd route this is the documented
+   surrogate-route difference (fi_compare item 4): reported, bar 1e-8.
+5. k = 3 and k = 30: the update equals an INDEPENDENT step (float64 autograd g1, x k at the decision states recomputed
+   from the token ids) to 1e-8 per parameter, surrogate losses to 1e-5 relative; it is real and differs from rkl_full's
+   and between the two k; paper/rkl_full and the per-set ||g1|| / ||d|| sums are bitwise FI-S's (same forward pass).
+6. k = 3 and k = 30 metrics: fi_mode 7, fi_dose k, applied 1, fp64 1, identity 0, floor 0; at every micro-batch with
+   a decision state fi_scale_dec == k exactly, fi_want_sum_dec and fi_app_sum_dec == k fi_g1_sum_dec (rel 1e-6); off
+   the decision states the target mass is g1's (rel 1e-9); normdev_max <= 1e-5; cos_to_g1_min >= 0.9999; the
+   decision-state share of realised mass == k s / (1 + (k - 1) s), s = g1's share (rel 1e-6).
+7. Chunk 1 == chunk 256: parameters and every FI metric bitwise.
+8. Every rkldose refusal case raises with parameters unchanged.
+"""
+import math
+import sys
+
+import numpy as np
+import torch
+
+old = torch.load(sys.argv[1], weights_only=False)
+new = torch.load(sys.argv[2], weights_only=False)
+RES = []
+
+
+def check(name, cond, detail=""):
+    RES.append(bool(cond))
+    print(f"{'PASS' if cond else 'FAIL'}  {name} {detail}", flush=True)
+
+
+def eq(a, b):
+    if isinstance(a, torch.Tensor) or isinstance(b, torch.Tensor):
+        return isinstance(a, torch.Tensor) and isinstance(b, torch.Tensor) and a.shape == b.shape and \
+            a.dtype == b.dtype and torch.equal(a, b)
+    if isinstance(a, dict) and isinstance(b, dict):
+        return list(a) == list(b) and all(eq(a[k], b[k]) for k in a)
+    if isinstance(a, (list, tuple)) and isinstance(b, (list, tuple)):
+        return len(a) == len(b) and all(eq(x, y) for x, y in zip(a, b))
+    if isinstance(a, float) and isinstance(b, float):
+        return np.float64(a).tobytes() == np.float64(b).tobytes()
+    return type(a) is type(b) and a == b
+
+
+def dparam(x, y):
+    return max((x["params"][k] - y["params"][k]).abs().max().item() for k in x["params"])
+
+
+def upd(x):
+    return max((x["params"][k] - x["params0"][k]).abs().max().item() for k in x["params"])
+
+
+print(f"parent tree: {old['verl_file']}\nnew tree:    {new['verl_file']}")
+check("each side ran its own tree (verl_file differs)", old["verl_file"] != new["verl_file"])
+# 1
+scen = [k for k in old if isinstance(old[k], dict) and "params" in old[k]]
+missing = [k for k in scen if k not in new]
+check(f"the new run covers all {len(scen)} parent scenarios", not missing and len(scen) >= 42, f"(missing {missing})")
+for k in scen:
+    if k not in new:
+        continue
+    a, b = old[k], new[k]
+    bad = [f for f in a if f != "metrics" and (f not in b or not eq(a[f], b[f]))]
+    ma, mb = a["metrics"], b["metrics"]
+    extra = [x for x in mb if x not in ma]
+    order = [x for x in mb if x in ma] == list(ma)
+    mbad = [x for x in ma if x not in mb or not eq(ma[x], mb[x])]
+    check(f"{k}: every stored field and all {len(ma)} metrics bitwise, same order, no new keys",
+          not bad and not mbad and order and not extra and set(a) == set(b),
+          f"(fields differ: {bad}; metrics differ: {mbad[:6]}; new keys {extra})" if (bad or mbad or extra) else "")
+# 2
+for sec in ("maxlp", "fullp", "has_rkl", "has_alpha", "has_fi", "has_mix", "rkl_refusals", "alpha_refusals",
+            "mix_refusals"):
+    check(f"section {sec} bitwise", sec in old and eq(old.get(sec), new.get(sec)))
+# the FI refusals: the same cases, each raising with parameters unchanged; the error text is the parent's except that
+# the list of valid modes in the unknown-mode message now ends with rkldose
+fo, fn = old.get("fi_refusals") or {}, new.get("fi_refusals") or {}
+txt = [k for k in fo if k in fn and fn[k]["error"] != fo[k]["error"]]
+ok_txt = all((fn[k]["error"] or "").replace(" | rkldose)", ")") == fo[k]["error"] for k in txt)
+check(f"section fi_refusals: the same {len(fo)} cases, all raise, parameters unchanged; error text bitwise except the "
+      f"valid-mode list in {txt}", list(fo) == list(fn) and ok_txt and set(txt) <= {"fi_unknown_mode", "fi_dropped_fif"}
+      and all(fn[k]["error"] is not None and fn[k]["params_unchanged"] == fo[k]["params_unchanged"] for k in fn))
+check("parent has no rkldose; new tree has it", not old.get("has_dose", False) and new.get("has_dose") is True)
+
+need = ["rkl_dose_k1", "rkl_dose_k3", "rkl_dose_k3_chunk1", "rkl_dose_k30", "rkl_dose_k3_nodec", "rkl_dose_k3_id",
+        "rkl_full", "rkl_fi_ctl", "rkl_fi_fis", "rkl_fi_fis_id"]
+if not all(n in new for n in need):
+    check("dose scenarios present", False, f"(missing {[n for n in need if n not in new]})")
+else:
+    k1, k3, k3c, k30, k3n, k3i, rf, ctl, fis, fisid = (new[n] for n in need)
+    # 3
+    check(f"[k=1] advantages, log-probs, pg losses and updated parameters bitwise rkl_full's (new tree) and the "
+          f"parent's rkl_full (update size {upd(k1):.3e})",
+          all(eq(k1[f], rf[f]) and eq(k1[f], old["rkl_full"][f]) for f in ("adv", "pg", "logp", "params0", "params")))
+    check("[k=1] ... and the FI control's (rkl_fi_ctl) parameters bitwise", eq(k1["params"], ctl["params"]))
+    mk1, mct = k1["metrics"], ctl["metrics"]
+    dk = [x for x in mct if x != "paper/fi_mode" and not eq(mct[x], mk1.get(x))]
+    check("[k=1] every FI-control metric bitwise except paper/fi_mode (4 vs 7); the only extra key is paper/fi_dose == 1; "
+          "applied 0, no surrogate loss",
+          not dk and set(mk1) == set(mct) | {"paper/fi_dose"}
+          and all(x == 7.0 for x in mk1["paper/fi_mode"]) and all(x == 1.0 for x in mk1["paper/fi_dose"])
+          and all(x == 0.0 for x in mk1["paper/fi_applied"]) and "paper/fi_surr_loss" not in mk1, f"(differ {dk[:6]})")
+    # 4
+    check("[k=3, no decision state] parameters bitwise rkl_fi_fis_id's (g1 everywhere through the surrogate), and "
+          "n_dec == 0 at every micro-batch",
+          eq(k3n["params"], fisid["params"]) and all(x == 0.0 for x in k3n["metrics"]["paper/fi_n_dec"]))
+    check("[k=3, identity switch] parameters bitwise rkl_fi_fis_id's", eq(k3i["params"], fisid["params"]))
+    dr = dparam(k3n, rf)
+    check(f"[k=3, no decision state] against rkl_full's autograd route: max parameter difference {dr:.2e} <= 1e-8 "
+          f"(the surrogate-route difference fi_compare item 4 documents; k = 1 avoids it by taking rkl_full's path)",
+          dr <= 1e-8)
+    # 5
+    for name, n, k in (("rkl_dose_k3", k3, 3.0), ("rkl_dose_k30", k30, 30.0)):
+        ref = n["fkl_ref"]
+        dl = max(abs(a - float(b)) for a, b in zip(n["metrics"]["paper/fi_surr_loss"], ref["ce"]))
+        sc = max(abs(float(b)) for b in ref["ce"]) + 1e-12
+        dp = max((n["params"][x] - ref["params"][x]).abs().max().item() for x in ref["params"])
+        check(f"[{name}] surrogate loss per micro-batch == the independent float64 autograd step's (max diff {dl:.2e} "
+              f"<= 1e-5 x {sc:.3g})", dl <= 1e-5 * sc)
+        check(f"[{name}] SGD update == the independent step (max param diff {dp:.2e} <= 1e-8; update size "
+              f"{upd(n):.2e})", dp <= 1e-8)
+        check(f"[{name}] the update is real and differs from rkl_full's (max diff {dparam(n, rf):.2e}) and from k=1's",
+              upd(n) > 1e-8 and dparam(n, rf) > 1e-8 and dparam(n, k1) > 1e-8)
+        m, mf = n["metrics"], fis["metrics"]
+        same_fwd = ["paper/rkl_full"] + [x for x in mf if x.startswith(("paper/fi_g1_sum_", "paper/fi_d_sum_",
+                                                                        "paper/fi_n_"))]
+        bad = [x for x in same_fwd if not eq(m.get(x), mf[x])]
+        check(f"[{name}] same forward pass as FI-S: paper/rkl_full and the {len(same_fwd) - 1} per-set ||g1|| / ||d|| "
+              f"sums and counts bitwise", not bad, f"(differ {bad})")
+        # 6
+        cfgv = {x: m[x] for x in ("paper/fi_mode", "paper/fi_dose", "paper/fi_applied", "paper/fi_fp64",
+                                  "paper/fi_identity", "paper/fi_floor")}
+        want = {"paper/fi_mode": 7.0, "paper/fi_dose": k, "paper/fi_applied": 1.0, "paper/fi_fp64": 1.0,
+                "paper/fi_identity": 0.0, "paper/fi_floor": 0.0}
+        check(f"[{name}] configuration logged at every micro-batch: mode 7, dose {k:g}, applied 1, fp64 1, identity 0, "
+              f"floor 0", all(all(float(v) == want[x] for v in cfgv[x]) for x in want))
+        nd = m["paper/fi_n_dec"]
+        idx = [i for i, v in enumerate(nd) if v > 0]
+        sd = m.get("paper/fi_scale_dec", [])
+        check(f"[{name}] decision states present ({[int(x) for x in nd]} per micro-batch) and fi_scale_dec == {k:g} "
+              f"exactly at each", len(idx) >= 1 and len(sd) == len(idx) and all(float(x) == k for x in sd))
+        wd, ad, gd = (m[f"paper/fi_{x}_sum_dec"] for x in ("want", "app", "g1"))
+        rw = max(abs(wd[i] / (k * gd[i]) - 1) for i in idx)
+        ra = max(abs(ad[i] / (k * gd[i]) - 1) for i in idx)
+        wa, ga = m["paper/fi_want_sum_all"], m["paper/fi_g1_sum_all"]
+        ro = max(abs((wa[i] - wd[i]) - (ga[i] - gd[i])) / ga[i] for i in range(len(wa)))
+        check(f"[{name}] want_sum_dec and app_sum_dec == k g1_sum_dec (rel {rw:.1e}, {ra:.1e} <= 1e-6); off the "
+              f"decision states the target is g1's (rel {ro:.1e} <= 1e-9)", rw <= 1e-6 and ra <= 1e-6 and ro <= 1e-9)
+        nm = max(m["paper/fi_normdev_max"])
+        cm = min(m["paper/fi_cos_to_g1_min"])
+        check(f"[{name}] N1: normdev_max {nm:.1e} <= 1e-5 and cos_to_g1_min {cm:.10f} >= 0.9999", nm <= 1e-5 and cm >= 0.9999)
+        aa = m["paper/fi_app_sum_all"]
+        err = max(abs((ad[i] / aa[i]) / (k * (gd[i] / ga[i]) / (1 + (k - 1) * gd[i] / ga[i])) - 1) for i in idx)
+        shares = [round(ad[i] / aa[i], 5) for i in idx]
+        check(f"[{name}] the decision share of realised logit-gradient mass == k s / (1 + (k - 1) s) with s = g1's "
+              f"share (rel {err:.1e} <= 1e-6); shares {shares} vs g1's {[round(gd[i] / ga[i], 5) for i in idx]}",
+              err <= 1e-6)
+        dlp = m.get("paper/fi_dlogp_err_dec_mean")
+        print(f"INFO  [{name}] post-step change of log p(err) at the decision states: {dlp} (k=1: "
+              f"{k1['metrics'].get('paper/fi_dlogp_err_dec_mean')}); grad_norm {m.get('actor/grad_norm')}, clip bound "
+              f"{m.get('paper/fi_clip_bound')}")
+    check("[k=30] differs from k=3", dparam(k30, k3) > 1e-8)
+    # 7
+    fk = [x for x in k3["metrics"] if x.startswith("paper/fi_")]
+    check(f"[k=3] chunk 1 == chunk 256: parameters and all {len(fk)} FI metrics bitwise",
+          eq(k3["params"], k3c["params"]) and all(eq(k3["metrics"][x], k3c["metrics"].get(x)) for x in fk)
+          and set(k3["metrics"]) == set(k3c["metrics"]))
+# 8
+dr_ = new.get("dose_refusals") or {}
+check(f"all {len(dr_)} rkldose refusal cases raise with parameters unchanged",
+      len(dr_) == 10 and all(v["error"] is not None and v["params_unchanged"] for v in dr_.values()),
+      "; ".join(f"{k}: {(v['error'] or 'NO ERROR')[:90]}" for k, v in dr_.items()))
+print(f"\n{len(scen)} parent scenarios; {sum(RES)} passed, {len(RES) - sum(RES)} failed")
+sys.exit(0 if all(RES) else 1)
