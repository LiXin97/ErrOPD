+h = ErropdHooks(make_cfg({"reopd": True}, lam=1.4, world=2, micro=2), TOK)
+check("T8 REOPD groups follow actor layout (world=2, micro=2, bs=8)", h.micro_groups(8) == [[0, 1, 4, 5], [2, 3, 6, 7]])
