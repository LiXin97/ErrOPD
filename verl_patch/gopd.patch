+        _sel = [self.class_mode != "off", self.schedule is not None, self.gate_tau is not None,
+                bool(_cfg_get(ncfg, "reopd", False)), self.plaus_alpha is not None, self.sg_gate]
+        if sum(_sel) > 1 and not (self.class_mode != "off" and sum(_sel) == 2 and
+                                  (self.schedule is not None or self.gate_tau is not None)):
+            raise ValueError("erropd: at most one per-token lambda rule (class x schedule/gate is the only combination)")
+
+        # REOPD
