+"""The DOSE k = 1 surrogate control adds PAPER_FI_FORCE_SURROGATE (rkldose at k = 1 applied through FI's surrogate, the
+path every k > 1 takes) to the DOSE snapshot 843c3b3cc0. Everything that snapshot can run must be unchanged, and the
+forced k = 1 step must (a) actually take the surrogate path and (b) equal rkl_full's autograd step to FI's 1e-8 bar.
+Exit 1 on any failure.
+
+  python dose_force_parent_compare.py PARENT.pt NEW.pt
+
+PARENT.pt is 843c3b3cc0's own equiv_harness output (its file, tree and scenario list); NEW.pt is the new tree's harness
+on the parent's scenarios plus rkl_dose_k1_surr and rkl_dose_k1_surr_chunk1, same interpreter, same stored batch.
+1. Every parent scenario (the six rkl_dose_* among them): every stored field and every metric bitwise, same key
+   order, no new keys.
+2. Sections maxlp, fullp and every refusal section (rkl, alpha, FI, MIX, dose) bitwise.
+3. PATH. The forced k = 1 run logs paper/fi_applied 1, paper/fi_force_surrogate 1 and paper/fi_surr_loss (logged only
+   when the surrogate is applied) at every micro-batch; the unforced k = 1 logs applied 0, no force key and no surrogate
+   loss. Its parameters are bitwise those of the two parent scenarios that apply g1 everywhere through the surrogate
+   (rkl_fi_fis_id, rkl_dose_k3_nodec), and equal the independent float64-autograd step (1e-8).
+4. EQUIVALENCE. Max parameter difference from rkl_full's autograd step (= unforced k = 1) <= 1e-8, reported; every
+   other metric of the unforced k = 1 bitwise (the forward pass and field are the same).
+5. Chunk 1 == chunk 256 bitwise. 6. Every force refusal raises with parameters unchanged.
+"""
+import sys
+
+import numpy as np
+import torch
+
+old = torch.load(sys.argv[1], weights_only=False)
+new = torch.load(sys.argv[2], weights_only=False)
+RES = []
+
+
+def check(name, cond, detail=""):
+    RES.append(bool(cond))
+    print(f"{'PASS' if cond else 'FAIL'}  {name} {detail}", flush=True)
+
+
+def eq(a, b):
+    if isinstance(a, torch.Tensor) or isinstance(b, torch.Tensor):
+        return isinstance(a, torch.Tensor) and isinstance(b, torch.Tensor) and a.shape == b.shape and \
+            a.dtype == b.dtype and torch.equal(a, b)
+    if isinstance(a, dict) and isinstance(b, dict):
+        return list(a) == list(b) and all(eq(a[k], b[k]) for k in a)
+    if isinstance(a, (list, tuple)) and isinstance(b, (list, tuple)):
+        return len(a) == len(b) and all(eq(x, y) for x, y in zip(a, b))
+    if isinstance(a, float) and isinstance(b, float):
+        return np.float64(a).tobytes() == np.float64(b).tobytes()
+    return type(a) is type(b) and a == b
+
+
+def dparam(x, y):
+    return max((x["params"][k] - y["params"][k]).abs().max().item() for k in x["params"])
+
+
+def upd(x):
+    return max((x["params"][k] - x["params0"][k]).abs().max().item() for k in x["params"])
+
+
+print(f"parent tree: {old['verl_file']}\nnew tree:    {new['verl_file']}")
+check("each side ran its own tree (verl_file differs)", old["verl_file"] != new["verl_file"])
+scen = [k for k in old if isinstance(old[k], dict) and "params" in old[k]]
+missing = [k for k in scen if k not in new]
+check(f"the new run covers all {len(scen)} parent scenarios, the six rkl_dose_* among them",
+      not missing and sum(k.startswith("rkl_dose_") for k in scen) == 6, f"(missing {missing})")
+for k in scen:
+    if k not in new:
+        continue
+    a, b = old[k], new[k]
+    bad = [f for f in a if f != "metrics" and (f not in b or not eq(a[f], b[f]))]
+    ma, mb = a["metrics"], b["metrics"]
+    extra = [x for x in mb if x not in ma]
+    order = [x for x in mb if x in ma] == list(ma)
+    mbad = [x for x in ma if x not in mb or not eq(ma[x], mb[x])]
+    check(f"{k}: every stored field and all {len(ma)} metrics bitwise, same order, no new keys",
+          not bad and not mbad and order and not extra and set(a) == set(b),
+          f"(fields differ: {bad}; metrics differ: {mbad[:6]}; new keys {extra})" if (bad or mbad or extra) else "")
+for sec in ("maxlp", "fullp", "has_rkl", "has_alpha", "has_fi", "has_mix", "has_dose", "rkl_refusals",
+            "alpha_refusals", "fi_refusals", "mix_refusals", "dose_refusals"):
+    check(f"section {sec} bitwise", sec in old and eq(old.get(sec), new.get(sec)))
+check("parent has no force switch; new tree has it", not old.get("has_dose_force", False)
+      and new.get("has_dose_force") is True)
+
+need = ["rkl_dose_k1_surr", "rkl_dose_k1_surr_chunk1", "rkl_dose_k1", "rkl_full", "rkl_fi_fis_id", "rkl_dose_k3_nodec"]
+if not all(n in new for n in need):
+    check("force scenarios present", False, f"(missing {[n for n in need if n not in new]})")
+else:
+    fs, fsc, k1, rf, fisid, k3n = (new[n] for n in need)
+    mf, m1 = fs["metrics"], k1["metrics"]
+    n_mb = len(mf["paper/fi_mode"])
+    # 3. path
+    check(f"[path] forced k=1 logs fi_applied 1, fi_force_surrogate 1 and a surrogate loss at all {n_mb} micro-batches",
+          all(x == 1.0 for x in mf["paper/fi_applied"]) and mf.get("paper/fi_force_surrogate") == [1.0] * n_mb
+          and len(mf.get("paper/fi_surr_loss", [])) == n_mb and all(x == 1.0 for x in mf["paper/fi_dose"])
+          and all(x == 7.0 for x in mf["paper/fi_mode"]))
+    check("[path] unforced k=1 (the parent's rkl_dose_k1): fi_applied 0, no force key, no surrogate loss",
+          all(x == 0.0 for x in m1["paper/fi_applied"]) and "paper/fi_force_surrogate" not in m1
+          and "paper/fi_surr_loss" not in m1)
+    check("[path] forced k=1 parameters are bitwise those of the parent's surrogate-path g1 scenarios "
+          "(rkl_fi_fis_id: FI-S at its own norm; rkl_dose_k3_nodec: k=3 with no decision state)",
+          eq(fs["params"], fisid["params"]) and eq(fs["params"], k3n["params"]))
+    ref = fs["fkl_ref"]
+    dp = max((fs["params"][x] - ref["params"][x]).abs().max().item() for x in ref["params"])
+    dl = max(abs(a - float(b)) for a, b in zip(mf["paper/fi_surr_loss"], ref["ce"]))
+    sc = max(abs(float(b)) for b in ref["ce"]) + 1e-12
+    check(f"[path] forced k=1 == the independent float64-autograd step (max param diff {dp:.2e} <= 1e-8; surrogate "
+          f"loss diff {dl:.2e} <= 1e-5 x {sc:.3g})", dp <= 1e-8 and dl <= 1e-5 * sc)
+    # 4. equivalence to rkl_full's autograd step
+    d_rf, d_k1 = dparam(fs, rf), dparam(fs, k1)
+    check(f"[equivalence] forced k=1 vs rkl_full's autograd step: max parameter difference {d_rf:.3e} <= 1e-8 (vs the "
+          f"unforced k=1: {d_k1:.3e}; update size {upd(fs):.3e}; bitwise equal: {eq(fs['params'], rf['params'])})",
+          d_rf <= 1e-8 and d_k1 <= 1e-8)
+    other = [x for x in m1 if x != "paper/fi_applied" and not eq(m1[x], mf.get(x))]
+    check("[equivalence] every other metric of the unforced k=1 is bitwise the forced run's (same forward pass and "
+          "field); the forced run adds only paper/fi_force_surrogate and paper/fi_surr_loss",
+          not other and set(mf) == set(m1) | {"paper/fi_force_surrogate", "paper/fi_surr_loss"}, f"(differ {other[:6]})")
+    check("[equivalence] advantages / log-probs / pg losses: the same (no policy-gradient path) as the unforced k=1",
+          eq(fs["adv"], k1["adv"]) and eq(fs["logp"], k1["logp"]))
+    # 5. chunking
+    fk = [x for x in mf if x.startswith("paper/fi_")]
+    check(f"[chunk] forced k=1 at chunk 1 == chunk 256: parameters and all {len(fk)} FI metrics bitwise",
+          eq(fs["params"], fsc["params"]) and all(eq(mf[x], fsc["metrics"].get(x)) for x in fk))
+# 6
+fr = new.get("dose_force_refusals") or {}
+check(f"all {len(fr)} PAPER_FI_FORCE_SURROGATE refusal cases raise with parameters unchanged",
+      len(fr) == 7 and all(v["error"] is not None and v["params_unchanged"] for v in fr.values()),
+      "; ".join(f"{k}: {(v['error'] or 'NO ERROR')[:90]}" for k, v in fr.items()))
+print(f"\n{len(scen)} parent scenarios; {sum(RES)} passed, {len(RES) - sum(RES)} failed")
+sys.exit(0 if all(RES) else 1)
