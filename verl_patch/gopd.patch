+        check(f"T19 FI rkldose k={_k}: an actor that did not report its k is refused",
+              _raises(lambda: hd_.check_ack(dpx, _fi_ack(7.0, applied=_applied)), RuntimeError))
+        check(f"T19 FI rkldose k={_k}: an actor that ran FI-S (code 5) is refused",
+              _raises(lambda: hd_.check_ack(dpx, _fi_ack(5.0, applied=_applied, **{"paper/fi_dose": _kf})),
