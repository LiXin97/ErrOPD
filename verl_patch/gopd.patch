+def fi_reference(teacher_seed, mode, identity, dose=None):
+    """Independent factor-isolation step on the stored batch (no verl actor code): per position, g1 and d are the
+    FLOAT64 AUTOGRAD gradients of the two objectives themselves, sum_v p (l - m) and sum_v q (m - l), w.r.t. logits
+    z = the fp32 log-probs (log_softmax renormalises), not the closed form the actor uses; then
+        fir: g1 * ||d|| / ||g1||    fis: the same at the item-k decision states, g1 elsewhere    fklfull: d
+        fkldec: d * ||g1|| / ||d|| at the item-k decision states, d elsewhere
+        rkldose: g1 * dose at the item-k decision states, g1 elsewhere (DOSE)
+    (identity: g1 at its own norm). fis's decision states are recomputed here from the token ids: the k-th position
+    of a row whose token is one of the two item-end tokens (_ALPHA_COMMON's boundary 30 and error 17, k = 2).
+    cast to fp32, masked, and the backward pass driven by the surrogate sum_v omega_v lps_v (omega detached);
+    micro-batches of 2 in row order, token-mean per micro-batch / grad accumulation, clip 1.0, SGD lr 1e-2.
+    Also returns the per-prefix ||g1||, ||d|| and ||omega|| at the masked positions."""
+    import verl.utils.torch_functional as vtf2
+
+    model, teacher = tiny_model(0), tiny_teacher(teacher_seed)
+    opt = torch.optim.SGD(model.parameters(), lr=1e-2)
+    d = build_batch()
+    ga = BS // 2
+    losses, n1s, nds, noms, decs = [], [], [], [], []
+    opt.zero_grad()
+    for j in range(0, BS, 2):
+        ids, am, pos = (d.batch[k][j:j + 2] for k in ("input_ids", "attention_mask", "position_ids"))
+        rm = d.batch["response_mask"][j:j + 2]
+        with torch.autocast(device_type="cpu", dtype=torch.bfloat16):
+            ls = model(input_ids=ids, attention_mask=am, position_ids=pos, use_cache=False).logits
+            with torch.no_grad():
+                lt = teacher(input_ids=ids, attention_mask=am, position_ids=pos, use_cache=False).logits
+        lps = torch.log_softmax(ls[:, -R - 1:-1, :].float(), dim=-1)
+        lpt = torch.log_softmax(lt[:, -R - 1:-1, :].float(), dim=-1)
+        m = torch.log_softmax(lpt.detach().double(), -1)
+        z1 = lps.detach().double().requires_grad_(True)
+        l1 = torch.log_softmax(z1, -1)
+        (g1,) = torch.autograd.grad((l1.exp() * (l1 - m)).sum(), z1)
+        z2 = lps.detach().double().requires_grad_(True)
+        (dd,) = torch.autograd.grad((m.exp() * (m - torch.log_softmax(z2, -1))).sum(), z2)
+        with torch.no_grad():
+            n1, nd = g1.norm(dim=-1, keepdim=True), dd.norm(dim=-1, keepdim=True)
+            resp = d.batch["responses"][j:j + 2]
+            is_e = ((resp == int(_ALPHA_COMMON["PAPER_ALPHA_BOUNDARY_TOKEN"]))
+                    | (resp == int(_ALPHA_COMMON["PAPER_ALPHA_ERR_TOKEN"]))) & rm.bool()
+            dec = is_e & (is_e.long().cumsum(-1) == int(_ALPHA_COMMON["PAPER_ALPHA_ERR_SLOT"]))
+            if mode == "fir":
+                om = g1 if identity else g1 * nd / n1
+            elif mode == "fis":
+                om = g1 if identity else torch.where(dec.unsqueeze(-1), g1 * nd / n1, g1)
+                decs.append(dec)
+            elif mode == "fkldec":
+                om = dd if identity else torch.where(dec.unsqueeze(-1), dd * n1 / nd, dd)
+                decs.append(dec)
+            elif mode == "rkldose":
+                om = g1 if identity else torch.where(dec.unsqueeze(-1), g1 * float(dose), g1)
+                decs.append(dec)
+            else:
+                om = dd
+            om = om.float() * rm.unsqueeze(-1)
+            n1s.append(n1.squeeze(-1) * rm)
+            nds.append(nd.squeeze(-1) * rm)
+            noms.append(om.norm(dim=-1))
+        loss = vtf2.masked_mean((om * lps).sum(-1), rm)
+        losses.append(loss.detach())
+        (loss / ga).backward()
+    torch.nn.utils.clip_grad_norm_(model.parameters(), max_norm=1.0)
+    opt.step()
+    return {"ce": losses, "params": {k: v.detach().clone() for k, v in model.state_dict().items()},
+            "n_g1": torch.cat(n1s), "n_d": torch.cat(nds), "n_om": torch.cat(noms),
+            "dec": torch.cat(decs) if decs else None}
+
+
