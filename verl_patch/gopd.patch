+def _flatten_if_ragged(val):
+    """ERROPD: a key gathered from several data-parallel ranks arrives as one list per rank. A key that a rank emits
+    in only some of its micro-batches (e.g. a per-position-set diagnostic skipped when the set is empty) gives lists
+    of different lengths, which np.mean/np.max/np.min refuse ("inhomogeneous shape"). Only in that case are the
+    per-rank lists concatenated (rank order kept), so the reduction runs over every entry that was emitted, the same
+    rule each rank already applies to its own micro-batches. Every other input, including equal-length per-rank lists
+    and lists of scalars, is returned as the same object, so its reduction is the original call on the original value.
+    """
+    if (
+        isinstance(val, list | tuple)
+        and len(val) > 1
+        and all(isinstance(v, list | tuple) for v in val)
+        and len({len(v) for v in val}) > 1
+    ):
+        return [x for v in val for x in v]
+    return val
