+++ b/verl/tests/erropd/e1_parent_compare.py
@@ -0,0 +1,78 @@
+"""E1 adds PAPER_FI_MODE=fkldec and the per-row cos(a, d) diagnostic to the FI snapshot ca93f26d14. Everything that
+snapshot can run must be unchanged: compare its own equiv_harness output (its harness file, its tree, its scenario
+list) with the new tree's (new harness file, new tree), same interpreter, same stored batch. Exit 1 on any failure.
+
+  python e1_parent_compare.py PARENT.pt NEW.pt
+
+For every scenario the parent ran (production lambda, ERROPD interventions, R2G, opd / fkl_sampled / rkl_full, the 8
+alpha-gate scenarios, every FI mode fir / fis / fklfull / ctl with their identity and chunk variants):
+  advantages, log-probs, pg losses, initial and updated parameters, the independent references, and every metric the
+  parent logs (key order and values) are bitwise equal. The only new metric keys allowed are paper/fi_cos_to_d_mean
+  and paper/fi_cos_to_d_min, and only in FI scenarios.
+The teacher-pass and full-vocabulary sections and every refusal case are bitwise equal, except the text of the
+unknown-mode refusals, which now lists fkldec among the valid modes. verl_file must differ (each side ran its tree).
+"""
+import math
+import sys
+
+import numpy as np
+import torch
+
+old = torch.load(sys.argv[1], weights_only=False)
+new = torch.load(sys.argv[2], weights_only=False)
+RES = []
+NEW_KEYS = {"paper/fi_cos_to_d_mean", "paper/fi_cos_to_d_min"}
+
+
+def check(name, cond, detail=""):
+    RES.append(bool(cond))
+    print(f"{'PASS' if cond else 'FAIL'}  {name} {detail}", flush=True)
+
+
+def eq(a, b):
+    if isinstance(a, torch.Tensor) or isinstance(b, torch.Tensor):
+        return isinstance(a, torch.Tensor) and isinstance(b, torch.Tensor) and a.shape == b.shape and \
+            a.dtype == b.dtype and torch.equal(a, b)
+    if isinstance(a, dict) and isinstance(b, dict):
+        return list(a) == list(b) and all(eq(a[k], b[k]) for k in a)
+    if isinstance(a, (list, tuple)) and isinstance(b, (list, tuple)):
+        return len(a) == len(b) and all(eq(x, y) for x, y in zip(a, b))
+    if isinstance(a, float) and isinstance(b, float):
+        return np.float64(a).tobytes() == np.float64(b).tobytes()
+    return type(a) is type(b) and a == b
+
+
+print(f"parent tree: {old['verl_file']}\nnew tree:    {new['verl_file']}")
+check("each side ran its own tree (verl_file differs)", old["verl_file"] != new["verl_file"])
+scen = [k for k in old if isinstance(old[k], dict) and "params" in old[k]]
+missing = [k for k in scen if k not in new]
+check(f"the new run covers all {len(scen)} parent scenarios", not missing, f"(missing {missing})")
+n_fi = 0
+for k in scen:
+    if k not in new:
+        continue
+    a, b = old[k], new[k]
+    bad = [f for f in a if f != "metrics" and (f not in b or not eq(a[f], b[f]))]
+    ma, mb = a["metrics"], b["metrics"]
+    extra = [x for x in mb if x not in ma]
+    order = [x for x in mb if x in ma] == list(ma)
+    mbad = [x for x in ma if x not in mb or not eq(ma[x], mb[x])]
+    is_fi = k.startswith("rkl_fi_")
+    n_fi += is_fi
+    ok_extra = set(extra) == (NEW_KEYS if is_fi else set())
+    check(f"{k}: every stored field bitwise ({len(a) - 1} fields) and all {len(ma)} parent metrics bitwise, same order;"
+          f" new keys {sorted(extra)}", not bad and not mbad and order and ok_extra and set(a) == set(b),
+          f"(fields differ: {bad}; metrics differ: {mbad[:6]})" if (bad or mbad) else "")
+check(f"the FI scenarios of the parent are among them ({n_fi}; expected 9)", n_fi == 9)
+for sec in ("maxlp", "fullp", "has_rkl", "has_alpha", "has_fi", "rkl_refusals", "alpha_refusals"):
+    check(f"section {sec} bitwise", eq(old.get(sec), new.get(sec)))
+fo, fn = old["fi_refusals"], new["fi_refusals"]
+txt = []
+for c in fo:
+    ea, eb = fo[c]["error"], (fn.get(c) or {}).get("error")
+    same = ea == eb or (ea is not None and eb is not None and eb.replace(" | fkldec", "") == ea)
+    txt.append(same and fn[c]["params_unchanged"] == fo[c]["params_unchanged"] is True)
+check(f"all {len(fo)} FI refusal cases still raise with parameters unchanged, same text up to the mode list",
+      list(fo) == list(fn) and all(txt))
+print(f"\n{len(scen)} scenarios; {sum(RES)} passed, {len(RES) - sum(RES)} failed")
+sys.exit(0 if all(RES) else 1)
