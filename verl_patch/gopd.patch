+                                 "PAPER_FI_FORCE_SURROGATE": "2"},
+             "force_with_fis": {**base, "PAPER_FI_MODE": "fis"}, "force_with_fir": {**base, "PAPER_FI_MODE": "fir"},
+             "force_with_ctl": {**base, "PAPER_FI_MODE": "ctl"}, "force_with_fklfull": {**base, "PAPER_FI_MODE": "fklfull"},
+             "force_with_fkldec": {**base, "PAPER_FI_MODE": "fkldec"}}
+    res = {}
+    for name, env in cases.items():
+        cfg = build_actor_cfg(1.0)
+        model = tiny_model(0)
+        p0 = {k: v.detach().clone() for k, v in model.state_dict().items()}
+        actor = dpa.DataParallelPPOActor(config=cfg, actor_module=model,
+                                         actor_optimizer=torch.optim.SGD(model.parameters(), lr=1e-2))
+        data = build_batch()
+        dpa._PAPER_TEACHER.clear()
+        dpa.paper_register_teacher(teacher_actor((1, 30.0)))
+        saved = {k: os.environ.get(k) for k in ("PAPER_LOSS_MODE",) + ALPHA_ENV_KEYS + FI_ENV_KEYS}
+        for k in ALPHA_ENV_KEYS + FI_ENV_KEYS:
+            os.environ.pop(k, None)
+        os.environ.update(env)
+        err = None
+        try:
+            actor.update_policy(data)
+        except (RuntimeError, ValueError) as e:
+            err = f"{type(e).__name__}: {e}"
+        finally:
+            dpa._PAPER_TEACHER.clear()
+            for k, v in saved.items():
+                if v is None:
+                    os.environ.pop(k, None)
+                else:
+                    os.environ[k] = v
+        res[name] = {"error": err,
+                     "params_unchanged": all(torch.equal(p0[k], v) for k, v in model.state_dict().items())}
+    return res
+
+
+def sft_reference(tokens):
+    """Independent plain-SFT step on `tokens` at the response positions of the stored batch (no verl actor code):
+    same tiny model init, micro-batches of 2 in row order, token-mean CE per micro-batch / grad accumulation,
+    grad-norm clip 1.0, SGD lr 1e-2. Returns per-micro-batch CE and the updated parameters."""
+    from transformers import Qwen3Config, Qwen3ForCausalLM
+
+    torch.manual_seed(0)
+    mcfg = Qwen3Config(vocab_size=VOCAB, hidden_size=32, intermediate_size=64, num_hidden_layers=2,
+                       num_attention_heads=4, num_key_value_heads=2, head_dim=8,
+                       max_position_embeddings=64, tie_word_embeddings=False)
+    mcfg._attn_implementation = "eager"
+    model = Qwen3ForCausalLM(mcfg).float()
+    opt = torch.optim.SGD(model.parameters(), lr=1e-2)
+    d = build_batch()
+    ga = BS // 2
+    ces = []
+    opt.zero_grad()
+    for j in range(0, BS, 2):
+        ids, am, pos = (d.batch[k][j:j + 2] for k in ("input_ids", "attention_mask", "position_ids"))
+        rm = d.batch["response_mask"][j:j + 2]
+        with torch.autocast(device_type="cpu", dtype=torch.bfloat16):
+            logits = model(input_ids=ids, attention_mask=am, position_ids=pos, use_cache=False).logits
+        # verl's primitives (same numerics as the actor: bf16 logits, the torch log-prob path, masked token-mean),
+        # none of the actor's control flow
+        import verl.utils.torch_functional as vtf2
+
+        lp = vtf2.logprobs_from_logits(logits[:, -R - 1:-1, :], tokens[j:j + 2])
+        ce = vtf2.masked_mean(-lp, rm)
+        (ce / ga).backward()
+        ces.append(ce.detach())
+    torch.nn.utils.clip_grad_norm_(model.parameters(), max_norm=1.0)
+    opt.step()
+    return {"ce": ces, "params": {k: v.detach().clone() for k, v in model.state_dict().items()}}
+
+
+def run_maxlp(tree_has_erropd):
+    """Teacher-style compute_log_prob with and without the ERROPD max-log-prob request, in both padding modes
+    (micro-batch 1, unpadded sequences, so the remove-padding forward equals the padded one)."""
+    from transformers import Qwen3Config, Qwen3ForCausalLM
+
+    import verl.utils.attention_utils as vau
+    import verl.workers.actor.dp_actor as dpa
+    from verl import DataProto
+
+    from flash_attn.bert_padding import index_first_axis, pad_input, rearrange, unpad_input  # pure torch helpers
+    vau._index_first_axis, vau._pad_input, vau._rearrange, vau._unpad_input = index_first_axis, pad_input, rearrange, unpad_input
+    vau._get_attention_functions = lambda: (index_first_axis, pad_input, rearrange, unpad_input)
+
+    torch.manual_seed(0)
+    mcfg = Qwen3Config(vocab_size=VOCAB, hidden_size=32, intermediate_size=64, num_hidden_layers=2,
+                       num_attention_heads=4, num_key_value_heads=2, head_dim=8,
+                       max_position_embeddings=64, tie_word_embeddings=False)
+    mcfg._attn_implementation = "eager"
+    model = Qwen3ForCausalLM(mcfg).float().eval()
+    g = torch.Generator().manual_seed(4321)
+    ids = torch.randint(0, VOCAB, (4, P + R), generator=g)
+    attn = torch.ones(4, P + R, dtype=torch.long)
+    pos = torch.arange(P + R)[None, :].repeat(4, 1)
+    out = {}
+    with torch.no_grad():
+        with torch.autocast(device_type="cpu", dtype=torch.bfloat16):
+            logits = model(input_ids=ids, attention_mask=attn, position_ids=pos).logits
+        lg = logits[:, -R - 1:-1, :].float()
+        out["direct_max"] = torch.log_softmax(lg, -1).max(-1).values
+    for rmpad in (False, True):
+        cfg = build_actor_cfg(1.0, rmpad=rmpad)
+        actor = dpa.DataParallelPPOActor(config=cfg, actor_module=model, actor_optimizer=None)
+        for want in ((False, True) if tree_has_erropd else (False,)):
+            d = DataProto.from_single_dict({"input_ids": ids, "attention_mask": attn, "position_ids": pos,
+                                            "responses": ids[:, P:]})
+            d.meta_info.update({"micro_batch_size": 1, "temperature": 1.0, "use_dynamic_bsz": False})
+            actor._erropd_want_max = want
+            lp, _ = actor.compute_log_prob(d, calculate_entropy=False)
+            actor._erropd_want_max = False
+            out[f"logp_rmpad{int(rmpad)}_want{int(want)}"] = lp
+            if want:
+                out[f"max_rmpad{int(rmpad)}"] = actor._erropd_last_max
+        if tree_has_erropd:
+            # teacher sampling at near-zero temperature (= argmax) and log-probs unchanged by the request
+            d = DataProto.from_single_dict({"input_ids": ids, "attention_mask": attn, "position_ids": pos,
+                                            "responses": ids[:, P:]})
+            d.meta_info.update({"micro_batch_size": 1, "temperature": 1e-4, "use_dynamic_bsz": False})
+            lp_cold0, _ = actor.compute_log_prob(d, calculate_entropy=False)
+            actor._paper_want_sample = True
+            lp_cold1, _ = actor.compute_log_prob(d, calculate_entropy=False)
+            actor._paper_want_sample = False
+            out[f"sample_cold_rmpad{int(rmpad)}"] = actor._paper_last_sample
+            out[f"logp_cold_unchanged_rmpad{int(rmpad)}"] = bool(torch.equal(lp_cold0, lp_cold1))
+            # label override: log p(label | student prefix) at each response position
+            g2 = torch.Generator().manual_seed(7)
+            lab = torch.randint(0, VOCAB, (4, R), generator=g2)
+            lps = []
+            for i in range(4):
+                mb = {"input_ids": ids[i:i + 1], "attention_mask": attn[i:i + 1], "position_ids": pos[i:i + 1],
+                      "responses": ids[i:i + 1, P:]}
+                with torch.no_grad():
+                    _, lp_ = actor._forward_micro_batch(mb, temperature=1.0, label_override=lab[i:i + 1])
+                lps.append(lp_)
+            out[f"logp_override_rmpad{int(rmpad)}"] = torch.cat(lps, 0)
+            out["override_labels"] = lab
+    if tree_has_erropd:
+        out["direct_argmax_logit_gap"] = None
+        with torch.no_grad():
+            with torch.autocast(device_type="cpu", dtype=torch.bfloat16):
+                lg2 = model(input_ids=ids, attention_mask=attn, position_ids=pos).logits
+            lgr = lg2[:, -R - 1:-1, :].float()
+            out["direct_logits"] = lgr
+            import verl.utils.torch_functional as vtf3
+
+            out["direct_override_logp"] = vtf3.logprobs_from_logits(lg2[:, -R - 1:-1, :], out["override_labels"])
+    return out
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--out", required=True)
+    ap.add_argument("--scenarios", required=True)
+    ap.add_argument("--batch-pt", default="")
+    args = ap.parse_args()
+    global BATCH_PT
+    BATCH_PT = args.batch_pt or None
+    import verl
+    import verl.utils.torch_functional as vtf
+
+    # CPU run: flash-attn's Triton cross-entropy needs CUDA; use the torch path in BOTH trees.
+    vtf.FLAH_ATTN_CROSS_ENTROPY_LOSS_AVAILABLE = False
+
+    tmp = tempfile.NamedTemporaryFile(delete=False)
+    torch.distributed.init_process_group("gloo", rank=0, world_size=1, init_method=f"file://{tmp.name}")
+    torch.use_deterministic_algorithms(True)
+    res = {"verl_file": verl.__file__}
+    import os as _os
+    res["maxlp"] = run_maxlp(_os.path.exists(_os.path.join(_os.path.dirname(verl.__file__), "erropd")))
+    import verl.workers.actor.dp_actor as _dpa
+
+    res["has_rkl"] = hasattr(_dpa, "paper_register_teacher")
+    res["has_alpha"] = hasattr(_dpa, "paper_alpha_cfg")
+    if res["has_rkl"]:
+        res["fullp"] = run_fullp()
+        res["rkl_refusals"] = run_rkl_refusals()
+    if res["has_alpha"]:
+        res["alpha_refusals"] = run_alpha_refusals()
+    res["has_fi"] = hasattr(_dpa, "paper_fi_cfg")
+    if res["has_fi"]:
+        res["fi_refusals"] = run_fi_refusals()
+    res["has_dose"] = hasattr(_dpa, "PAPER_FI_MODES") and "rkldose" in _dpa.PAPER_FI_MODES
+    if res["has_dose"]:
+        res["dose_refusals"] = run_dose_refusals()
+    res["has_dose_force"] = bool(res["has_dose"]) and "PAPER_FI_FORCE_SURROGATE" in (_dpa.paper_fi_cfg.__doc__ or "")
+    if res["has_dose_force"]:
+        res["dose_force_refusals"] = run_dose_force_refusals()
+    res["has_mix"] = hasattr(_dpa, "paper_mix_cfg")
+    if res["has_mix"]:
+        res["mix_refusals"] = run_mix_refusals()
+    for name in args.scenarios.split(","):
+        if name in RKL_TEACHER_SEED and not res["has_rkl"]:
+            continue
+        res[name] = run(name)
+        print(f"{name}: pg={[round(float(x), 6) for x in res[name]['pg']]}", flush=True)
+    torch.save(res, args.out)
+    print("saved", args.out, "verl from", verl.__file__)
+
+
+if __name__ == "__main__":
+    main()
