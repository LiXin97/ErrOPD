+    # ------------------------------------------------------------------
+    def pre_ref(self, batch):
+        """Before the teacher (ref) log-prob pass: request the teacher's per-position max log-prob (B3p) and/or one
+        teacher-sampled token per position (PAPER_LOSS_MODE=fkl_sampled)."""
+        if self.need_ref_max:
+            batch.meta_info["erropd_need_ref_max"] = True
+        if self.fkl or self.mix_cfg is not None:
+            batch.meta_info["paper_need_ref_sample"] = True
+
+    def post_ref(self, batch):
+        batch.meta_info.pop("erropd_need_ref_max", None)
+        batch.meta_info.pop("paper_need_ref_sample", None)
+        if self.need_ref_max and "ref_max_log_prob" not in batch.batch.keys():
+            raise RuntimeError("[erropd] B3p needs ref_max_log_prob from the teacher pass; the worker did not return it")
+        if self.fkl and "ref_sampled_token" not in batch.batch.keys():
+            raise RuntimeError("[paper] fkl_sampled needs ref_sampled_token from the teacher pass; not returned")
+        if self.mix_cfg is not None and "ref_sampled_token" not in batch.batch.keys():
+            raise RuntimeError("[paper] PAPER_MIX_BETA needs ref_sampled_token from the teacher pass; not returned")
+
+    # ------------------------------------------------------------------
+    def lambda_for_step(self, step):
+        """Returns (lambda_step, gate_open or None)."""
+        if self.schedule is not None:
+            lam = self.schedule[0][1]
+            for s, l in self.schedule:
+                if step >= s:
+                    lam = l
+            return lam, None
+        if self.gate_tau is not None:
+            est = self.prev_frac[self.gate_estimator]
+            if est is None:  # step 1: no t-1 estimate
+                return 1.0, False
+            is_open = est >= self.gate_tau
+            return (self.lambda_max if is_open else 1.0), is_open
+        return self.lambda_max, None
+
+    # ------------------------------------------------------------------
+    def micro_groups(self, bs):
+        """Row indices of each synchronized actor micro-batch (rank r gets the contiguous
+        chunk r of the batch; each rank splits its chunk into micro-batches in order)."""
+        w, mic = self.layout["world"], self.layout["micro"]
+        if self.layout["dynamic"] or not mic or bs % w or (bs // w) % int(mic):
+            return [list(range(bs))]
+        per, mic = bs // w, int(mic)
+        return [[r * per + j * mic + k for r in range(w) for k in range(mic)] for j in range(per // mic)]
+
+    def reopd_token_lambda(self, old, ref, base, resp_mask):
+        """REOPD Eq. 4-12 on the driver. Inputs [bs, L] float; returns (tl float32, stats)."""
+        eps = 1e-8
+        st = self.r_state
+        bs, L = old.shape
+        tl = torch.ones(bs, L, dtype=torch.float64)
+        gammas, qs = [], []
+        for rows in self.micro_groups(bs):
+            idx = torch.tensor(rows, dtype=torch.long)
+            m = resp_mask[idx].double()
+            if m.sum() <= 0:
+                continue
+            x = (ref[idx] - old[idx]).double()          # log piT - log pi_theta (sampled token)
+            a = -x                                      # alignment cost  log pi_theta - log piT
+            r = (ref[idx] - base[idx]).double()         # residual        log piT - log pi_ref
+            delta = torch.exp(x) - x - 1.0
+            q = torch.exp(-delta / self.r_tau)
+            q = torch.where(torch.isfinite(q), q, torch.zeros_like(q))
+            st["calls"] += 1
+            if st["calls"] <= self.r_k0:
+                rms_a = float(torch.sqrt((m * a * a).sum() / m.sum()))
+                st["b0_sum"] += rms_a
+                st["B0"] = self.r_kappa * st["b0_sum"] / st["calls"]
+            rho = float((m * r.abs() * q).sum() / ((m * r.abs()).sum() + eps))
+            s_ = float(torch.sqrt((m * (q * r) ** 2).sum() / (m.sum() + eps)))
+            st["rho_bar"] = rho if st["rho_bar"] is None else self.r_beta * st["rho_bar"] + (1 - self.r_beta) * rho
+            st["s_bar"] = s_ if st["s_bar"] is None else self.r_beta * st["s_bar"] + (1 - self.r_beta) * s_
+            g_tilde = min(max(st["B0"] * st["rho_bar"] / (st["s_bar"] + eps), 0.0), self.r_gamma_max)
+            st["gamma"] = self.r_beta_g * st["gamma"] + (1 - self.r_beta_g) * g_tilde
+            gamma = self.r_warm_gamma if st["calls"] <= self.r_warm_calls else st["gamma"]
+            tl[idx] = torch.where(m > 0, 1.0 + gamma * q, torch.ones_like(q))
+            gammas.append(gamma)
+            qs.append(float((m * q).sum() / m.sum()))
+        stats = {
+            "erropd/reopd_gamma_mean": float(np.mean(gammas)) if gammas else 0.0,
+            "erropd/reopd_gamma_last": gammas[-1] if gammas else 0.0,
+            "erropd/reopd_q_mean": float(np.mean(qs)) if qs else 0.0,
+            "erropd/reopd_B0": float(st["B0"] or 0.0),
+            "erropd/reopd_rho_bar": float(st["rho_bar"] or 0.0),
+            "erropd/reopd_s_bar": float(st["s_bar"] or 0.0),
+            "erropd/reopd_calls_cum": st["calls"],
+        }
+        return tl.float(), stats
+
+
+    # ------------------------------------------------------------------
+    def analyze(self, batch):
+        """Per-rollout analysis. Pure function of the batch (no mutation)."""
+        responses = batch.batch["responses"].cpu()
+        resp_mask = batch.batch["response_mask"].cpu()
+        extra = batch.non_tensor_batch["extra_info"]
+        bs, L = responses.shape
+        lengths = resp_mask.sum(-1).long().tolist()
+        cls = torch.zeros(bs, L, dtype=torch.long)
+        recs = []
+        n_straddle = 0
+        n_tok_total = 0
+        for i in range(bs):
+            n = int(lengths[i])
+            ids = responses[i, :n].tolist()
+            text, spans = self.decoder.decode(ids)
+            ei = extra[i]
+            K = int(ei["K"])
+            task = lc.task_of(ei)
+            id_key, list_key = lc.TASK_KEYS[task]
+            rids = [str(r) for r in list(ei[list_key])]
+            valid = lc.strict_valid(text, K, rids, task)
+            eligible = lc.prompt_eligible(K, rids)
+            status, ci, vtype = lc.locate_first_violation(text, K, rids, id_key)
+            tcls, ns = lc.token_classes_from_spans(text, spans, id_key)
+            n_straddle += ns
+            n_tok_total += n
+            if n:
+                cls[i, :n] = torch.tensor(tcls, dtype=torch.long)
+            vtok = char_to_token(ci, spans) if ci is not None else None
+            recs.append({
+                "index": int(ei.get("index", -1)) if hasattr(ei, "get") else -1,
+                "K": K, list_key: rids, "task": task, "valid": bool(valid), "eligible": bool(eligible), "status": status,
+                "vtype": vtype, "viol_char": ci, "viol_tok": vtok, "n_tok": n, "text": text,
+            })
+        return cls, recs, lengths, n_straddle, n_tok_total
+
+    # ------------------------------------------------------------------
+    def on_batch(self, batch, step, metrics):
+        """Called after compute_advantage, before update_actor. Returns the batch
+        (unchanged object when no intervention is active)."""
+        t0 = time.time()
+        self.n_steps += 1
+        extra = batch.non_tensor_batch.get("extra_info", None)
+        listwise = (extra is not None and len(extra) > 0 and hasattr(extra[0], "get")
+                    and ("review_ids" in extra[0] or "product_ids" in extra[0]) and "K" in extra[0])
+        if listwise:
+            cls, recs, lengths, n_straddle, n_tok_total = self.analyze(batch)
+        else:
+            if self.class_mode != "off" or self.mask_mode != "off" or self.gate_tau is not None or \
+                    self.sg_gate or self.format_beta is not None:
+                raise ValueError("[erropd] token classes / masking / validity gate need listwise "
+                                 "extra_info (K, review_ids) in the batch")
+            bs0, L0 = batch.batch["responses"].shape
+            cls, recs, n_straddle, n_tok_total = torch.zeros(bs0, L0, dtype=torch.long), [], 0, 0
+        bs, L = cls.shape
+        resp_mask = batch.batch["response_mask"].cpu().float()
+
+        lam_step, gate_open = self.lambda_for_step(step)
+        if gate_open:
+            self.gate_open_steps += 1
+
+        # per-token lambda actually applied
+        sel = _CLASS_MODES[self.class_mode]
+        if sel is None:
+            tl = torch.full((bs, L), float(lam_step), dtype=torch.float32)
+        else:
+            tl = torch.ones(bs, L, dtype=torch.float32)
+            selmask = torch.zeros(bs, L, dtype=torch.bool)
+            for c in sel:
+                selmask |= cls == c
+            tl[selmask] = float(lam_step)
+        tl = torch.where(resp_mask > 0, tl, torch.ones_like(tl))
+        reopd_stats = {}
+        if self.reopd:
+            bk0 = batch.batch
+            tl, reopd_stats = self.reopd_token_lambda(
+                bk0["old_log_probs"].cpu().float(), bk0["ref_log_prob"].cpu().float(),
+                bk0["base_log_prob"].cpu().float(), resp_mask)
+            lam_step = float((tl * resp_mask).sum() / resp_mask.sum().clamp(min=1))  # mean applied lambda
+
+        # eligible-rollout validity signal (B6 verifier, B7 bonus)
+        elig_mask = torch.tensor([bool(r["eligible"]) for r in recs] or [False] * bs)
+        valid_vec = torch.tensor([float(r["valid"]) for r in recs] or [0.0] * bs)
+        vbar = float(valid_vec[elig_mask].mean()) if bool(elig_mask.any()) else 0.0
+        a1_sign = torch.where(elig_mask, torch.sign(valid_vec - vbar), torch.zeros_like(valid_vec))
+        extra_stats = {}
+        bk1 = batch.batch
+        if self.plaus_alpha is not None:
+            if "ref_max_log_prob" not in bk1.keys():
+                raise RuntimeError("[erropd] plaus_alpha set but ref_max_log_prob missing")
+            gap = bk1["ref_log_prob"].cpu().float() - bk1["ref_max_log_prob"].cpu().float()
+            plaus = (gap >= float(np.log(self.plaus_alpha))) & (resp_mask > 0)
+            tl = torch.where(plaus, torch.full_like(tl, float(lam_step)), torch.ones_like(tl))
+            extra_stats["erropd/plaus_token_frac"] = float(plaus.float().sum() / resp_mask.sum().clamp(min=1))
+            # alignment diagnostic: log pT(y_t) - max_v log pT(v) must be <= ~0 on every response token
+            extra_stats["erropd/plaus_gap_max"] = float(gap[resp_mask > 0].max()) if bool((resp_mask > 0).any()) else 0.0
+            vt_ = [(i, r["viol_tok"]) for i, r in enumerate(recs) if r["viol_tok"] is not None]
+            if vt_:
+                extra_stats["erropd/plaus_frac_at_violation_tok"] = float(np.mean([float(plaus[i, t]) for i, t in vt_]))
+        if self.sg_gate:
+            push = torch.sign(bk1["ref_log_prob"].cpu().float() - bk1["old_log_probs"].cpu().float())
+            cons = (a1_sign[:, None] * push > 0) & (resp_mask > 0)
+            tl = torch.where(cons, torch.full_like(tl, float(lam_step)), torch.ones_like(tl))
+            extra_stats["erropd/sg_consensus_token_frac"] = float(cons.float().sum() / resp_mask.sum().clamp(min=1))
+            extra_stats["erropd/sg_vbar_eligible"] = vbar
+        bonus = None
+        if self.format_beta is not None:
+            bonus = (self.format_beta * (valid_vec - vbar) * elig_mask.float())[:, None] * resp_mask
+            bonus = bonus.float()
+            extra_stats["erropd/format_bonus_beta"] = self.format_beta
+            extra_stats["erropd/format_bonus_abs_mean"] = float(bonus.abs().sum() / resp_mask.sum().clamp(min=1))
+
+        # loss mask
+        lm = torch.ones(bs, L, dtype=torch.float32)
+        if self.mask_mode == "invalid_rollout":
+            for i, r in enumerate(recs):
+                if not r["valid"]:
+                    lm[i, :] = 0.0
+        elif self.mask_mode in ("from_violation", "after_violation"):
+            off = 0 if self.mask_mode == "from_violation" else 1
+            for i, r in enumerate(recs):
+                if r["status"] == lc.VIOLATION and r["viol_tok"] is not None:
+                    lm[i, r["viol_tok"] + off:] = 0.0
+        kept = int(((lm * resp_mask).sum(-1) > 0).sum().item())
+        self.kept_cum += kept
+        if self.stop_after_kept is not None and self.kept_cum >= self.stop_after_kept:
+            self.stop_now = True
+
+        # ---------------- metrics (always) ----------------
+        m = {"erropd/listwise": float(listwise)}
+        n = len(recs)
+        n_valid = sum(r["valid"] for r in recs)
+        elig = [r for r in recs if r["eligible"]]
+        n_elig = len(elig)
+        frac_raw = n_valid / n if n else 0.0
+        frac_elig = (sum(r["valid"] for r in elig) / n_elig) if n_elig else 0.0
+        m["erropd/rollout_valid_frac_sampled"] = frac_raw
+        m["erropd/rollout_valid_frac_sampled_eligible"] = frac_elig
+        m["erropd/n_rollouts"] = n
+        m["erropd/n_eligible"] = n_elig
+        for st in (lc.VALID, lc.VIOLATION, lc.INCOMPLETE, lc.INELIGIBLE):
+            m[f"erropd/status_frac/{st}"] = sum(r["status"] == st for r in recs) / max(n, 1)
+        vtypes = {}
+        for r in recs:
+            if r["status"] in (lc.VIOLATION, lc.INCOMPLETE) and r["vtype"]:
+                vtypes[r["vtype"]] = vtypes.get(r["vtype"], 0) + 1
+        for k, v in vtypes.items():
+            m[f"erropd/vtype_frac/{k}"] = v / max(n, 1)
+        m["erropd/lambda_step"] = float(lam_step)
+        if gate_open is not None:
+            m["erropd/gate_open"] = float(gate_open)
+            est = self.prev_frac[self.gate_estimator]
+            m["erropd/gate_estimate_prev"] = -1.0 if est is None else float(est)
+        m["erropd/kept_rollouts"] = kept
+        m["erropd/kept_rollouts_cum"] = self.kept_cum
+        m["erropd/masked_token_frac"] = float(((1 - lm) * resp_mask).sum() / resp_mask.sum().clamp(min=1))
+        m["erropd/straddle_token_frac"] = n_straddle / max(n_tok_total, 1)
+        m["erropd/decode_fallbacks_cum"] = self.decoder.n_fallback
+
+        # per-class advantage as the actor will compute it (up to recompute numerics)
+        bk = batch.batch
+        if "old_log_probs" in bk.keys() and "ref_log_prob" in bk.keys():
+            old = bk["old_log_probs"].cpu().float()
+            ref = bk["ref_log_prob"].cpu().float()
+            if "base_log_prob" in bk.keys():
+                base = bk["base_log_prob"].cpu().float()
+                adv = torch.where(tl == 1.0, ref - old, (ref - base) * tl - (old - base))
+                tb = ref - base
+                sb = old - base
+            else:
+                adv, tb, sb = ref - old, None, None
+            for c, name in lc.CLASS_NAMES.items():
+                w = ((cls == c).float() * resp_mask)
+                cnt = w.sum().clamp(min=1)
+                m[f"erropd/adv_mean/{name}"] = float((adv * w).sum() / cnt)
+                m[f"erropd/tok_frac/{name}"] = float(w.sum() / resp_mask.sum().clamp(min=1))
+                if tb is not None:
+                    m[f"erropd/teacher_minus_base_mean/{name}"] = float((tb * w).sum() / cnt)
+                    m[f"erropd/student_minus_base_mean/{name}"] = float((sb * w).sum() / cnt)
+            m["erropd/adv_mean/all"] = float((adv * resp_mask).sum() / resp_mask.sum().clamp(min=1))
+            # R2G study: per-batch mean baseline for PAPER_ADV_MODE=reward_to_go* (actor subtracts it)
+            _mode = os.environ.get("PAPER_ADV_MODE", "per_token")
+            if _mode in ("reward_to_go", "reward_to_go_disc"):
+                _g = 1.0 if _mode == "reward_to_go" else float(os.environ.get("PAPER_ADV_GAMMA", "0.99"))
+                from verl.erropd.r2g import reward_to_go
+
+                r2g = reward_to_go(adv, resp_mask, _g)
+                rm64 = resp_mask.double()
+                r2g_mean = float((r2g * rm64).sum() / rm64.sum().clamp(min=1))
+                m["paper/r2g_mean"] = r2g_mean
+                m["paper/r2g_abs_mean"] = float((r2g.abs() * rm64).sum() / rm64.sum().clamp(min=1))
+                if os.environ.get("PAPER_ADV_BASELINE", "0") == "1":
+                    batch.meta_info["paper_adv_baseline"] = r2g_mean
+                    m["paper/r2g_baseline"] = r2g_mean
+            _absv = adv.abs()[resp_mask > 0]
+            if _absv.numel():
+                m["erropd/abs_adv_mean"] = float(_absv.mean())
+                m["erropd/abs_adv_median"] = float(_absv.median())
+            vt = [(i, r["viol_tok"]) for i, r in enumerate(recs) if r["viol_tok"] is not None]
+            if vt:
+                m["erropd/adv_at_violation_tok"] = float(np.mean([adv[i, t].item() for i, t in vt]))
+                if tb is not None:
+                    m["erropd/teacher_minus_base_at_violation_tok"] = float(
+                        np.mean([tb[i, t].item() for i, t in vt]))
+        m.update(reopd_stats)
+        m.update(extra_stats)
+        if "ref_sampled_token" in batch.batch.keys():
+            _eq = (batch.batch["ref_sampled_token"].cpu() == batch.batch["responses"].cpu()).float() * resp_mask
+            m["paper/fkl_teacher_eq_student"] = float(_eq.sum() / resp_mask.sum().clamp(min=1))
+            _tm = (cls == lc.TERM).float() * resp_mask
+            if float(_tm.sum()) > 0:
+                m["paper/fkl_teacher_eq_student_term"] = float((_eq * _tm).sum() / _tm.sum())
+        m["erropd/hook_sec"] = time.time() - t0
+
+        # update gate estimate for step t+1
+        self.prev_frac = {"raw": frac_raw, "eligible": frac_elig}
+        metrics.update(m)
+        self._last = {"step": step, **m}
+
+        if self.dump_rollouts:
+            with open(os.path.join(self.log_dir, "erropd_rollouts.jsonl"), "a") as fh:
+                for r in recs:
+                    fh.write(json.dumps({"step": step, "lambda_step": lam_step, **r}, ensure_ascii=False) + "\n")
+
+        if self.log_update_norm:
+            batch.meta_info["erropd_log_update_norm"] = True
+        if not self.active:
+            return batch
+        if self.needs_lambda_tensor:
+            batch.batch["erropd_token_lambda"] = tl
+        if self.needs_mask_tensor:
+            batch.batch["erropd_loss_mask"] = lm
+        if self.needs_bonus_tensor:
+            batch.batch["erropd_adv_bonus"] = bonus
+        batch.meta_info["erropd_expect_ack"] = True
+        return batch
+
+    # ------------------------------------------------------------------
+    def check_ack(self, batch, actor_metrics):
+        if self.rkl and "paper/rkl_full" not in actor_metrics:
+            raise RuntimeError("[paper] PAPER_LOSS_MODE=rkl_full but the actor did not run the rkl loss (wrong verl "
+                               "tree on the workers?). Refusing to continue.")
+        if not self.rkl and "paper/rkl_full" in actor_metrics:
+            raise RuntimeError("[paper] the actor ran the rkl loss but PAPER_LOSS_MODE is not rkl_full. Refusing to continue.")
+        if self.alpha_cfg is not None and "paper/alpha" not in actor_metrics:
+            raise RuntimeError("[paper] PAPER_RKL_ALPHA is set but the actor did not run the alpha gate (wrong verl "
+                               "tree on the workers?). Refusing to continue.")
+        if self.alpha_cfg is None and "paper/alpha" in actor_metrics:
+            raise RuntimeError("[paper] the actor ran the alpha gate but PAPER_RKL_ALPHA is unset. Refusing to continue.")
+        if self.alpha_cfg is not None and float(actor_metrics["paper/alpha"]) != float(self.alpha_cfg["alpha"]):
+            raise RuntimeError(f"[paper] alpha mismatch: driver {self.alpha_cfg['alpha']} vs actor "
+                               f"{actor_metrics['paper/alpha']}. Refusing to continue.")
+        if self.fi_cfg is not None and "paper/fi_mode" not in actor_metrics:
+            raise RuntimeError("[paper] PAPER_FI_MODE is set but the actor did not run the FI arm (wrong verl tree on "
+                               "the workers?). Refusing to continue.")
+        if self.fi_cfg is None and "paper/fi_mode" in actor_metrics:
+            raise RuntimeError("[paper] the actor ran the FI arm but PAPER_FI_MODE is unset. Refusing to continue.")
+        if self.fi_cfg is not None:
+            # mode, identity and fp64 are small integers, exact through reduce_metrics' averaging; the floor is a
+            # float that the average of identical copies can move by an ulp, so it is compared with a tolerance
+            _fc = self.fi_cfg
+            _want = {"paper/fi_mode": _fc["code"], "paper/fi_identity": 1.0 if _fc["identity"] else 0.0,
+                     "paper/fi_fp64": 1.0 if _fc["fp64"] else 0.0, "paper/fi_applied": 1.0 if _fc["apply"] else 0.0}
+            for _k, _v in _want.items():
+                if float(actor_metrics.get(_k, float("nan"))) != _v:
+                    raise RuntimeError(f"[paper] FI mismatch on {_k}: driver {_v} vs actor {actor_metrics.get(_k)} "
+                                       f"(PAPER_FI_MODE={_fc['mode']}). Refusing to continue.")
+            _fl = float(actor_metrics.get("paper/fi_floor", float("nan")))
+            if not abs(_fl - _fc["floor"]) <= 1e-9 * max(abs(_fc["floor"]), 1e-300):
+                raise RuntimeError(f"[paper] FI floor mismatch: driver {_fc['floor']} vs actor {_fl}. Refusing to continue.")
+            # DOSE (rkldose): the actor must acknowledge the driver's k (emitted by rkldose only; same tolerance as the
+            # floor, for the average of identical copies); any other mode must not emit it
+            _kd = _fc.get("dose")
+            if _kd is not None:
+                _ka = float(actor_metrics.get("paper/fi_dose", float("nan")))
+                if not abs(_ka - _kd) <= 1e-9 * abs(_kd):
+                    raise RuntimeError(f"[paper] FI dose mismatch: driver k={_kd} vs actor {actor_metrics.get('paper/fi_dose')}. "
+                                       f"Refusing to continue.")
+            # the DOSE k = 1 surrogate control: the actor must report it iff the driver set it
+            _fs = bool(_fc.get("force_surrogate"))
+            if _fs and float(actor_metrics.get("paper/fi_force_surrogate", float("nan"))) != 1.0:
+                raise RuntimeError(f"[paper] PAPER_FI_FORCE_SURROGATE=1 but the actor reports "
+                                   f"{actor_metrics.get('paper/fi_force_surrogate')}. Refusing to continue.")
+            if not _fs and "paper/fi_force_surrogate" in actor_metrics:
+                raise RuntimeError("[paper] the actor forced the surrogate but the driver did not set "
+                                   "PAPER_FI_FORCE_SURROGATE. Refusing to continue.")
+            if _kd is None and "paper/fi_dose" in actor_metrics:
+                raise RuntimeError(f"[paper] the actor ran rkldose (paper/fi_dose logged) but the driver's mode is "
+                                   f"{_fc['mode']}. Refusing to continue.")
+        if self.mix_cfg is not None and ("paper/mix_beta" not in actor_metrics or "paper/fkl_ce" not in actor_metrics):
+            raise RuntimeError("[paper] PAPER_MIX_BETA is set but the actor did not run the mixed loss (wrong verl tree "
+                               "on the workers?). Refusing to continue.")
+        if self.mix_cfg is None and "paper/mix_beta" in actor_metrics:
+            raise RuntimeError("[paper] the actor ran the mixed loss but PAPER_MIX_BETA is unset. Refusing to continue.")
+        if self.mix_cfg is not None and abs(float(actor_metrics["paper/mix_beta"]) - self.mix_cfg["beta"]) > 1e-9:
+            raise RuntimeError(f"[paper] mix beta mismatch: driver {self.mix_cfg['beta']} vs actor "
+                               f"{actor_metrics['paper/mix_beta']}. Refusing to continue.")
+        if self.fkl and "paper/fkl_ce" not in actor_metrics:
+            raise RuntimeError("[paper] PAPER_LOSS_MODE=fkl_sampled but the actor did not run the fkl loss (wrong verl "
+                               "tree on the workers?). Refusing to continue.")
+        if not self.active:
+            return
+        if "erropd/actor_ack" not in actor_metrics:
+            raise RuntimeError(
+                "[erropd] actor did not acknowledge erropd tensors: the Ray workers imported a verl "
+                "without the erropd actor patch (wrong tree on sys.path?). Refusing to continue."
+            )
+        # the tensors are consumed; drop them so later logging/dumps see the vanilla key set
+        for k in ("erropd_token_lambda", "erropd_loss_mask", "erropd_adv_bonus", "ref_max_log_prob"):
+            if k in batch.batch.keys():
+                batch.batch.pop(k)
+        batch.meta_info.pop("erropd_expect_ack", None)
+
+    def is_save_step(self, step):
+        return step in self.save_steps
+
+    def write_step(self, step, metrics):
+        rec = {"step": step}
+        for k, v in metrics.items():
+            if k.startswith(("erropd/", "paper/")) or k in ("actor/pg_loss", "actor/grad_norm", "response_length/mean",
+                                                "actor/entropy", "training/epoch"):
+                try:
+                    rec[k] = float(v)
+                except Exception:
+                    pass
+        with open(os.path.join(self.log_dir, "erropd_step_metrics.jsonl"), "a") as fh:
+            fh.write(json.dumps(rec) + "\n")
+
+    def summary(self):
+        return {"gate_open_steps": self.gate_open_steps, "n_steps": self.n_steps, "kept_cum": self.kept_cum}
