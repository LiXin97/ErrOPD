+def rkl_reference(teacher_seed):
+    """Independent full-vocabulary reverse-KL step on the stored batch (no verl actor code): student = the tiny model
+    (seed 0), teacher = tiny model (teacher_seed); micro-batches of 2 in row order; per position
+    sum_v p_S(v) (log p_S(v) - log p_T(v)) from fp32 log_softmax of the bf16-autocast logits, token-mean per
+    micro-batch / grad accumulation, grad-norm clip 1.0, SGD lr 1e-2. Returns per-micro-batch loss and parameters."""
+    import verl.utils.torch_functional as vtf2
+
+    model, teacher = tiny_model(0), tiny_teacher(teacher_seed)
+    opt = torch.optim.SGD(model.parameters(), lr=1e-2)
+    d = build_batch()
+    ga = BS // 2
+    losses = []
+    opt.zero_grad()
+    for j in range(0, BS, 2):
+        ids, am, pos = (d.batch[k][j:j + 2] for k in ("input_ids", "attention_mask", "position_ids"))
+        rm = d.batch["response_mask"][j:j + 2]
+        with torch.autocast(device_type="cpu", dtype=torch.bfloat16):
+            ls = model(input_ids=ids, attention_mask=am, position_ids=pos, use_cache=False).logits
+            with torch.no_grad():
+                lt = teacher(input_ids=ids, attention_mask=am, position_ids=pos, use_cache=False).logits
+        lps = torch.log_softmax(ls[:, -R - 1:-1, :].float(), dim=-1)
+        lpt = torch.log_softmax(lt[:, -R - 1:-1, :].float(), dim=-1)
+        kl = (lps.exp() * (lps - lpt)).sum(-1)
+        loss = vtf2.masked_mean(kl, rm)
+        (loss / ga).backward()
+        losses.append(loss.detach())
+    torch.nn.utils.clip_grad_norm_(model.parameters(), max_norm=1.0)
+    opt.step()
+    return {"ce": losses, "params": {k: v.detach().clone() for k, v in model.state_dict().items()}}
+
+
+def alpha_reference(teacher_seed, alpha, renorm, eps=1e-12):
+    """Independent alpha-gated full-vocabulary reverse-KL step on the stored batch (no verl actor code, the closed
+    form written out directly): per position, with p = exp(lps), r = lps - lpt - sum_v p_v (lps - lpt)_v,
+
+        omega = p^alpha r - (sum_v p_v^alpha r_v) p,    omega <- omega * ||p r||_2 / max(||omega||_2, eps) if renorm
+
+    and the backward pass driven by the surrogate sum_v omega_v lps_v with omega detached; micro-batches of 2 in row
+    order, token-mean per micro-batch / grad accumulation, clip 1.0, SGD lr 1e-2. Also returns the realised per-prefix
+    norms and the alpha-1 norms so the comparison can check what the renormalisation holds."""
+    import verl.utils.torch_functional as vtf2
+
+    model, teacher = tiny_model(0), tiny_teacher(teacher_seed)
+    opt = torch.optim.SGD(model.parameters(), lr=1e-2)
+    d = build_batch()
+    ga = BS // 2
+    losses, n_pre, n_post, n_a1 = [], [], [], []
+    opt.zero_grad()
+    for j in range(0, BS, 2):
+        ids, am, pos = (d.batch[k][j:j + 2] for k in ("input_ids", "attention_mask", "position_ids"))
+        rm = d.batch["response_mask"][j:j + 2]
+        with torch.autocast(device_type="cpu", dtype=torch.bfloat16):
+            ls = model(input_ids=ids, attention_mask=am, position_ids=pos, use_cache=False).logits
+            with torch.no_grad():
+                lt = teacher(input_ids=ids, attention_mask=am, position_ids=pos, use_cache=False).logits
+        lps = torch.log_softmax(ls[:, -R - 1:-1, :].float(), dim=-1)
+        lpt = torch.log_softmax(lt[:, -R - 1:-1, :].float(), dim=-1)
+        with torch.no_grad():
+            p = lps.exp()
+            r = lps - lpt
+            r = r - (p * r).sum(-1, keepdim=True)
+            g1 = p * r
+            om = g1 if alpha == 1.0 else (p.pow(alpha) * r)
+            if alpha != 1.0:
+                om = om - om.sum(-1, keepdim=True) * p
+            a1 = g1.norm(dim=-1)
+            pre = om.norm(dim=-1)
+            if renorm:
+                om = om * (a1 / pre.clamp_min(eps)).unsqueeze(-1)
+            n_a1.append(a1 * rm)
+            n_pre.append(pre * rm)
+            n_post.append(om.norm(dim=-1) * rm)
+            om = om * rm.unsqueeze(-1)
+        loss = vtf2.masked_mean((om * lps).sum(-1), rm)
+        losses.append(loss.detach())
+        (loss / ga).backward()
+    torch.nn.utils.clip_grad_norm_(model.parameters(), max_norm=1.0)
+    opt.step()
+    return {"ce": losses, "params": {k: v.detach().clone() for k, v in model.state_dict().items()},
+            "n_a1": torch.cat(n_a1), "n_pre": torch.cat(n_pre), "n_post": torch.cat(n_post)}
+
+
+def run_fullp():
+    """Full-vocabulary log-probs (PAPER rkl_full) from _forward_micro_batch: remove-padding and padded paths vs a
+    direct log_softmax, sampled-token log-probs unchanged by the request; micro-batch 1. Rows of the stored batch
+    (left- and right-padded) for the index map; unpadded rows for exactness."""
+    import verl.utils.attention_utils as vau
+    import verl.workers.actor.dp_actor as dpa
+
+    from flash_attn.bert_padding import index_first_axis, pad_input, rearrange, unpad_input
+    vau._index_first_axis, vau._pad_input, vau._rearrange, vau._unpad_input = index_first_axis, pad_input, rearrange, unpad_input
+    vau._get_attention_functions = lambda: (index_first_axis, pad_input, rearrange, unpad_input)
+    model = tiny_model(0).eval()
+    d = build_batch()
+    out = {"rows": []}
+    for i in range(BS):
+        mb = {k: d.batch[k][i:i + 1] for k in ("input_ids", "attention_mask", "position_ids", "responses")}
+        am = mb["attention_mask"][0].bool()
+        with torch.no_grad():
+            with torch.autocast(device_type="cpu", dtype=torch.bfloat16):  # the row alone, no padding
+                lg = model(input_ids=mb["input_ids"][:, am], position_ids=mb["position_ids"][:, am]).logits
+            n_resp = int(d.batch["response_mask"][i].sum())
+            n_prompt = int(am.sum()) - n_resp
+            direct = torch.log_softmax(lg[0, n_prompt - 1:n_prompt - 1 + n_resp].float(), -1)
+            row = {"n_resp": n_resp, "direct": direct}
+            for rmpad in (False, True):
+                a = dpa.DataParallelPPOActor(config=build_actor_cfg(1.0, rmpad=rmpad), actor_module=model)
+                e0, lp0 = a._forward_micro_batch(mb, temperature=1.0)
+                e1, lp1, full = a._forward_micro_batch(mb, temperature=1.0, full_logprobs=True)
+                row[f"lp_unchanged_rmpad{int(rmpad)}"] = bool(torch.equal(lp0, lp1))
+                row[f"full_rmpad{int(rmpad)}"] = full[0, :n_resp]
+                row[f"tok_from_full_rmpad{int(rmpad)}"] = full[0, :n_resp].gather(
+                    -1, mb["responses"][0, :n_resp, None]).squeeze(-1)
+                row[f"lp_rmpad{int(rmpad)}"] = lp1[0, :n_resp]
+            out["rows"].append(row)
+    return out
+
