+++ b/verl/tests/erropd/test_dose.py
@@ -0,0 +1,299 @@
+"""PAPER DOSE (PAPER_FI_MODE=rkldose, k = PAPER_FI_DOSE): the full-vocabulary reverse KL's logit gradient g1 multiplied
+by a FIXED k at the state-defined item-k decision states (fis's mask), g1 everywhere else. CPU, no GPU, no Ray.
+
+  PYTHONPATH=<tree>/verl python test_dose.py
+
+(1) Off the decision rows rkldose IS the unscaled field, bitwise: omega and every per-row statistic equal ctl's (g1 at
+    its own norm) and fis's off-decision rows, in float64 (shipped) and fp32 (test-only) arithmetic, chunked or not.
+(2) On the decision rows omega is EXACTLY fp32(k) times ctl's fp32 omega (k is applied after the cast), the logged scale
+    is exactly k, and the target / realised norm are k ||g1|| (rel 1e-6); direction: cos(a, g1) >= 0.9999 against an
+    INDEPENDENT float64 autograd g1.
+(3) With no decision row (an empty mask) the whole field and its statistics are ctl's, bitwise.
+(4) The applied logit gradient (autograd of the token-mean surrogate through log_softmax): off the decision rows bitwise
+    the surrogate's at k = 1 (the identity route); on them k times it to rel 1e-6, with ||a|| = k ||g1|| against the
+    independent g1.
+(5) k = 1: the config takes rkl_full's untouched step (apply False); its omega and statistics are ctl's bitwise.
+(6) The real 151,936-token vocabulary at provoked item-7 states, student p(err) = 10^-j, j = 6..14: the drive on the
+    close-vs-continue log-odds is k times rkl_full's (rel 1e-6) for k in {3, 10, 30}. INFO: FI-S's factor there.
+(7) The metrics: paper/fi_mode 7, paper/fi_dose k (rkldose only), fi_scale_dec == k, want/app sums at the decision
+    states == k x the g1 sums (rel 1e-6), normdev <= 1e-5; the key set is fis's plus paper/fi_dose.
+(8) Configuration and refusals: code 7, (g1, kg1, dec); k required, finite, > 0; PAPER_FI_DOSE refused with every other
+    mode; the identity switch gives ctl's field; a floor above ||g1|| leaves the row unscaled; stationary point.
+(9) The k = 1 surrogate control (PAPER_FI_FORCE_SURROGATE=1): apply True at k = 1, the field and every statistic
+    unchanged, paper/fi_force_surrogate emitted only then; refused at k != 1, with a non-0/1 value, with other modes.
+"""
+import math
+import os
+import sys
+
+import torch
+
+import verl.utils.torch_functional as vtf
+from verl.trainer.ppo.core_algos import agg_loss
+from verl.workers.actor.dp_actor import DataParallelPPOActor as A
+from verl.workers.actor.dp_actor import PAPER_FI_MODES, paper_fi_cfg
+
+vtf.FLAH_ATTN_CROSS_ENTROPY_LOSS_AVAILABLE = False
+RES = []
+FI_ENV = ("PAPER_FI_MODE", "PAPER_FI_FP64", "PAPER_FI_IDENTITY", "PAPER_FI_FLOOR", "PAPER_FI_CHUNK", "PAPER_FI_DOSE",
+          "PAPER_FI_FORCE_SURROGATE",
+          "PAPER_ALPHA_POSTSTEP", "PAPER_ALPHA_ERR_TOKEN", "PAPER_ALPHA_BOUNDARY_TOKEN", "PAPER_ALPHA_ERR_SLOT")
+KS = (3.0, 10.0, 30.0)
+
+
+def check(name, cond, detail=""):
+    RES.append(bool(cond))
+    print(f"{'PASS' if cond else 'FAIL'}  {name} {detail}", flush=True)
+
+
+def cosd(a, b, dim=-1):
+    a, b = a.double(), b.double()
+    return (a * b).sum(dim) / (a.norm(dim=dim) * b.norm(dim=dim))
+
+
+def cfg_of(mode, **env):
+    for k in FI_ENV:
+        os.environ.pop(k, None)
+    os.environ["PAPER_FI_MODE"] = mode
+    for k, v in env.items():
+        os.environ[k] = str(v)
+    try:
+        return paper_fi_cfg()
+    finally:
+        for k in FI_ENV:
+            os.environ.pop(k, None)
+
+
+def omega(mode, s, t, rows=None, err_token=7, **env):
+    c = cfg_of(mode, **env)
+    return A._paper_fi_omega(s, t, c, err_token=err_token, rescale_rows=(rows if c["where"] == "dec" else None))
+
+
+def ref_g1(lp_s, lp_t):
+    """INDEPENDENT g1: float64 autograd of sum_v p (l - m) w.r.t. logits z = lp_s."""
+    z = lp_s.detach().double().clone().requires_grad_(True)
+    m = torch.log_softmax(lp_t.detach().double(), -1)
+    l = torch.log_softmax(z, -1)
+    (g1,) = torch.autograd.grad((l.exp() * (l - m)).sum(), z)
+    return g1
+
+
+def states(seed=11, B=2, n=6, V=64):
+    g = torch.Generator().manual_seed(seed)
+    zs = 3.0 * torch.randn(B, n, V, generator=g)
+    zt = 3.0 * torch.randn(B, n, V, generator=g)
+    zs[0, 0] *= 6.0                                # a near-deterministic prefix, as in test_fi / test_e1
+    zt[0, 0, 7] = zs[0, 0].max() - 1.4
+    zs[1, 2] *= 6.0                                # and one on a decision row
+    zt[1, 2, 7] = zs[1, 2].max() - 1.4
+    return torch.log_softmax(zs.float(), -1), torch.log_softmax(zt.float(), -1)
+
+
+lp_s, lp_t = states()
+B, T, V = lp_s.shape
+ROWS = torch.zeros(B, T, dtype=torch.bool)
+ROWS[0, 1] = ROWS[0, 4] = ROWS[1, 2] = True        # the decision rows of these tests
+OFF = ~ROWS
+g1_ref = ref_g1(lp_s, lp_t)
+n1_ref = g1_ref.norm(dim=-1)
+
+# ------------------------------------------------------------------ (1) off the decision rows: the unscaled field
+for k in KS:
+    for fp64 in (1, 0):
+        for chunk in (256, 1):
+            o_k, s_k = omega("rkldose", lp_s, lp_t, ROWS, PAPER_FI_DOSE=k, PAPER_FI_FP64=fp64, PAPER_FI_CHUNK=chunk)
+            o_c, s_c = omega("ctl", lp_s, lp_t, ROWS, PAPER_FI_FP64=fp64, PAPER_FI_CHUNK=chunk)
+            o_s, s_s = omega("fis", lp_s, lp_t, ROWS, PAPER_FI_FP64=fp64, PAPER_FI_CHUNK=chunk)
+            bad_c = [x for x in s_c if not torch.equal(s_k[x][OFF], s_c[x][OFF])]
+            bad_s = [x for x in s_s if not torch.equal(s_k[x][OFF], s_s[x][OFF])]
+            check(f"[k={k:g} fp64={fp64} chunk={chunk}] off the decision rows omega and all {len(s_c)} per-row "
+                  f"statistics are ctl's (g1) and fis's bitwise",
+                  torch.equal(o_k[OFF], o_c[OFF]) and torch.equal(o_k[OFF], o_s[OFF]) and not bad_c and not bad_s
+                  and set(s_k) == set(s_c), f"(differ from ctl: {bad_c}; from fis: {bad_s})")
+            # (2) on them: exactly fp32(k) x ctl's fp32 omega; scale exactly k
+            kf = torch.tensor(k, dtype=torch.float32)
+            check(f"[k={k:g} fp64={fp64} chunk={chunk}] on the decision rows omega == fp32(k) * ctl's omega BITWISE, "
+                  f"scale == k exactly there and == 1 exactly elsewhere",
+                  torch.equal(o_k[ROWS], o_c[ROWS] * kf) and bool((s_k["scale"][ROWS] == k).all())
+                  and bool((s_k["scale"][OFF] == 1.0).all()))
+
+for k in KS:
+    o_k, s_k = omega("rkldose", lp_s, lp_t, ROWS, PAPER_FI_DOSE=k)
+    rw = ((s_k["n_want"].double() / s_k["n_g1"].double()) / k - 1).abs()[ROWS].max().item()
+    ra = ((s_k["n_app"].double() / (k * n1_ref)) - 1).abs()[ROWS].max().item()
+    check(f"[k={k:g} dec rows] target n_want == k ||g1|| (rel 1e-6) and realised n_app == k ||g1|| against the "
+          f"independent float64 autograd g1 (rel 1e-6)", rw < 1e-6 and ra < 1e-6, f"(target {rw:.1e}, realised {ra:.1e})")
+    p = lp_s.double().exp()
+    a = o_k.double() - p * o_k.double().sum(-1, keepdim=True)
+    cmin = cosd(a, g1_ref)[ROWS].min().item()
+    want = torch.where(ROWS.unsqueeze(-1), g1_ref * k, g1_ref)
+    rel = ((o_k.double() - want).norm(dim=-1) / want.norm(dim=-1)).max().item()
+    check(f"[k={k:g}] direction cos(a, g1) >= 0.9999 on the decision rows (independent g1), and omega == where(dec, "
+          f"k g1, g1) from the independent field (rel L2 1e-6)", cmin >= 0.9999 and rel < 1e-6,
+          f"(min cos {cmin:.12f}; rel {rel:.1e})")
+
+# ------------------------------------------------------------------ (3) no decision row: ctl's field
+o_c, s_c = omega("ctl", lp_s, lp_t)
+o_e, s_e = A._paper_fi_omega(lp_s, lp_t, cfg_of("rkldose", PAPER_FI_DOSE=30), err_token=7,
+                             rescale_rows=torch.zeros_like(ROWS))
+check(f"[no decision rows] an empty mask: omega and all {len(s_c)} statistics bitwise ctl's",
+      torch.equal(o_e, o_c) and all(torch.equal(s_e[x], s_c[x]) for x in s_c))
+try:
+    A._paper_fi_omega(lp_s, lp_t, cfg_of("rkldose", PAPER_FI_DOSE=3), err_token=7, rescale_rows=None)
+    check("[guard] rkldose without its decision mask raises", False)
+except ValueError as e:
+    check("[guard] rkldose without its decision mask raises", True, f"({e})")
+
+# ------------------------------------------------------------------ (4) the applied logit gradient
+mask = torch.ones(B, T)
+N = float(mask.sum())
+
+
+def applied(mode, rows, **env):
+    z = lp_s.detach().clone().requires_grad_(True)
+    s = torch.log_softmax(z, -1)
+    om, _ = omega(mode, s, lp_t, rows, **env)
+    loss = agg_loss(loss_mat=(om * s).sum(-1), loss_mask=mask, loss_agg_mode="token-mean")
+    (g,) = torch.autograd.grad(loss, z)
+    return g
+
+
+g_id = applied("rkldose", ROWS, PAPER_FI_DOSE=3, PAPER_FI_IDENTITY=1)   # the surrogate at k = 1 (g1 everywhere)
+g_ctl = applied("ctl", ROWS)
+check("[applied] the identity route (rkldose at its own norm) applies ctl's surrogate field bitwise", torch.equal(g_id, g_ctl))
+for k in KS:
+    g_k = applied("rkldose", ROWS, PAPER_FI_DOSE=k)
+    r = ((g_k[ROWS].double() - k * g_id[ROWS].double()).norm(dim=-1) / (k * g_id[ROWS].double()).norm(dim=-1)).max().item()
+    na = ((g_k.double() * N).norm(dim=-1) / (k * n1_ref) - 1).abs()[ROWS].max().item()
+    check(f"[applied k={k:g}] off the decision rows the applied gradient is the k = 1 surrogate's BITWISE; on them it "
+          f"is k times it (rel 1e-6) with ||a|| == k ||g1|| (independent g1, rel 1e-6)",
+          torch.equal(g_k[OFF], g_id[OFF]) and r < 1e-6 and na < 1e-6, f"(x k rel {r:.1e}; norm rel {na:.1e})")
+
+# ------------------------------------------------------------------ (5) k = 1
+c1 = cfg_of("rkldose", PAPER_FI_DOSE=1)
+o1, s1 = omega("rkldose", lp_s, lp_t, ROWS, PAPER_FI_DOSE=1)
+check("[k=1] the untouched rkl_full step (apply False, as ctl), and omega and every statistic are ctl's bitwise",
+      c1["apply"] is False and torch.equal(o1, o_c) and all(torch.equal(s1[x], s_c[x]) for x in s_c))
+
+# ------------------------------------------------------------------ (6) the real vocabulary, provoked item-7 states
+VV = 151936
+tail = 2.0 * torch.randn(VV, generator=torch.Generator().manual_seed(3))
+worst, fis_fac = 0.0, []
+for j in range(6, 15):
+    zs = tail.clone()
+    zs[100] = 30.0                                 # continue
+    zs[101] = 30.0 + math.log(10.0 ** -j)          # error at p ~ 10^-j
+    zt = tail + 0.3 * torch.randn(VV, generator=torch.Generator().manual_seed(j))
+    zt[100], zt[101] = 30.0, 30.0 - 1.4            # teacher q(err) ~ 0.2
+    zs, zt = zs.bfloat16().float(), zt.bfloat16().float()
+    ss, tt = torch.log_softmax(zs, -1).view(1, 1, VV), torch.log_softmax(zt, -1).view(1, 1, VV)
+    one = torch.ones(1, 1, dtype=torch.bool)
+    og, _ = omega("ctl", ss, tt, one, err_token=101)
+
+    def drive(x):
+        return float(-(x[0, 0, 101].double() - x[0, 0, 100].double()))
+    for k in KS:
+        ok_, sk = omega("rkldose", ss, tt, one, err_token=101, PAPER_FI_DOSE=k)
+        worst = max(worst, abs(drive(ok_) / (k * drive(og)) - 1.0))
+    of, sf = omega("fis", ss, tt, one, err_token=101)
+    fis_fac.append((j, float(sf["scale"][0, 0])))
+check("[provoked, V = 151,936] at p(err) = 10^-j, j = 6..14: rkldose's drive on the close-vs-continue log-odds is k "
+      "times rkl_full's (k = 3, 10, 30; rel 1e-6)", worst < 1e-6, f"(worst rel {worst:.1e})")
+print(f"INFO  [provoked] FI-S's per-prefix factor ||d|| / ||g1|| at the same states, by j: "
+      f"{[(j, f'{x:.3g}') for j, x in fis_fac]}")
+
+# ------------------------------------------------------------------ (7) metrics
+mk = {"all": mask.bool(), "dec": ROWS}
+for k in KS:
+    o_k, s_k = omega("rkldose", lp_s, lp_t, ROWS, PAPER_FI_DOSE=k)
+    fm = A._paper_fi_metrics(cfg_of("rkldose", PAPER_FI_DOSE=k), s_k, mk)
+    check(f"[metrics k={k:g}] paper/fi_mode 7, fi_dose {k:g}, applied 1, identity 0, fp64 1, floor 0, fi_scale_dec == k",
+          (fm["paper/fi_mode"], fm["paper/fi_dose"], fm["paper/fi_applied"], fm["paper/fi_identity"],
+           fm["paper/fi_fp64"], fm["paper/fi_floor"], fm["paper/fi_scale_dec"]) == (7.0, k, 1.0, 0.0, 1.0, 0.0, k))
+    rw = abs(fm["paper/fi_want_sum_dec"] / (k * fm["paper/fi_g1_sum_dec"]) - 1)
+    ra = abs(fm["paper/fi_app_sum_dec"] / (k * fm["paper/fi_g1_sum_dec"]) - 1)
+    off_w = abs((fm["paper/fi_want_sum_all"] - fm["paper/fi_want_sum_dec"])
+                - (fm["paper/fi_g1_sum_all"] - fm["paper/fi_g1_sum_dec"])) / fm["paper/fi_g1_sum_all"]
+    check(f"[metrics k={k:g}] want_sum_dec and app_sum_dec == k g1_sum_dec (rel 1e-6); off the decision rows the "
+          f"target is g1's (rel 1e-12); normdev_max <= 1e-5; cos_to_g1_min >= 0.9999",
+          rw < 1e-6 and ra < 1e-6 and off_w < 1e-12 and fm["paper/fi_normdev_max"] <= 1e-5
+          and fm["paper/fi_cos_to_g1_min"] >= 0.9999,
+          f"({rw:.1e}, {ra:.1e}, {off_w:.1e}, normdev {fm['paper/fi_normdev_max']:.1e})")
+    # the decision states' share of the batch's realised logit-gradient mass, as logged: k x g1 there over the total
+    sh = fm["paper/fi_app_sum_dec"] / fm["paper/fi_app_sum_all"]
+    g1s = fm["paper/fi_g1_sum_dec"] / fm["paper/fi_g1_sum_all"]
+    pred = k * g1s / (1 + (k - 1) * g1s)
+    check(f"[metrics k={k:g}] the decision share of realised mass == k s / (1 + (k - 1) s), s = g1's share "
+          f"(rel 1e-6); fi_mass_share_dec is it", abs(sh / pred - 1) < 1e-6 and abs(fm["paper/fi_mass_share_dec"] / sh - 1) < 1e-12,
+          f"(s {g1s:.4f} -> {sh:.4f})")
+fs = A._paper_fi_metrics(cfg_of("fis"), omega("fis", lp_s, lp_t, ROWS)[1], mk)
+fc = A._paper_fi_metrics(cfg_of("ctl"), s_c, mk)
+check("[metrics] rkldose's key set is fis's plus paper/fi_dose; fis and ctl emit no paper/fi_dose",
+      set(fm) == set(fs) | {"paper/fi_dose"} and "paper/fi_dose" not in fs and "paper/fi_dose" not in fc)
+
+# ------------------------------------------------------------------ (8) configuration, refusals, identity, floor
+c = cfg_of("rkldose", PAPER_FI_DOSE=3)
+check("[cfg] rkldose: code 7, direction g1, target kg1, where dec, applied, fp64 on, floor 0, dose 3.0",
+      (c["code"], c["dir"], c["tgt"], c["where"], c["apply"], c["fp64"], c["floor"], c["dose"])
+      == (7.0, "g1", "kg1", "dec", True, True, 0.0, 3.0) and PAPER_FI_MODES["rkldose"] == (7, "g1", "kg1", "dec"))
+check("[cfg] a non-integer k (0.3) is accepted and applies the surrogate; other modes carry dose None",
+      cfg_of("rkldose", PAPER_FI_DOSE="0.3")["dose"] == 0.3 and cfg_of("rkldose", PAPER_FI_DOSE="0.3")["apply"]
+      and all(cfg_of(m)["dose"] is None for m in ("fir", "fis", "fklfull", "fkldec", "ctl")))
+for bad, mode, env in (("rkldose without PAPER_FI_DOSE", "rkldose", {}),
+                       ("k = 0", "rkldose", {"PAPER_FI_DOSE": "0"}), ("k < 0", "rkldose", {"PAPER_FI_DOSE": "-1"}),
+                       ("k = nan", "rkldose", {"PAPER_FI_DOSE": "nan"}), ("k = inf", "rkldose", {"PAPER_FI_DOSE": "inf"}),
+                       ("k = '3x'", "rkldose", {"PAPER_FI_DOSE": "3x"}), ("k empty", "rkldose", {"PAPER_FI_DOSE": " "}),
+                       *((f"PAPER_FI_DOSE with {m}", m, {"PAPER_FI_DOSE": "3"})
+                         for m in ("fir", "fis", "fklfull", "fkldec", "ctl"))):
+    try:
+        cfg_of(mode, **env)
+        check(f"refused: {bad}", False)
+    except ValueError as e:
+        check(f"refused: {bad}", True, f"({e})")
+for fp64 in (1, 0):
+    o_i, _ = omega("rkldose", lp_s, lp_t, ROWS, PAPER_FI_DOSE=30, PAPER_FI_IDENTITY=1, PAPER_FI_FP64=fp64)
+    o_c2, _ = omega("ctl", lp_s, lp_t, PAPER_FI_FP64=fp64)
+    check(f"[identity fp64={fp64}] rkldose at its own norm is ctl's field, bitwise", torch.equal(o_i, o_c2))
+fl = float(s_c["n_g1"][1, 2]) * 1.0001          # a floor just above the decision row (1, 2)'s ||g1||
+o_f, s_f = omega("rkldose", lp_s, lp_t, ROWS, PAPER_FI_DOSE=3, PAPER_FI_FLOOR=fl)
+check("[floor] a decision row whose ||g1|| is below the floor is not rescaled (scale 1, counted), the others are",
+      float(s_f["scale"][1, 2]) == 1.0 and float(s_f["floor"][1, 2]) == 1.0
+      and bool((s_f["scale"][ROWS & (s_f["floor"] == 0)] == 3.0).all()) and torch.equal(o_f[1, 2], o_c[1, 2]))
+o0, s0 = omega("rkldose", lp_s, lp_s.clone(), ROWS, PAPER_FI_DOSE=30)
+check("[stationary] teacher == student: omega exactly 0 at every prefix (decision rows included), all counted zero",
+      bool((o0 == 0).all()) and bool((s0["zero"] == 1).all()) and all(bool(torch.isfinite(v).all()) for v in s0.values()))
+# ------------------------------------------------------------------ (9) the k = 1 surrogate control
+cf = cfg_of("rkldose", PAPER_FI_DOSE=1, PAPER_FI_FORCE_SURROGATE=1)
+check("[force] rkldose k = 1 with PAPER_FI_FORCE_SURROGATE=1 applies the surrogate (apply True, force True); "
+      "unforced k = 1 and FORCE=0 do not", cf["apply"] is True and cf["force_surrogate"] is True
+      and cfg_of("rkldose", PAPER_FI_DOSE=1)["apply"] is False
+      and cfg_of("rkldose", PAPER_FI_DOSE=1, PAPER_FI_FORCE_SURROGATE=0)["apply"] is False
+      and cfg_of("rkldose", PAPER_FI_DOSE=1)["force_surrogate"] is False)
+o_f1, s_f1 = A._paper_fi_omega(lp_s, lp_t, cf, err_token=7, rescale_rows=ROWS)
+check("[force] the field is unchanged by the switch: omega and every statistic bitwise unforced k = 1's (= ctl's)",
+      torch.equal(o_f1, o1) and all(torch.equal(s_f1[x], s1[x]) for x in s1))
+fmf = A._paper_fi_metrics(cf, s_f1, mk)
+fm1 = A._paper_fi_metrics(cfg_of("rkldose", PAPER_FI_DOSE=1), s1, mk)
+check("[force] metrics: paper/fi_force_surrogate 1 and fi_applied 1 when forced; unforced k = 1 emits no force key "
+      "and fi_applied 0; every other metric bitwise equal",
+      fmf.get("paper/fi_force_surrogate") == 1.0 and fmf["paper/fi_applied"] == 1.0 and fm1["paper/fi_applied"] == 0.0
+      and "paper/fi_force_surrogate" not in fm1 and set(fmf) == set(fm1) | {"paper/fi_force_surrogate"}
+      and all(fmf[x] == fm1[x] for x in fm1 if x != "paper/fi_applied"))
+check("[force] no other mode emits paper/fi_force_surrogate", all(
+    "paper/fi_force_surrogate" not in A._paper_fi_metrics(cfg_of(m), omega(m, lp_s, lp_t, ROWS)[1], mk)
+    for m in ("fir", "fis", "fklfull", "fkldec", "ctl")))
+for bad, mode, env in (("force at k = 3", "rkldose", {"PAPER_FI_DOSE": "3", "PAPER_FI_FORCE_SURROGATE": "1"}),
+                       ("force not 0/1", "rkldose", {"PAPER_FI_DOSE": "1", "PAPER_FI_FORCE_SURROGATE": "yes"}),
+                       *((f"force with {m}", m, {"PAPER_FI_FORCE_SURROGATE": "1"})
+                         for m in ("fir", "fis", "fklfull", "fkldec", "ctl")),
+                       ("FORCE=0 with fis", "fis", {"PAPER_FI_FORCE_SURROGATE": "0"})):
+    try:
+        cfg_of(mode, **env)
+        check(f"refused: {bad}", False)
+    except ValueError as e:
+        check(f"refused: {bad}", True, f"({e})")
+for k in FI_ENV:
+    os.environ.pop(k, None)
+
+print(f"\n{sum(RES)} passed, {len(RES) - sum(RES)} failed")
+sys.exit(0 if all(RES) else 1)
diff --git a/verl/tests/erropd/test_e1.py b/verl/tests/erropd/test_e1.py
new file mode 100644
index 0000000..8d719c2
--- /dev/null
+++ b/verl/tests/erropd/test_e1.py
@@ -0,0 +1,263 @@
+"""PAPER E1 (PAPER_FI_MODE=fkldec), the mirror of FI-S: at the state-defined item-k decision states the forward KL's
+direction d = p - q rescaled to the reverse KL's per-prefix norm ||g1||; everywhere else d at its own norm, i.e.
+exactly fklfull. CPU, no GPU, no Ray.
+
+  PYTHONPATH=<tree>/verl python test_e1.py
+
+(1) Off the decision rows fkldec IS fklfull, bitwise: omega and every per-row statistic (target, scale, realised norm,
+    cosines, sums, error-token entries), in float64 (shipped) and fp32 (test-only) arithmetic, chunked or not.
+(2) With no decision row at all (an empty mask, or no mask) the whole field and its statistics are fklfull's, bitwise.
+(3) The applied logit gradient (autograd of the token-mean surrogate through log_softmax) is fklfull's bitwise on the
+    non-decision rows; on the decision rows it is a / N with ||a|| = ||g1|| and cos(a, d) = 1.
+(4) On the decision rows: the target is ||g1|| (n_want == n_g1 bitwise), the realised norm n_app equals it to 1e-6
+    relative, and cos(a, d) >= 0.9999 against an INDEPENDENT float64 autograd d; omega == d * ||g1|| / ||d|| from the
+    independent fields to 1e-6.
+(5) The real 151,936-token vocabulary at the lock's provoked item-7 states, student p(err) = 10^-k, k = 6..14: the
+    realised norm equals ||g1|| to 1e-6 and cos(a, d_float64-from-logits) >= 0.9999 at every k. INFO: fkldec's drive on
+    the close-vs-continue log-odds against rkl_full's (g1) and FKL-full's at the same state.
+(6) The metrics: paper/fi_mode == 6; fi_want_sum_dec == fi_g1_sum_dec bitwise; fi_cos_to_d_{mean,min} emitted and
+    equal to the per-row cos_d; the N1 keys the E1 lock reads exist.
+(7) Configuration: code 6, (d, g1, dec), applied; the identity switch gives fklfull's field bitwise; stationary point.
+"""
+import math
+import os
+import sys
+
+import torch
+
+import verl.utils.torch_functional as vtf
+from verl.trainer.ppo.core_algos import agg_loss
+from verl.workers.actor.dp_actor import DataParallelPPOActor as A
+from verl.workers.actor.dp_actor import PAPER_FI_MODES, paper_fi_cfg
+
+vtf.FLAH_ATTN_CROSS_ENTROPY_LOSS_AVAILABLE = False
+RES = []
+FI_ENV = ("PAPER_FI_MODE", "PAPER_FI_FP64", "PAPER_FI_IDENTITY", "PAPER_FI_FLOOR", "PAPER_FI_CHUNK",
+          "PAPER_ALPHA_POSTSTEP", "PAPER_ALPHA_ERR_TOKEN", "PAPER_ALPHA_BOUNDARY_TOKEN", "PAPER_ALPHA_ERR_SLOT")
+
+
+def check(name, cond, detail=""):
+    RES.append(bool(cond))
+    print(f"{'PASS' if cond else 'FAIL'}  {name} {detail}", flush=True)
+
+
+def cosd(a, b, dim=-1):
+    a, b = a.double(), b.double()
+    return (a * b).sum(dim) / (a.norm(dim=dim) * b.norm(dim=dim))
+
+
+def cfg_of(mode, **env):
+    for k in FI_ENV:
+        os.environ.pop(k, None)
+    os.environ["PAPER_FI_MODE"] = mode
+    for k, v in env.items():
+        os.environ[k] = str(v)
+    try:
+        return paper_fi_cfg()
+    finally:
+        for k in FI_ENV:
+            os.environ.pop(k, None)
+
+
+def omega(mode, s, t, rows=None, err_token=7, **env):
+    c = cfg_of(mode, **env)
+    return A._paper_fi_omega(s, t, c, err_token=err_token, rescale_rows=(rows if c["where"] == "dec" else None))
+
+
+def ref_fields(lp_s, lp_t):
+    """INDEPENDENT g1 and d: float64 autograd of sum_v p (l - m) and sum_v q (m - l) w.r.t. logits z = lp_s."""
+    z = lp_s.detach().double().clone().requires_grad_(True)
+    m = torch.log_softmax(lp_t.detach().double(), -1)
+    l = torch.log_softmax(z, -1)
+    (g1,) = torch.autograd.grad((l.exp() * (l - m)).sum(), z)
+    z2 = lp_s.detach().double().clone().requires_grad_(True)
+    (d,) = torch.autograd.grad((m.exp() * (m - torch.log_softmax(z2, -1))).sum(), z2)
+    return g1, d
+
+
+def states(seed=11, B=2, n=6, V=64):
+    g = torch.Generator().manual_seed(seed)
+    zs = 3.0 * torch.randn(B, n, V, generator=g)
+    zt = 3.0 * torch.randn(B, n, V, generator=g)
+    zs[0, 0] *= 6.0                                # a near-deterministic prefix, as in test_fi
+    zt[0, 0, 7] = zs[0, 0].max() - 1.4
+    zs[1, 2] *= 6.0                                # and one on a decision row
+    zt[1, 2, 7] = zs[1, 2].max() - 1.4
+    return torch.log_softmax(zs.float(), -1), torch.log_softmax(zt.float(), -1)
+
+
+lp_s, lp_t = states()
+B, T, V = lp_s.shape
+ROWS = torch.zeros(B, T, dtype=torch.bool)
+ROWS[0, 1] = ROWS[0, 4] = ROWS[1, 2] = True        # the decision rows of these tests
+g1_ref, d_ref = ref_fields(lp_s, lp_t)
+
+# ------------------------------------------------------------------ (1) off the decision rows: fklfull, bitwise
+for fp64 in (1, 0):
+    for chunk in (256, 1):
+        o_d, s_d = omega("fkldec", lp_s, lp_t, ROWS, PAPER_FI_FP64=fp64, PAPER_FI_CHUNK=chunk)
+        o_k, s_k = omega("fklfull", lp_s, lp_t, ROWS, PAPER_FI_FP64=fp64, PAPER_FI_CHUNK=chunk)
+        off = ~ROWS
+        bad = [k for k in s_k if not torch.equal(s_d[k][off], s_k[k][off])]
+        check(f"[fp64={fp64} chunk={chunk}] off the decision rows omega is fklfull's bitwise, and so is every per-row "
+              f"statistic ({len(s_k)} keys)", torch.equal(o_d[off], o_k[off]) and not bad and set(s_d) == set(s_k),
+              f"(differ: {bad})")
+        check(f"[fp64={fp64} chunk={chunk}] ... and the decision rows ARE rescaled (omega differs there, scale != 1)",
+              not torch.equal(o_d[ROWS], o_k[ROWS]) and bool((s_d["scale"][ROWS] != 1.0).all())
+              and bool((s_d["scale"][off] == 1.0).all()))
+
+# ------------------------------------------------------------------ (2) no decision row: the whole step is fklfull's
+o_k, s_k = omega("fklfull", lp_s, lp_t)
+o_d, s_d = A._paper_fi_omega(lp_s, lp_t, cfg_of("fkldec"), err_token=7, rescale_rows=torch.zeros_like(ROWS))
+check(f"[no decision rows] an empty decision mask: omega and all {len(s_k)} statistics bitwise fklfull's",
+      torch.equal(o_d, o_k) and all(torch.equal(s_d[k], s_k[k]) for k in s_k))
+# a 'dec' mode without its mask would rescale EVERY row (for fkldec: the retired all-prefix FI-F); it must raise
+for _m in ("fkldec", "fis"):
+    try:
+        A._paper_fi_omega(lp_s, lp_t, cfg_of(_m), err_token=7, rescale_rows=None)
+        check(f"[guard] {_m} without its decision mask (rescale_rows=None) raises", False)
+    except ValueError as e:
+        check(f"[guard] {_m} without its decision mask (rescale_rows=None) raises", True, f"({e})")
+mask = torch.ones(B, T)
+fm_k = A._paper_fi_metrics(cfg_of("fklfull"), s_k, {"all": mask.bool(), "dec": torch.zeros_like(ROWS)})
+o_d, s_d = omega("fkldec", lp_s, lp_t, torch.zeros_like(ROWS))
+fm_d = A._paper_fi_metrics(cfg_of("fkldec"), s_d, {"all": mask.bool(), "dec": torch.zeros_like(ROWS)})
+diff = [k for k in fm_k if k != "paper/fi_mode" and fm_k[k] != fm_d.get(k)]
+check("[no decision rows] every paper/fi_* metric bitwise fklfull's except paper/fi_mode (3 vs 6)",
+      not diff and set(fm_k) == set(fm_d) and (fm_k["paper/fi_mode"], fm_d["paper/fi_mode"]) == (3.0, 6.0),
+      f"(differ: {diff})")
+
+# ------------------------------------------------------------------ (3) the applied logit gradient
+def applied(mode, rows):
+    z = lp_s.detach().clone().requires_grad_(True)
+    s = torch.log_softmax(z, -1)
+    om, _ = omega(mode, s, lp_t, rows)
+    loss = agg_loss(loss_mat=(om * s).sum(-1), loss_mask=mask, loss_agg_mode="token-mean")
+    (g,) = torch.autograd.grad(loss, z)
+    return g
+
+
+ga_d, ga_k = applied("fkldec", ROWS), applied("fklfull", ROWS)
+check("[applied] the logit gradient of the surrogate (autograd through log_softmax) is fklfull's bitwise off the "
+      "decision rows", torch.equal(ga_d[~ROWS], ga_k[~ROWS]))
+N = float(mask.sum())
+n1 = g1_ref.norm(dim=-1)
+na = (ga_d.double() * N).norm(dim=-1)
+rel = ((na - n1).abs() / n1)[ROWS].max().item()
+cmin = cosd(ga_d.double(), d_ref)[ROWS].min().item()
+check("[applied] on the decision rows the applied gradient is N^-1 a with ||a|| == ||g1|| (rel 1e-6) and cos(a, d) "
+      ">= 0.9999 (independent float64 autograd fields)", rel < 1e-6 and cmin >= 0.9999,
+      f"(rel {rel:.1e}, min cos {cmin:.12f})")
+
+# ------------------------------------------------------------------ (4) the decision rows: target, realised, direction
+o_d, s_d = omega("fkldec", lp_s, lp_t, ROWS)
+check("[dec rows] the target is ||g1||: n_want == n_g1 bitwise there, == n_d bitwise elsewhere",
+      torch.equal(s_d["n_want"][ROWS], s_d["n_g1"][ROWS]) and torch.equal(s_d["n_want"][~ROWS], s_d["n_d"][~ROWS]))
+rel_app = ((s_d["n_app"].double() - s_d["n_g1"].double()).abs() / s_d["n_g1"].double())[ROWS].max().item()
+rel_ref = ((s_d["n_app"].double() - n1).abs() / n1)[ROWS].max().item()
+check("[dec rows] realised norm n_app == ||g1|| (rel 1e-6; against the logged n_g1 and the independent ||g1||)",
+      rel_app < 1e-6 and rel_ref < 1e-6, f"({rel_app:.1e}, {rel_ref:.1e})")
+p = lp_s.double().exp()
+a = o_d.double() - p * o_d.double().sum(-1, keepdim=True)
+cos_ind = cosd(a, d_ref)[ROWS].min().item()
+e_cos = (s_d["cos_d"].double() - cosd(a, d_ref)).abs().max().item()
+check("[dec rows] cos(a, d) >= 0.9999 (independent d), and the logged cos_d equals it everywhere (1e-7)",
+      cos_ind >= 0.9999 and e_cos < 1e-7 and float(s_d["cos_d"][ROWS].min()) >= 0.9999,
+      f"(min {cos_ind:.12f}; logged-vs-independent {e_cos:.1e})")
+want = torch.where(ROWS.unsqueeze(-1), d_ref * (n1 / d_ref.norm(dim=-1)).unsqueeze(-1), d_ref)
+rel = ((o_d.double() - want).norm(dim=-1) / want.norm(dim=-1)).max().item()
+check("[all rows] omega == where(dec, d ||g1|| / ||d||, d) from the independent fields (rel L2 1e-6)", rel < 1e-6,
+      f"({rel:.1e})")
+check("[dec rows] scale == ||g1|| / ||d|| (rel 1e-6)",
+      ((s_d["scale"].double() - n1 / d_ref.norm(dim=-1)).abs() / (n1 / d_ref.norm(dim=-1)))[ROWS].max().item() < 1e-6)
+
+# ------------------------------------------------------------------ (5) the real vocabulary, provoked item-7 states
+VV = 151936
+tail = 2.0 * torch.randn(VV, generator=torch.Generator().manual_seed(3))
+worst_n, worst_x, worst_c, drives = 0.0, 0.0, 1.0, []
+for k in range(6, 15):
+    zs = tail.clone()
+    zs[100] = 30.0                                 # continue
+    zs[101] = 30.0 + math.log(10.0 ** -k)          # error at p ~ 10^-k
+    zt = tail + 0.3 * torch.randn(VV, generator=torch.Generator().manual_seed(k))
+    zt[100], zt[101] = 30.0, 30.0 - 1.4            # teacher q(err) ~ 0.2
+    zs, zt = zs.bfloat16().float(), zt.bfloat16().float()
+    ss, tt = torch.log_softmax(zs, -1).view(1, 1, VV), torch.log_softmax(zt, -1).view(1, 1, VV)
+    one = torch.ones(1, 1, dtype=torch.bool)
+    o, sk = omega("fkldec", ss, tt, one, err_token=101)
+    of, _ = omega("fklfull", ss, tt, one, err_token=101)
+    og, _ = omega("ctl", ss, tt, one, err_token=101)  # rkl_full's g1, float64 build
+    l_, m_ = torch.log_softmax(zs.double(), -1), torch.log_softmax(zt.double(), -1)
+    p_, q_ = l_.exp(), m_.exp()
+    g_ = p_ * ((l_ - m_) - (p_ * (l_ - m_)).sum())
+    d_ = p_ - q_
+    a_ = o[0, 0].double() - p_ * o[0, 0].double().sum()
+    # against the arm's own target (||g1|| from the same fp32 log-probs, re-normalised in float64): the arm's claim
+    worst_n = max(worst_n, abs(float(sk["n_app"]) / float(sk["n_g1"]) - 1.0),
+                  abs(a_.norm().item() / float(sk["n_g1"]) - 1.0))
+    # against ||g1|| from the bf16 logits in float64: differs by the fp32 rounding of the log-probs themselves (the
+    # input every arm shares), which at k >= 10 is where ||g1|| lives (the tail, not the decision)
+    worst_x = max(worst_x, abs(a_.norm().item() / g_.norm().item() - 1))
+    worst_c = min(worst_c, cosd(a_, d_, dim=0).item(), float(sk["cos_d"]))
+
+    def drive(x):
+        return float(-(x[0, 0, 101] - x[0, 0, 100]))
+    drives.append((k, drive(o) / drive(og), drive(o) / drive(of)))
+check("[provoked, V = 151,936] at p(err) = 10^-k, k = 6..14: realised norm == the arm's ||g1|| (rel 1e-6; logged n_app "
+      "and recomputed a) and cos(a, d) >= 0.9999 (logged and against the float64-from-logits d)",
+      worst_n < 1e-6 and worst_c >= 0.9999, f"(worst rel {worst_n:.1e}, worst cos {worst_c:.12f})")
+print(f"INFO  [provoked] realised norm against ||g1|| built in float64 from the bf16 logits (not from the fp32 log-probs "
+      f"the actor receives): worst rel {worst_x:.1e} (the fp32 log-prob rounding every arm shares)")
+print(f"INFO  [provoked] fkldec's drive on the close-vs-continue log-odds at the decision state, by k: "
+      f"(k, / rkl_full's, / FKL-full's) {[(k, round(x, 4), f'{y:.2e}') for k, x, y in drives]}")
+
+# ------------------------------------------------------------------ (6) metrics
+mk = {"all": mask.bool(), "dec": ROWS}
+fm = A._paper_fi_metrics(cfg_of("fkldec"), s_d, mk)
+nz = mask.bool() & (s_d["zero"] == 0)
+check("[metrics] paper/fi_mode == 6, applied 1, identity 0, fp64 1, floor 0",
+      (fm["paper/fi_mode"], fm["paper/fi_applied"], fm["paper/fi_identity"], fm["paper/fi_fp64"], fm["paper/fi_floor"])
+      == (6.0, 1.0, 0.0, 1.0, 0.0))
+check("[metrics] fi_want_sum_dec == fi_g1_sum_dec bitwise (the decision rows' target is ||g1||); the rest of the "
+      "target is ||d||", fm["paper/fi_want_sum_dec"] == fm["paper/fi_g1_sum_dec"]
+      and abs((fm["paper/fi_want_sum_all"] - fm["paper/fi_want_sum_dec"])
+              - (fm["paper/fi_d_sum_all"] - fm["paper/fi_d_sum_dec"])) <= 1e-12 * fm["paper/fi_d_sum_all"],
+      f"({fm['paper/fi_want_sum_dec']:.6g} vs {fm['paper/fi_g1_sum_dec']:.6g})")
+check("[metrics] fi_cos_to_d_mean / _min are the mean / min of the per-row cos_d over non-zero prefixes",
+      fm["paper/fi_cos_to_d_mean"] == float(s_d["cos_d"][nz].mean())
+      and fm["paper/fi_cos_to_d_min"] == float(s_d["cos_d"][nz].min()) and fm["paper/fi_cos_to_d_min"] >= 0.9999)
+N1 = ["paper/fi_normdev_mean", "paper/fi_normdev_max", "paper/fi_cos_to_d_mean", "paper/fi_cos_to_d_min",
+      "paper/fi_zero_want_share", "paper/fi_zerosum_rel_max", "paper/fi_want_sum_dec", "paper/fi_want_sum_all",
+      "paper/fi_g1_sum_dec", "paper/fi_app_sum_dec", "paper/fi_scale_dec", "paper/fi_cos_to_g1_mean"]
+check("[metrics] the keys the E1 lock's N1 reads are emitted, and the norm deviation is within the bars here "
+      "(normdev_max <= 1e-5)", all(k in fm for k in N1) and fm["paper/fi_normdev_max"] <= 1e-5,
+      f"(normdev_max {fm['paper/fi_normdev_max']:.1e}; missing {[k for k in N1 if k not in fm]})")
+fk = A._paper_fi_metrics(cfg_of("fklfull"), s_k, mk)
+check("[metrics] fklfull emits the same key set (cos_to_d exists for every FI mode; for fklfull it is 1 to rounding)",
+      set(fk) == set(fm) and fk["paper/fi_cos_to_d_min"] >= 0.9999, f"({fk['paper/fi_cos_to_d_min']:.12f})")
+
+# ------------------------------------------------------------------ (7) configuration, identity, stationary point
+c = cfg_of("fkldec")
+check("[cfg] fkldec: code 6, direction d, target g1, where dec, applied, fp64 on, floor 0",
+      (c["code"], c["dir"], c["tgt"], c["where"], c["apply"], c["fp64"], c["floor"])
+      == (6.0, "d", "g1", "dec", True, True, 0.0) and PAPER_FI_MODES["fkldec"] == (6, "d", "g1", "dec"))
+for fp64 in (1, 0):
+    o_i, _ = omega("fkldec", lp_s, lp_t, ROWS, PAPER_FI_IDENTITY=1, PAPER_FI_FP64=fp64)
+    o_k2, _ = omega("fklfull", lp_s, lp_t, PAPER_FI_FP64=fp64)
+    check(f"[identity fp64={fp64}] fkldec at its own norm is fklfull's field, bitwise", torch.equal(o_i, o_k2))
+o0, s0 = omega("fkldec", lp_s, lp_s.clone(), ROWS)
+check("[stationary] teacher == student: omega exactly 0 at every prefix (decision rows included), all counted zero",
+      bool((o0 == 0).all()) and bool((s0["zero"] == 1).all()) and all(bool(torch.isfinite(v).all()) for v in s0.values()))
+for k in FI_ENV:
+    os.environ.pop(k, None)
+for bad in ("fif", "fkl_dec", "FKLDEC"):
+    os.environ["PAPER_FI_MODE"] = bad
+    try:
+        paper_fi_cfg()
+        check(f"refused: PAPER_FI_MODE={bad}", False)
+    except ValueError as e:
+        check(f"refused: PAPER_FI_MODE={bad}", True, f"({e})")
+os.environ.pop("PAPER_FI_MODE", None)
+
+print(f"\n{sum(RES)} passed, {len(RES) - sum(RES)} failed")
+sys.exit(0 if all(RES) else 1)
diff --git a/verl/tests/erropd/test_esci.py b/verl/tests/erropd/test_esci.py
new file mode 100644
index 0000000..346a93a
--- /dev/null
+++ b/verl/tests/erropd/test_esci.py
@@ -0,0 +1,139 @@
+"""ESCI (product_id lists) support: verbatim parser, locator vs parser, token classes incl. T, hook path.
+
+  PYTHONPATH=<snapshot>/verl ERROPD_TOKENIZER=<Qwen3 tokenizer dir> ERROPD_ESCI_EVAL=<scripts/eval_esci_listwise_offline.py>
+  ERROPD_F3_DATA=<data/esci_k8_f3/k1_f20_x5.jsonl> python test_esci.py
+"""
+import ast
+import inspect
+import json
+import os
+import sys
+import tempfile
+
+import numpy as np
+import torch
+from omegaconf import OmegaConf
+from transformers import AutoTokenizer
+
+from verl import DataProto
+from verl.erropd import esci_contract
+from verl.erropd import listwise_contract as lc
+from verl.erropd.hooks import ErropdHooks, TokenSpanDecoder
+
+RES = []
+
+
+def check(name, cond, detail=""):
+    RES.append(bool(cond))
+    print(f"{'PASS' if cond else 'FAIL'}  {name} {detail}", flush=True)
+
+
+# 1. verbatim ESCI parser
+src = open(os.environ["ERROPD_ESCI_EVAL"]).read()
+fn = [n for n in ast.parse(src).body if isinstance(n, ast.FunctionDef) and n.name == "parse_score_list"][0]
+check("ESCI parse_score_list is byte-identical to scripts/eval_esci_listwise_offline.py",
+      inspect.getsource(esci_contract.parse_score_list).rstrip() == ast.get_source_segment(src, fn).rstrip())
+
+# 2. locator vs parser + classes on the F3 injected SFT targets (clean and one-item-short)
+tok = AutoTokenizer.from_pretrained(os.environ["ERROPD_TOKENIZER"])
+dec = TokenSpanDecoder(tok)
+EOS = tok.eos_token_id
+rows = [json.loads(l) for l in open(os.environ["ERROPD_F3_DATA"])]
+agree = n_valid = n_k1 = n_other = 0
+bad_t = 0
+t_pieces = {}
+k1_viol_T = 0
+for r in rows:
+    tgt = [m for m in r["messages"] if m["role"] == "assistant"][0]["content"]
+    text = tgt.split("</think>", 1)[1].lstrip("\n") if "</think>" in tgt else tgt  # rollout response = JSON part
+    md = r["metadata"]
+    K, pids = int(md["K"]), [str(x) for x in md["product_ids"]]
+    p = lc.strict_valid(text, K, pids, "esci")
+    st, ci, vt = lc.locate_first_violation(text, K, pids, "product_id")
+    agree += (p and st == lc.VALID) or (not p and st != lc.VALID)
+    n_valid += p
+    n_k1 += vt == lc.V_PREMATURE_CLOSE
+    n_other += (not p) and vt != lc.V_PREMATURE_CLOSE
+    ids = tok(text, add_special_tokens=False)["input_ids"] + [EOS]
+    t, spans = dec.decode(ids)
+    cls, _ = lc.token_classes_from_spans(t, spans, "product_id")
+    tpos = set(lc._term_positions(t))
+    must = {i for i, (a, b) in enumerate(spans) if any(a <= q < b for q in tpos)} | {len(ids) - 1}
+    got = {i for i, c in enumerate(cls) if c == lc.TERM}
+    bad_t += must != got
+    for i in got:
+        pc = t[spans[i][0]:spans[i][1]] if spans[i][1] > spans[i][0] else "<EOS>"
+        t_pieces[(pc, ids[i])] = t_pieces.get((pc, ids[i]), 0) + 1
+    if vt == lc.V_PREMATURE_CLOSE:
+        vtok = [i for i, (a, b) in enumerate(spans) if a <= ci < b][0]
+        k1_viol_T += cls[vtok] == lc.TERM
+check(f"F3 k1_f20 targets: locator == ESCI parser on all {len(rows)}", agree == len(rows),
+      f"(valid {n_valid}, one-item-short {n_k1}, other failures {n_other})")
+check("F3 k1_f20 targets: T tokens are exactly the tokens with an item-closing '}' / top-level ',' / list ']' + EOS",
+      bad_t == 0, f"(violations {bad_t}); T pieces (piece, id): {dict(sorted(t_pieces.items(), key=lambda x: -x[1])[:8])}")
+check("F3 one-item-short targets: the violating token is T", k1_viol_T == n_k1, f"({k1_viol_T}/{n_k1})")
+ex = [json.loads(l) for l in open(os.environ["ERROPD_F3_DATA"])][0]
+text0 = [m for m in ex["messages"] if m["role"] == "assistant"][0]["content"]
+text0 = text0.split("</think>", 1)[1].lstrip("\n") if "</think>" in text0 else text0
+ids0 = tok(text0, add_special_tokens=False)["input_ids"] + [EOS]
+t0, sp0 = dec.decode(ids0)
+c0, _ = lc.token_classes_from_spans(t0, sp0, "product_id")
+arr = json.loads(t0[t0.index("["):t0.rindex("]") + 1])
+id_chars = "".join(t0[a:b] for (a, b), c in zip(sp0, c0) if c == lc.ID)
+check("ESCI id-class tokens spell exactly the product_id values", id_chars == "".join(o["product_id"] for o in arr),
+      f"(first id tokens {[t0[a:b] for (a, b), c in zip(sp0, c0) if c == lc.ID][:6]})")
+
+# 3. hook path on an ESCI batch (extra_info with product_ids): validity, T lambda, masks, dump keys
+cases = []
+for r in rows[:64]:
+    tgt = [m for m in r["messages"] if m["role"] == "assistant"][0]["content"]
+    text = tgt.split("</think>", 1)[1].lstrip("\n") if "</think>" in tgt else tgt
+    cases.append((text, r["metadata"]))
+ids = [tok(t, add_special_tokens=False)["input_ids"] + [EOS] for t, _ in cases]
+L = max(len(x) for x in ids) + 2
+bs = len(cases)
+resp = torch.full((bs, L), tok.pad_token_id or EOS, dtype=torch.long)
+mask = torch.zeros(bs, L)
+for i, x in enumerate(ids):
+    resp[i, :len(x)] = torch.tensor(x)
+    mask[i, :len(x)] = 1
+g = torch.Generator().manual_seed(0)
+d = {"responses": resp, "response_mask": mask, "old_log_probs": -torch.rand(bs, L, generator=g),
+     "ref_log_prob": -torch.rand(bs, L, generator=g), "base_log_prob": -torch.rand(bs, L, generator=g),
+     "advantages": torch.zeros(bs, L)}
+extra = np.array([{"K": md["K"], "product_ids": md["product_ids"], "index": i} for i, (_, md) in enumerate(cases)],
+                 dtype=object)
+cfg = lambda n: OmegaConf.create({  # noqa: E731
+    "actor_rollout_ref": {"actor": {"policy_loss": {"lambda_vals": 1.4, "only_reverse_kl_advantages": True,
+                                                    "multi_teacher_distill": False},
+                                    "ppo_epochs": 1, "ppo_micro_batch_size_per_gpu": 2, "use_dynamic_bsz": False}},
+    "trainer": {"default_local_dir": tempfile.mkdtemp(), "n_gpus_per_node": 2, "nnodes": 1}, "erropd": n})
+dp = DataProto.from_single_dict({**{k: v.clone() for k, v in d.items()}, "extra_info": extra})
+m = {}
+h = ErropdHooks(cfg({"token_class_lambda": "only_term", "dump_rollouts": True}), tok)
+h.on_batch(dp, 1, m)
+exp_valid = np.mean([lc.strict_valid(t, int(md["K"]), md["product_ids"], "esci") for t, md in cases])
+check("ESCI hook: logged validity == ESCI parser", abs(m["erropd/rollout_valid_frac_sampled"] - exp_valid) < 1e-12,
+      f"({m['erropd/rollout_valid_frac_sampled']:.4f})")
+cls_t, recs, _, _, _ = h.analyze(dp)
+tl = dp.batch["erropd_token_lambda"]
+check("ESCI hook: T-only lambda tensor is 1.4 exactly on T tokens",
+      torch.equal(tl, torch.where((cls_t == lc.TERM) & (mask > 0), torch.full_like(tl, 1.4), torch.ones_like(tl))))
+check("ESCI hook: records carry task=esci and product_ids", all(r["task"] == "esci" and "product_ids" in r for r in recs))
+dump = [json.loads(l) for l in open(os.path.join(h.log_dir, "erropd_rollouts.jsonl"))]
+check("ESCI hook: rollout dump has product_ids and one-item-short labels",
+      all("product_ids" in r for r in dump) and any(r["vtype"] == "premature_close" for r in dump),
+      f"({sum(r['vtype'] == 'premature_close' for r in dump)} of {len(dump)} one-item-short)")
+for mode in ("invalid_rollout", "from_violation"):
+    dp2 = DataProto.from_single_dict({**{k: v.clone() for k, v in d.items()}, "extra_info": extra})
+    ErropdHooks(cfg({"mask": mode}), tok).on_batch(dp2, 1, {})
+    lm = dp2.batch["erropd_loss_mask"]
+    ok = True
+    for i, r in enumerate(recs):
+        if mode == "invalid_rollout":
+            ok &= bool((lm[i] == (1.0 if r["valid"] else 0.0)).all())
+        elif r["status"] == lc.VIOLATION:
+            ok &= bool((lm[i, :r["viol_tok"]] == 1).all()) and bool((lm[i, r["viol_tok"]:] == 0).all())
+    check(f"ESCI hook: mask {mode} exact", ok)
+print(f"\n{sum(RES)} passed, {len(RES) - sum(RES)} failed")
+sys.exit(0 if all(RES) else 1)
diff --git a/verl/tests/erropd/test_fi.py b/verl/tests/erropd/test_fi.py
new file mode 100644
index 0000000..05b73f8
--- /dev/null
+++ b/verl/tests/erropd/test_fi.py
@@ -0,0 +1,426 @@
+"""PAPER factor isolation (FI) on the full-vocabulary arm: the maths of the four modes (CPU, no GPU, no Ray).
+
+  PYTHONPATH=<tree>/verl python test_fi.py
+
+Notation: per prefix, l = log pi_S, m = log pi_T over the vocabulary, p = e^l, q = e^m, r = l - m - sum_v p (l - m),
+g1 = p (.) r (the full-vocabulary reverse KL's logit gradient), d = p - q (the full-vocabulary forward KL's).
+Modes: fir = g1 at ||d|| at every prefix (FI-R); fis = the same at the item-k decision states only, g1 elsewhere
+(FI-S); fklfull = d; fkldec = d at ||g1|| at the item-k decision states only, d elsewhere (E1, the mirror of fis);
+ctl = the untouched rkl_full step (FI diagnostics only). fkldec's own properties are in test_e1.py.
+
+(1)  omega is what each mode says, against an INDEPENDENT derivation: g1 and d as float64 autograd gradients of the two
+     objectives themselves (sum_v p (l - m) and sum_v q (m - l)), not the closed form.
+(2)  The surrogate sum_v omega_v l_v (omega detached, token-mean) has logit gradient exactly omega / N in every mode,
+     because both g1 and d sum to zero over the vocabulary.
+(3)  fklfull's applied gradient equals autograd of the full-vocabulary forward-KL loss, in the actor's own fp32
+     numerics and in float64; fir's applied gradient has the reverse KL's direction and the forward KL's norm; at a
+     two-token decision the two directions are collinear and the factor has its closed form.
+(4)  The identity switch: fir at its own norm is rkl_full's field (fp32 arithmetic: bitwise the alpha gate's alpha=1
+     field, whose surrogate reproduces rkl_full's update); fis at its own norm is fir's, bitwise; ctl's (unapplied)
+     field is fir-identity's, bitwise.
+(5)  Stationary point: teacher == student gives omega == 0 exactly in every mode; elsewhere omega != 0 at every prefix.
+(6)  Per-prefix norms: ||omega|| equals the mode's target norm; the logged realised norm, applied direction and
+     zero-sum residual (the lock's N1 diagnostics) are what they claim.
+(7)  Chunk invariance: chunk 1 and one-shot give bitwise identical omega and statistics.
+(8)  The floor and the zero-norm rule: prefixes below the floor keep scale exactly 1; floor 0 never binds; a prefix
+     with ||g1|| = 0 exactly keeps omega = 0 with scale 1 and is counted, with no overflow anywhere.
+(9)  FI-S: only the rows of its mask are rescaled, the rest are rkl_full's field bitwise; and the state-defined
+     item-k decision mask contains the closing row (the error itself), unlike the alpha gate's outcome-defined slot.
+(10) Numerical stability at a near-deterministic prefix over the real 151,936-token vocabulary, and the lock's
+     provoked states (an item-7-like decision with p(err) = 10^-k, k = 6..14): fp32 p - q is unreliable, the float64
+     build recovers d and FI-R's applied field (cosine to g1 >= 0.9999 at every k), and without it FI-R's per-prefix
+     norm is wrong.
+(11) The configuration surface and its refusals.
+"""
+import math
+import os
+import sys
+
+import torch
+
+import verl.utils.torch_functional as vtf
+from verl.trainer.ppo.core_algos import agg_loss
+from verl.workers.actor.dp_actor import DataParallelPPOActor as A
+from verl.workers.actor.dp_actor import PAPER_FI_MODES, paper_fi_cfg
+
+vtf.FLAH_ATTN_CROSS_ENTROPY_LOSS_AVAILABLE = False
+RES = []
+MODES = ("fir", "fis", "fklfull", "fkldec", "ctl")
+FI_ENV = ("PAPER_FI_MODE", "PAPER_FI_FP64", "PAPER_FI_IDENTITY", "PAPER_FI_FLOOR", "PAPER_FI_CHUNK", "PAPER_FI_DOSE",
+          "PAPER_ALPHA_POSTSTEP", "PAPER_ALPHA_ERR_TOKEN", "PAPER_ALPHA_BOUNDARY_TOKEN", "PAPER_ALPHA_ERR_SLOT")
+
+
+def cosd(a, b, dim=-1):
+    """cosine in float64 with no norm floor (torch's cosine_similarity clamps each norm at 1e-8, which is above the
+    per-prefix norms of a near-deterministic prefix)"""
+    a, b = a.double(), b.double()
+    return (a * b).sum(dim) / (a.norm(dim=dim) * b.norm(dim=dim))
+
+
+def check(name, cond, detail=""):
+    RES.append(bool(cond))
+    print(f"{'PASS' if cond else 'FAIL'}  {name} {detail}", flush=True)
+
+
+def cfg_of(mode, **env):
+    for k in FI_ENV:
+        os.environ.pop(k, None)
+    os.environ["PAPER_FI_MODE"] = mode
+    for k, v in env.items():
+        os.environ[k] = str(v)
+    try:
+        return paper_fi_cfg()
+    finally:
+        for k in FI_ENV:
+            os.environ.pop(k, None)
+
+
+def ref_fields(lp_s, lp_t):
+    """INDEPENDENT g1 and d: float64 autograd of the two objectives w.r.t. logits z = lp_s (log_softmax renormalises)."""
+    z = lp_s.detach().double().clone().requires_grad_(True)
+    m = torch.log_softmax(lp_t.detach().double(), -1)
+    l = torch.log_softmax(z, -1)
+    (g1,) = torch.autograd.grad((l.exp() * (l - m)).sum(), z)
+    z2 = lp_s.detach().double().clone().requires_grad_(True)
+    (d,) = torch.autograd.grad((m.exp() * (m - torch.log_softmax(z2, -1))).sum(), z2)
+    return g1, d
+
+
+def want_omega(mode, g1, d, rows=None, identity=False):
+    n1, nd = g1.norm(dim=-1, keepdim=True), d.norm(dim=-1, keepdim=True)
+    if mode == "ctl" or (identity and mode in ("fir", "fis")):
+        return g1
+    if mode == "fir":
+        return g1 * nd / n1
+    if mode == "fis":
+        return torch.where(rows.unsqueeze(-1), g1 * nd / n1, g1)
+    if mode == "fkldec" and not identity:
+        return torch.where(rows.unsqueeze(-1), d * n1 / nd, d)
+    return d
+
+
+def states(seed=11, n=5, V=64):
+    """n random (student, teacher) states, one of them near-deterministic like a JSON-ranking prefix."""
+    g = torch.Generator().manual_seed(seed)
+    zs = 3.0 * torch.randn(n, V, generator=g)
+    zt = 3.0 * torch.randn(n, V, generator=g)
+    zs[0] *= 6.0
+    zt[0, 7] = zs[0].max() - 1.4  # the teacher likes token 7, which the peaked student does not
+    return torch.log_softmax(zs.float(), -1).view(1, n, V), torch.log_softmax(zt.float(), -1).view(1, n, V)
+
+
+def omega(mode, s, t, rows=None, err_token=7, **env):
+    c = cfg_of(mode, **env)
+    return A._paper_fi_omega(s, t, c, err_token=err_token, rescale_rows=(rows if c["where"] == "dec" else None))
+
+
+lp_s, lp_t = states()
+V = lp_s.shape[-1]
+ROWS = torch.tensor([[True, False, True, False, False]])  # FI-S's rows in the unit tests
+g1_ref, d_ref = ref_fields(lp_s, lp_t)
+
+# ------------------------------------------------------------------ (1) omega against the independent derivation
+for mode in MODES:
+    for fp64 in (1, 0):
+        om, st = omega(mode, lp_s, lp_t, ROWS, PAPER_FI_FP64=fp64)
+        want = want_omega(mode, g1_ref, d_ref, ROWS[0])
+        rel = ((om.double() - want).abs().max() / want.abs().max()).item()
+        bar = 1e-6 if fp64 else 1e-4
+        check(f"[{mode} fp64={fp64}] omega == the mode's field built from float64 autograd of the two objectives",
+              rel < bar, f"(max rel diff {rel:.2e}, bar {bar:g})")
+        zs = (st["zsum"] / st["l1"]).max().item()
+        # fp32 arithmetic inherits the residual of rkl_full's own expression p*r (the alpha gate's bar, 1e-4; on the
+        # GPU at alpha = 1 it reached 4e-2); the float64 build is centred to float64 and only cast
+        zbar = 1e-6 if fp64 else 1e-4
+        check(f"[{mode} fp64={fp64}] sum_v omega[v] == 0 to fp32 (relative to ||omega||_1, bar {zbar:g})", zs < zbar,
+              f"(max {zs:.2e})")
+        rat = (st["ratio"].double() - (d_ref.norm(dim=-1) / g1_ref.norm(dim=-1))).abs().max().item()
+        check(f"[{mode} fp64={fp64}] the logged ratio is ||d|| / ||g1|| (max abs diff {rat:.2e})",
+              rat < 1e-4 * float((d_ref.norm(dim=-1) / g1_ref.norm(dim=-1)).max()))
+
+# ------------------------------------------------------------------ (2) the surrogate's logit gradient is omega / N
+for mode in MODES:
+    z = (3.0 * torch.randn(1, 4, V, generator=torch.Generator().manual_seed(5))).requires_grad_(True)
+    s = torch.log_softmax(z, -1)
+    t = torch.log_softmax(3.0 * torch.randn(1, 4, V, generator=torch.Generator().manual_seed(6)), -1)
+    om, _ = omega(mode, s, t, torch.tensor([[True, False, False, True]]))
+    mask = torch.ones(1, 4)
+    loss = agg_loss(loss_mat=(om * s).sum(-1), loss_mask=mask, loss_agg_mode="token-mean")
+    (g,) = torch.autograd.grad(loss, z)
+    want = om / mask.sum()
+    rel = ((g - want).abs().max() / want.abs().max()).item()
+    check(f"[{mode}] d/dlogit of the surrogate == omega / N_masked", rel < 1e-5, f"(max rel diff {rel:.2e})")
+
+# ------------------------------------------------------------------ (3) fklfull is the forward KL; fir's geometry
+z = (3.0 * torch.randn(1, 4, V, generator=torch.Generator().manual_seed(7))).requires_grad_(True)
+s = torch.log_softmax(z, -1)
+t = torch.log_softmax(3.0 * torch.randn(1, 4, V, generator=torch.Generator().manual_seed(8)), -1)
+mask = torch.ones(1, 4)
+fkl_loss = agg_loss(loss_mat=(t.exp() * (t - s)).sum(-1), loss_mask=mask, loss_agg_mode="token-mean")
+(g_fkl,) = torch.autograd.grad(fkl_loss, z, retain_graph=True)
+om, st = omega("fklfull", s, t)
+surr = agg_loss(loss_mat=(om * s).sum(-1), loss_mask=mask, loss_agg_mode="token-mean")
+(g_surr,) = torch.autograd.grad(surr, z)
+rel = ((g_surr - g_fkl).abs().max() / g_fkl.abs().max()).item()
+check("[fklfull] the surrogate's gradient == autograd of the full-vocabulary forward-KL loss sum_v q (m - l), in the "
+      "actor's fp32 numerics", rel < 1e-5, f"(max rel diff {rel:.2e})")
+zz = z.detach().double().requires_grad_(True)
+(g64,) = torch.autograd.grad(agg_loss(loss_mat=(t.double().exp() * (t.double() - torch.log_softmax(zz, -1))).sum(-1),
+                                      loss_mask=mask.double(), loss_agg_mode="token-mean"), zz)
+rel = ((g_surr.double() - g64).abs().max() / g64.abs().max()).item()
+check("[fklfull] ... and in float64", rel < 1e-6, f"(max rel diff {rel:.2e})")
+fkl_rel = ((st["fkl"].double() - (t.double().exp() * (t.double() - s.detach().double())).sum(-1)).abs().max()).item()
+check("[fklfull] the logged per-prefix forward KL is sum_v q (m - l)", fkl_rel < 1e-5, f"(max abs diff {fkl_rel:.2e})")
+g1r, dr = ref_fields(s, t)
+om_r, st_r = omega("fir", s, t)
+cosr = cosd(om_r.double(), g1r, dim=-1).min().item()
+nrel = ((om_r.double().norm(dim=-1) - dr.norm(dim=-1)).abs() / dr.norm(dim=-1)).max().item()
+check("[fir] the applied field has the reverse KL's direction (cos to autograd of sum p (l - m) >= 1 - 1e-9) and the "
+      "forward KL's per-prefix norm (to 1e-6)", cosr >= 1 - 1e-9 and nrel < 1e-6, f"(min cos {cosr:.12f}, norm rel {nrel:.1e})")
+# at a binary decision the two directions are collinear (both along e_1 - e_2): the only thing FI changes there is size
+zb = torch.full((1, 1, V), -1e4)
+zb[0, 0, 0], zb[0, 0, 1] = 0.0, -12.0           # student: p(err) ~ 6e-6
+tb = torch.full((1, 1, V), -1e4)
+tb[0, 0, 0], tb[0, 0, 1] = 0.0, -1.4            # teacher: q(err) ~ 0.2
+lsb, ltb = torch.log_softmax(zb, -1), torch.log_softmax(tb, -1)
+g1b, db = ref_fields(lsb, ltb)
+cb = cosd(g1b, db, dim=-1).item()
+_, stb = omega("fir", lsb, ltb)
+pe = math.exp(-12.0) / (1 + math.exp(-12.0))
+qe = math.exp(-1.4) / (1 + math.exp(-1.4))
+want_ratio = abs(pe - qe) / (pe * (1 - pe) * abs(math.log(pe / (1 - pe)) - math.log(qe / (1 - qe))))
+check("[binary decision] g1 and d are collinear (cos = 1) and the FI-R factor is |p - q| / (p(1-p)|logit p - logit q|)",
+      cb > 1 - 1e-9 and abs(float(stb["ratio"]) / want_ratio - 1) < 1e-4,
+      f"(cos {cb:.12f}; ratio {float(stb['ratio']):.1f} vs closed form {want_ratio:.1f})")
+
+# ------------------------------------------------------------------ (4) the identity switch
+for fp64 in (1, 0):
+    om_id, st_id = omega("fir", lp_s, lp_t, PAPER_FI_IDENTITY=1, PAPER_FI_FP64=fp64)
+    check(f"[fir identity fp64={fp64}] the scale is exactly 1.0 at every prefix", bool((st_id["scale"] == 1.0).all()))
+    om_si, _ = omega("fis", lp_s, lp_t, ROWS, PAPER_FI_IDENTITY=1, PAPER_FI_FP64=fp64)
+    check(f"[fis identity fp64={fp64}] fis at its own norm is fir's identity field, bitwise", torch.equal(om_si, om_id))
+    om_c, _ = omega("ctl", lp_s, lp_t, PAPER_FI_FP64=fp64)
+    check(f"[ctl fp64={fp64}] ctl's (unapplied) field is fir-identity's, bitwise", torch.equal(om_c, om_id))
+om_id32, _ = omega("fir", lp_s, lp_t, PAPER_FI_IDENTITY=1, PAPER_FI_FP64=0)
+om_a1, _ = A._paper_alpha_omega(lp_s, lp_t, 1.0, False, err_token=7)
+check("[fir identity fp64=0] omega is bitwise the alpha gate's alpha=1 field p*r (whose surrogate reproduces rkl_full's "
+      "update; smoke_alpha.md)", torch.equal(om_id32, om_a1))
+om_id64, _ = omega("fir", lp_s, lp_t, PAPER_FI_IDENTITY=1)
+rel = ((om_id64 - om_a1).abs().max() / om_a1.abs().max()).item()
+check("[fir identity fp64=1] omega equals that field to fp32 rounding (the float64 build differs only below it here)",
+      rel < 1e-5, f"(max rel diff {rel:.2e})")
+
+# ------------------------------------------------------------------ (5) stationary point
+for mode in MODES:
+    om, st = omega(mode, lp_s, lp_s.clone(), ROWS)
+    check(f"[{mode}] teacher == student: omega is exactly 0 (rkl_full's stationary point), and every prefix is counted "
+          f"as zero-norm", bool((om == 0).all()) and bool((st["zero"] == 1).all()),
+          f"(max |omega| {om.abs().max().item():.2e})")
+    om2, _ = omega(mode, lp_s, lp_t, ROWS)
+    check(f"[{mode}] teacher != student: omega != 0 at every prefix (no new zeros)", bool((om2.abs().sum(-1) > 0).all()))
+
+# ------------------------------------------------------------------ (6) per-prefix norms and the N1 diagnostics
+for mode in MODES:
+    om, st = omega(mode, lp_s, lp_t, ROWS)
+    tgt = want_omega(mode, g1_ref, d_ref, ROWS[0]).norm(dim=-1)
+    rel = ((om.double().norm(dim=-1) - tgt).abs() / tgt).max().item()
+    check(f"[{mode}] ||omega||_2 per prefix == the target norm", rel < 1e-6, f"(max rel diff {rel:.2e})")
+    # the logged realised norm and direction are of the gradient the surrogate applies, a = omega - p sum_v omega
+    p = lp_s.double().exp()
+    a = om.double() - p * om.double().sum(-1, keepdim=True)
+    e1 = ((st["n_app"].double() - a.norm(dim=-1)).abs() / a.norm(dim=-1)).max().item()
+    e2 = (st["cos_g1"].double() - cosd(a, g1_ref)).abs().max().item()
+    e3 = ((st["n_want"].double() - tgt).abs() / tgt).max().item()
+    check(f"[{mode}] logged n_app == ||omega - p sum omega||, cos_g1 == its cosine to g1, n_want == the target "
+          f"(max errors {e1:.1e}, {e2:.1e}, {e3:.1e})", e1 < 1e-6 and e2 < 1e-7 and e3 < 1e-6)
+    if mode in ("fir", "fis", "ctl"):
+        check(f"[{mode}] applied direction against g1: min cos {float(st['cos_g1'].min()):.12f} >= 0.9999 (lock N1)",
+              float(st["cos_g1"].min()) >= 0.9999)
+    else:
+        e4 = (st["cos_d"].double() - cosd(a, d_ref)).abs().max().item()
+        check(f"[{mode}] logged cos_d == the applied gradient's cosine to d ({e4:.1e}), and min cos "
+              f"{float(st['cos_d'].min()):.12f} >= 0.9999 (the d modes' N1)", e4 < 1e-7 and float(st["cos_d"].min()) >= 0.9999)
+
+# ------------------------------------------------------------------ (7) chunk invariance
+for mode in MODES:
+    for fp64 in (1, 0):
+        o1, s1 = omega(mode, lp_s, lp_t, ROWS, PAPER_FI_FP64=fp64, PAPER_FI_CHUNK=1)
+        oa, sa = omega(mode, lp_s, lp_t, ROWS, PAPER_FI_FP64=fp64, PAPER_FI_CHUNK=10 ** 6)
+        same = torch.equal(o1, oa) and all(torch.equal(s1[k], sa[k]) for k in s1)
+        check(f"[{mode} fp64={fp64}] chunk=1 and one-shot give bitwise identical omega and statistics", same)
+
+# ------------------------------------------------------------------ (8) the floor and the zero-norm rule
+n1 = g1_ref.norm(dim=-1)[0]
+_v = n1.sort().values
+fl = float(0.5 * (_v[1] + _v[2]))  # midway between the 2nd and 3rd smallest ||g1||: exactly two prefixes below it
+om, st = omega("fir", lp_s, lp_t, PAPER_FI_FLOOR=fl)
+hit = st["floor"][0].bool()
+om0, _ = omega("fir", lp_s, lp_t, PAPER_FI_IDENTITY=1)
+omr, _ = omega("fir", lp_s, lp_t)
+check("[fir floor] exactly the prefixes with ||g1|| < floor are at the floor, with scale exactly 1 and omega == g1",
+      int(hit.sum()) == 2 and bool((st["scale"][0][hit] == 1.0).all()) and torch.equal(om[0][hit], om0[0][hit])
+      and torch.equal(om[0][~hit], omr[0][~hit]), f"(floor {fl:.3e}; {int(hit.sum())} of {hit.numel()} at the floor)")
+_, st0 = omega("fir", lp_s, lp_t)
+check("[fir floor] floor 0 (the default) never binds", float(st0["floor"].sum()) == 0.0)
+_, stf = omega("fklfull", lp_s, lp_t, PAPER_FI_FLOOR=1e9)
+check("[fklfull floor] a mode with nothing to rescale reports no floor hits", float(stf["floor"].sum()) == 0.0)
+lz_t = lp_t.clone()
+lz_t[0, 3] = lp_s[0, 3]  # prefix 3: teacher == student exactly, so ||g1|| = ||d|| = 0 there
+for mode in MODES:
+    om, st = omega(mode, lp_s, lz_t, ROWS)
+    ok = (bool((om[0, 3] == 0).all()) and float(st["zero"][0, 3]) == 1.0 and float(st["scale"][0, 3]) == 1.0
+          and float(st["zero"].sum()) == 1.0 and all(bool(torch.isfinite(v).all()) for v in st.values()))
+    check(f"[{mode}] a prefix with ||g1|| = 0 exactly: omega 0, scale 1, counted once, every statistic finite", ok)
+
+# ------------------------------------------------------------------ (9) FI-S and the state-defined decision mask
+om_s, st_s = omega("fis", lp_s, lp_t, ROWS)
+om_r, _ = omega("fir", lp_s, lp_t)
+om_i, _ = omega("fir", lp_s, lp_t, PAPER_FI_IDENTITY=1)
+r_ = ROWS[0]
+check("[fis] rescaled exactly at its mask rows (== fir there, bitwise) and rkl_full's field elsewhere (== fir-identity, "
+      "bitwise), with scale 1 off the mask",
+      torch.equal(om_s[0][r_], om_r[0][r_]) and torch.equal(om_s[0][~r_], om_i[0][~r_])
+      and bool((st_s["scale"][0][~r_] == 1.0).all()) and bool((st_s["scale"][0][r_] != 1.0).all()))
+CONT, ERR, EOS, X = 2137, 25439, 151645, 11
+# row 0: continues at item 7 and closes at item 8 (canonical K = 8); row 1: closes at item 7 (the injected error);
+# row 2: closes at item 3 (never reaches item 7); row 3: K = 9 (continues at items 7 and 8); row 4: masked out after
+# item 6, so the 7th item end is not a response position
+rows = [[X, CONT] * 7 + [X, ERR, EOS],
+        [X, CONT] * 6 + [X, ERR, EOS] + [0, 0],
+        [X, CONT] * 2 + [X, ERR, EOS] + [0] * 10,
+        [X, CONT] * 8 + [X],
+        [X, CONT] * 7 + [X, ERR, EOS]]
+resp = torch.tensor(rows)
+rmask = torch.ones_like(resp, dtype=torch.float32)
+rmask[1, 15:] = 0
+rmask[2, 7:] = 0
+rmask[4, 12:] = 0
+dec = A._paper_fi_dec_mask(resp, rmask, (CONT, ERR), 7)
+old = A._paper_alpha_masks(resp, rmask, CONT, 7)["slot"]
+pos = [(i, j) for i, j in dec.nonzero().tolist()]
+check("[dec mask] the item-7 decision of a row that CLOSES at item 7 (the error) is in the state-defined mask, and is "
+      "not in the alpha gate's outcome-defined slot",
+      bool(dec[1, 13]) and not bool(old[1].any()) and int(resp[1, 13]) == ERR, f"(dec positions {pos})")
+check("[dec mask] where the row continues at item 7 the two masks mark the same position",
+      bool(dec[0, 13]) and bool(old[0, 13]) and bool(dec[3, 13]) and bool(old[3, 13]))
+check("[dec mask] a row that never reaches item 7, and a row whose 7th item end is masked out, have no decision state",
+      not bool(dec[2].any()) and not bool(dec[4].any()))
+check("[dec mask] exactly one position per row that reaches item 7 (rows 0, 1, 3)", pos == [(0, 13), (1, 13), (3, 13)])
+_m = A._paper_fi_metrics(cfg_of("fis"), {k: torch.zeros(resp.shape) for k in st_s}, {"all": rmask.bool(), "dec": dec},
+                         resp)
+check("[dec mask] the per-step count of decision states that sampled the close is logged (1 here)",
+      _m.get("paper/fi_n_close_dec") == 1.0 and _m.get("paper/fi_n_dec") == 3.0, f"({_m.get('paper/fi_n_close_dec')})")
+
+# ------------------------------------------------------------------ (10) numerical stability on the real vocabulary
+VV = 151936
+g = torch.Generator().manual_seed(3)
+tail = 2.0 * torch.randn(VV, generator=g)
+zs9 = tail.clone()
+zs9[100] = 32.0                                   # tail mass ~1e-8: fp32 rounds l_top to 0 and p_top to 1
+zt9 = tail + 0.3 * torch.randn(VV, generator=g)   # a teacher that agrees on the top token and differs in the tail
+zt9[100] = 32.0
+zs9, zt9 = zs9.bfloat16().float(), zt9.bfloat16().float()  # bf16 logits, as in training
+s9 = torch.log_softmax(zs9, -1).view(1, 1, VV)
+t9 = torch.log_softmax(zt9, -1).view(1, 1, VV)
+l64, m64 = torch.log_softmax(zs9.double(), -1), torch.log_softmax(zt9.double(), -1)  # from the logits themselves
+p64, q64 = l64.exp(), m64.exp()
+r64 = (l64 - m64) - (p64 * (l64 - m64)).sum()
+g1_true, d_true = p64 * r64, p64 - q64
+p32 = s9[0, 0].exp()
+d32 = p32 - t9[0, 0].exp()
+cos_d32 = cosd(d32.double(), d_true, dim=0).item()
+r32 = (s9[0, 0] - t9[0, 0])
+r32 = r32 - (p32 * r32).sum()
+cos_g32 = cosd((p32 * r32).double(), g1_true, dim=0).item()
+zg = zs9.clone().requires_grad_(True)
+sg = torch.log_softmax(zg, -1)
+(g_ag,) = torch.autograd.grad((sg.exp() * (sg - t9[0, 0])).sum(), zg)
+cos_ag = cosd(g_ag.double(), g1_true, dim=0).item()
+om64, st64 = omega("fklfull", s9, t9, err_token=None)
+cos_rem = cosd(om64[0, 0].double(), d_true, dim=0).item()
+print(f"      sharp prefix: ||g1|| {g1_true.norm():.3e}, ||d|| {d_true.norm():.3e}, p_top {float(p64[100]):.12f}; "
+      f"cos to the float64-from-logits field: fp32 p-q {cos_d32:.6f}, fp32 explicit p*r {cos_g32:.9f}, "
+      f"fp32 autograd of rkl_full {cos_ag:.6f}, float64 remedy p-q {cos_rem:.12f}")
+check("[stability] fp32 p - q is unreliable at a near-deterministic prefix (cos to the float64 field < 0.99): the risk "
+      "the remedy exists for", cos_d32 < 0.99, f"(cos {cos_d32:.6f})")
+check("[stability] the float64 remedy recovers d (1 - cos < 1e-9)", 1 - cos_rem < 1e-9, f"(1 - cos {1 - cos_rem:.2e})")
+check("[stability] the explicit centred fp32 p (.) r is direction-exact there (1 - cos < 1e-6)", 1 - cos_g32 < 1e-6,
+      f"(1 - cos {1 - cos_g32:.2e})")
+print(f"INFO  [stability] the fp32 AUTOGRAD gradient of the rkl_full loss (RX part D's applied field) at this prefix: "
+      f"cos {cos_ag:.6f} to the float64 field (the explicit centred p*r: {cos_g32:.12f})")
+omr64, str64 = omega("fir", s9, t9, err_token=None)
+want = g1_true * d_true.norm() / g1_true.norm()
+rel = ((omr64[0, 0].double() - want).norm() / want.norm()).item()
+rel32 = ((omega("fir", s9, t9, err_token=None, PAPER_FI_FP64=0)[0][0, 0].double() - want).norm() / want.norm()).item()
+check("[stability] FI-R's field with the remedy equals the float64-from-logits FI-R field (relative L2 error < 1e-6); "
+      "without it the per-prefix norm is wrong", rel < 1e-6 and rel32 > 1e-2,
+      f"(rel err {rel:.2e}; fp32 arithmetic: {rel32:.2e})")
+del om64, omr64
+# the lock's provoked states (4.2 (v)): a two-way decision on the real vocabulary, student p(err) = 10^-k with the rest
+# of its mass on the continue token and a tail, teacher q(err) ~ 0.2; FI-R's applied direction against g1 must keep
+# cos >= 0.9999 at every k, and the drive on the close-vs-continue log-odds is reported against FKL-full's
+worst, drives = 1.0, []
+for k in range(6, 15):
+    zs = tail.clone()
+    zs[100] = 30.0                                 # continue
+    zs[101] = 30.0 + math.log(10.0 ** -k)          # error at p ~ 10^-k
+    zt = tail + 0.3 * torch.randn(VV, generator=torch.Generator().manual_seed(k))
+    zt[100], zt[101] = 30.0, 30.0 - 1.4            # teacher q(err) ~ 0.2
+    zs, zt = zs.bfloat16().float(), zt.bfloat16().float()
+    ss, tt = torch.log_softmax(zs, -1).view(1, 1, VV), torch.log_softmax(zt, -1).view(1, 1, VV)
+    o, sk = omega("fir", ss, tt, err_token=101)
+    of, _ = omega("fklfull", ss, tt, err_token=101)
+    l_, m_ = torch.log_softmax(zs.double(), -1), torch.log_softmax(zt.double(), -1)
+    p_ = l_.exp()
+    g_ = p_ * ((l_ - m_) - (p_ * (l_ - m_)).sum())
+    a_ = o[0, 0].double() - p_ * o[0, 0].double().sum()
+    c_ = cosd(a_, g_, dim=0).item()
+    worst = min(worst, c_, float(sk["cos_g1"]))
+    drives.append((k, float(-(o[0, 0, 101] - o[0, 0, 100])) / float(-(of[0, 0, 101] - of[0, 0, 100]))))
+check("[stability, provoked] FI-R's applied direction keeps cos >= 0.9999 to the float64-from-logits g1 at p(err) = "
+      "10^-k, k = 6..14 (lock 4.3 item 6)", worst >= 0.9999, f"(worst {worst:.9f}; FI-R drive / FKL-full drive by k: "
+      f"{[(k, round(x, 3)) for k, x in drives]})")
+
+# ------------------------------------------------------------------ (11) configuration surface and refusals
+for k in FI_ENV:
+    os.environ.pop(k, None)
+check("paper_fi_cfg() is None when PAPER_FI_MODE is unset (default off)", paper_fi_cfg() is None)
+c = cfg_of("fir")
+check("defaults: fp64 on, identity off, floor 0, chunk 256, poststep first, applied, item 7 of {2137, 25439}",
+      c["fp64"] and not c["identity"] and c["floor"] == 0.0 and c["chunk"] == 256 and c["poststep"] == "first"
+      and c["apply"] and c["err_slot"] == 7 and (c["boundary_token"], c["err_token"]) == (2137, 25439), f"({c})")
+check("ctl does not apply the surrogate (cfg['apply'] is False); every other mode does",
+      cfg_of("ctl")["apply"] is False and all(cfg_of(m)["apply"] for m in ("fir", "fis", "fklfull", "fkldec")))
+check("only fis and fkldec rescale a subset of rows (where = 'dec'); the others rescale every row or none",
+      all(cfg_of(m)["where"] == "dec" for m in ("fis", "fkldec"))
+      and all(cfg_of(m)["where"] == "all" for m in ("fir", "fklfull", "ctl")))
+check("mode codes are distinct small integers (exact through reduce_metrics' mean), FI-F's retired 2 unused",
+      sorted(v[0] for v in PAPER_FI_MODES.values()) == [1, 3, 4, 5, 6, 7] and "fif" not in PAPER_FI_MODES
+      and PAPER_FI_MODES["fkldec"] == (6, "d", "g1", "dec") and PAPER_FI_MODES["rkldose"] == (7, "g1", "kg1", "dec"))
+for bad, env in (("unknown mode", {"PAPER_FI_MODE": "fir2"}), ("FI-F (dropped)", {"PAPER_FI_MODE": "fif"}),
+                 ("negative floor", {"PAPER_FI_FLOOR": "-1e-9"}),
+                 ("nan floor", {"PAPER_FI_FLOOR": "nan"}), ("inf floor", {"PAPER_FI_FLOOR": "inf"}),
+                 ("fp64 not 0/1", {"PAPER_FI_FP64": "true"}), ("identity not 0/1", {"PAPER_FI_IDENTITY": "yes"}),
+                 ("chunk 0", {"PAPER_FI_CHUNK": "0"}), ("bad poststep", {"PAPER_ALPHA_POSTSTEP": "sometimes"}),
+                 ("ctl with identity", {"PAPER_FI_MODE": "ctl", "PAPER_FI_IDENTITY": "1"}),
+                 ("item index 0", {"PAPER_ALPHA_ERR_SLOT": "0"}),
+                 ("error token == separator", {"PAPER_ALPHA_ERR_TOKEN": "2137"})):
+    for k in FI_ENV:
+        os.environ.pop(k, None)
+    os.environ["PAPER_FI_MODE"] = "fir"
+    os.environ.update(env)
+    try:
+        paper_fi_cfg()
+        check(f"refused: {bad}", False)
+    except ValueError as e:
+        check(f"refused: {bad}", True, f"({e})")
+for k in FI_ENV:
+    os.environ.pop(k, None)
+try:
+    omega("fir", lp_s, lp_t, err_token=V)
+    check("refused: an error token outside the vocabulary", False)
+except ValueError as e:
+    check("refused: an error token outside the vocabulary", True, f"({e})")
+
+print(f"\n{sum(RES)} passed, {len(RES) - sum(RES)} failed")
+sys.exit(0 if all(RES) else 1)
