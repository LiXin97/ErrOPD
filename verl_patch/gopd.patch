diff --git a/verl/tests/erropd/metrics_fix_compare.py b/verl/tests/erropd/metrics_fix_compare.py
new file mode 100644
index 0000000..98af3ea
--- /dev/null
+++ b/verl/tests/erropd/metrics_fix_compare.py
@@ -0,0 +1,76 @@
+"""The metrics-reduction fix does not touch training: compare equiv_harness outputs of 1701cf637e (the FI snapshot the
+FI_K / FI_R runs crashed on) and the fixed tree, run in the same interpreter on the same stored batch. Every scenario
+the harness has (opd, fkl_sampled, rkl_full, the 8 alpha-gate ones, every FI mode, the ERROPD interventions) must be
+bitwise identical: advantages, pg losses, log-probs, initial and updated parameters, and every per-micro-batch metric
+update_policy returned (keys, order, values). Then each scenario's metrics, gathered as two identical ranks through
+each tree's own DataProto.concat and reduce_metrics, must reduce to bitwise the same step metrics.
+Exit 1 on any failure.
+
+Usage: python metrics_fix_compare.py REF.pt NEW.pt REF_TREE NEW_TREE
+"""
+import copy
+import importlib.util
+import os
+import sys
+
+import numpy as np
+import torch
+
+old = torch.load(sys.argv[1], weights_only=False)
+new = torch.load(sys.argv[2], weights_only=False)
+RES = []
+
+
+def check(name, cond, detail=""):
+    RES.append(bool(cond))
+    print(f"{'PASS' if cond else 'FAIL'}  {name} {detail}", flush=True)
+
+
+def eq(a, b):
+    if isinstance(a, torch.Tensor) or isinstance(b, torch.Tensor):
+        return isinstance(a, torch.Tensor) and isinstance(b, torch.Tensor) and a.shape == b.shape and \
+            a.dtype == b.dtype and torch.equal(a, b)
+    if isinstance(a, dict) and isinstance(b, dict):
+        return list(a) == list(b) and all(eq(a[k], b[k]) for k in a)
+    if isinstance(a, (list, tuple)) and isinstance(b, (list, tuple)):
+        return len(a) == len(b) and all(eq(x, y) for x, y in zip(a, b))
+    if isinstance(a, float) and isinstance(b, float):
+        return np.float64(a).tobytes() == np.float64(b).tobytes()  # NaN-safe, sign-of-zero-safe
+    return type(a) is type(b) and a == b
+
+
+def load(name, path):
+    spec = importlib.util.spec_from_file_location(name, path)
+    mod = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(mod)
+    return mod
+
+
+trees = {}
+for tag, root in (("ref", sys.argv[3]), ("new", sys.argv[4])):
+    trees[tag] = (load(f"{tag}_utils", os.path.join(root, "verl/utils/metric/utils.py")),
+                  load(f"{tag}_proto", os.path.join(root, "verl/protocol.py")))
+
+check("same scenario set", sorted(old) == sorted(new), f"({len(new)} entries)")
+n_scen = 0
+for k in sorted(set(old) & set(new)):
+    a, b = old[k], new[k]
+    if not isinstance(a, dict):
+        check(f"{k}", eq(a, b))
+        continue
+    n_scen += 1
+    bad = [f for f in a if f not in b or not eq(a[f], b[f])]
+    check(f"{k}: every stored field bitwise ({', '.join(sorted(a))})", not bad and a.keys() == b.keys(),
+          f"differs: {bad}" if bad else "")
+    m = a.get("metrics")
+    if isinstance(m, dict) and m:
+        red = {}
+        for tag, (u, p) in trees.items():
+            d = p.DataProto.concat([p.DataProto(meta_info={"metrics": copy.deepcopy(m)}) for _ in range(2)])
+            red[tag] = u.reduce_metrics(d.meta_info["metrics"])
+        same = list(red["ref"]) == list(red["new"]) and all(
+            type(red["ref"][x]) is type(red["new"][x])
+            and np.asarray(red["ref"][x]).tobytes() == np.asarray(red["new"][x]).tobytes() for x in red["ref"])
+        check(f"{k}: step metrics through each tree's concat + reduce_metrics bitwise", same, f"({len(red['ref'])} keys)")
+print(f"\n{n_scen} scenarios; {sum(RES)} passed, {len(RES) - sum(RES)} failed")
+sys.exit(0 if all(RES) else 1)
