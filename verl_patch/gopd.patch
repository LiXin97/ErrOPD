+#!/bin/bash
+# G-OPD ExOPD reproduction: Qwen3-1.7B student, Qwen3-4B-Non-Thinking-RL-Math teacher
+# All paths point to shared disk (models + data already downloaded).
+
+set -eu
+
+export WANDB_API_KEY="${WANDB_API_KEY:-}"
+export WANDB_MODE="${WANDB_MODE:-offline}"
+export USED_MODEL=no_api
+
+REPO=/path/to/verl_trees/G-OPD
+DATA=/path/to/verl_trees/G-OPD-Training-Data
+MODELS=/path/to/models
+
+STUDENT=$MODELS/Qwen3-1.7B
+TEACHER=$MODELS/Qwen3-4B-Non-Thinking-RL-Math-Step500
+
+aime24_test_path=$DATA/AIME2024/test.parquet
+aime25_test_path=$DATA/AIME2025/test.parquet
+test_files="['$aime24_test_path', '$aime25_test_path']"
+
+CKPT_DIR=/path/to/verl_trees/G-OPD-checkpoints/Qwen3-1.7B-ExOPD-DeepMath
+mkdir -p "$CKPT_DIR"
+
+cd "$REPO"
+
+python3 -m verl.trainer.main_ppo \
+    algorithm.adv_estimator=grpo \
+    algorithm.rollout_correction.rollout_is=token \
+    algorithm.rollout_correction.rollout_is_threshold=5.0 \
+    algorithm.rollout_correction.rollout_rs=null \
+    algorithm.rollout_correction.bypass_mode=false \
+    actor_rollout_ref.rollout.calculate_log_probs=true \
+    data.train_files=$DATA/DeepMath-103K/train_filtered_level6.parquet \
+    data.val_files="$test_files" \
+    data.train_batch_size=1024 \
+    data.max_prompt_length=2048 \
+    data.max_response_length=16384 \
+    data.filter_overlong_prompts=True \
+    data.truncation='error' \
+    data.shuffle=True \
+    data.seed=42 \
+    data.return_raw_chat=True \
+    +data.apply_chat_template_kwargs.enable_thinking=False \
+    actor_rollout_ref.model.path=$STUDENT \
+    +actor_rollout_ref.model.base_model_path=$STUDENT \
+    +actor_rollout_ref.ref.model.path=$TEACHER \
+    +actor_rollout_ref.ref.model.base_model_path=$STUDENT \
+    actor_rollout_ref.actor.optim.lr=1e-5 \
+    actor_rollout_ref.actor.optim.lr_warmup_steps_ratio=0.0 \
+    actor_rollout_ref.model.use_remove_padding=True \
+    actor_rollout_ref.actor.policy_loss.only_reverse_kl_advantages=True \
+    actor_rollout_ref.actor.policy_loss.lambda_vals=1.25 \
+    actor_rollout_ref.actor.ppo_mini_batch_size=1024 \
+    actor_rollout_ref.actor.ppo_micro_batch_size_per_gpu=1 \
+    actor_rollout_ref.actor.use_kl_loss=True \
+    actor_rollout_ref.actor.kl_loss_coef=0 \
+    actor_rollout_ref.actor.kl_loss_type=low_var_kl \
+    actor_rollout_ref.actor.entropy_coeff=0 \
+    actor_rollout_ref.actor.ppo_max_token_len_per_gpu=32768 \
+    actor_rollout_ref.model.enable_gradient_checkpointing=True \
+    actor_rollout_ref.actor.fsdp_config.param_offload=False \
+    actor_rollout_ref.actor.fsdp_config.optimizer_offload=False \
+    actor_rollout_ref.rollout.log_prob_micro_batch_size_per_gpu=4 \
+    actor_rollout_ref.rollout.tensor_model_parallel_size=4 \
+    actor_rollout_ref.rollout.name=vllm \
+    actor_rollout_ref.rollout.gpu_memory_utilization=0.6 \
+    actor_rollout_ref.rollout.n=1 \
+    actor_rollout_ref.rollout.max_num_batched_tokens=32768 \
+    actor_rollout_ref.rollout.temperature=1.0 \
+    actor_rollout_ref.rollout.top_p=1.0 \
+    actor_rollout_ref.rollout.val_kwargs.do_sample=True \
+    actor_rollout_ref.rollout.val_kwargs.temperature=1.0 \
+    actor_rollout_ref.rollout.val_kwargs.top_p=1.0 \
+    actor_rollout_ref.rollout.val_kwargs.n=32 \
+    actor_rollout_ref.ref.log_prob_micro_batch_size_per_gpu=4 \
+    actor_rollout_ref.ref.fsdp_config.param_offload=True \
+    algorithm.use_kl_in_reward=False \
+    reward_model.reward_manager=naive \
+    trainer.critic_warmup=0 \
+    trainer.val_before_train=True \
+    trainer.logger='["console"]' \
+    trainer.log_val_generations=10 \
+    trainer.project_name='on-policy-distillation' \
+    trainer.experiment_name='qwen3_1.7b_exopd_deepmath_repro' \
+    trainer.n_gpus_per_node=8 \
+    trainer.nnodes=1 \
+    trainer.save_freq=50 \
+    trainer.default_local_dir=$CKPT_DIR \
+    trainer.test_freq=10 \
+    trainer.total_epochs=3 "$@"
diff --git a/verl/tests/erropd/alpha_compare.py b/verl/tests/erropd/alpha_compare.py
new file mode 100644
index 0000000..e61f7ab
--- /dev/null
+++ b/verl/tests/erropd/alpha_compare.py
@@ -0,0 +1,198 @@
+"""Compare equiv_harness outputs of the reference snapshot without the alpha gate (e5b0c8e6f8, the snapshot RX part D
+ran on) and the tree with it, run in the same interpreter on the same stored batch. Exit 1 on any failure.
+
+Usage: python alpha_compare.py OLD.pt NEW.pt
+
+The reference tree does not read PAPER_RKL_ALPHA at all, so for every alpha scenario it runs the plain rkl_full step.
+That is what makes the default-off claim checkable rather than asserted:
+
+1. DEFAULT OFF.  Every pre-alpha scenario is bitwise unchanged (rkl_compare.py checks that set). Here: the tested
+   tree's `rkl_full` is bitwise equal to the reference tree's.
+2. alpha = 1 IS THE EXISTING ARM, BITWISE.  `rkl_alpha1` (alpha = 1, renorm off) and `rkl_alpha1_rn` (renorm on):
+   advantages, log-probs, pg losses, initial and updated parameters bitwise equal to the reference tree's run of the
+   same scenario, and to the tested tree's own `rkl_full`. Metrics are equal on every key the reference tree also
+   logs; the tested tree adds only `paper/alpha*` keys.
+3. THE LOSS IS THE SAME IN EVERY ARM.  `paper/rkl_full` (the true reverse KL at the parameters the step starts from)
+   is bitwise equal across `rkl_full` and all alpha arms: only the update differs, not what is measured.
+4. THE SURROGATE IS RIGHT.  `rkl_alpha1_surr` forces the surrogate path at alpha = 1: its update equals `rkl_full`'s
+   to float tolerance (it is the same gradient computed a different way), and its surrogate loss equals an
+   independent closed-form reference.
+5. alpha != 1 IS A DIFFERENT, CORRECT STEP.  For alpha 0.5 and 0, with and without renormalisation: the surrogate
+   loss and the updated parameters equal an independent implementation (plain HF forwards, the formula written out,
+   SGD), the update is real, and the parameters differ from `rkl_full`'s.
+6. THE RENORMALISATION HOLDS WHAT IT CLAIMS.  Per-prefix ||omega||_2 after renormalisation equals the alpha = 1 norm;
+   with renormalisation off the realised norms differ from it by orders of magnitude. Reported, with the factor.
+7. DIAGNOSTICS POPULATED.  Per step: the per-prefix gradient norm before and after renormalisation, the scale, the
+   angle to the alpha = 1 direction, the share of the gradient mass on the error decision (all masked positions, the
+   item-boundary states, and the err_slot-th one), and the update applied to the error decision's log-probability
+   after the optimizer step.
+8. CHUNKING IS NOT A DEGREE OF FREEDOM: chunk 1 and chunk 256 give bitwise identical metrics and parameters.
+9. REFUSALS: alpha with opd or fkl_sampled, a negative or non-finite alpha, a bad poststep mode.
+"""
+import math
+import sys
+
+import torch
+
+old = torch.load(sys.argv[1], weights_only=False)
+new = torch.load(sys.argv[2], weights_only=False)
+lines, fails = [], []
+ALPHA_SCEN = [k for k in new if isinstance(new[k], dict) and k.startswith("rkl_alpha")]
+
+
+def check(name, cond):
+    lines.append(f"{'PASS' if cond else 'FAIL'}  {name}")
+    if not cond:
+        fails.append(name)
+
+
+def eq(a, b):
+    if isinstance(a, torch.Tensor) or isinstance(b, torch.Tensor):
+        return isinstance(a, torch.Tensor) and isinstance(b, torch.Tensor) and a.shape == b.shape and torch.equal(a, b)
+    if isinstance(a, dict) and isinstance(b, dict):
+        return a.keys() == b.keys() and all(eq(a[k], b[k]) for k in a)
+    if isinstance(a, (list, tuple)) and isinstance(b, (list, tuple)):
+        return len(a) == len(b) and all(eq(x, y) for x, y in zip(a, b))
+    if isinstance(a, float) and isinstance(b, float) and math.isnan(a) and math.isnan(b):
+        return True
+    return a == b
+
+
+def dparam(x, y):
+    return max((x["params"][k] - y["params"][k]).abs().max().item() for k in x["params"])
+
+
+def upd(x):
+    return max((x["params"][k] - x["params0"][k]).abs().max().item() for k in x["params"])
+
+
+lines.append(f"reference tree: {old['verl_file']} (alpha gate: {old.get('has_alpha', False)})")
+lines.append(f"tested tree:    {new['verl_file']} (alpha gate: {new.get('has_alpha', False)})")
+check("reference tree lacks the alpha gate, tested tree has it",
+      (not old.get("has_alpha", False)) and new.get("has_alpha", False))
+check(f"all 8 alpha scenarios ran ({sorted(ALPHA_SCEN)})", len(ALPHA_SCEN) == 8)
+
+# 1. default off
+check("[rkl_full] with PAPER_RKL_ALPHA unset the tested tree is bitwise equal to the reference tree "
+      "(advantages, log-probs, pg losses, initial/updated parameters, every metric)",
+      all(eq(old["rkl_full"][k], new["rkl_full"][k]) for k in ("adv", "pg", "logp", "params0", "params", "metrics")))
+
+# 2. alpha = 1 is the existing arm, bitwise
+for sc in ("rkl_alpha1", "rkl_alpha1_rn"):
+    o, n = old[sc], new[sc]
+    hard = all(eq(o[k], n[k]) for k in ("adv", "pg", "logp", "params0", "params"))
+    extra = sorted(set(n["metrics"]) - set(o["metrics"]))
+    same = all(eq(o["metrics"][k], n["metrics"][k]) for k in o["metrics"])
+    check(f"[{sc}] losses and the parameter update are bitwise equal to the reference tree's plain rkl_full step "
+          f"(update size {upd(n):.3e})", hard)
+    check(f"[{sc}] every metric the reference tree logs is bitwise equal; the only new keys are paper/alpha* "
+          f"({len(extra)} of them)", same and all(k.startswith("paper/alpha") for k in extra) and len(extra) > 10)
+    check(f"[{sc}] bitwise equal to the tested tree's own rkl_full as well (max param diff "
+          f"{dparam(n, new['rkl_full']):.1e})", eq(n["params"], new["rkl_full"]["params"]))
+    check(f"[{sc}] the renormalisation factor is exactly 1.0 at alpha = 1 "
+          f"(min {min(n['metrics']['paper/alpha_scale_min']):.6f}, max {max(n['metrics']['paper/alpha_scale_max']):.6f})",
+          all(x == 1.0 for x in n["metrics"]["paper/alpha_scale_min"] + n["metrics"]["paper/alpha_scale_max"]))
+    check(f"[{sc}] the applied step is flagged as the existing one (paper/alpha_applied == 0)",
+          all(x == 0.0 for x in n["metrics"]["paper/alpha_applied"]))
+
+# 3. the measured loss is the same in every arm
+base = new["rkl_full"]["metrics"]["paper/rkl_full"]
+check(f"[all arms] paper/rkl_full is bitwise equal across rkl_full and all 8 alpha arms "
+      f"({[round(x, 5) for x in base]}): only the update differs, not the quantity measured",
+      all(eq(base, new[sc]["metrics"]["paper/rkl_full"]) for sc in ALPHA_SCEN))
+
+# 4. the surrogate is right
+n = new["rkl_alpha1_surr"]
+dp = dparam(n, new["rkl_full"])
+check(f"[rkl_alpha1_surr] forcing the surrogate at alpha = 1 gives the same update as rkl_full to float tolerance "
+      f"(max param diff {dp:.2e} <= 1e-9, update size {upd(n):.2e})", dp <= 1e-9)
+ref = n["fkl_ref"]
+dl = max(abs(a - float(b)) for a, b in zip(n["metrics"]["paper/alpha_surr_loss"], ref["ce"]))
+check(f"[rkl_alpha1_surr] the surrogate loss equals the independent closed-form reference (max diff {dl:.2e} <= 1e-6)",
+      dl <= 1e-6)
+
+# 5. alpha != 1 is a different, correct step
+for sc in ("rkl_alpha05", "rkl_alpha05_norn", "rkl_alpha0", "rkl_alpha0_norn"):
+    n = new[sc]
+    ref = n["fkl_ref"]
+    dl = max(abs(a - float(b)) for a, b in zip(n["metrics"]["paper/alpha_surr_loss"], ref["ce"]))
+    scale = max(abs(float(b)) for b in ref["ce"])
+    # 1e-5 relative, not tighter, for a reason: the implementation centres omega twice (the second pass is a float
+    # cleanup of an identity that is exact in real arithmetic) and this reference centres it once as the formula is
+    # written, and the surrogate sums terms of order ||omega||_inf * ||lp||_inf to a result two to three orders of
+    # magnitude smaller, so the cancellation amplifies that difference. The load-bearing check is the next one: the
+    # parameter update is bitwise equal, i.e. the GRADIENT is identical and only this scalar's reduction differs.
+    bar = 1e-5 * scale + 1e-8
+    dp = max((n["params"][k] - ref["params"][k]).abs().max().item() for k in ref["params"])
+    dd = dparam(n, new["rkl_full"])
+    check(f"[{sc}] surrogate loss per micro-batch == an independent implementation of the same formula "
+          f"(max diff {dl:.2e} <= {bar:.1e}, i.e. 1e-5 of the largest loss; the residual is the implementation's "
+          f"second centering pass seen through the surrogate's cancellation, and the gradient check below is bitwise; "
+          f"losses {[round(float(x), 6) for x in n['metrics']['paper/alpha_surr_loss']]})", dl <= bar)
+    check(f"[{sc}] SGD update == the independent step (max param diff {dp:.2e} <= 1e-8; update size {upd(n):.2e})",
+          dp <= 1e-8)
+    check(f"[{sc}] the update is real and differs from rkl_full's (max param diff from rkl_full {dd:.2e} > 1e-8)",
+          upd(n) > 1e-8 and dd > 1e-8)
+    check(f"[{sc}] no policy-gradient path was taken and no ERROPD ack was emitted",
+          len(n["adv"]) == 0 and "erropd/actor_ack" not in n["metrics"])
+
+# 6. what the renormalisation holds
+for sc in ALPHA_SCEN:
+    n, m = new[sc], new[sc]["metrics"]
+    a1 = sum(m["paper/alpha_gnorm_a1"]) / len(m["paper/alpha_gnorm_a1"])
+    pre = sum(m["paper/alpha_gnorm_pre"]) / len(m["paper/alpha_gnorm_pre"])
+    post = sum(m["paper/alpha_gnorm_post"]) / len(m["paper/alpha_gnorm_post"])
+    renorm = m["paper/alpha_renorm"][0] == 1.0
+    cos = sum(m["paper/alpha_cos_to_a1"]) / len(m["paper/alpha_cos_to_a1"])
+    if renorm:
+        check(f"[{sc}] renormalised: mean per-prefix ||omega|| after == the alpha=1 norm "
+              f"({post:.6g} vs {a1:.6g}; before renormalisation {pre:.6g}, i.e. x{pre / max(a1, 1e-30):.3g}); "
+              f"mean cos to the alpha=1 direction {cos:.4f}", abs(post - a1) <= 1e-6 * max(a1, 1e-30) + 1e-12)
+    else:
+        check(f"[{sc}] renormalisation off: realised norm {pre:.6g} against the alpha=1 norm {a1:.6g} "
+              f"(x{pre / max(a1, 1e-30):.3g}); mean cos to the alpha=1 direction {cos:.4f}", True)
+    zs = max(m["paper/alpha_zerosum_rel_max"])
+    check(f"[{sc}] the zero-sum identity holds to fp32 (max |sum_v omega| / ||omega||_1 = {zs:.2e} <= 1e-4)",
+          zs <= 1e-4)
+
+# 7. diagnostics populated
+WANT = ["paper/alpha", "paper/alpha_renorm", "paper/alpha_applied", "paper/alpha_gnorm_a1", "paper/alpha_gnorm_pre",
+        "paper/alpha_gnorm_post", "paper/alpha_scale_mean", "paper/alpha_scale_min", "paper/alpha_scale_max",
+        "paper/alpha_cos_to_a1", "paper/alpha_zerosum_rel_max"]
+for sc in ALPHA_SCEN:
+    m = new[sc]["metrics"]
+    miss = [k for k in WANT if k not in m]
+    check(f"[{sc}] the step-size diagnostics are all logged ({len(WANT)} keys)", not miss)
+    for tag in ("all", "bnd", "slot"):
+        need = [f"paper/alpha_p_err_{tag}", f"paper/alpha_om_err_{tag}", f"paper/alpha_err_share_{tag}",
+                f"paper/alpha_err_mass_frac_{tag}", f"paper/alpha_dlogp_err_{tag}_mean",
+                f"paper/alpha_dlogp_err_{tag}_absmax"]
+        miss = [k for k in need if k not in m]
+        n_set = max(m.get(f"paper/alpha_n_{tag}", [0]))
+        if n_set == 0:
+            # the set can be empty on a synthetic batch; then the count must be logged and nothing else
+            check(f"[{sc}] the '{tag}' position set is empty on this batch and is reported as 0, with no "
+                  f"other key for it", not any(k in m for k in need))
+            continue
+        check(f"[{sc}] the error-decision diagnostics are logged for the '{tag}' position set ({n_set:g} positions), "
+              f"including the post-step update to its log-probability ("
+              f"share {m.get(f'paper/alpha_err_mass_frac_{tag}', [float('nan')])[0]:.3g}, "
+              f"dlogp {m.get(f'paper/alpha_dlogp_err_{tag}_mean', [float('nan')])[0]:+.3e})", not miss)
+    check(f"[{sc}] the post-step measurement covered a nonzero number of positions",
+          m.get("paper/alpha_dlogp_err_all_n", [0])[0] > 0)
+
+# 8. chunking
+check("[rkl_alpha0_chunk1] chunk 1 and chunk 256 give bitwise identical parameters and alpha metrics",
+      eq(new["rkl_alpha0"]["params"], new["rkl_alpha0_chunk1"]["params"])
+      and all(eq(new["rkl_alpha0"]["metrics"][k], new["rkl_alpha0_chunk1"]["metrics"][k])
+              for k in new["rkl_alpha0"]["metrics"] if k.startswith("paper/alpha")
+              and not k.startswith("paper/alpha_dlogp")))
+
+# 9. refusals
+for k, r in new.get("alpha_refusals", {}).items():
+    check(f"[refusal {k}] raises ({(r['error'] or 'none')[:90]}) and leaves parameters unchanged",
+          r["error"] is not None and r["params_unchanged"])
+
+print("\n".join(lines))
+print(f"\n{sum(1 for x in lines if x.startswith('PASS'))} passed, {len(fails)} failed")
+sys.exit(1 if fails else 0)
diff --git a/verl/tests/erropd/check_locator_vs_parser.py b/verl/tests/erropd/check_locator_vs_parser.py
new file mode 100644
index 0000000..6d54072
--- /dev/null
+++ b/verl/tests/erropd/check_locator_vs_parser.py
@@ -0,0 +1,85 @@
+"""Agreement between the b2 violation locator and the verbatim strict parser.
+
+Runs over eval prediction files (records with review_ids, K, pred_text, pred_scores),
+recomputes the parser on pred_text, and cross-tabulates it against the locator.
+
+Required property (asserted): parser passes  <=>  locator status == valid,
+on records where pred_text is not truncated (eval stores text[:1000]).
+
+Usage: python check_locator_vs_parser.py FILE_LIST [REPO_ROOT]
+"""
+
+import collections
+import importlib.util
+import json
+import os
+import sys
+
+HERE = os.path.dirname(os.path.abspath(__file__))
+spec = importlib.util.spec_from_file_location(
+    "lc", os.path.join(HERE, "..", "..", "verl", "erropd", "listwise_contract.py"))
+lc = importlib.util.module_from_spec(spec)
+spec.loader.exec_module(lc)
+
+
+def main():
+    flist = sys.argv[1]
+    root = sys.argv[2] if len(sys.argv) > 2 else "."
+    files = [l.strip() for l in open(flist) if l.strip()]
+    tab = collections.Counter()
+    vtypes = collections.Counter()
+    stored_mismatch = 0
+    n_files_used = 0
+    n_trunc = 0
+    bad_examples = []
+    for f in files:
+        path = os.path.join(root, f)
+        try:
+            fh = open(path)
+        except Exception:
+            continue
+        used = False
+        for line in fh:
+            try:
+                r = json.loads(line)
+            except Exception:
+                continue
+            task = "esci" if "product_ids" in r else "fashion"
+            id_key, list_key = lc.TASK_KEYS[task]
+            if not all(k in r for k in (list_key, "K", "pred_text")):
+                continue
+            used = True
+            text, K, rids = r["pred_text"], int(r["K"]), [str(x) for x in r[list_key]]
+            if len(text) >= 1000:
+                n_trunc += 1
+                continue
+            p = lc.strict_valid(text, K, rids, task)
+            if "pred_scores" in r and (r["pred_scores"] is not None) != p:
+                stored_mismatch += 1
+            st, ci, vt = lc.locate_first_violation(text, K, rids, id_key)
+            tab[(p, st)] += 1
+            if st in (lc.VIOLATION, lc.INCOMPLETE):
+                vtypes[vt] += 1
+            agree = (p and st == lc.VALID) or (not p and st != lc.VALID)
+            if not agree and len(bad_examples) < 10:
+                bad_examples.append({"file": f, "parser": p, "locator": st, "vtype": vt, "at": ci,
+                                     "text": text[:300]})
+        fh.close()
+        n_files_used += used
+    print(f"files scanned={len(files)} with listwise records={n_files_used} truncated(skipped)={n_trunc}")
+    print(f"stored pred_scores vs recomputed parser mismatches: {stored_mismatch}")
+    print("cross-tab (parser_pass, locator_status): count")
+    for k in sorted(tab, key=str):
+        print(f"  {k}: {tab[k]}")
+    print("violation/incomplete types:")
+    for k, v in vtypes.most_common():
+        print(f"  {k}: {v}")
+    dis = sum(v for (p, st), v in tab.items() if (p and st != lc.VALID) or (not p and st == lc.VALID))
+    print(f"DISAGREEMENTS: {dis}")
+    for b in bad_examples:
+        print(json.dumps(b))
+    sys.exit(1 if dis else 0)
+
+
+if __name__ == "__main__":
+    main()
